	};
	
	const array<string> FriendNames = {
		"äpıttˇDM", "|UR|Ja|zz|CC", "BeckY", "|l<ÓrB˝|g|ääB", "evilmike", "Ma|tt|W LD CC", "DreamaGpW", "L¡bR·TkÔ–|TF", "R‡d|i˘m", "|Bl‰Ák —ÔÒj‡", "violetclm DM", "||||||||'", "", "",
		"–J‚zz", "KJAZZ", "||||Hugela", "Trafton", "|||Bean", "|L||Ô|Ò|k||*", "|et", "||||Blurred||D", "The Server", "|||Smoke|[NC]", "-t3>PJ", "blacky[si]", "cooba[si]", "s¿lƒm√nDËR DM"
	};
	const array<bool> FriendSpaz = {
		true, false, true, false, true, true, true, true, false, false, true, true, false, false,
		true, false, true, true, true, false, false, true, false, true, true, true, true, true
		
