	const uint FirstFriendPlayerID = 32 - FriendNames.length;
	uint FriendColor(uint8 a, uint8 b, uint8 c, uint8 d) { return a | (b << 8) | (c << 16) | (d << 24); }
	const array<uint> FriendColors = {
		FriendColor(72, 72, 32, 80), FriendColor(29,29,29,29), FriendColor(1,1,1,1), FriendColor(34,24,31,16), FriendColor(72,32,72,72), FriendColor(1,1,1,1), FriendColor(1,1,1,1), FriendColor(80,80,80,80), FriendColor(1,1,1,1), FriendColor(1,88,40,16), FriendColor(32, 72, 24, 88), FriendColor(40,80,72,80), FriendColor(152,152,152,152), FriendColor(72, 24,24,24),
		FriendColor(32,16,64,40), FriendColor(24,16,40,32), FriendColor(32,40,96,104), FriendColor(32,1,16,1), FriendColor(24,32,24,72), FriendColor(74,96,40,104), FriendColor(73,24,24,39), FriendColor(32,40,32,32), FriendColor(24,24,24,24), FriendColor(72,72,72,72), FriendColor(40,88,32,80), FriendColor(24,1,24,24), FriendColor(32,88,32,1), FriendColor(72,16,40,32)
	};
	//jazz: fur, headband, gun, armbands
	//spaz: gun, ears, shoes, chest
	const array<uint8> KeyColors = {
		48, 80, 24, 72, 32, 88, 40, 16
	};
	
	
	const SOUND::Sample HPYeahoo =		SOUND::P2_FROG1;
	const SOUND::Sample HPCrystal =		SOUND::P2_FROG2;
	const SOUND::Sample HPSwitch =		SOUND::P2_FROG3;
	const SOUND::Sample HPTreasure =	SOUND::COMMON_PICKUP1;
	const SOUND::Sample HPTrigger =		SOUND::P2_FROG5;
	const SOUND::Sample HPWarp =		SOUND::P2_FART;
