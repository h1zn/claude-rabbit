	const SOUND::Sample ESJF =			SOUND::P2_PLOPSEQ4;
	
	
	const bool CountEnemies = false; //only useful during development, for determining the total numbers of enemies in the whole pack, to display in the Guardian level clear screen
	
	
	const uint heartFrame = jjAnimations[jjAnimSets[ANIM::PICKUPS] + 41];
	int ExtraHealthPadding = 0;
	uint skullFrame;
	const array<uint8> StaticColors = {28, 29, 30, 76, 77, 78};
	jjPLAYER@ Player = jjLocalPlayers[0];
	float PlayerLastSpeed = 0;
	const auto oldScore = Player.score;
	const uint LocalPlayerID = Player.localPlayerID;
	
	array<uint> GemTargets(4, 0), GemCounts(4, 0);
	uint TimeSpentNotViewingPopups = 0;
	
	bool IsMurderer = false;
	jjVOIDFUNC@ myLevelReload = null;
	jjVOIDFUNC@ myCoinWarpFunction = null;
	funcdef void CanvasFunction(jjPLAYER@, jjCANVAS@);
	CanvasFunction@ myHUD = null;
	
	int GetAngle(float xSpeed, float ySpeed) {
		return int(atan2(
		    ySpeed,
		    xSpeed
		) * -512.0 * 0.318309886142228);
	}
	
	class Point {
		float x; float y;
		Point(){}
		Point(float xx, float yy) {
			x = xx;
			y = yy;
		}
		const Point& opAssign(const Point &in other) {
			x = other.x;
			y = other.y;
			return this;
		}
		bool opEquals(const Point &in other) const {
			return x == other.x && y == other.y;
		}
	}
	enum CollectibleTypes {
		Coin, Pink,Turquoise,Red,Silver,Blue,Purple,Gold,Green
	};
	class CollectibleLocation {
		Point Location;
		bool Found = false;
		CollectibleTypes Type;
		CollectibleLocation(Point l, CollectibleTypes t) { Location = l; Type = t; }
		CollectibleLocation(){}
	}
	array<CollectibleLocation> CollectibleLocations;
	Point CoinWarpLocation;
	bool CoinWarpFound = false;
	const uint CoinAnim = jjObjectPresets[OBJECT::SILVERCOIN].curAnim;
	const uint CoinFirstFrame = jjAnimations[CoinAnim];
	uint KeyFrame, PogoFrame;
	
	string musicFilename = jjMusicFileName;
	
	void Setup() {
		jjAnimSets[ANIM::CUSTOM[AnimSets::Misc]].load(AnimSets::Misc, "BL18.j2a");
		const uint firstMiscMiscFrame = jjAnimations[jjAnimSets[ANIM::CUSTOM[AnimSets::Misc]] + 1];
		KeyFrame = firstMiscMiscFrame + 3;
		
		for (uint i = 4; i <= 5; ++i)
			Resize::Resize(jjAnimations[jjAnimSets[ANIM::CUSTOM[AnimSets::Misc]] + i], 2, Resize::Method::Scale2xSAI | Resize::Flags::OnlySpriteColors);
			
		for (uint i = 5; i <= 20; ++i)
			if (i <= 6 || i >= 19) {
				const uint frameID = jjAnimations[jjAnimSets[ANIM::CUSTOM[AnimSets::Misc]] + 1] + i;
				Resize::Resize(Resize::Resize(jjPIXELMAP(jjAnimFrames[frameID]), 0.5), 2, Resize::Method::Scale2x).save(jjAnimFrames[frameID]);
			}
		
		TrueColor::ProcessPalette();
		const auto skullAnimSet = TrueColor::FindCustomAnim();
		TrueColor::AllocateSpriteSheet(skullAnimSet, TrueColor::Bitmap("BL18.bmp"), array<array<TrueColor::Coordinates>>={{TrueColor::Coordinates(0,0,40,45,-20,-22), TrueColor::Coordinates(40,0,64,32,-32,0), TrueColor::Coordinates(40,32,64,32,-32,0)}});
		skullFrame = jjAnimations[jjAnimSets[skullAnimSet]];
		
		if ((FriendColors.length != FriendNames.length) || (FriendColors.length != FriendSpaz.length))
			jjDebug("Inconsistent friend array lengths!");
		
		for (uint i = 0; i < FriendColors.length; ++i)
			jjPlayers[FirstFriendPlayerID + i].fur = FriendColors[i];
		ConversationAppearance.xAmp = ConversationAppearance.yAmp = 0;
		
		jjAnimFrames[heartFrame].transparent = true;
		
		Player.morphTo(Player.charOrig = CHAR::JAZZ, false);
		
		jjSampleLoad(HPYeahoo, "HPYeahoo.wav");
		jjSampleLoad(HPCrystal, "HPCrystal.wav");
		jjSampleLoad(HPSwitch, "HPSwitch.wav");
		jjSampleLoad(HPTreasure, "HPTreasure.wav");
		jjSampleLoad(HPTrigger, "HPTrigger.wav");
		jjSampleLoad(HPWarp, "HPWarp.wav");
		for (int i = 0; i < 3; ++i) {
			jjSampleLoad(SOUND::Sample(ESJM + i), "ESJM" + (i+1) + ".wav");
			jjSampleLoad(SOUND::Sample(ESJF + i), "ESJF" + (i+1) + ".wav");
		}
		
		uint EnemyCount = 0;
		array<uint> EventsAreEnemies(256, 0);
		const uint levelID = jjLevelFileName.substr(jjLevelFileName.length - 5, 1)[0] - '0'[0];
		if (CountEnemies) {
			EventsAreEnemies[OBJECT::FATCHICK] = 1;
			EventsAreEnemies[OBJECT::FENCER] = 1;
			EventsAreEnemies[OBJECT::FLOATLIZARD] = 1;
			EventsAreEnemies[OBJECT::TUBETURTLE] = 1;
			EventsAreEnemies[OBJECT::FISH] = 1;
			EventsAreEnemies[OBJECT::BAT] = 1;
			EventsAreEnemies[OBJECT::MONKEY] = 1;
			EventsAreEnemies[OBJECT::STANDMONKEY] = 1;
			EventsAreEnemies[OBJECT::DOGGYDOGG] = 1;
			EventsAreEnemies[OBJECT::WATERMELON] = 1; //Trogdor
			EventsAreEnemies[OBJECT::BILSY] = 1;
			EventsAreEnemies[OBJECT::PEACH] = 4; //Frog
			EventsAreEnemies[OBJECT::FLOATSUCKER] = 1;
			EventsAreEnemies[OBJECT::SUCKER] = 1;
			EventsAreEnemies[OBJECT::LABRAT] = 1;
			EventsAreEnemies[OBJECT::RAVEN] = 1;
			EventsAreEnemies[OBJECT::DEMON] = 1;
			EventsAreEnemies[OBJECT::SPARK] = 2;
			EventsAreEnemies[OBJECT::HATTER] = 1;
			if (levelID == 3) {
				EventsAreEnemies[OBJECT::UTERUS] = 1 + 4;// + 2 * jjDifficulty; //spikeballs //doing this addition in Guardian instead
			} else if (levelID == 4) {
				EventsAreEnemies[OBJECT::MORPH] = 8; //BN
				EventsAreEnemies[OBJECT::MILK] = 1; //Cow
				EventsAreEnemies[OBJECT::DEVILDEVAN] = 1;
			} else if (levelID == 6) {
				EventsAreEnemies[OBJECT::UTERUS] = 1;
				EventsAreEnemies[OBJECT::MORPH] = 1; //PJ
				EnemyCount = 1; //Jill/Fooruman
			} else if (levelID == 7) {
				EventsAreEnemies[OBJECT::MORPH] = 1; //Monk, including Greenkiller
			}
		}
		for (uint i = 0; i < 256; ++i)
			jjObjectPresets[i].points = 0;
		array<bool> EventsFound(256, false);
		for (int x = 0; x < jjLayerWidth[4]; ++x)
			for (int y = jjLayerHeight[4] - 1; y >= 0; --y) {
				uint8 eventID = jjEventGet(x, y);
				if (CountEnemies) {
					if (eventID == OBJECT::GRASSPLATFORM && levelID == 6) { //ferris wheel
						if (jjParameterGet(x,y, 12,1) == 1) //with mortar enemies
							EnemyCount += jjParameterGet(x,y, 2,5); //number of platforms
					} else {
						uint8 enemyEventID = eventID;
						//detect events hidden inside walls
						if (eventID == OBJECT::BANANA) //HocusWall
							enemyEventID = jjParameterGet(x, y, 5, 8);
						else if (eventID == OBJECT::CHERRY) // HocusDestructScenery
							enemyEventID = jjParameterGet(x, y, 0, 8);
						else if (enemyEventID == OBJECT::FLOATLIZARD && jjParameterGet(x, y, 0, 3) == 3) //fake egg
							EnemyCount -= 1;
						EnemyCount += EventsAreEnemies[enemyEventID];
					}
				}
				if (eventID > 32 && !EventsFound[eventID]) {
					EventsFound[eventID] = true;
					jjOBJ@ preset = jjObjectPresets[eventID];
					switch (eventID) {
						case OBJECT::FATCHICK:
							FatChick(preset);
							break;
						case OBJECT::FENCER:
							Fencer(preset);
							break;
						case OBJECT::FLOATLIZARD:
							FloatLizard(preset);
							break;
						case OBJECT::TUBETURTLE:
							TubeTurle(preset);
							break;
						case OBJECT::FISH:
							Fish(preset);
							break;
						case OBJECT::BAT:
							RedBat(preset);
							break;
						case OBJECT::MONKEY:
						case OBJECT::STANDMONKEY:
							Monkey(preset);
							break;
						case OBJECT::DOGGYDOGG:
							Muttshroom(preset);
							break;
						case OBJECT::WATERMELON:
							Trogdor(preset);
							break;
						case OBJECT::BILSY:
							MiniBilsy(preset);
							break;
						case OBJECT::PEACH:
							FrogFly(jjObjectPresets[OBJECT::DRAGONFLY]);
							Frog(preset);
							break;
						case OBJECT::FLOATSUCKER:
							FloatSucker(preset);
							break;
						case OBJECT::SUCKER:
							Sucker(preset);
							break;
						case OBJECT::LABRAT:
							Labrat(preset);
							break;
						case OBJECT::RAVEN:
							Phoenix(preset);
							break;
						case OBJECT::DEMON:
							Demon(preset);
							break;
						case OBJECT::SPARK:
							Duet(preset);
							break;
						case OBJECT::HATTER:
							Hatter(preset);
							break;
						case OBJECT::SILVERCOIN:
							EventsFound[eventID] = false;
							CollectibleLocations.insertLast(CollectibleLocation(Point(x * 32 + 15, y * 32 + 15), CollectibleTypes(jjParameterGet(x, y, 0, 4))));
							break;
						case OBJECT::WARP:
							if (jjParameterGet(x, y, 17, 1) == 0) { //ShowAnim=0: just an area, not a warp object
								EventsFound[eventID] = false;
								break;
							}
							CoinWarpLocation = Point(x * 32, y * 32);
							preset.behavior = CoinWarp;
							break;
						case OBJECT::CARROT:
							preset.behavior = RestrictedCarrot;
							break;
						case OBJECT::BOUNCERAMMO3:
						case OBJECT::ICEAMMO3:
						case OBJECT::SEEKERAMMO3:
						case OBJECT::RFAMMO3:
						case OBJECT::TOASTERAMMO3:
						case OBJECT::TNTAMMO3:
						case OBJECT::GUN8AMMO3:
						case OBJECT::GUN9AMMO3:
							preset.behavior = NotOnHardPickup;
							break;
						case OBJECT::APPLE:
							preset.scriptedCollisions = true;
							preset.curFrame = KeyFrame + 1;
							preset.behavior = Lock();
							break;
						case OBJECT::BANANA:
							preset.behavior = HocusWall;
							preset.playerHandling = HANDLING::PARTICLE;
							break;
						case OBJECT::CHERRY:
							preset.behavior = HocusDestructScenery();
							preset.playerHandling = HANDLING::SPECIAL;
							preset.bulletHandling = HANDLING::DETECTBULLET;
							preset.scriptedCollisions = true;
							preset.isFreezable = false;
							preset.triggersTNT = true;
							preset.determineCurAnim(ANIM::DESTSCEN, 2);
							preset.determineCurFrame();
							break;
						case OBJECT::REDGEM:
							HocusGem(preset, 0, 0, 10, 100);
							break;
						case OBJECT::PURPLEGEM:
							HocusGem(preset, 0, 3, 4, 250);
							break;
						case OBJECT::GREENGEM:
							HocusGem(preset, 1, 1, 5, 500);
							break;
						case OBJECT::BLUEGEM:
							HocusGem(preset, 2, 2, 5, 1000);
							break;
						case OBJECT::ORANGE: {
							preset.behavior = WarpPotion();
							preset.scriptedCollisions = true;
							Recolor(jjAnimations[preset.determineCurAnim(ANIM::PICKUPS, 78)], array<uint8>={88}, RecolorReplace(32));
							break; }
						case OBJECT::PEAR:
							preset.behavior = Switch();
							preset.playerHandling = HANDLING::PARTICLE;
							preset.curFrame = firstMiscMiscFrame + 5;
							break;
						case OBJECT::PRETZEL:
							preset.behavior = Friend();
							preset.playerHandling = HANDLING::PARTICLE;
							preset.determineCurAnim(ANIM::MENU,0,false);
							preset.curFrame = firstMiscMiscFrame + 5;
							break;
						case OBJECT::STRAWBERRY:
							preset.behavior = Furryball;
							preset.playerHandling = HANDLING::ENEMYBULLET;
							preset.animSpeed = jjDifficulty > 0 ? 2 : 1;
							preset.curFrame = firstMiscMiscFrame + 9;
							preset.killAnim = jjAnimSets[ANIM::AMMO] + 5;
							break;
						case OBJECT::LEMON:
							preset.behavior = Elevator;
							preset.isBlastable = false;
							preset.playerHandling = HANDLING::SPECIAL;
							preset.bulletHandling = HANDLING::DESTROYBULLET;
							preset.curFrame = skullFrame + TrueColor::NumberOfFramesPerImage;
							preset.special = firstMiscMiscFrame + 10; //8-bit
							preset.deactivates = false;
							break;
						case OBJECT::LIME:
							preset.behavior = Spikes;
							preset.playerHandling = HANDLING::ENEMYBULLET;
							preset.animSpeed = 1;
							preset.curFrame = firstMiscMiscFrame + 12;
							break;
						case 122: //lava
							LevelContainsLava = true;
							preset.behavior = function(obj) { obj.behavior = Lava(); };
							preset.playerHandling = HANDLING::PARTICLE;
							preset.determineCurAnim(ANIM::CUSTOM[AnimSets::Misc], 6);
							preset.special = firstMiscMiscFrame + 14;
							break;
						case OBJECT::BRIDGE:
							jjAnimSets[ANIM::BRIDGE].load(AnimSets::Bridge, "BL18.j2a");
							break;
						case OBJECT::SAVEPOST:
							preset.deactivates = false;
							preset.behavior = CheckpointWrapper;
							preset.curFrame = (jjAnimations[preset.curAnim] = jjAnimations[jjAnimSets[ANIM::CUSTOM[AnimSets::Misc]] + 8]).firstFrame;
							break;
						case OBJECT::BIGROCK:
							preset.behavior = CompanionRock;
							jjAnimFrames[preset.curFrame].hotSpotX -= 4; //to be better able to avoid landing on elevators
							break;
						case OBJECT::GRAPES:
							preset.behavior = Balloon();
							preset.scriptedCollisions = true;
							preset.curFrame = firstMiscMiscFrame + 18;
							break;
						case OBJECT::FLYCARROT:
							preset.behavior = TemporaryFlyCarrot(); //this is going to be limited to the PJ level, but it's similar enough code to some of this other stuff I find it more convenient to have it in here
							preset.scriptedCollisions = true;
							break;
						case OBJECT::LETTUCE:
							if (jjDifficulty > 0) { //no smart bombs on easy
								preset.behavior = SmartBomb();
								preset.playerHandling = HANDLING::SPECIAL;
								preset.scriptedCollisions = true;
								preset.curAnim = jjAnimSets[TrueColor::FindCustomAnim()].load(AnimSets::SmartBomb, "BL18.j2a");
								preset.killAnim = jjAnimSets[ANIM::AMMO] + 77;
								preset.lightType = LIGHT::BRIGHT;
								preset.light = 9;
							} else {
								preset.behavior = BEHAVIOR::INACTIVE;
							}
							break;
						case OBJECT::BURGER:
							preset.behavior = Gear;
							preset.playerHandling = HANDLING::PARTICLE;
							preset.curAnim = jjAnimSets[TrueColor::FindCustomAnim()].load(AnimSets::Gear, "BL18.j2a");
							preset.determineCurFrame();
							break;
					}
				}
				//detect events hidden inside walls
				if (eventID == OBJECT::BANANA) //HocusWall
					eventID = jjParameterGet(x, y, 5, 8);
				else if (eventID == OBJECT::CHERRY) // HocusDestructScenery
					eventID = jjParameterGet(x, y, 0, 8);
				if (eventID >= OBJECT::REDGEM && eventID <= OBJECT::PURPLEGEM) {
					GemTargets[eventID - OBJECT::REDGEM] += 1;
				}
			}
			
		if (CountEnemies)
			jjPrint("Total enemies:  " + EnemyCount);
			
		jjOBJ@ preset = jjObjectPresets[OBJECT::THING]; //do this outside the loop, because of JJPOGO
		preset.behavior = PogoStick();
		preset.playerHandling = HANDLING::PARTICLE;
		preset.curFrame = firstMiscMiscFrame + 5;
		jjAnimations[preset.curAnim].firstFrame = PogoFrame = firstMiscMiscFrame + 16;
		@preset = jjObjectPresets[OBJECT::SILVERCOIN]; //do this once, because coins are counted EVERY time they show up inside the loop
		preset.scriptedCollisions = true;
		preset.behavior = CollectableCoin();
	
		if (jjResolutionMaxWidth != 800 || jjResolutionMaxHeight != 600)
			jjChat("/maxresolution 800x600");
		
		int targetMaxHealth = 5 + Player.score % 50; //increased by 100% gem collection bonuses
		if (jjDifficulty != 0 ) targetMaxHealth -= jjDifficulty - 1; //5,5,4,3
		targetMaxHealth += ExtraHealthPadding;
		if (jjMaxHealth != targetMaxHealth) {
			jjChat("/smhealth " + targetMaxHealth);
		}
		for (int i = 0; i < 8; ++i)
			jjAlert(""); //move commands out of onscreen chatlog
		
		//fireballs, not pepper spray
		jjWeapons[WEAPON::GUN8].gradualAim = false;
		jjWeapons[WEAPON::GUN8].spread = SPREAD::NORMAL;
	}
	
	void RestrictedCarrot(jjOBJ@ obj) {
		if (IsMurderer) obj.delete();
		else obj.behave(BEHAVIOR::PICKUP);
	}
	void NotOnHardPickup(jjOBJ@ obj) {
		if (jjDifficulty >= 2 && obj.creator == CREATOR::LEVEL)
			obj.delete();
		else
			obj.behavior = BEHAVIOR::PICKUP;
	}
	
	class CollectableCoin : jjBEHAVIORINTERFACE {
		void onBehave(jjOBJ@ obj) { 
			if (obj.state == STATE::START) {
				obj.var[0] = jjParameterGet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0, 4);
				obj.points = 0;
				//if (obj.var[0] != 0)
					//obj.points *= 4;
			}
			obj.behave(BEHAVIOR::PICKUP, false);
			if (obj.var[0] != 0) obj.curFrame = KeyFrame;
			jjDrawSpriteFromCurFrame(obj.xPos, (obj.ySpeed != 0.f) ? obj.yPos : (obj.yPos + jjSin((obj.objectID*8+jjGameTicks+int(obj.xPos+obj.yPos*256))*16) * 4), obj.curFrame, obj.direction, SPRITE::SINGLEHUE, obj.var[0] == 0 ? 72 : KeyColors[obj.var[0] - 1]);
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			const Point myLocation(obj.xOrg, obj.yOrg);
			for (uint i = 0; i < CollectibleLocations.length; ++i)
				if (myLocation == CollectibleLocations[i].Location) {
					CollectibleLocations[i].Found = true;
					break;
				}
			jjSample(obj.xPos, obj.yPos, (obj.var[0] == 0) ? HPCrystal : HPYeahoo);
			jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos)].curAnim = obj.killAnim;
			obj.delete();
			jjEventSet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0);
			return true;
		}
	}
	
	const array<SOUND::Sample> ButtstompSounds = {SOUND::COMMON_SPLAT1, SOUND::COMMON_SPLAT2, SOUND::COMMON_SPLAT3, SOUND::COMMON_SPLAT4};
	enum Gender { Male, Female, Random };
	class Enemy : jjBEHAVIORINTERFACE {
		ANIM::Set animSetID;
		Gender gender = Gender::Random;
		Enemy(jjOBJ@ preset, BL18::AnimSets asi = BL18::AnimSets::_LAST) {
			preset.behavior = this;
			if (asi != AnimSets::_LAST)
				jjAnimSets[animSetID = TrueColor::FindCustomAnim()].load(asi, "BL18.j2a");
			preset.playerHandling = HANDLING::SPECIAL;
			preset.scriptedCollisions = true;
			preset.bulletHandling = HANDLING::DETECTBULLET;
			preset.isTarget = true;
			preset.triggersTNT = true;
			preset.isFreezable = true;
			preset.isBlastable = false; //not bothering with that nonsense
		}
		void die(jjOBJ@ obj, bool diedToBullet, bool diedWhileFrozen) const {
			Player.food += 1;
			obj.particlePixelExplosion(diedToBullet ? 0 : 2);
			for (uint i = 0; i < 30; ++i) {
				if (i < 10)
					jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos, i, CREATOR::OBJECT, BloodSpatter);
				jjObjects[jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos - (jjRandom() & 15), i, CREATOR::OBJECT, BoneWrapper)].freeze = diedWhileFrozen ? 255 : 0;
			}
			obj.energy = 0;
			obj.state = STATE::KILL;
			removeFromEventMap(obj);
			jjSamplePriority(jjRandom() & 3 < 3 ? SOUND::INTRO_BOEM1 : SOUND::INTRO_BOEM2);
			obj.delete();
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (obj.state == STATE::START || obj.state == STATE::DELAYEDSTART)
				return true;
			const bool isProbablyBoss = jjObjectPresets[obj.eventID].energy >= 20;
			const bool objfreeze = obj.freeze != 0;
			if (bullet is null) {
				if (force != 0) {
					if (objfreeze) {
						obj.state = obj.oldState;
						obj.unfreeze(1);
					}
					if ((obj.energy -= 4) <= 0) {
						obj.energy = 0;
						if (!IsMurderer) {
							player.showText("#||||~@@MURDERER", STRING::LARGE);
						}
						die(obj, false, objfreeze);
					} else {
						obj.justHit = 5;
					}
					if (!IsMurderer) {
						IsMurderer = true;
						jjPalette.fill(jjPALCOLOR(), 0.15);
						jjPalette.apply();
						if (!jjMusicLoad("DARKSIDE.MOD")) jjMusicStop();
					}
					jjSample(obj.xPos, obj.yPos, ButtstompSounds[jjRandom() % ButtstompSounds.length]);
					if (force > 0) { //buttstomp or sugar rush
						player.buttstomp = 50; //landing
						player.ySpeed = player.ySpeed / -2 - 8;
						player.yAcc = 0;
						player.extendInvincibility(-70);
					} else if (force == -101) { //running into frozen enemy
						player.xAcc = 0;
						player.xSpeed /= -2;
						player.ySpeed = -6;
						player.extendInvincibility(-10);
					}
					if (jjObjectPresets[obj.eventID].energy > 20)
						player.specialMove = 0;
				} else if (!objfreeze)
					player.hurt();
			} else {
				if (objfreeze) {
					obj.state = obj.oldState;
					obj.unfreeze(0);
					force += 1;
				}
				if ((bullet.var[6] & 16) == 0) { //fireball
					bullet.state = STATE::EXPLODE;
				} else if (isProbablyBoss) {
					bullet.state = STATE::EXPLODE;
					force *= 2;
				}
				if ((obj.energy -= force) <= 0) {
					if (!IsMurderer) {
						obj.oldState = obj.state;
						obj.state = STATE::DONE;
						obj.playerHandling = HANDLING::SPECIALDONE;
						obj.deactivates = false;
						obj.triggersTNT = false;
						obj.isTarget = false;
						obj.lightType = LIGHT::NONE;
						if (!jjLowDetail)
							jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos, 0, CREATOR::OBJECT, Orgasm);
						const uint rand = jjRandom();
						jjSample(obj.xPos, obj.yPos, SOUND::Sample(((gender == Gender::Female || (gender == Gender::Random && (rand & 128) == 128)) ? ESJF : ESJM) + (rand % 3)));
						Player.lives += 1;
						removeFromEventMap(obj);
					} else
						die(obj, true, objfreeze);
				} else {
					obj.justHit = 5;
				}
			}
			if (obj.energy <= 0 && !isProbablyBoss) { 
				const auto rand = jjRandom();
				if (rand & 15 == 0) {
					jjOBJ@ pickup = jjObjects[jjAddObject(rand & 16 == 16 ? OBJECT::FASTFIRE : OBJECT::CARROT, obj.xPos, obj.yPos, obj.objectID,CREATOR::OBJECT, BEHAVIOR::FLICKERGEM)];
					pickup.playerHandling = HANDLING::DELAYEDPICKUP;
					pickup.var[2] = 20;
					pickup.counter = 400 - (jjDifficulty * 50);
					pickup.light = 1;
					pickup.lightType = LIGHT::LASER;
				}
			}
			return true;
		}
		void onBehave(jjOBJ@ obj) {}
		
		uint8 Layer = 4;
		void drawBodySprite(const jjOBJ@ obj, float xPos, float yPos, int curFrame, int angle = 0, float scale = 1) const {
			const SPRITE::Mode mode = obj.state == STATE::DONE ? SPRITE::TINTED : obj.state == STATE::FREEZE ? SPRITE::FROZEN : obj.justHit == 0 ? SPRITE::NORMAL : SPRITE::SINGLECOLOR;
			if (angle == 0)
				jjDrawSpriteFromCurFrame(xPos, yPos, curFrame, obj.direction, mode, 48, Layer);
			else
				jjDrawRotatedSpriteFromCurFrame(xPos, yPos, curFrame, angle, obj.direction * scale, scale, mode, 48, Layer);
		}
		void drawHearts(const jjOBJ@ obj, int curFrame = -1) const {
			if (obj.state == STATE::DONE) {
				if (curFrame < 0) curFrame = obj.curFrame;
				const float heartsY = obj.yPos + jjAnimFrames[obj.curFrame].hotSpotY - 8;
				for (int i = 0; i < 1024; i += 205) {
					const int heartAngle = (jjGameTicks << 3) + i;
					jjDrawResizedSpriteFromCurFrame(obj.xPos + jjSin(heartAngle) * 13, heartsY + jjCos(heartAngle) * 6, heartFrame, 0.5, 0.5, SPRITE::TINTED, 48, Layer);
				}
			}
		}
		void drawMainSprite(const jjOBJ@ obj, int curFrame = -1, int angle = 0) const {
			if (curFrame < 0) curFrame = obj.curFrame;
			drawHearts(obj, curFrame);
			drawBodySprite(obj, obj.xPos, obj.yPos, curFrame, angle);
		}
		void onDraw(jjOBJ@ obj) { drawMainSprite(obj); }
		
	}
		int getParameterAtOrigin(const jjOBJ@ obj, int offset, int length) /*const*/ {
			return jjParameterGet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, offset, length);
		}
	
	void removeFromEventMap(jjOBJ@ obj) {
		obj.eventID = 0; //prevent STATE::DEACTIVATE snafus
		jjEventSet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0);
	}
	
	void Orgasm(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.lightType = LIGHT::RING2;
			obj.light = 0;
			obj.state = STATE::EXPLODE;
		} else if (++obj.light > 31)
			obj.delete();
		else
			jjAddObject(obj.eventID, obj.xOrg + (jjRandom() & 63) - 32, obj.yOrg + (jjRandom() & 63) - 32, 0,CREATOR::OBJECT, LesserOrgasm);
	}
	void LesserOrgasm(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.lightType = LIGHT::RING;
			obj.light = 0;
			obj.state = STATE::EXPLODE;
			if (jjGameTicks & 1 == 1)
				jjObjects[jjAddObject(OBJECT::BOUNCEONCE, obj.xPos, obj.yPos)].curAnim = (jjRandom() & 1 == 1) ? (jjAnimSets[ANIM::COMMON].firstAnim) : (jjAnimSets[ANIM::PICKUPS].firstAnim + 41);
		} else if (++obj.light > 11)
			obj.delete();
	}
	
	class FatChick : Enemy {
		FatChick(jjOBJ@ preset) {
			super(preset, AnimSets::FatChick);
			gender = Gender::Female;
		}		
		void onBehave(jjOBJ@ obj) override {
			if (obj.counter >= 70*2 - 1 && obj.state == STATE::WALK) {
				if (obj.counter++ == 70*2 - 1) {
					jjObjects[jjAddObject(OBJECT::BULLET, obj.xPos + 5*obj.direction, obj.yPos - 14, obj.objectID, CREATOR::OBJECT, FatHead)].curFrame = jjAnimations[jjAnimSets[animSetID]];
				} else if (obj.counter == 70*3)
					obj.counter = 0;
			} else {
				obj.behave(BEHAVIOR::FATCHICK, false);
			}
		}
		void onDraw(jjOBJ@ obj) override {
			drawMainSprite(obj, (obj.counter >= 70*2) ? jjAnimations[jjAnimSets[ANIM::FATCHK]] + 10 + ((obj.counter >> 2) & 1) : -1);
		}
	}
	void FatHead(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.direction = jjObjects[obj.creatorID].direction;
			
			obj.special = GetAngle(Player.yPos - obj.yPos, obj.xPos - Player.xPos);
			obj.doesHurt = (jjRandom() & 3) + 6;
			obj.state = STATE::FLY;
			obj.playerHandling = HANDLING::ENEMYBULLET;
			obj.animSpeed = 1;
		} else if (obj.state == STATE::EXPLODE || ++obj.counter >= (!IsMurderer ? 120 + jjDifficulty * 40 : 255)) {
			obj.delete();
		} else {
			int angle = obj.special;
			float xPos = obj.xPos, yPos = obj.yPos;
			const jjANIMFRAME@ myFrame = jjAnimFrames[obj.curFrame];
			for (int i = 0; i < obj.counter; ++i) {
				jjDrawSpriteFromCurFrame(xPos, yPos, obj.curFrame, obj.direction, SPRITE::NORMAL,0, 3);
				if (Player.blink == 0 && myFrame.doesCollide(int(xPos), int(yPos), obj.direction, jjAnimFrames[Player.curFrame], int(Player.xPos), int(Player.yPos), Player.direction)) {
					Player.objectHit(obj, 0, HANDLING::ENEMYBULLET);
					//break;
				}
				xPos += jjSin(angle) * 2;
				yPos += jjCos(angle) * 2;
				angle += ((((((i >> 5) + 1) >> 1) & 1) << 1) - 1) * obj.doesHurt * obj.direction;
			}
		}
		
	}
	
	void Recolor(jjANIMFRAME@ frame, const array<uint8> &in pattern, const array<uint8> &in replace) {
		jjPIXELMAP image(frame);
		for (int x = image.width - 1; x >= 0; --x)
			for (int y = image.height - 1; y >= 0; --y) {
				const uint8 color = image[x,y];
				if (pattern.find( color & ~7) >= 0)
					image[x,y] = replace[color & 7];
			}
		image.save(frame);
	}
	void Recolor(const jjANIMATION@ anim, const array<uint8> &in pattern, const array<uint8> &in replace) {
		for (uint frameID = 0; frameID < anim.frameCount; ++frameID)
			Recolor(jjAnimFrames[anim + frameID], pattern, replace);
	}
	array<uint8>@ RecolorReplace(uint8 hue) {
		return array<uint8> = {hue,hue+1,hue+2,hue+3,hue+4,hue+5,hue+6,hue+7};
	}
	
	class Fencer : Enemy {
		Fencer(jjOBJ@ preset) {
			super(preset);
			gender = Gender::Male;
			for (uint animID = 0; animID < 2; ++animID) {
				Recolor(jjAnimations[jjAnimSets[ANIM::FENCER] + animID], array<uint8>={24,48}, array<uint8>={38,39,79,79,79,79,79,79}); //red or pink to black
			}
		}		
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::START) {
				obj.doesHurt = getParameterAtOrigin(obj, 0, 2);
				switch (obj.doesHurt) {
					case 0: //floor
						obj.behave(BEHAVIOR::FENCER, false);
						break;
					case 1: {
						int newYPos = int(obj.yPos) - 22;
						while (newYPos > 0 && !jjMaskedPixel(int(obj.xPos), newYPos))
							newYPos -= 2;
						obj.yPos = newYPos + 22;
						obj.state = STATE::DELAYEDSTART;
						break;
					}
					case 2:
					case 3: {
						int newXPos = int(obj.xPos);
						obj.direction = ((int(obj.doesHurt) - 2) << 1) - 1;
						while (!jjMaskedPixel(newXPos, int(obj.yPos)))
							newXPos += (obj.direction << 1);
						obj.xPos = newXPos - (obj.direction << 4);
						obj.state = STATE::STILL;
					}
				}
			} else if (obj.doesHurt == 1) { //hiding at ceiling
				if (Player.yPos > obj.yPos && abs(Player.xPos - obj.xPos) < 64) {
					obj.state = STATE::JUMP;
					obj.doesHurt = 0;
					obj.curAnim -= 1;
					obj.counter = obj.frameID = 0;
					jjSample(obj.xPos, obj.yPos, SOUND::COMMON_UP, 52);
					obj.direction = Player.direction;
					obj.xSpeed = -1 * obj.direction;
					obj.ySpeed = 1;
				}
			} else {
				if (obj.state == STATE::JUMP && obj.doesHurt != 0) {
					obj.xSpeed = (obj.doesHurt == 2) ? 4 : -4;
					obj.doesHurt = 0;
				}
				obj.behave(BEHAVIOR::FENCER, false);
				if (IsMurderer)// || (jjGameTicks & 1) == 1)
					obj.behave(BEHAVIOR::FENCER, false);
			}
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.state == STATE::DELAYEDSTART) //hiding in the ceiling
				return;
			else if (obj.doesHurt != 0)
				drawMainSprite(obj, -1, obj.doesHurt == 2 ? 0x300 : 0x100);
			else
				Enemy::onDraw(obj);
		}
	}
	
	class FloatLizard : Enemy {
		Egg egg;
		FloatLizard(jjOBJ@ preset) {
			super(preset, AnimSets::Egg);
			egg.firstAnim = jjAnimSets[animSetID];
			preset.behavior = jjVOIDFUNCOBJ(behaviorAssigner);
			preset.energy = 1;
			gender = Male;
			Layer = 2;
			for (uint animID = 0; animID < 5; ++animID) {
				Recolor(jjAnimations[jjAnimSets[ANIM::LIZARD] + animID], array<uint8>={40,56}, array<uint8>={38,39,39,39,39,79,79,79}); //orange or yellow to black
			}
		}
		void behaviorAssigner(jjOBJ@ obj) {
			if (obj.creator != CREATOR::LEVEL || getParameterAtOrigin(obj, 1, 1) == 0) obj.behavior = this; else obj.behavior = egg;
		}
		
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::START) {
				obj.state = getParameterAtOrigin(obj, 0, 1) == 0 ? STATE::SLEEP : STATE::FALL;
			}
			
			const int xDiff = 96 * obj.direction;
			Player.yPos -= 96; //target ABOVE me
			Player.xPos += xDiff;
			obj.behave(BEHAVIOR::FLOATLIZARD, false);
			Player.yPos += 96;
			Player.xPos -= xDiff;
			
			if (obj.state == STATE::FLY) {
				obj.var[1] = 0; //counter to entering STATE::ATTACK
				if (obj.yPos < Player.yPos && obj.yPos > Player.yPos - 192 && abs(obj.xPos - Player.xPos) < 24 && !jjMaskedVLine(int(obj.xPos), int(obj.yPos) - 5, 30)) {
					obj.state = STATE::FALL;
					obj.counter = 0;
					obj.frameID = 0;
					obj.direction = (obj.xPos > Player.xPos) ? -6 : 6;
				}
			} else if ((obj.state == STATE::WALK || obj.state == STATE::WAIT) && ++obj.counter > 70*4) {
				obj.state = STATE::SLEEP; //return to the air
				obj.ySpeed = -8;
				obj.xSpeed *= 2;
			} else if (obj.state == STATE::SLEEP) { //just got off the ground
				obj.xPos += (obj.xSpeed *= 0.9) + jjSin(jjGameTicks << 3) / 2;
				obj.yPos += (obj.ySpeed *= 0.9) + jjCos(jjGameTicks << 3);
			}
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.state == STATE::FLY || obj.state == STATE::SLEEP || (obj.state == STATE::DONE && (obj.oldState == STATE::FLY || obj.oldState == STATE::SLEEP)))
				jjDrawSprite(obj.xPos, obj.yPos + 4, ANIM::LIZARD, 3, jjGameTicks/3, obj.direction, SPRITE::NORMAL,0, Layer);
			Enemy::onDraw(obj);
		}
	}
	class Egg : jjBEHAVIORINTERFACE {
		uint firstAnim;
		void onBehave(jjOBJ@ obj) {
			if (obj.state == STATE::START) {
				obj.curFrame = jjAnimations[firstAnim];
				obj.xPos += int(jjRandom() & 31) - 15;
				obj.putOnGround();
				obj.yPos += jjRandom() & 3;
				obj.isFreezable = false; //let's just not bother
				obj.isTarget = false;
				if (jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 0, 1) == 0) { //real egg
					obj.playerHandling = HANDLING::SPECIAL;
					obj.scriptedCollisions = true;
					obj.bulletHandling = HANDLING::DETECTBULLET;
					obj.counterEnd = 4;
					obj.energy = 30;
				} else { //false egg
					obj.playerHandling = HANDLING::PARTICLE;
					obj.counterEnd = (jjRandom() & 2) + 3;
				}
				obj.state = STATE::WAIT;
			} else if (obj.state == STATE::DEACTIVATE) {
				obj.deactivate();
			} else if (obj.counterEnd == 4) { //real egg, needing to hatch
				if (obj.counter > 0) {
					if (++obj.counter >= 210)
						hatch(obj);
					else
						obj.curFrame = jjAnimations[firstAnim] + obj.counter / 70;
				}
			}
		}
		void onDraw(jjOBJ@ obj) {
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, 1, obj.counterEnd != 4 ? SPRITE::TINTED : SPRITE::NORMAL, 79, obj.counterEnd);
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (bullet !is null) {
				obj.counter += force*70;
				bullet.state = STATE::EXPLODE;
			} else {
				if (obj.counter == 0) obj.counter = 1;
			}
			return true;
		}
		void hatch(jjOBJ@ obj) const {
			jjSample(obj.xPos, obj.yPos, SOUND::COMMON_CANSPS);
			jjParameterSet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 1, 1, 0); //only raptors now
			jjOBJ@ blacky = jjObjects[jjAddObject(obj.eventID, obj.xOrg, obj.yOrg, 0, CREATOR::LEVEL)];
			blacky.xPos = obj.xPos;
			blacky.yPos = obj.yPos - 24;
			for (uint i = 0; i < 6; ++i) {
				jjOBJ@ shard = jjObjects[jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos - 24, obj.creatorID, CREATOR::OBJECT, BEHAVIOR::INACTIVE)];
				shard.curAnim = firstAnim + 1 + i;
				shard.behavior = BEHAVIOR::SHARD;
			}
			obj.delete();
		}
	}
	
	class TubeTurle : Enemy {
		TubeTurle(jjOBJ@ preset) {
			super(preset, AnimSets::TubeTurle);
			preset.energy = 1;
		}
		void onBehave(jjOBJ@ obj) override {
			++obj.counter;
			if (obj.state == STATE::WAIT) {
				obj.curFrame = jjAnimations[obj.curAnim] + ((jjGameTicks >> 3) & 3);
				const float distanceFromPlayer = abs(Player.xPos - obj.xPos);
				if (distanceFromPlayer < 290)
					obj.direction = (obj.xPos > Player.xPos) ? -1 : 1;
				if ((distanceFromPlayer < 180 || IsMurderer) && obj.counter > 70) {
					obj.counter = 0;
					obj.state = STATE::ATTACK;
				}
			} else if (obj.state == STATE::ATTACK) {
				int frameID = obj.counter / 6;
				if (frameID > 12) {
					obj.state = STATE::WAIT;
					obj.counter = 0;
				} else if (frameID > 8)
					frameID = 12 - frameID;
				else if (frameID > 3) {
					frameID = 3;
					if (obj.counter % 6 == 5) {
						jjObjects[jjAddObject(OBJECT::BULLET, obj.xPos + 20*obj.direction, obj.yPos + 12, obj.objectID, CREATOR::OBJECT, TurleTube)].curAnim = jjAnimSets[animSetID];
						jjSample(obj.xPos, obj.yPos, SOUND::Sample(SOUND::TURTLE_SPK1TURT + (jjRandom() & 3)));
					}
				}
				obj.curFrame = jjAnimations[obj.curAnim + 1] + frameID;
			} else {
				obj.behave(BEHAVIOR::TUBETURTLE, false);
				return;
			}
			const jjANIMFRAME@ frame = jjAnimFrames[obj.curFrame];
			if (!jjMaskedPixel(int(obj.xPos), int(obj.yPos) + frame.hotSpotY - frame.coldSpotY))
				obj.yPos += 1;
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (bullet !is null && obj.state == STATE::FLOAT) {
				bullet.state = STATE::EXPLODE;
				obj.state = STATE::WAIT;
				obj.energy = 4;
				obj.curAnim = jjAnimSets[animSetID] + 1;
				obj.counter = 45;
				obj.yPos -= 20;
				jjSample(obj.xPos, obj.yPos, SOUND::TURTLE_TURN);
				return true;
			}
			return Enemy::onObjectHit(obj, bullet, player, force);
		}
	}
	void TurleTube(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.xSpeed = jjObjects[obj.creatorID].direction * 5;
			obj.ySpeed = int(jjRandom() & 7) * -0.5;
			obj.state = STATE::FLY;
			obj.playerHandling = HANDLING::ENEMYBULLET;
			obj.animSpeed = 1;
			obj.killAnim = jjAnimSets[ANIM::AMMO] + 7;
		} else if (obj.state == STATE::EXPLODE) {
			obj.curAnim = obj.killAnim;
			obj.frameID = 0;
			obj.behavior = BEHAVIOR::EXPLOSION;
			obj.playerHandling = HANDLING::EXPLOSION;
		} else {
			if (jjMaskedPixel(int(obj.xPos), int(obj.yPos)))
				obj.state = STATE::EXPLODE;
			else {
				obj.xPos += obj.xSpeed;
				obj.yPos += obj.ySpeed += 0.1;
				obj.frameID = jjGameTicks / 3;
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.determineCurFrame());
			}
		}
	}
	class Fish : Enemy {
		Fish(jjOBJ@ preset) {
			super(preset);
			preset.energy = 1;
			preset.isFreezable = false;
			preset.isTarget = false;
			for (uint animID = 0; animID < 2; ++animID) {
				Recolor(jjAnimations[jjAnimSets[ANIM::FISH] + animID], array<uint8>={32}, RecolorReplace(80));
				Recolor(jjAnimations[jjAnimSets[ANIM::FISH] + animID], array<uint8>={48}, RecolorReplace(64));
			}
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::START)
				obj.state = STATE::DELAYEDSTART;
			else if (obj.state == STATE::DEACTIVATE)
				obj.deactivate();
			else if (obj.state == STATE::FREEZE)
				obj.behave(BEHAVIOR::FISH, false); //as good as any other for unfreezing
			else {
				if (obj.state == STATE::DELAYEDSTART) {
					if (obj.yPos > jjWaterLevel) {
						obj.state = STATE::FLY;
						obj.isFreezable = true;
						obj.isTarget = true;
					}
				} else if (obj.state != STATE::DONE && obj.state != STATE::KILL) {
					if (int(obj.xSpeed) == 0 && int(obj.ySpeed) == 0) {
						const int divide = IsMurderer ? 1 : 2;
						const float targetX = obj.xOrg + ((jjRandom() & 255) - 127.5) / divide;
						const float targetY = obj.yOrg + ((jjRandom() & 255) - 127.5) / divide;
						obj.xSpeed = (targetX - obj.xPos) / 16 / divide;
						obj.ySpeed = (targetY - obj.yPos) / 16 / divide;
						obj.direction = obj.xSpeed >= 0 ? 1 : -1;
					} else {
						if (jjMaskedPixel(int(obj.xPos + obj.xSpeed), int(obj.yPos)))
							obj.xSpeed = -obj.xSpeed;
						else
							obj.xPos += obj.xSpeed;
						if (jjMaskedPixel(int(obj.xPos), int(obj.yPos + obj.ySpeed)))
							obj.ySpeed = -obj.ySpeed;
						else
							obj.yPos += obj.ySpeed;
						obj.xSpeed *= 0.94;
						obj.ySpeed *= 0.94;
					}
					if (obj.yPos < jjWaterLevel)
						obj.yPos = jjWaterLevel;
				}
				obj.frameID = jjGameTicks >> 3;
				obj.determineCurFrame();
			}
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.state == STATE::DELAYEDSTART) //yet to be activated by the water
				return;
			else
				Enemy::onDraw(obj);
		}
	}
	
	class RedBat : Enemy {
		RedBat(jjOBJ@ preset) {
			super(preset);
			preset.energy = 2;
			preset.curAnim -= 1;
			gender = Gender::Female;
			for (uint animID = 0; animID < 1; ++animID) { //lul
				Recolor(jjAnimations[jjAnimSets[ANIM::BAT] + animID], array<uint8>={88}, RecolorReplace(24));
			}
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::START)
				obj.state = STATE::FLY; //don't stick to the ceiling like regular bats
			else if (obj.state == STATE::DEACTIVATE || obj.state == STATE::FREEZE)
				obj.behave(BEHAVIOR::BAT, false); //as good as any other for unfreezing
			else if (obj.state == STATE::FLY) { //I feel bad about not making any call to jjOBJ::behave in here but there's not a lot of bat code to begin with
				obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::BAT_BATFLY1,obj.doesHurt,43,0);

				const float wantx = Player.xPos;
				const float wanty = Player.yPos - 96;
				
				//cut out some code here about making the bat return to its place of origin if the player is too far away

				const float xDiff = int(jjRandom() & 32767) / 10923.6667f;
				const float xTarget = obj.xPos + (wantx<obj.xPos ? -xDiff : xDiff);
				if (!jjMaskedPixel(int(xTarget), int(obj.yPos)))
					obj.xPos = xTarget;
				const float yTarget = obj.yPos + obj.ySpeed;
				if (yTarget <= jjWaterLevel && !jjMaskedPixel(int(obj.xPos), int(yTarget)))
					obj.yPos = yTarget;

				if (++obj.counter > 7) {
					if (wantx<obj.xPos-1)
						obj.direction=-1;
					else
					if (wantx>obj.xPos+1)
						obj.direction=1;

					if (wanty < obj.yPos)
						obj.ySpeed = int(jjRandom() & 32767) / -16384.f;
					else
						obj.ySpeed = int(jjRandom() & 32767) / 16384.f;
						
					if (++obj.counterEnd > 14) {
						obj.counterEnd = 0;
						jjOBJ@ bullet = jjObjects[jjAddObject(OBJECT::ELECTROBULLET, obj.xPos, obj.yPos, 0, CREATOR::OBJECT)];
						bullet.playerHandling = HANDLING::ENEMYBULLET;
						bullet.xSpeed = (wantx - obj.xPos) / (IsMurderer ? 32.f : 128.f);
						bullet.ySpeed = 3;
						jjSample(obj.xPos, obj.yPos, SOUND::Sample(SOUND::AMMO_LASER2 + (jjRandom()&1)));
					}

					obj.counter = 0;
					++obj.frameID;
					obj.determineCurFrame();
				}
			}
		}
	}
	
	bool LevelContainsMonkeys, LevelContainsLava;
	class Monkey : Enemy {
		Monkey(jjOBJ@ preset) {
			super(preset);
			gender = Gender::Male;
			if (!LevelContainsMonkeys) {
				LevelContainsMonkeys = true;
				for (uint animID = 0; animID < 7; ++animID) {
					const jjANIMATION@ anim = jjAnimations[jjAnimSets[ANIM::MONKEY] + animID];
					if (animID >= 2) {
						Recolor(anim, array<uint8>={40}, RecolorReplace(24)); //orange to red
						Recolor(anim, array<uint8>={64}, RecolorReplace(36)); //brown to orange
					} else {
						Resize::Resize(anim, 1.75, Resize::Method::Scale2x);
					}
				}
			}
		}
		void onBehave(jjOBJ@ obj) override {
			for (uint i = (IsMurderer && jjGameTicks&1==1) ? 2 : 1; i > 0; --i)
				obj.behave(BEHAVIOR::MONKEY, false); //both MONKEY and STANDMONKEY use the same behavior... not very efficient, arjan
		}
	}
	void DoObjectLoop() {
		if (LevelContainsMonkeys && (jjDifficulty > 0 || IsMurderer)) {
			for (uint i = jjObjectCount; --i > 0;) {
				jjOBJ@ obj = jjObjects[i];
				if (obj.behavior == BEHAVIOR::MONKEYBULLET) {
					if (obj.state == STATE::EXPLODE) {
						obj.behavior = BEHAVIOR::RFBULLET;
						obj.playerHandling = HANDLING::ENEMYBULLET;
						obj.eventID = OBJECT::RFBULLETPU;
						obj.curAnim = obj.killAnim;
						obj.frameID = 0;
						obj.blast(96*96, false);
					} else {
						obj.lightType = LIGHT::BRIGHT;
						obj.light = 6;
					}
				}
			}
		}
	}
	
	class Muttshroom : Enemy {
		uint firstMushroomFrame;
		Muttshroom(jjOBJ@ preset) {
			super(preset, AnimSets::Muttshroom);
			firstMushroomFrame = jjAnimations[jjAnimSets[animSetID]];
			for (uint animID = 0; animID < 2; ++animID) {
				const jjANIMATION@ anim = jjAnimations[jjAnimSets[ANIM::DOG] + animID];
				Recolor(anim, array<uint8>={64}, RecolorReplace(24)); //brown to red
				Recolor(anim, array<uint8>={40}, RecolorReplace(62)); //orange to brown
			}
			if (true) {
				for (uint i = 0; i < 5; ++i) { //copter
					jjANIMFRAME@ frame = jjAnimFrames[firstMushroomFrame + 5 + i];
					jjPIXELMAP image(frame);
					for (int x = image.width - 1; x >= 0; --x)
						for (int y = image.height - 1; y >= 0; --y)
							if (image[x,y] != 0)
								image[x,y] += 16;
					image.save(frame);
				}
			}
		}
		void onBehave(jjOBJ@ obj) override {
			switch (obj.state) {
				case STATE::ROTATE:
					obj.counter += 4;
					obj.xPos = obj.xOrg + jjSin(obj.counter) * 48;
					obj.yPos = obj.yOrg + jjCos(obj.counter) * 48;
					obj.direction = (obj.counter - 256) & 1023 < 512 ? 1 : -1;
					if (Player.blink == 0 && jjAnimFrames[Player.curFrame].doesCollide(int(Player.xPos), int(Player.yPos), Player.direction, jjAnimFrames[firstMushroomFrame+5], int(obj.xPos), int(obj.yPos), 1)) //player collides with copter
						Player.hurt(2);
					if (obj.counterEnd == 0)
						obj.counterEnd = jjRandom() & 63;
					else if ((++obj.counterEnd > 200 || IsMurderer) && jjGameTicks & 1 == 1)
						jjAddObject(obj.eventID, obj.xPos, obj.yPos+20, obj.creatorID); //spores
					break;
				case STATE::FLY: //copter part
					if ((obj.counterEnd -= 3) < 30)
						obj.delete();
					else {
						obj.xPos += obj.xSpeed *= 0.97;
						obj.yPos += obj.ySpeed *= 0.97;
					}
					break;
				case STATE::START:
					if (obj.creatorType == CREATOR::LEVEL) {
						if (getParameterAtOrigin(obj, 0, 1) == 1) {
							obj.state = STATE::ROTATE;
							obj.curFrame = firstMushroomFrame + 3;
							obj.energy = 3;
							break;
						}
						obj.energy = 2;
					} else {
						obj.state = STATE::FLY;
						obj.curFrame = firstMushroomFrame + 4;
						obj.counterEnd = 255;
						const auto angle = jjRandom();
						obj.xSpeed = jjSin(angle) * 4;
						obj.ySpeed = jjCos(angle) * 4;
						obj.isTarget = false;
						obj.isFreezable = false;
						break;
					}
				default:
					obj.behave(BEHAVIOR::DOGGYDOGG, false);
					if (obj.state == STATE::WALK && (jjRandom() & 127) == 0) {
						jjSample(obj.xPos, obj.yPos, SOUND::DOG_AGRESSIV);
						obj.var[0] = -1;
						obj.var[1] = 255;
						obj.counter=jjGameTicks&7;	//aligning anim
						obj.state = STATE::ACTION;
					}
			}
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.state == STATE::FLY) {
				const float scale = obj.counterEnd / 255.f;
				jjDrawResizedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, scale,scale, SPRITE::ALPHAMAP, 42);
			} else {
				if (obj.curFrame > firstMushroomFrame) {
					const auto realDirection = obj.direction;
					obj.direction = 1;
					drawMainSprite(obj, firstMushroomFrame + 5 + ((obj.counter >> 3) % 5));
					obj.direction = realDirection;
				}
				Enemy::onDraw(obj);
				if (obj.curFrame < firstMushroomFrame) {
					const uint frameID = (jjGameTicks >> 2) & 3;
					const uint mushroomFrame = firstMushroomFrame + (obj.state == STATE::DONE ? 0 : (frameID < 3 ? frameID : 1));
					drawBodySprite(obj, obj.xPos + obj.direction * 13, obj.yPos + (obj.curAnim == jjObjectPresets[obj.eventID].curAnim ? 2 : -5), mushroomFrame);
					drawBodySprite(obj, obj.xPos - obj.direction * 18, obj.yPos - 6, mushroomFrame, 128 * obj.direction, 0.5f);
				}
			}
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (obj.state != STATE::FLY || (bullet is null && obj.counterEnd > 50)) {
				if (jjColorDepth >= 16 && player.shieldTime <= 0) {
					if (Player.stoned <= 0)
						jjSample(Player.xPos, Player.yPos, SOUND::CATERPIL_RIDOE);
					if (Player.stoned < 15)
						Player.stoned = IsMurderer ? 140 : 55;
				}
			}
			if (obj.state != STATE::FLY) {
				const bool isFlier = obj.state == STATE::ROTATE;
				Enemy::onObjectHit(obj,bullet,player,force);
				if (!obj.isActive && isFlier) { //murdered
					jjObjects[jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos)].curAnim = jjAnimSets[animSetID] + 1; //lose copter as particle
				}
			} else if (bullet is null)
				obj.delete();
			return true;
		}
	}
	
	class Trogdor : Enemy {
		Trogdor(jjOBJ@ preset) {
			super(preset, AnimSets::Trogdor);
			preset.energy = 3;
			preset.curAnim = jjAnimSets[animSetID];
			preset.determineCurFrame();
			preset.xSpeed = 0.7;
			gender = Gender::Male;
		}
		void onBehave(jjOBJ@ obj) override {
			obj.behave(BEHAVIOR::WALKINGENEMY, false);
			if (obj.state != STATE::FREEZE && obj.state != STATE::DONE && (jjGameTicks & 3) == 3 && (IsMurderer || (obj.frameID % 7) == 3)) {
				jjSample(obj.xPos, obj.yPos, SOUND::AMMO_FIREGUN2A);
				jjOBJ@ bullet = jjObjects[obj.fireBullet(OBJECT::TOASTERBULLET)];
				bullet.xPos += 40 * obj.direction;
				bullet.yPos += 20;
				bullet.killAnim = bullet.determineCurAnim(ANIM::AMMO, 0, false);
				bullet.playerHandling = HANDLING::ENEMYBULLET;
				bullet.state = STATE::FLY;
				bullet.animSpeed = 1;
				bullet.xSpeed /= 4;
				bullet.xAcc /= 3;
				bullet.yAcc = (int(jjRandom() & 3) - 1) / 64.f; //replicates normal spreading behavior for player-fired toaster
			}
		}
	}
	
	const uint FrogDistanceFromGround = 18;
	class Frog : Enemy {
		Frog(jjOBJ@ preset) {
			super(preset);
			preset.energy = 2;
			preset.determineCurAnim(ANIM::FROG, 2);
			preset.determineCurFrame();
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			Enemy::onObjectHit(obj,bullet,player,force);
			if (obj.energy <= 0) {
				for (uint i = jjObjectCount; --i > 0;) {
					jjOBJ@ obj2 = jjObjects[i];
					if (obj2.eventID == OBJECT::DRAGONFLY && obj2.isActive && obj2.state != STATE::DONE && obj2.creatorID == uint(obj.objectID))
						obj2.state = STATE::ATTACK;
				}
			}
			return true;
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::START) {
				obj.state = STATE::IDLE;
				obj.yPos += jjMaskedTopVLine(int(obj.xPos), int(obj.yPos + FrogDistanceFromGround), 200);
				for (uint i = 0; i < 3; ++i)
					jjAddObject(OBJECT::DRAGONFLY, obj.xPos, obj.yPos, obj.objectID);
			} else if (obj.state == STATE::DEACTIVATE) {
				for (uint i = jjObjectCount; --i > 0;) {
					jjOBJ@ obj2 = jjObjects[i];
					if (obj2.eventID == OBJECT::DRAGONFLY && obj2.isActive && obj2.state != STATE::DONE && obj2.creatorID == uint(obj.objectID)) {
						obj2.delete();
					}
				}
				if (obj.var[0] == 0)
					obj.deactivate();
				else {
					obj.delete();
					removeFromEventMap(obj);
				}
			} else if (obj.state == STATE::FREEZE)
				obj.behave(BEHAVIOR::WALKINGENEMY, false);
			else if (obj.state != STATE::DONE) {
				const float delta = abs(obj.xPos - Player.xPos);
				if (delta > 16)
					obj.direction = (obj.xPos > Player.xPos) ? -1 : 1;
				if (obj.state != STATE::JUMP && obj.state != STATE::FALL && !jjMaskedHLine(int(obj.xPos) - 12, 24, int(obj.yPos) + FrogDistanceFromGround)) {
					obj.determineCurAnim(ANIM::FROG, 0);
					obj.state = STATE::FALL;
					obj.ySpeed = 0;
				} else if (obj.state == STATE::FIRE) {
					if (++obj.counter >= 14*5) {
						obj.determineCurAnim(ANIM::FROG, 2);
						obj.state = STATE::IDLE;
						obj.counter = 0;
					}
				} else if (obj.state == STATE::IDLE) {
					if (++obj.counter > 80) {
						if (delta > 32 && delta < 256 && abs(obj.yPos - Player.yPos) < 192) {
							if (Player.direction == obj.direction) { //looking away from me
								obj.determineCurAnim(ANIM::FROG, jjIsTSF ? 12 : 11);
								obj.state = STATE::WALK;
								obj.xSpeed = 1.5;
							} else { //looking at me
								obj.determineCurAnim(ANIM::FROG, 5);
								obj.state = STATE::JUMP;
								obj.ySpeed = -3.75;
								obj.xSpeed = -2.3;
								jjSample(obj.xPos, obj.yPos, SOUND::COMMON_JUMP);
							}
						} else if (obj.counter >= 100) {
							obj.counter = 0;
							obj.state = STATE::FIRE;
							obj.determineCurAnim(ANIM::FROG, (jjIsTSF ? 8 : 7) + (jjRandom() % 3));
							jjSample(obj.xPos, obj.yPos, SOUND::FROG_TONG);
						}
					}
				} else {
					if (!jjMaskedVLine(int(obj.xPos) + (obj.xSpeed >= 0 ? 19 : -19) * obj.direction, int(obj.yPos) - 10, 4 + FrogDistanceFromGround))
						obj.xPos += obj.xSpeed * obj.direction;
					else if (obj.state == STATE::WALK) {
						obj.determineCurAnim(ANIM::FROG, 2);
						obj.state = STATE::IDLE;
						obj.counter = 0;
					}
					if (obj.state != STATE::WALK && obj.state != STATE::IDLE) {
						if ((obj.ySpeed += 0.25) >= 0 && obj.state == STATE::JUMP) {
							obj.determineCurAnim(ANIM::FROG, 0);
							obj.state = STATE::FALL;
						} else if (jjMaskedHLine(int(obj.xPos) - 11, 22, int(obj.yPos += obj.ySpeed) + FrogDistanceFromGround)) {
							if (obj.xSpeed != 1.5) {
								if (obj.state == STATE::FALL) {
									obj.determineCurAnim(ANIM::FROG, 2);
									obj.counter = 30;
									obj.yPos -= FrogDistanceFromGround * 2;
									obj.yPos += jjMaskedTopVLine(int(obj.xPos), int(obj.yPos + FrogDistanceFromGround), 200);
									obj.state = STATE::IDLE;
								}
							} else {
								obj.determineCurAnim(ANIM::FROG, jjIsTSF ? 12 : 11);
								obj.state = STATE::WALK;
							}
						}
					} else if (delta <= 16) {
						obj.determineCurAnim(ANIM::FROG, 2);
						obj.state = STATE::IDLE;
						obj.counter = 0;
						obj.xSpeed = 0;
					}
				}
				obj.frameID = (obj.state != STATE::FIRE ? jjGameTicks : obj.counter) / 5 ;
				obj.determineCurFrame();
			}
		}
	}
	class FrogFly : Enemy {
		FrogFly(jjOBJ@ preset) {
			super(preset);
			preset.energy = 1;
			preset.deactivates = false;
			preset.determineCurAnim(ANIM::DRAGFLY, 0);
		}
		void onBehave(jjOBJ@ obj) override {
			switch (obj.state) {
				case STATE::START:
					if (obj.creatorType == CREATOR::OBJECT) {
						obj.state = STATE::CIRCLE;
						obj.counter = jjRandom();
					} else {
						jjDebug("something went wrong with a frogfly :(");
						obj.delete();
					}
					break;
				case STATE::DEACTIVATE:
				case STATE::FREEZE:
					obj.behave(BEHAVIOR::DRAGONFLY, false);
					return;
				case STATE::CIRCLE: {
					obj.counter += 5 + (jjRandom() & 7);
					const float targetX = jjObjects[obj.creatorID].xPos + jjSin(obj.counter) * 40, targetY = jjObjects[obj.creatorID].yPos - 45 + jjCos(obj.counter) * 15;
					if (obj.xPos > targetX + 3) {
						obj.xPos -= 1;
						obj.direction = -1;
					} else if (obj.xPos < targetX - 3) {
						obj.xPos += 1;
						obj.direction = 1;
					}
					if (obj.yPos > targetY + 3) {
						obj.yPos -= 1;
					} else if (obj.yPos < targetY - 3) {
						obj.yPos += 1;
					}
					break; }
				case STATE::ATTACK:
					obj.counter += 14;
					if ((obj.counterEnd += 2) == 20) {
						obj.special = GetAngle(Player.yPos - obj.yPos, obj.xPos - Player.xPos);
						obj.deactivates = true;
						obj.direction = jjSin(obj.special) >= 0 ? 1 : -1;
					} else if (obj.counterEnd > 70) {
						obj.xPos += jjSin(obj.special) * 6;
						obj.yPos += jjCos(obj.special) * 6;
					}
					break;
				default:
					return;
			}
			obj.frameID = obj.counter >> 4;
			obj.determineCurFrame();
			obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::DRAGFLY_BEELOOP,obj.doesHurt, obj.state == STATE::ATTACK ? 63 : 20);
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			Enemy::onObjectHit(obj,bullet,player,force);
			if (obj.energy <= 0) {
				jjObjects[obj.creatorID].var[0] = 1; //has lost a fly; should be deleted instead of deactivated, to avoid letting the player kill more enemies than exist.
			}
			return true;
		}
	}
	
	class MiniBilsy : Enemy {
		MiniBilsy(jjOBJ@ preset) {
			super(preset);
			preset.energy = 4;
			preset.isFreezable = false;
			preset.isTarget = false;
			gender = Gender::Male;
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (obj.state == STATE::DELAYEDSTART) {
				if (bullet is null) {
					obj.isFreezable = true;
					obj.isTarget = true;
					obj.state = STATE::FADEIN;
					obj.determineCurAnim(ANIM::BILSBOSS, 1);
					obj.determineCurFrame();
					obj.putOnGround(true);
					obj.direction = player.direction;
					obj.xPos -= obj.direction * 96;
					jjSample(obj.xPos, obj.yPos, SOUND::BILSBOSS_THUNDER);
				}
			} else
				Enemy::onObjectHit(obj,bullet,player,force);
			return true;
		}
		void onBehave(jjOBJ@ obj) override {
			switch (obj.state) {
			case STATE::START:
				obj.state = STATE::DELAYEDSTART;
				break;
			case STATE::FREEZE:
			case STATE::DEACTIVATE:
				obj.behave(BEHAVIOR::TUBETURTLE);
				break;
			case STATE::IDLE:
				obj.frameID = (jjGameTicks >> 2) & 7;
				obj.determineCurFrame();
				switch (jjRandom() & 127) {
					case 0:
						obj.state = STATE::ATTACK;
						obj.determineCurAnim(ANIM::BILSBOSS, 0);
						obj.counter = 0;
						break;
					case 1: //teleport
					case 2:
					case 3:
						obj.state = STATE::FADEOUT;
						obj.determineCurAnim(ANIM::BILSBOSS, 2);
						obj.counter = 0;
						if (IsMurderer) { //invincible while transportalizing
							obj.playerHandling = HANDLING::PARTICLE;
						} {
							obj.xAcc = Player.xPos;
							obj.yAcc = Player.yPos;
						}
						break;
				}
				break;
			case STATE::FADEOUT:
				if (++obj.counter < 68) {
					obj.frameID = obj.counter >> 2;
					obj.determineCurFrame();
				} else {
					obj.frameID = obj.counter = 0;
					obj.state = STATE::FADEIN;
					jjSample(obj.xPos, obj.yPos, SOUND::BILSBOSS_BILLAPPEAR);
					obj.determineCurAnim(ANIM::BILSBOSS, 1);
					obj.xPos = obj.xAcc;
					obj.yPos = obj.yAcc - 32;
					obj.direction = (Player.xPos < obj.xPos) ? -1 : 1;
					obj.determineCurFrame();
					obj.putOnGround(true);
					return;
				}
				break;
			case STATE::FADEIN:
				if (++obj.counter < 40) {
					obj.frameID = obj.counter >> 1;
					obj.determineCurFrame();
				} else {
					obj.frameID = obj.counter = 0;
					obj.determineCurAnim(ANIM::BILSBOSS, 4);
					obj.state = STATE::IDLE;
					obj.playerHandling = HANDLING::SPECIAL;
				}
				break;
			case STATE::ATTACK:
				if (++obj.counter < 36) {
					obj.frameID = obj.counter >> 1;
					obj.determineCurFrame();
					if (obj.counter == 32) {
						jjOBJ@ bullet = jjObjects[obj.fireBullet(OBJECT::FIREBALLBULLET)];
						bullet.direction = obj.direction;
						bullet.xAcc = abs(bullet.xAcc) * bullet.direction;
						bullet.xSpeed = abs(bullet.xSpeed) * bullet.direction / 3;
						bullet.state = STATE::FLY;
						bullet.playerHandling = HANDLING::ENEMYBULLET;
						bullet.animSpeed = IsMurderer ? 2 : 1;
						bullet.determineCurAnim(ANIM::BILSBOSS, 3);
					}
				} else {
					obj.frameID = obj.counter = 0;
					obj.determineCurAnim(ANIM::BILSBOSS, 4);
					obj.state = STATE::IDLE;
				}
				break;
			}
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.state != STATE::DELAYEDSTART)
				Enemy::onDraw(obj);
			//else //just for testing
			//	jjDrawSpriteFromCurFrame(obj.xPos,obj.yPos,obj.curFrame,obj.direction,SPRITE::TRANSLUCENT);
		}
	}
	
	abstract class SharedSucker : Enemy {
		SharedSucker(jjOBJ@ preset) { super(preset); }
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
			if (obj.age < 0) {
				if (bullet is null)
					player.hurt();
				else
					if (!bullet.ricochet()) bullet.state = STATE::EXPLODE;
				return true;
			}
			return Enemy::onObjectHit(obj,bullet,player,force);
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.state == STATE::DONE || obj.age >= 0 || jjGameTicks & 1 == 1)
				Enemy::onDraw(obj);
			else
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::SINGLEHUE, 80);
		}
		void makeSparks(jjOBJ@ obj, bool reducedY) {
			obj.lightType = LIGHT::BRIGHT;
			obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::COMMON_SHIELD_ELEC,obj.doesHurt);
			if (jjGameTicks & 3 == 0) {
				jjOBJ@ spark = jjObjects[jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos, obj.objectID)];
				spark.determineCurAnim(ANIM::PICKUPS, 85);
				spark.animSpeed = 1;
				spark.playerHandling = HANDLING::ENEMYBULLET;
				spark.xSpeed /= 7;
				if (reducedY)
					spark.ySpeed /= 2;
				else
					spark.ySpeed = -2.5;
				spark.lightType = LIGHT::POINT2;
			}
		}
	}
	class FloatSucker : SharedSucker {
		FloatSucker(jjOBJ@ preset) {
			super(preset);
			preset.energy = 1;
			preset.age = 40;
			preset.light = 13;
			Recolor(jjAnimations[jjAnimSets[ANIM::SUCKER] + 4], array<uint8>={24}, RecolorReplace(40)); //red to orange
			Recolor(jjAnimations[jjAnimSets[ANIM::SUCKER] + 4], array<uint8>={80}, RecolorReplace(24)); //green to red
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state != STATE::DONE) {
				obj.behave(BEHAVIOR::FLOATSUCKER, false);
				if (obj.freeze == 0) {
					if (--obj.age == -175) {
						obj.age = (IsMurderer ? 75 : 200) + (jjRandom() & 31);
						obj.lightType = LIGHT::NONE;
					} else if (obj.age < 0) {
						obj.behave(BEHAVIOR::FLOATSUCKER, false);
						makeSparks(obj, true);
					}
				}
			}
		}
	}
	
	class Sucker : SharedSucker {
		Sucker(jjOBJ@ preset) {
			super(preset);
			preset.energy = 2;
			preset.light = 13;
			const auto@ anim = jjAnimations[jjAnimSets[ANIM::SUCKER] + 6];
			Recolor(anim, array<uint8>={24}, RecolorReplace(40)); //red to orange
			Recolor(anim, array<uint8>={80}, RecolorReplace(24)); //green to red
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state != STATE::DONE) {
				obj.behave(BEHAVIOR::SUCKER, false);
				if (obj.freeze == 0) {
					obj.age = ((obj.direction == 1) == (obj.xPos < Player.xPos)) ? 1 : -1;
					if (obj.age < 0)
						makeSparks(obj, false);
					else
						obj.lightType = LIGHT::NONE;
				}
			}
		}
	}
	
	class Labrat : Enemy {
		Labrat(jjOBJ@ preset) {
			super(preset);
			Layer = 3;
			preset.energy = 1;
			for (uint i = 1; i < 3; ++i) {
				Recolor(jjAnimations[jjAnimSets[ANIM::LABRAT] + i], array<uint8>={48}, RecolorReplace(32));
				Recolor(jjAnimations[jjAnimSets[ANIM::LABRAT] + i], array<uint8>={72}, RecolorReplace(80));
			}
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::DONE)
				return;
			else if (obj.state == STATE::FREEZE || obj.state == STATE::DEACTIVATE)
				obj.behave(BEHAVIOR::LABRAT, false);
			else if (obj.state == STATE::START)
				obj.state = STATE::WALK;
			else {
				const auto xDelta = obj.xPos - Player.xPos;
				const auto yDelta = obj.yPos - Player.yPos - 8;
				const jjOBJ@ preset = jjObjectPresets[OBJECT::LABRAT];
				if (abs(xDelta) > 224 || abs(yDelta) > 160) {
					obj.curAnim = preset.curAnim - 1;
				} else {
					obj.curAnim = preset.curAnim;
					bool moved = false;
					if (abs(xDelta) > 64)
						obj.direction = (xDelta < 0) ? 1 : -1;
					if (yDelta > 0) {
						if (jjMaskedHLine(int(obj.xPos) - 30, 60, int(obj.yPos) + 7)) {
							obj.yPos -= 0.75;
							moved = true;
						}
					} else {
						if (jjMaskedHLine(int(obj.xPos) - 30, 60, int(obj.yPos) + 18)) {
							obj.yPos += 0.75;
							moved = true;
						}
					}
					if (obj.direction == -1) {
						if (jjMaskedVLine(int(obj.xPos) - 30, int(obj.yPos) + 7, 20)) {
							obj.xPos -= 1.25;
							moved = true;
						}
					} else {
						if (jjMaskedVLine(int(obj.xPos) + 30, int(obj.yPos) + 7, 20)) {
							obj.xPos += 1.25;
							moved = true;
						}
					}
					if (!moved)
						obj.curAnim -= 1;
				}
				
				obj.frameID = jjGameTicks >> 3;
				obj.determineCurFrame();
				
				uint rand = jjRandom();
				if ((rand & 127) == 0) {
					switch ((rand >>= 7) &= 3) {
						case 0:
						case 1:
						case 2:
							jjSample(obj.xPos, obj.yPos, SOUND::Sample(SOUND::LABRAT_MOUSE1 + rand));
							break;
					}
				}
			}
		}
	}
	
	class Phoenix : Enemy {
		Phoenix(jjOBJ@ preset) {
			super(preset);
			preset.energy = 3;
			gender = Gender::Male;
			for (uint i = 0; i < 3; ++i) {
				Recolor(jjAnimations[jjAnimSets[ANIM::RAVEN] + i], array<uint8>={24}, RecolorReplace(88));
				Recolor(jjAnimations[jjAnimSets[ANIM::RAVEN] + i], array<uint8>={72}, array<uint8>={0,0,0,0,46,44,42,41});
			}
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state != STATE::DONE) {
				const auto oldDirection = obj.direction;
				for (uint i = (obj.state == STATE::ATTACK) ? 3 : IsMurderer ? 2 : 1; i > 0; --i)
					obj.behave(BEHAVIOR::RAVEN, false);
				if (oldDirection != obj.direction) {
					jjSample(obj.xPos, obj.yPos, SOUND::AMMO_FIREGUN2A);
					obj.direction *= -1;
					for (int i = 0; i < 3; ++i) {
						jjOBJ@ bullet = jjObjects[jjAddObject(OBJECT::TOASTERBULLET, obj.xPos + i * 15 * oldDirection, obj.yPos + (i-1) * 10)];
						bullet.playerHandling = HANDLING::ENEMYBULLET;
						bullet.state = STATE::FLY;
						bullet.animSpeed = 1;
						bullet.xSpeed /= 3;
						bullet.xAcc /= 2;
						bullet.yAcc = (int(jjRandom() & 3) - 1) / 64.f; //replicates normal spreading behavior for player-fired toaster
					}
					obj.direction *= -1;
				}
				if (obj.state == STATE::STOP)
					obj.state = STATE::IDLE; //never return to origin place
			}
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.state != STATE::ATTACK)
				Enemy::onDraw(obj);
			else
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::SINGLEHUE, 40);
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
			if (obj.state == STATE::ATTACK) {
				if (bullet is null)
					player.hurt(IsMurderer ? 2 : 1);
				return true;
			}
			return Enemy::onObjectHit(obj,bullet,player,force);
		}
	}
	
	class Demon : Enemy {
		Demon(jjOBJ@ preset) {
			super(preset);
			for (uint i = 0; i < 4; ++i) {
				Recolor(jjAnimations[jjAnimSets[ANIM::DEMON] + i], array<uint8>={24}, RecolorReplace(48));
				Recolor(jjAnimations[jjAnimSets[ANIM::DEMON] + i], array<uint8>={64,80}, RecolorReplace(72));
			}
		}
		void onBehave(jjOBJ@ obj) override {
			obj.special = (obj.state == STATE::IDLE) ? obj.counter : 0;
			
			if (obj.state != STATE::DONE) {
				if (obj.state == STATE::START) {
					obj.isBlastable = getParameterAtOrigin(obj, -2, 1) == 1;
					obj.lightType = LIGHT::NONE;
				}
				if (obj.special > 140) obj.special = 140;
				else if (obj.state == STATE::WALK && abs(obj.direction) == 1)
					obj.direction *= 2;
				if (!obj.isBlastable) { //rightside up
					obj.behave(BEHAVIOR::DEMON, false);
				} else { //upside down
					obj.yPos -= 64;
					Player.yPos -= 64;
					obj.behave(BEHAVIOR::DEMON, false);
					obj.yPos += 64;
					Player.yPos += 64;
				}
				if (obj.special != 0 && obj.state == STATE::ATTACK) {
					FireLoop(obj, true);
				}
			}
		}
		void onDraw(jjOBJ@ obj) override {
			if (obj.isBlastable) obj.direction ^= SPRITE::FLIPV;
			Enemy::onDraw(obj);
			if (obj.isBlastable) obj.direction ^= SPRITE::FLIPV;
			FireLoop(obj, false);
		}
		void FireLoop(const jjOBJ@ obj, bool attack) const {
			const int fireFrame = jjAnimations[jjAnimSets[ANIM::AMMO] + 13] + ((jjGameTicks >> 2) % 7);
			for (int i = 0; i + 16 < obj.special; i += (IsMurderer ? 16 : 32)) {
				const int angle = (i + jjGameTicks) << 3;
				const int distance = (200 - obj.special) / 2;
				const float xPos = obj.xPos + jjSin(angle) * distance;
				const float yPos = obj.yPos + jjCos(angle) * distance;
				if (attack) {
					jjOBJ@ spark = jjObjects[jjAddObject(OBJECT::SHARD, xPos, yPos, obj.objectID)];
					spark.determineCurAnim(ANIM::AMMO, 13);
					spark.animSpeed = 1;
					spark.playerHandling = HANDLING::ENEMYBULLET;
					spark.xSpeed /= 2;
					spark.lightType = LIGHT::RING2;
					spark.light = 2;
				} else {
					jjDrawSpriteFromCurFrame(xPos, yPos, fireFrame);
					if (jjAnimFrames[Player.curFrame].doesCollide(int(Player.xPos), int(Player.yPos), Player.direction, jjAnimFrames[fireFrame], int(xPos), int(yPos), 1))
						Player.hurt(IsMurderer ? 2 : 1);
					for (uint j = jjObjectCount; --j != 0;) {
						jjOBJ@ bullet = jjObjects[j];
						if (bullet.playerHandling == HANDLING::PLAYERBULLET && bullet.freeze == 0 && bullet.isActive && jjAnimFrames[bullet.curFrame].doesCollide(int(bullet.xPos), int(bullet.yPos), bullet.direction, jjAnimFrames[fireFrame], int(xPos), int(yPos), 1)) {
							bullet.particlePixelExplosion(1);
							bullet.delete();
						}
					}
				}
			}
		}
	}
	
	class Duet : Enemy {
		Duet(jjOBJ@ preset) {
			super(preset, AnimSets::Duet);
			Layer = 3;
			preset.isFreezable = false; //splitness
			preset.special = jjAnimations[jjAnimSets[animSetID]];
			preset.lightType = LIGHT::BRIGHT;
			preset.light = 16;
			preset.direction = 1;
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::DONE)
				return;
			if (obj.state == STATE::START || obj.state == STATE::FREEZE || obj.state == STATE::DEACTIVATE) {
				if (obj.state == STATE::START)
					obj.xAcc = float(jjRandom() & 1023);
				obj.behave(BEHAVIOR::SPARK, false);
				return;
			} //else...
			obj.behave(BEHAVIOR::SPARK, false);
			if (!obj.isFreezable) { //not yet split
				obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::COMMON_SHIELD_ELEC,obj.doesHurt);
				obj.xAcc += (obj.xSpeed) * (IsMurderer ? 7 : 5) + obj.direction; //angle
				const int angle = int(obj.xAcc);
				for (int i = 0; i < 1024; i += 512) {
					const float xPos = obj.xPos + jjSin(angle+i) * 50, yPos = obj.yPos + jjCos(angle+i) * 50;
					const jjANIMFRAME@ frame = jjAnimFrames[obj.curFrame];
					if (jjAnimFrames[Player.curFrame].doesCollide(int(Player.xPos), int(Player.yPos), Player.direction, frame, int(xPos), int(yPos), 1)) {
						const auto force = Player.getObjectHitForce();
						if (force == 0)
							Player.hurt(1);
						else
							split(obj, xPos, yPos, null, force);
					}
					for (uint j = jjObjectCount; --j != 0;) {
						jjOBJ@ bullet = jjObjects[j];
						if (bullet.playerHandling == HANDLING::PLAYERBULLET && bullet.freeze == 0 && bullet.isActive && jjAnimFrames[bullet.curFrame].doesCollide(int(bullet.xPos), int(bullet.yPos), bullet.direction, frame, int(xPos), int(yPos), 1)) {
							split(obj, xPos, yPos, bullet, 0);
						}
					}
					if (obj.isFreezable) { //got split
						i ^= 512;
						obj.xPos += jjSin(angle+i) * 50;
						obj.yPos += jjCos(angle+i) * 50;
						obj.lightType = LIGHT::NONE;
						break;
					}
				}
			}
		}
		void split(jjOBJ@ obj, float xPos, float yPos, jjOBJ@ bullet, int force) {
			obj.isFreezable = true;
			jjSample(obj.xPos, obj.yPos, SOUND::COMMON_SHLDOF3);
			jjOBJ@ spark2 = jjObjects[jjAddObject(obj.eventID, xPos, yPos, obj.objectID, CREATOR::OBJECT, BEHAVIOR::INACTIVE)];
			removeFromEventMap(obj); //in case it deactivates, so it can't spawn a second spark more than once
			spark2.isFreezable = true;
			spark2.direction = obj.direction;
			spark2.curFrame = obj.curFrame; //why not
			spark2.behavior = this;
			if (bullet !is null)
				bullet.objectHit(spark2, spark2.playerHandling);
			else
				Player.objectHit(spark2, force, spark2.playerHandling);
		}
		void onDraw(jjOBJ@ obj) override {
			if (!obj.isFreezable) {
				int angle = int(obj.xAcc);
				jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.special, angle + 256, int(jjRandom() & 1) * 2 - 1, int(jjRandom() & 1) * 2 - 1, SPRITE::TRANSLUCENT,0, Layer);
				for (int i = 0; i < 1024; i += 512) {
					drawBodySprite(obj, obj.xPos + jjSin(angle+i) * 50, obj.yPos + jjCos(angle+i) * 50, obj.curFrame);
				}
			} else
				Enemy::onDraw(obj);
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
			if (bullet !is null && !obj.isFreezable) {
				bullet.particlePixelExplosion(1);
				bullet.delete();
				return true;
			}
			return Enemy::onObjectHit(obj, bullet, player, force);
		}
	}
	
	class Hatter : Enemy {
		Hatter(jjOBJ@ preset) {
			super(preset);
			for (uint i = 0; i < 3; ++i) {
				Recolor(jjAnimations[jjAnimSets[ANIM::HATTER] + 2 + i], array<uint8>={80}, RecolorReplace(120));
				Recolor(jjAnimations[jjAnimSets[ANIM::HATTER] + 2 + i], array<uint8>={32}, RecolorReplace(48));
			}
		}
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::TURN) {
				if (--obj.counterEnd == 0)
					obj.state = STATE::WALK;
				if (obj.counterEnd & 7 == 0) {
					jjSample(obj.xPos, obj.yPos, SOUND::HATTER_PTOEI, 128);
					jjOBJ@ bullet = jjObjects[jjAddObject(OBJECT::BULLET, obj.xPos, obj.yPos, obj.creatorID, CREATOR::OBJECT, BEHAVIOR::BULLET)];
					bullet.curAnim = obj.curAnim - 1;
					bullet.killAnim=jjAnimSets[ANIM::AMMO] + 80;
					bullet.xSpeed = (obj.counterEnd & 8 == 0) ? 4 : -4;
					bullet.yAcc = 0.125;
					bullet.ySpeed = ((jjRandom() & 63) - 31.5) / 8;
					bullet.animSpeed = 1;
					bullet.playerHandling = HANDLING::ENEMYBULLET;
					bullet.lightType = LIGHT::POINT2;
					bullet.counterEnd = 80;
				}
				obj.curFrame = jjAnimations[obj.curAnim] + (obj.counterEnd % 12);
			} else {
				const int direction = obj.direction;
				obj.behave(BEHAVIOR::HATTER, false);
				if (obj.direction != direction) {
					obj.state = STATE::TURN;
					obj.curAnim = jjAnimSets[ANIM::HATTER] + 4;
					obj.counterEnd = 70;
					obj.frameID = obj.counter = 0;
				}
			}
		}
	}
	
	void Furryball(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			if (obj.creatorType == CREATOR::OBJECT)
				obj.direction = jjObjects[obj.creatorID].direction;
			else
				obj.direction = (jjTileGet(4, (uint(obj.xPos) >> 5) + 1, uint(obj.yPos) >> 5)) == 0 ? 1 : -1;
			obj.xSpeed = obj.direction * 3.5;
			obj.state = STATE::FLY;
			jjSample(obj.xPos, obj.yPos, SOUND::AMMO_FIREGUN1A);
		} else if (obj.state == STATE::EXPLODE) {
			for (uint i = jjObjectCount; --i > 0;) {
				jjOBJ@ obj2 = jjObjects[i];
				if (obj2.behavior == BEHAVIOR::DESTRUCTSCENERY && obj2.state != STATE::DONE && obj.doesCollide(obj2)) {
					obj2.state = STATE::KILL;
					obj2.behave(BEHAVIOR::DEFAULT, false);
					break;
				}
			}
			obj.curAnim = obj.killAnim;
			obj.frameID = 0;
			obj.behavior = BEHAVIOR::EXPLOSION;
			obj.playerHandling = HANDLING::EXPLOSION;
			/*for (uint i = 0; i < 3; ++i) {
				jjOBJ@ shard = jjObjects[jjAddObject(OBJECT::BOUNCEONCE, obj.xPos, obj.yPos, obj.objectID)];
				shard.curAnim = jjObjectPresets[OBJECT::SILVERCOIN].killAnim;
				shard.lightType = LIGHT::POINT2;
			}*/
		} else {
			if (++obj.counterEnd == 60 || jjMaskedPixel(int(obj.xPos), int(obj.yPos)))
				obj.state = STATE::EXPLODE;
			else {
				obj.xPos += obj.xSpeed;
				obj.yPos += obj.ySpeed;
				if (obj.ySpeed == 0)
					jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::NORMAL,0, 3);
				else
					jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, BL18::GetAngle(obj.xSpeed,obj.ySpeed), 1,1, SPRITE::NORMAL,0, 3);
			}
		}
	}
	
	void BloodSpatter(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.curFrame = jjAnimations[jjAnimSets[ANIM::CUSTOM[AnimSets::Misc]]] + (jjRandom() % 9);
			obj.special = jjRandom();
			if (obj.creatorID >= 3) {
				obj.state = STATE::FLY;
				obj.xSpeed = jjSin(obj.special) * 8;
				obj.ySpeed = jjCos(obj.special) * 9;
				return;
			} else
				obj.state = STATE::SLEEP;
		} else if (obj.state == STATE::DEACTIVATE) {
			obj.delete();
		} else if (obj.state == STATE::FLY) {
			if (jjMaskedPixel(int(obj.xPos), int(obj.yPos)))
				obj.state = STATE::SLEEP;
			else {
				obj.xPos += obj.xSpeed;
				obj.yPos += (obj.ySpeed += 0.25);
				jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.special, 0.5, 0.5);
				return;
			}
		}
		if (obj.age < 7 * 50 - 1)
			++obj.age;
		jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.special, 1,1, SPRITE::TRANSLUCENTPALSHIFT, obj.age / 50);
	}
	void BoneWrapper(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE) {
			obj.delete();
		} else {
			if (obj.state == STATE::START) {
				obj.determineCurAnim(ANIM::SKELETON, obj.creatorID != 0 ? 0 : 1);
				obj.var[5] = SOUND::SKELETON_BONE1 + (jjRandom() % 6);
			}
			obj.behave(BEHAVIOR::BONE);
			if (!obj.isActive)
				jjObjects[jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos, 0, CREATOR::OBJECT, SitUntilDeactivation)].curFrame = obj.curFrame;
		}
	}
	void SitUntilDeactivation(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE)
			obj.delete();
		else
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction);
	}
	
	void HUD(jjCANVAS@ canvas) {
		if (IsMurderer) {
			int staticIntensity = jjGameTicks % 740;
			if (staticIntensity < 17) {
				staticIntensity = 8 - int(abs(staticIntensity - 8));
				for (int i = StaticColors.length - 1; i >= 0; --i)
					canvas.drawRectangle(0,0, jjResolutionWidth, jjResolutionHeight, StaticColors[i], SPRITE::BLEND_DISSOLVE, staticIntensity << 4);
			}
		}
		
		const int scoreDiff = Player.score - Player.scoreDisplayed;
		if (scoreDiff > 50)
			Player.scoreDisplayed += 50;
		else if (scoreDiff > 10)
			Player.scoreDisplayed += 10;
		else if (scoreDiff > 2)
			Player.scoreDisplayed += 2;
		else
			Player.scoreDisplayed = Player.score;
		canvas.drawString(4,12, formatInt(Player.scoreDisplayed - (Player.scoreDisplayed % 50), "0", 7), STRING::MEDIUM);
		
		const int livesIconAngle = int(jjSin(jjRenderFrame << 4) * 16);
		if (!IsMurderer)
			canvas.drawRotatedSpriteFromCurFrame(25, jjResolutionHeight - 25, heartFrame, livesIconAngle, 5, 5);
		else
			TrueColor::DrawCanvasRotatedSpriteFromCurFrame(canvas, 25, jjResolutionHeight - 25, skullFrame, livesIconAngle, 2,2);
		const string enemiesCount = formatInt(!IsMurderer ? (Player.lives - 3) : (Player.food % 10000));
		canvas.drawString(0x8000 - jjResolutionWidth/2 + 25, jjResolutionHeight - (enemiesCount.length < 3 ? 37 : 23), enemiesCount, enemiesCount.length < 3 ? STRING::LARGE : STRING::MEDIUM);
		
		/*
		canvas.drawString(10, 320, GemCounts[0] + "/" + GemTargets[0], STRING::MEDIUM, STRING::NORMAL,0, SPRITE::SINGLEHUE, 48);
		canvas.drawString(10, 340, GemCounts[3] + "/" + GemTargets[3], STRING::MEDIUM, STRING::NORMAL,0, SPRITE::SINGLEHUE, 88);
		canvas.drawString(10, 360, GemCounts[1] + "/" + GemTargets[1], STRING::MEDIUM, STRING::NORMAL,0, SPRITE::SINGLEHUE, 80);
		canvas.drawString(10, 380, GemCounts[2] + "/" + GemTargets[2], STRING::MEDIUM, STRING::NORMAL,0, SPRITE::SINGLEHUE, 32);
		*/
		
		const auto totalGemTarget = GemTargets[0] + GemTargets[1] + GemTargets[2] + GemTargets[3];
		if (totalGemTarget > 0) {
			canvas.drawSpriteFromCurFrame(14, 42, KeyFrame-3, 1, SPRITE::GEM, 9);
			const auto totalGemCount = GemCounts[0] + GemCounts[1] + GemCounts[2] + GemCounts[3];
			const bool dark = totalGemCount < totalGemTarget;
			if (dark || (jjGameTicks & 15 < 9))
				canvas.drawString(10, 42, (totalGemCount * 100 / totalGemTarget) + "%", STRING::SMALL,STRING::NORMAL,0, dark ? SPRITE::BRIGHTNESS : SPRITE::PALSHIFT, dark ? 96 : 208);
		}
		
		if (!CoinWarpFound) {
			uint coinsTotal = 0;
			uint coinsFound = 0;
			uint collectiblesFound = 0;
			int keyX = 56;
			const int keyY = jjSubscreenHeight - 19;
			for (uint i = 0; i < CollectibleLocations.length; ++i) {
				const auto@ location = CollectibleLocations[i];
				const bool found = location.Found;
				
				if (found)
					collectiblesFound += 1;
				if (location.Type == CollectibleTypes::Coin) {
					if (found)
						coinsFound += 1;
					coinsTotal += 1;
				} else {
					canvas.drawSpriteFromCurFrame(keyX += 20, keyY, KeyFrame, 1, found ? SPRITE::SINGLEHUE : SPRITE::SHADOW, KeyColors[location.Type - 1]);
				}
			}
			if (coinsTotal > 0) {
				const bool dark = coinsFound < coinsTotal;
				canvas.drawSpriteFromCurFrame(64, 42, CoinFirstFrame);
				canvas.drawString(60, 42, "ß1" + coinsFound + "/" + coinsTotal, STRING::SMALL,STRING::NORMAL,0, dark ? SPRITE::BRIGHTNESS : SPRITE::PALSHIFT, dark ? 96 : 208);
			}
			if (collectiblesFound == CollectibleLocations.length)
				canvas.drawString(0x8000, keyY - 30, !IsMurderer ? "FIND   EXIT" : "SEEK   FORGIVENESS", STRING::MEDIUM, STRING::SPIN);
		}
	}
	
	class SortableDistance {
		float distance;
		uint index;
		SortableDistance(){}
		SortableDistance(float d, uint i) { distance = d; index = i; }
		int opCmp(const SortableDistance &in other) const {
			return int(distance - other.distance);
		}
	}
	int ArrowTimer = 0;
	const uint ArrowSprite = jjAnimations[jjAnimSets[ANIM::FLAG]];
	void ShowArrow() {
		if (CoinWarpFound)
			return;
		if (ArrowTimer > jjGameTicks + 70*4)
			ArrowTimer = jjGameTicks;
		else if (ArrowTimer < jjGameTicks) {
			if (ArrowTimer + 64 >= jjGameTicks) {
				const Point playerLocation(Player.xPos, Player.yPos);
				array<SortableDistance> distances;
				for (uint i = 0; i < CollectibleLocations.length; ++i) {
					if (CollectibleLocations[i].Found)
						continue;
					const float deltaX = abs(playerLocation.x - CollectibleLocations[i].Location.x);
					const float deltaY = abs(playerLocation.y - CollectibleLocations[i].Location.y);
					distances.insertLast(SortableDistance(deltaX * deltaX + deltaY * deltaY, i));
				}
				const Point@ target = null;
				if (distances.length == 0) {
					@target = CoinWarpLocation;
				} else {
					distances.sortAsc();
					if (distances[0].distance > 300*300)
						@target = CollectibleLocations[distances[0].index].Location;
				}
				if (target !is null) {
					const int angle = GetAngle(target.x - playerLocation.x, playerLocation.y - target.y);
					const float scale = (112 - (jjSin((jjGameTicks - ArrowTimer) << 3) * -64)) / 128.f;
					jjDrawRotatedSpriteFromCurFrame(
						Player.xPos + jjCos(angle) * 32, Player.yPos + jjSin(angle) * 32,
						ArrowSprite, 970 - angle, scale, scale, SPRITE::SINGLEHUE, 72, -9
					);
				}
			} else {
				ArrowTimer = jjGameTicks + 70*3;
			}
		}
	}
	
	void CoinWarp(jjOBJ@ obj) {
		const auto realYPos = Player.yPos;
		Player.yPos = 20;
		obj.behave(BEHAVIOR::WARP);
		Player.yPos = realYPos;
		if (Player.currTile != obj.age) {
			obj.age = Player.currTile;
			const int desiredCurrTile = (int(obj.xPos)>>5) + ((int(obj.yPos)>>5)<<16);
			if (obj.age == desiredCurrTile || obj.age == desiredCurrTile+1 || obj.age == desiredCurrTile - 0x10000 || obj.age == desiredCurrTile - 0xFFFF) { //player in front of warp
				Player.coins = 0;
				for (uint i = 0; i < BL18::CollectibleLocations.length; ++i)
					if (CollectibleLocations[i].Found && CollectibleLocations[i].Type == CollectibleTypes::Coin)
						Player.coins += 1;
				if (CoinWarpFound || Player.testForCoins(obj.var[0])) {
					CoinWarpFound = true;
					if (myCoinWarpFunction is null)
						Player.warpToID(jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 0, 8)); //default
					else
						myCoinWarpFunction();
				} else if (!obj.isBlastable)
					Player.showText(0, 0);
				obj.isBlastable = true;
			} else
				obj.isBlastable = false;
		}
	}
	
	const bool PreserveGemsAfterDeath = jjDifficulty <= 1 || jjLevelFileName.substr(jjLevelFileName.length-5, 1)[0] >= "6"[0];
	class HocusGem : jjBEHAVIORINTERFACE {
		uint Index, CurFrame, Color;
		HocusGem(jjOBJ@ preset, uint frameID, uint index, uint color, uint points) {
			preset.behavior = this; //2, 3, 5, 1000
			Index = index;
			CurFrame = frameID + KeyFrame - 3;
			Color = color-1;
			preset.points = points;
			preset.scriptedCollisions = true;
		}
		void onBehave(jjOBJ@ obj) { 
			obj.behave(BEHAVIOR::PICKUP, false);
			jjDrawSpriteFromCurFrame(obj.xPos, (obj.ySpeed != 0.f) ? obj.yPos : (obj.yPos + jjSin((obj.objectID*8+jjGameTicks+int(obj.xPos+obj.yPos*256))*16) * 4), obj.curFrame = CurFrame, 1, SPRITE::GEM, Color);
			uint rand = jjRandom();
			if (rand & 7 == 0) {
				const int xOffset = int((rand >>= 3) & 15) - 9;
				const int yOffset = int((rand >>= 4) & 15) - 11;
				jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos + xOffset, obj.yPos + yOffset)].determineCurAnim(ANIM::CUSTOM[AnimSets::Misc], 2 | ((rand >> 4) & 1));
			}
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			GemCounts[Index] += 1;
			if (PreserveGemsAfterDeath) {
				const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
				const uint8 eventMapID = jjEventGet(xTile,yTile);
				if (eventMapID == obj.eventID)
					jjEventSet(xTile,yTile, 0);
				else if (eventMapID == OBJECT::BANANA) //HocusWall
					jjParameterSet(xTile,yTile, 5,8, 0);
				else if (eventMapID == OBJECT::CHERRY) //HocusDestructScenery
					jjParameterSet(xTile,yTile, 0,8, 0);
				else
					jjDebug("Gem from unknown source detected at " + xTile + "," + yTile);
			}
			obj.eventID = OBJECT::FASTFEET;
			obj.scriptedCollisions = false;
			player.objectHit(obj, 0, HANDLING::PICKUP);
			return true;
		}
	}
	
	class Lock : jjBEHAVIORINTERFACE {
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			for (uint i = 0; i < CollectibleLocations.length; ++i)
				if (CollectibleLocations[i].Found && CollectibleLocations[i].Type == obj.var[0] + 1) {
					jjTriggers[obj.special] = true;
					jjSamplePriority(HPTrigger);
					if (obj.doesHurt > 0)
						obj.particlePixelExplosion(obj.doesHurt);
					obj.delete();
					break;
				}
			return true;
		}
		void onBehave(jjOBJ@ obj) {
			if (obj.state == STATE::START) {
				obj.doesHurt = KeyColors[(obj.var[0] = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 5, 4))];
				obj.special = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 0, 5);
				obj.state = STATE::WAIT;
			} else if (obj.state == STATE::DEACTIVATE)
				obj.deactivate();
			else if (jjTriggers[obj.special])
				obj.delete();
			else
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, 1, SPRITE::SINGLEHUE, obj.doesHurt, 5);
		}
	}
	void HocusWall(jjOBJ@ obj) {
		const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
		if (obj.state == STATE::START) {
			const auto@ tile = jjTiles[obj.var[0] = jjTileGet(4, xTile,yTile)];
			const auto@ Frames = tile.getFrames();
			if (Frames.length == 0) //?
				Frames.insertLast(0);
			obj.var[1] = Frames[0];
			obj.var[2] = Frames[Frames.length-1];
			obj.special = jjParameterGet(xTile,yTile, 0, 5);
			obj.var[3] = jjParameterGet(xTile,yTile, 5, 8);
			obj.isBlastable = jjTriggers[obj.special];
			obj.lightType = LIGHT::NONE;
			jjTileSet(4, xTile,yTile, obj.var[obj.isBlastable ? 2 : 1]);
			if (obj.isBlastable) {
				const uint8 eventID = obj.var[3];
				if (eventID > 32 && jjObjectPresets[eventID].behavior != BEHAVIOR::INACTIVE) {
					jjObjects[jjAddObject(eventID, obj.xOrg, obj.yOrg, obj.objectID)].deactivates = false;
					obj.var[3] = 0; //only do this once
					obj.deactivates = false;
				}
			}
			obj.state = STATE::WAIT;
		} else if (obj.state == STATE::DEACTIVATE) {
			if (obj.var[0] != 0) //has been STARTed
				jjTileSet(4, xTile,yTile, obj.var[0]);
			jjParameterSet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, -1, 1, 0);
			obj.delete();
		} else if (jjTriggers[obj.special] != obj.isBlastable) {
			const bool currentlyBlank = obj.var[jjTriggers[obj.special] ? 1 : 2] == 0;
			if (!currentlyBlank || !(abs(Player.xPos - obj.xPos) < 48 && abs(Player.yPos - obj.yPos) < 48)) { //not going to trap the player in a wall
				const uint rand = jjRandom();
				if ((rand & 31) == 0 || ++obj.age >= (!currentlyBlank ? 55 : 8)) { //trigger faster if becoming solid
					obj.age = 0;//in case it gets disabled again later
					obj.isBlastable = jjTriggers[obj.special];
					jjTileSet(4, xTile,yTile, obj.var[obj.isBlastable ? 2 : 1]);
					const uint8 eventID = obj.var[3];
					if (eventID > 32 && jjObjectPresets[eventID].behavior != BEHAVIOR::INACTIVE) {
						jjObjects[jjAddObject(eventID, obj.xOrg, obj.yOrg, obj.objectID)].deactivates = false;
						obj.var[3] = 0; //only do this once
						obj.deactivates = false;
					}
					jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xOrg, obj.yOrg)].determineCurAnim(ANIM::CUSTOM[AnimSets::Misc], 4 | ((rand >> 5) & 1));
				}
			}
		}
	}
	
	class HocusDestructScenery : jjBEHAVIORINTERFACE {
		void onBehave(jjOBJ@ obj) {
			const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
			if (obj.state == STATE::START) {
				const auto@ tile = jjTiles[obj.var[0] = jjTileGet(4, xTile,yTile)];
				const auto@ Frames = tile.getFrames();
				if (Frames.length == 1) //non-animated tile
					Frames.insertLast(0);
				obj.var[1] = Frames[Frames.length-1];
				obj.special = jjParameterGet(xTile,yTile, 0, 5);
				jjTileSet(4, xTile,yTile, Frames[0]);
				obj.state = STATE::WAIT;
				obj.yPos += 1;
			} else if (obj.state == STATE::DEACTIVATE) {
				if (obj.var[0] != 0) //has been STARTed
					jjTileSet(4, xTile,yTile, obj.var[0]);
				jjParameterSet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, -1, 1, 0);
				obj.delete();
			}
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (bullet !is null) {
				bullet.state = STATE::EXPLODE; //even fireballs, in accordance with hocusy tradition
				obj.deactivates = false;
				obj.playerHandling = HANDLING::PARTICLE;
				const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
				jjTileSet(4, xTile,yTile, obj.var[1]);
				jjSample(obj.xPos, obj.yPos, SOUND::COMMON_DAMPED1, 128);
				const uint8 eventID = jjParameterGet(xTile,yTile, 0, 8);
				if (eventID > 32 && jjObjectPresets[eventID].behavior != BEHAVIOR::INACTIVE)
					jjObjects[jjAddObject(eventID, obj.xOrg, obj.yOrg, obj.objectID)].deactivates = false;
				jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xOrg, obj.yOrg)].determineCurAnim(ANIM::CUSTOM[AnimSets::Misc], 4 | (jjRandom() & 1));
			}
			return true;
		}
	}
	
	class WarpPotion : jjBEHAVIORINTERFACE {
		void onBehave(jjOBJ@ obj) { 
			jjDrawSpriteFromCurFrame(obj.xPos, (obj.yPos + jjSin((obj.objectID*8+jjGameTicks+int(obj.xPos+obj.yPos*256))*16) * 4), obj.curFrame = jjAnimations[obj.curAnim] + ((jjGameTicks>>1) & 7));
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (player.noclipMode) //already being warped by a different potion
				return true;
			player.xPos = obj.xPos;
			player.yPos = obj.yPos;
			player.noclipMode = true;
			player.fur = 0x28282828;
			const int angle = (2 - jjParameterGet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0, 3)) << 7;
			player.xSpeed = jjSin(angle) * 4;
			player.ySpeed = jjCos(angle) * 4;
			jjSample(obj.xPos, obj.yPos, HPWarp);
			jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos)].curAnim = obj.killAnim;
			obj.delete();
			SetPogoStick(false);
			return true;
		}
	}
	
	class Balloon : jjBEHAVIORINTERFACE {
		void onBehave(jjOBJ@ obj) {
			if (obj.state == STATE::DEACTIVATE)
				obj.deactivate();
		}
		void onDraw(jjOBJ@ obj) {
			const auto time = jjGameTicks << 3;
			jjDrawResizedSpriteFromCurFrame(obj.xPos, (obj.yPos + jjSin((obj.objectID*8+jjGameTicks+int(obj.xPos+obj.yPos*256))*16) * 4), obj.curFrame, obj.direction * (jjSin(time) / 10.f + 1), jjCos(time) / 10.f + 1, SPRITE::TRANSLUCENT);
			jjDrawString(obj.xPos + 10, obj.yPos, (obj.creatorID == 0) ? "|x1" : "|x^");
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			player.antiGrav = !player.antiGrav;
			player.ySpeed = -player.ySpeed;
			player.yAcc = -player.yAcc;
			player.morphTo(player.charCurr, true); //for the effect
			jjSample(obj.xPos, obj.yPos, HPYeahoo);
			jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos)].curAnim = obj.killAnim;
			obj.delete();
			return true;
		}
	}
	
	int FlyCarrotTime = 0;
	class TemporaryFlyCarrot : jjBEHAVIORINTERFACE {
		void onBehave(jjOBJ@ obj) {
			obj.behave(BEHAVIOR::PICKUP);
		}
		void onDraw(jjOBJ@ obj) {
			jjDrawString(obj.xPos + 10, obj.yPos, (obj.creatorID == 0) ? "|x1" : "|x^");
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			player.fly = FLIGHT::FLYCARROT;
			jjSample(obj.xPos, obj.yPos, HPYeahoo);
			jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos)].curAnim = obj.killAnim;
			FlyCarrotTime = 256;
			obj.delete();
			return true;
		}
	}
	
	bool IsPlayerOnGround() {
		const auto playerAnim = Player.curAnim - jjAnimSets[Player.setID];
		return playerAnim == RABBIT::STAND || (playerAnim >= RABBIT::IDLE1 && playerAnim <= RABBIT::IDLE5) || playerAnim == RABBIT::LOOKUP || playerAnim == RABBIT::LEDGEWIGGLE || playerAnim == RABBIT::FIREUP || playerAnim == RABBIT::FALLLAND || (playerAnim >= RABBIT::FIRE && playerAnim <= RABBIT::FIREUPQUIT) || (playerAnim >= RABBIT::LOOKUP && playerAnim <= RABBIT::QUIT) || (playerAnim >= RABBIT::RUN1 && playerAnim <= RABBIT::SKID3) || (playerAnim >= RABBIT::SWIMRIGHT && playerAnim <= RABBIT::SWIMTURN2);
	}
	
	class Switch : jjBEHAVIORINTERFACE {
		void onBehave(jjOBJ@ obj) {
			if (obj.state == STATE::START) {
				obj.state = STATE::WAIT;
				const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
				obj.var[0] = jjParameterGet(xTile,yTile, 0, 5); //triggerID
				if (jjParameterGet(xTile,yTile, 8, 1) == 1) { //cheapfix
					obj.var[3] = 1;
					obj.var[2] = 1;
					obj.var[1] = (jjTriggers[obj.var[0]]) ? 1 : 0;
				} else {
					if (!jjTriggers[obj.var[0]])
						obj.var[3] = jjParameterGet(xTile,yTile, 7, 1); //reversible
					if (obj.var[3] == 0) {
						obj.var[1] = 0; //status
						obj.var[2] = 1; //target
						obj.curFrame += 14;
					} else {
						obj.var[1] = jjParameterGet(xTile,yTile, 5, 1); //status
						obj.var[2] = jjParameterGet(xTile,yTile, 6, 1); //target
					}
				}
				obj.var[5] = 0; //time spent pressing up
			} else if (obj.state == STATE::DEACTIVATE) {
				obj.deactivate();
				return;
			}
			if (obj.var[3] == 0)
				obj.var[1] = jjTriggers[obj.var[0]] ? 1 : 0;
			if (CurrentPopup is null && (obj.eventID != OBJECT::PEAR || obj.var[3] == 1 || obj.var[1] == 0)) { //still usable
				if (jjAnimFrames[obj.curFrame].doesCollide(int(obj.xPos), int(obj.yPos), obj.direction, jjAnimFrames[Player.curFrame], int(Player.xPos), int(Player.yPos), Player.direction, true)) {
					if (int(Player.ySpeed) == 0 && !BL18::OnPogoStick) {
						if (jjKey[0x54]) { //T
							if (obj.var[5] != 1 && IsPlayerOnGround()) {
								obj.var[5] = 1;
								playerPressedT(obj);
							}
						} else if (obj.var[5] >= 1)
							obj.var[5] = 2;
						else if (CurrentPopup is null)
							obj.var[5] = obj.var[5] - 1;
					}
				} else
					obj.var[5] = 0;
				if (obj.var[5] < -35) { //been standing in front of this thing for a while without pressing T
					jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos - 60, KeyFrame + 5, 0, SPRITE::SHADOW);
					jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos - 60 - ((jjGameTicks >> 2) & 3), KeyFrame + 4);
				}
			}
			drawMe(obj);
		}
		void playerPressedT(jjOBJ@ obj) {
			jjSample(obj.xPos, obj.yPos, HPSwitch);
			obj.var[1] = obj.var[1] ^ 1;
			obj.deactivates = false;
			if ((obj.var[1] == obj.var[2]) || (obj.var[3] == 1)) {
				const int triggerID = obj.var[0];
				uint numberOfOtherSwitches = 0;
				for (uint i = jjObjectCount - 1; i > 0; --i) { //only searches active objects, so all switches should be vaguely near to each other
					const jjOBJ@ obj2 = jjObjects[i];
					if (cast<jjBEHAVIORINTERFACE>(obj2.behavior) is this && obj2.var[0] == triggerID) {
						if (obj2.objectID != obj.objectID)
							++numberOfOtherSwitches;
						if (obj2.var[1] != obj2.var[2]) {
							if (jjTriggers[triggerID] == true) {
								jjTriggers[triggerID] = false;
								jjSamplePriority(HPTrigger);
							}
							return;
						}
					}
				}
				if (numberOfOtherSwitches > 0)
					for (uint i = jjObjectCount - 1; i > 0; --i) { //only searches active objects, so all switches should be vaguely near to each other
						jjOBJ@ obj2 = jjObjects[i];
						if (cast<jjBEHAVIORINTERFACE>(obj2.behavior) is this && obj2.var[0] == triggerID) {
							obj2.var[3] = 0; //no longer reversible
							obj2.curFrame += 14;
							obj2.deactivates = false;
						}
					}
				jjTriggers[triggerID] = true;
				jjSamplePriority(HPTrigger);
			}
		}
		void drawMe(const jjOBJ@ obj) {
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame + obj.var[1], 1, SPRITE::NORMAL,0, 5);
		}
	}
	
	jjTEXTAPPEARANCE ConversationAppearance(STRING::SPIN);
	abstract class Popup {
		Popup(){}
		bool Do() {
			return true;
		}
		void Draw(jjCANVAS@ canvas) const {
		}
		bool DrawHUD() const { return false; }
	}
	class Conversation : Popup {
		bool LastSelect = true;
		uint LineID = 0;
		uint CharacterCount;
		const array<string>@ Lines;
		bool DrawSpotty;
		uint CurFrame;
		string Line;
		uint TriggerID;
		uint FriendID;
		Conversation(const array<string>@ src, uint t, uint f) { @Lines = @src; TriggerID = t; FriendID = f; ParseLine(); }
		bool Do() override {
			if (jjKey[8]) //backspace
				return Finish();
			const bool pressingSelect = Player.keyFire || Player.keySelect || jjKey[1]; //left mouse button
			if (!LastSelect && pressingSelect) {
				if (++LineID >= Lines.length)
					return Finish();
				else
					ParseLine();
			} else if (CharacterCount < Line.length) {
				CharacterCount += 1;
				jjSamplePriority(SOUND::MENUSOUNDS_TYPE);
			}
			LastSelect = pressingSelect;
			return true;
		}
		bool Finish() const {
			if (TriggerID != 0 && !jjTriggers[TriggerID]) {
				jjTriggers[TriggerID] = true;
				jjSamplePriority(HPTrigger);
			}
			if (TriggerID == 2) //hardcoded for level 1, lol
				Player.noFire = false;
			return false;
		}
		void ParseLine() {
			const string line = Lines[LineID];
			DrawSpotty = (line[0] != 'J'[0]);
			CurFrame = (FriendID < FriendSpaz.length || !DrawSpotty) ? (jjAnimations[jjAnimSets[ANIM::MENU] + (jjIsTSF ? 11 : 9) + ((DrawSpotty && FriendSpaz[FriendID]) ? jjIsTSF ? 2 : 1 : 0)] + line[1] - '0'[0]) : FriendID;
			Line = jjRegexReplace(line.substr(2), "@", "@@");
			CharacterCount = 0;
		}
		void Draw(jjCANVAS@ canvas) const override {
			canvas.drawRectangle(100, 200, jjResolutionWidth-200, 190, 0, SPRITE::SHADOW);
			if (DrawSpotty && FriendID == 12 && jjRenderFrame & 15 == 0) { //false prophet
				canvas.drawResizedSpriteFromCurFrame(DrawSpotty ? jjResolutionWidth-100 : 100, 410, CurFrame, -1.2,1.2, SPRITE::SINGLECOLOR, 28);
			}
			if (CurFrame != FriendID)
				canvas.drawSpriteFromCurFrame(DrawSpotty ? jjResolutionWidth-100 : 100, 400, CurFrame, (!DrawSpotty || FriendSpaz[FriendID]) ? 1 : -1, SPRITE::MENUPLAYER, DrawSpotty ? FirstFriendPlayerID+FriendID : LocalPlayerID);
			else
				DrawCustomFriendTalkSprite(canvas);
			const string stringToWrite = Line.substr(0,CharacterCount);
			canvas.drawString(0x8000 - (jjGetStringWidth(Line, STRING::MEDIUM, ConversationAppearance) - (jjGetStringWidth(stringToWrite, STRING::MEDIUM, ConversationAppearance) & ~1))/2, 250, stringToWrite, STRING::MEDIUM, ConversationAppearance);
			if (Lines.length > 1) { //LineID < Lines.length - 1) {
				canvas.drawString(13, jjResolutionHeight - 17, "Press Backspace to skip.", STRING::SMALL,STRING::NORMAL,0,SPRITE::SHADOW);
				canvas.drawString(10, jjResolutionHeight - 20, "|||||Press Backspace to skip.");
			}
		}
		void DrawCustomFriendTalkSprite(jjCANVAS@ canvas) const {
			canvas.drawSpriteFromCurFrame(jjResolutionWidth-100, 400, CurFrame);
		}
	}
	Popup@ CurrentPopup = null;
	class Friend : Switch {
		//jjTEXTAPPEARANCE appearance(STRING::NORMAL);
		void onBehave(jjOBJ@ obj) override {
			if (obj.state == STATE::START) {
				obj.special = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 5, 5);
				obj.age = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 10, 5);
				obj.animSpeed = jjGetStringWidth("ß1" + FriendNames[obj.age], STRING::SMALL, STRING::NORMAL) / 2;
				obj.state = STATE::WAIT;
				obj.curFrame = jjAnimations[jjAnimSets[FriendSpaz[obj.age] ? ANIM::SPAZ : ANIM::JAZZ] + RABBIT::STAND];
				if (FriendNames[obj.age].length != 0)
					obj.putOnGround();
			}
			Switch::onBehave(obj);
		}
		void playerPressedT(jjOBJ@ obj) override {
			@CurrentPopup = Conversation(Conversations[jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 0, 5)], obj.special, obj.age);
			//jjTriggers[obj.special] = true;
		}
		void drawMe(const jjOBJ@ obj) override {
			if (FriendNames[obj.age].length == 0) //tile-based
				return;
			jjDrawSprite(obj.xPos, obj.yPos - 3, FriendSpaz[obj.age] ? ANIM::SPAZ : ANIM::JAZZ, RABBIT::STAND, jjGameTicks >> 3, (obj.xPos > Player.xPos) ? -1 : 1, obj.age < 10 ? SPRITE::TRANSLUCENTPLAYER : SPRITE::PLAYER, FirstFriendPlayerID + obj.age);
			if (obj.age == 6) //dreama
				jjDrawSprite(obj.xPos + 26, obj.yPos - 20, ANIM::SPAZ2, 2, jjGameTicks>>2, (obj.xPos+26 < Player.xPos) ? -1 : 1, SPRITE::TRANSLUCENTSINGLEHUE, 40); //tweety
			else if (obj.age == 4) //mike
				jjDrawSprite(obj.xPos + 40, obj.yPos - 76 + (jjGameTicks&1), ANIM::SPAZ2, 3, jjGameTicks>>3); //et
			jjDrawString(obj.xPos - obj.animSpeed, obj.yPos - 36, "ß1" + FriendNames[obj.age]);//, STRING::SMALL, appearance,0, SPRITE::TRANSLUCENTPALSHIFT);
		}
	}
	
	//[SOLID]
	bool PlayerOnElevator(jjOBJ@ obj) {
		if (Player.platform == obj.objectID) {
			if (!Player.antiGrav)
				return obj.yPos - Player.yPos >= 17;
			return Player.yPos - obj.yPos >= 37;
		}
		return false;
	}
	void Elevator(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.state = STATE::IDLE;
			obj.triggersTNT = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 0, 1) == 1;
			if (obj.triggersTNT) { obj.curFrame += TrueColor::NumberOfFramesPerImage; obj.special += 1; }
			obj.xPos += 17;
			obj.yPos -= 15;
		} else if (obj.state == STATE::DEACTIVATE) {
			obj.clearPlatform();
			obj.deactivate();
		} else if (!Player.noclipMode) {
			obj.beSolid();
			if (PlayerOnElevator(obj)) {
				const int speed = obj.var[0];
				if (speed != 0) {
					for (uint i = (Player.running ? 2 : 1); i > 0; --i) {
						if (obj.triggersTNT) { //LR
							if (!jjMaskedVLine(int(obj.xPos - 1 + 16.5 * speed), int(obj.yPos - 32), 64)) {
								obj.xPos += speed;
								Player.xPos += speed;
							}
						} else {
							if (!jjMaskedHLine(int(obj.xPos - 32), 64, int(obj.yPos + 16 * speed))) {
								obj.yPos += speed;
								Player.yPos += speed;
								if (Player.xPos < obj.xPos - 16)
									Player.xPos = obj.xPos - 16;
								else if (Player.xPos > obj.xPos + 16)
									Player.xPos = obj.xPos + 16;
							}
						}
					}
				}
			}
		}
		if (jjColorDepth != 8)
			TrueColor::DrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame);
		else
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.special);
	}
	
	void Spikes(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE) {
			obj.deactivate();
			return;
		} else if (obj.state == STATE::START) {
			obj.doesHurt = uint8(jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 2, 4));
			if (obj.doesHurt == 15) { //random
				do {
					obj.doesHurt = (jjRandom() % 10);
				} while (obj.doesHurt == 5); //yellow
			}
			obj.doesHurt = ((obj.doesHurt + 2) << 3) - 88;
			obj.age = jjRandom();
			//floor ceiling right left
			const int angle = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 0, 2);
			const int dir = (((angle & 1) ^ 1) << 1) - 1;
			if (angle & 2 == 0) { //UD
				if (obj.creator == CREATOR::LEVEL)
					jjAddObject(obj.eventID, obj.xPos + 16, obj.yPos, obj.objectID, CREATOR::OBJECT);
				obj.xPos -= 8;
				obj.direction = dir == 1 ? 1 : SPRITE::FLIPV;
				while (!jjMaskedPixel(int(obj.xPos), int(obj.yPos)) && obj.yPos > 0 && obj.yPos < jjLayerHeight[4]*32-1)
					obj.yPos += dir;
				obj.var[0] = 0;
				obj.var[1] = dir;
			} else { //LD
				if (obj.creator == CREATOR::LEVEL)
					jjAddObject(obj.eventID, obj.xPos, obj.yPos + 16, obj.objectID, CREATOR::OBJECT);
				obj.yPos -= 8;
				obj.curFrame += 1;
				obj.direction = dir == 1 ? 1 : SPRITE::FLIPH;
				while (!jjMaskedPixel(int(obj.xPos), int(obj.yPos)))
					obj.xPos += dir;
				obj.var[0] = dir;
				obj.var[1] = 0;
			}
		}
		obj.state = STATE::BOUNCE;
		++obj.age;
		uint offset = (obj.age >> 1) & 31;
		if (offset > 15) offset = 31 - offset;
		jjDrawSpriteFromCurFrame(obj.xPos + offset * obj.var[0], obj.yPos + offset * obj.var[1], obj.curFrame, obj.direction, SPRITE::PALSHIFT, obj.doesHurt, 5);
	}
	
	class LavaEffect {
		Point location;
		uint counter = jjRandom() & 15;
		LavaEffect(){}
	}
	uint LavaDamage = jjDifficulty + 1;
	class Lava : jjBEHAVIORINTERFACE {
		uint widthInPixels = 0, widthInTiles;
		bool ceiling;
		array<LavaEffect> effects;
		void onBehave(jjOBJ@ obj) {
			if (obj.state == STATE::DEACTIVATE) {
				if (jjDeactivatingBecauseOfDeath || widthInPixels == 0)
					obj.deactivate();
				else
					obj.state = STATE::FADEIN;
			} else if (obj.state == STATE::START) {
				obj.state = STATE::LAND;
				ceiling = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 5, 1) == 1;
				obj.yPos += ceiling ? -15 : 1;
				obj.xPos -= 15;
				widthInTiles = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 0, 5);
				widthInPixels = widthInTiles * 32;
				effects.resize(widthInTiles * 6);
			} else if (obj.state == STATE::FADEIN) {
				obj.state = STATE::LAND;
			} else {
				if (Player.xPos >= obj.xPos && Player.xPos <= obj.xPos + widthInPixels && abs(obj.yPos + 8 - Player.yPos) < 20)
					Player.hurt(LavaDamage);
				for (uint i = 0; i < effects.length; ++i) {
					LavaEffect@ effect = @effects[i];
					if (++effect.counter == 24) {
						effect.counter = 0;
						effect.location.x = obj.xPos + ((jjRandom() % widthInPixels) & ~1);
						effect.location.y = obj.yPos + ((jjRandom() & 7) << 1);
					}
				}
			}
		}
		void onDraw(jjOBJ@ obj) {
			if (obj.state != STATE::LAND)
				return;
			const uint8 lavaColor = 44;
			jjDrawRectangle(obj.xPos, obj.yPos, widthInPixels, 16, lavaColor, SPRITE::NORMAL,0, 5);
			const uint firstBubbleFrame = effects.length - effects.length / 3;
			for (uint i = 0; i < effects.length; ++i) {
				const LavaEffect@ effect = @effects[i];
				const bool isFlow = i < firstBubbleFrame;
				jjDrawSpriteFromCurFrame(effect.location.x, effect.location.y, jjAnimations[obj.curAnim + (isFlow?0:1)] + (effect.counter / 3), !ceiling ? 1 : SPRITE::FLIPV, isFlow?SPRITE::NORMAL:SPRITE::BLEND_SCREEN,255, isFlow?5:4);
			}
		}
	}
	
	class HeartStar {
		uint angle = jjRandom();
		uint age = jjRandom() & 255;
	}
	class EndScene : Popup {
		array<string> Message;
		array<uint8> Colors = {72, 24,  16, 24,  16, 24};
		array<bool> KeyPressed(256, true);
		array<HeartStar> HeartStars(IsMurderer ? 0 : 100);
		int age;
		uint8 boxColor = IsMurderer ? 30 : 53;
		uint8 boxTextColor = IsMurderer ? 24 : 88;
		string title = IsMurderer ? "What have you done?" : "BunnyLover 2018";
		string instruction = "Press any key";
		EndScene(int delay = 0) {
			age = -delay;
			jjMusicStop();
		}
		bool Do() override {
			if (age++ == 0) {
				Player.lighting = 0;
				Player.lightType = LIGHT::NONE;
				jjSamplePriority(SOUND::ENDTUNEJAZZ_TUNE);
				if (Message.length == 0) {
					const uint time = TimeSpentNotViewingPopups / 70;
					const uint gemTarget = GemTargets[0] + GemTargets[1] + GemTargets[2] + GemTargets[3];
					const uint gems = GemCounts[0] + GemCounts[1] + GemCounts[2] + GemCounts[3];
					if (time <= TimeTarget)
						Player.setScore(Player.score + 50000);
					if (gems >= gemTarget) //play it safe I guess?
						Player.setScore(Player.score + 1);
					Message = array<string> = {
						"Castle complete - congratulations!",
						"Results for Level " + jjLevelFileName.substr(jjLevelFileName.length-5, 1),
						"Treasures found: " + gems + "   Treasures available: " + gemTarget,
						(gems >= gemTarget) ? "Accuracy: 100%   BONUS EXTRA HEART!" : ("Accuracy: " + (gems * 100 / gemTarget) + "%   NO BONUS HEART"),
						"Time to beat: " + TimeTarget + "   Your time: " + time,
						(time <= TimeTarget) ? "BONUS 50,000 points!" : "Not fast enough   NO BONUS POINTS"
					};
				}
			}
			if (age >= -1000 && ++age >= 250) {
				if (age == 250 && !IsMurderer)
					jjMusicLoad("3ddemo.mod");
				for (uint i = 3; i < 256; ++i) {
					const bool pressed = jjKey[i];
					if (pressed && !KeyPressed[i]) {
						jjSetDarknessColor(); //iris out to black
						jjEventSet(uint(Player.xPos) >> 5, uint(Player.yPos) >> 5, AREA::WARPEOL); //jjNxt doesn't work for this because it doesn't support secret levels
						jjParameterSet(uint(Player.xPos) >> 5, uint(Player.yPos) >> 5, 0, 10, 2); //Fast
						age = -1000; //don't cycle multiple times
						break;
					}
					KeyPressed[i] = pressed;
				}
			}
			for (uint i = 0; i < HeartStars.length; ++i) {
				HeartStar@ heartStar = HeartStars[i];
				if (++heartStar.age > 255) {
					heartStar.age = 0;
					heartStar.angle = jjRandom();
				}
			}
			return true;
		}
		void Draw(jjCANVAS@ canvas) const override {
			if (age > -1000 && age < 250)
				return;
			const auto width = jjResolutionWidth, height = jjResolutionHeight;
			canvas.drawRectangle(0,64, width, height-64, 0);
			
			{
				const auto centerX = width/2, centerY = height/2;
				for (uint i = 0; i < HeartStars.length; ++i) {
					const HeartStar@ heartStar = HeartStars[i];
					canvas.drawSpriteFromCurFrame(centerX + int(jjSin(heartStar.angle) * heartStar.age * 3), centerY + int(jjCos(heartStar.angle) * heartStar.age * 2), heartFrame, 0, SPRITE::BRIGHTNESS, heartStar.age);
				}
			}
			
			int yPos = height / 2 - 32 * 4 + 20;
			for (uint i = 0; i < Message.length; ++i) {
				canvas.drawString(0x8000, yPos, "ß1" + Message[i], STRING::MEDIUM, STRING::NORMAL,0, SPRITE::SINGLEHUE, IsMurderer ? 24 : Colors[i]);
				if (i < 5 && i & 1 == 1)
					yPos += 64;
				else
					yPos += 32;
			}
			
			canvas.drawRectangle(0,0, width, 64, boxColor);
			canvas.drawString(0x8000, 20, title, STRING::LARGE, STRING::NORMAL,0,SPRITE::SINGLEHUE,boxTextColor);
			if (age >= 0) {
				canvas.drawRectangle(0,height-32, width, 32, boxColor);
				canvas.drawString(0x8000, height - 20, instruction, STRING::MEDIUM, STRING::NORMAL,0,SPRITE::SINGLEHUE,boxTextColor);
			}
		}
	}
	
	bool OnPogoStick = false;
	void SetPogoStick(bool setTo) {
		if (OnPogoStick && !setTo) {
			jjAddObject(OBJECT::THING, Player.xPos, Player.yPos, 0, CREATOR::OBJECT, BEHAVIOR::BOUNCEONCE);
		}
		OnPogoStick = setTo;
		Player.spriteMode = setTo ? SPRITE::INVISIBLE : SPRITE::PLAYER;
		jjTriggers[0] = setTo; //for narrow passages
		jjCharacters[CHAR::JAZZ].airJump = setTo ? AIR::NONE : AIR::HELICOPTER;
		Player.jumpStrength = -10;
	}
	
	class PogoStick : Switch {
		void playerPressedT(jjOBJ@ obj) override {
			SetPogoStick(true);
			jjSample(obj.xPos, obj.yPos, HPYeahoo);
			obj.delete();
		}
		void drawMe(const jjOBJ@ obj) override {
			const auto dx = Player.xPos - obj.xPos, dy = Player.yPos - obj.yPos;
			int dist = int((dx * dx + dy * dy) / 250) - 50;
			if (dist > 255) dist = 255;
			else if (dist < 0) dist = 0;
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, PogoFrame, 1, SPRITE::BLEND_DISSOLVE, 255 - dist);
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, PogoFrame + 1);
			jjDrawString(obj.xPos + 10, obj.yPos, (obj.creatorID == 0 || obj.creatorType != CREATOR::LEVEL) ? "|x1" : "|x^");
		}
	}
	
	
	[SOLID]
	void CompanionRock(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE) {
			obj.clearPlatform();
			obj.deactivate();
			return;
		}
		if (obj.state == STATE::START)
			obj.triggersTNT = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, -2, 1) == 1; //illuminate surroundings, but frozen objects have their own lighting effect, so it's safe to repurpose this (and it's easier to apply to regenerating objects than most settings)
		if (obj.state == STATE::START || obj.freeze > 20)
			obj.freeze = 30;
		if (!Player.antiGrav) {
			for (int i = 0; i < 7; ++i)
				if (i <= 1 || obj.state != STATE::FALL) { //behave more frequently while moving horizontally than vertically
					const auto lastX = obj.xPos, lastY = obj.yPos;
					const auto lastDir = obj.var[5];
					const auto lastSpeed = obj.xSpeed;
					const bool wasPlatform = Player.platform == obj.objectID && Player.yPos < obj.yPos - 50;
					obj.behave(BEHAVIOR::BIGOBJECT, false);
					if (Player.platform == obj.objectID) {
						if (abs(Player.xPos - obj.xPos) < 20) {
							if (obj.state == STATE::FALL && wasPlatform && obj.yPos != lastY) {
								if (Player.xPos < obj.xPos - 10)
									Player.xPos = obj.xPos - 10;
								else if (Player.xPos > obj.xPos + 10)
									Player.xPos = obj.xPos + 10;
							} else if (i != 6)
								Player.xPos += obj.xPos - lastX;
							Player.yPos += obj.yPos - lastY;
						}
					} else if (wasPlatform) {
						if (obj.triggersTNT)
							jjObjects[jjAddObject(OBJECT::TNT, obj.xPos, obj.yPos)].state = STATE::EXPLODE;
						obj.clearPlatform();
						obj.unfreeze(1);
						obj.delete();
						return;
					}
					if (lastSpeed != 0.f && obj.xSpeed == 0.f && obj.state != STATE::FALL) //hit wall
						obj.var[5] = ((obj.xSpeed = -lastSpeed) >= 0) ? 1 : -1;
					else if (lastDir != 0 && obj.var[5] == 0) //fell
						obj.var[5] = lastDir;
					else if (obj.var[5] == 0 && Player.platform == obj.objectID)
						obj.var[5] = Player.direction;
				}
		} else if (obj.state == STATE::START)
			obj.behave(BEHAVIOR::BIGOBJECT, false); //putOnGround
		for (uint i = jjObjectCount; --i > 0;) {
			const jjOBJ@ elevator = jjObjects[i];
			if (elevator.behavior == BL18::Elevator && obj.doesCollide(elevator)) {
				if (obj.triggersTNT)
					jjObjects[jjAddObject(OBJECT::TNT, obj.xPos, obj.yPos)].state = STATE::EXPLODE;
				obj.clearPlatform();
				obj.unfreeze(1);
				obj.delete();
			}
		}
		jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, 1, SPRITE::FROZEN);
		const int angle = (-obj.var[5]) << 7;
		if (!obj.triggersTNT)
			jjDrawRotatedSpriteFromCurFrame(obj.xPos - 4, obj.yPos - 14, heartFrame, angle, 2,2, SPRITE::BLEND_HUE,192);
		else
			jjDrawRotatedSpriteFromCurFrame(obj.xPos - 4, obj.yPos - 14, jjObjectPresets[OBJECT::TNT].curFrame, angle, 1,1, SPRITE::TRANSLUCENT);
		if (obj.var[5] == 0)
			jjDrawString(obj.xPos + 36, obj.yPos - 8, (obj.creatorID == 0) ? "|x1" : "|x^");
	}
	
	array<bool> SavedTriggers(32, false);
	void CheckpointWrapper(jjOBJ@ obj) {
		if (obj.state == STATE::STOP) { //don't do anything anymore
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame);
		} else if (obj.state == STATE::DEACTIVATE) { //due to death
			obj.deactivate();
		} else {
			obj.behave(BEHAVIOR::CHECKPOINT);
			if (obj.state == STATE::DONE) { //triggered by the player hitting it
				obj.state = STATE::STOP;
				for (uint i = 1; i < 32; ++i) //skip 0, which is used by pogo sticks
					SavedTriggers[i] = jjTriggers[i];
				for (int i = jjObjectCount; --i > 0;) {
					jjOBJ@ obj2 = jjObjects[i];
					if (obj2.eventID == OBJECT::CHECKPOINT && i != obj.objectID && obj2.isActive) {
						obj2.state = STATE::SLEEP;
						obj2.var[0] = 0;
					}
				}
			}
		}
	}
	
	class SmartBomb : jjBEHAVIORINTERFACE {
		void onBehave(jjOBJ@ obj) {
			if (obj.state == STATE::START)
				obj.state = STATE::FLY;
			else if (obj.state == STATE::FREEZE || obj.state == STATE::DEACTIVATE)
				obj.behave(BEHAVIOR::BEE, false);
			else {
				obj.age += 4;
				obj.frameID = (obj.age >> 5) & 7;
				if (obj.frameID > 3) obj.frameID = 3 - obj.frameID;
				obj.determineCurFrame();
				if (obj.age & 255 == 128) {
					const auto angle = jjRandom();
					const float speed = IsMurderer ? 2.f : 1.5f;
					obj.xSpeed = jjSin(angle) * speed;
					obj.ySpeed = jjCos(angle) * speed;
					jjSample(obj.xPos, obj.yPos, SOUND::Sample(SOUND::COMMON_AIRBTURN + ((obj.age >> 9) & 1)));
				} else {
					const float targetX = obj.xPos + obj.xSpeed, targetY = obj.yPos + obj.ySpeed;
					if (!jjMaskedPixel(int(targetX), int(targetY))) {
						obj.xPos = targetX; obj.yPos = targetY;
					} else {
						obj.xSpeed = -obj.xSpeed;
						obj.ySpeed = -obj.ySpeed;
					}
				}
			}
		}
		void onDraw(jjOBJ@ obj) {
			jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, int(jjSin(obj.age) * 16), 1,1, obj.state != STATE::FREEZE ? SPRITE::NORMAL : SPRITE::FROZEN);
		}
		bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
			if (bullet is null && force == 0) { //no need to explode just from physical contact
				if (obj.state != STATE::FREEZE)
					player.hurt(1);
				return true;
			}
			if (bullet !is null && bullet.var[6] & 16 == 0)
				bullet.state = STATE::EXPLODE;
			player.blink = 0;
			player.hurt(2);
			obj.curFrame = jjAnimations[obj.curAnim = obj.killAnim] + (obj.frameID = 4);
			obj.behavior = BEHAVIOR::EXPLOSION;
			obj.playerHandling = HANDLING::EXPLOSION;
			if (obj.state == STATE::FREEZE)
				obj.unfreeze(0);
			jjSample(obj.xPos, obj.yPos, SOUND::AMMO_BOEM1);
			@CurrentPopup = Flash(24); //red
			return true;
		}
	}
	
	class Flash : Popup {
		uint opacity = 255;
		uint8 color;
		Flash(uint8 c) { color = c; }
		bool Do() {
			return (opacity -= 10) > 40;
		}
		void Draw(jjCANVAS@ canvas) const {
			canvas.drawRectangle(0,0, jjSubscreenWidth, jjSubscreenHeight, color, SPRITE::BLEND_NORMAL, opacity);
		}
		bool DrawHUD() const { return true; }
	}
	
	void Gear(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.state = STATE::WAIT;
			obj.yPos += 16;
		} else if (obj.state == STATE::DEACTIVATE) {
			obj.clearPlatform();
			obj.deactivate();
		} else {
			const int pushDir = obj.beSolid();
			if (pushDir != 0 && ((pushDir == 1 && Player.keyRight) || (pushDir == -1 && Player.keyLeft))) {
				if (jjGameTicks & 7 == 0)
					obj.frameID += pushDir;
				if (++obj.age >= 20) {
					if (jjWaterTarget < Player.cameraY)
						jjSetWaterLevel(Player.cameraY, true);
					else if (jjWaterTarget > Player.cameraY + jjSubscreenHeight)
						jjSetWaterLevel(Player.cameraY + jjSubscreenHeight, true);
					else if (jjWaterTarget < obj.yOrg)
						jjSetWaterLevel(jjWaterTarget + 2, true);
					else
						jjSetWaterLevel(jjWaterTarget - 2, true);
				}
				obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::COMMON_CLOCK,obj.doesHurt);
			} else
				obj.age = 0;
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame + (uint(obj.frameID) % 3));
		}
	}
}

void onLevelReload() {
	BL18::Player.lives += 1; //replenish
	BL18::Player.food += 10000; //deaths are food/10000
	if (!BL18::PreserveGemsAfterDeath) {
		BL18::Player.setScore(BL18::oldScore); //treasures aren't collected anymore
		for (uint i = 0; i < 4; ++i)
			BL18::GemCounts[i] = 0;
	}
	BL18::IsMurderer = false; //merciful
	BL18::SetPogoStick(false);
	BL18::Player.antiGrav = false;
	BL18::Player.fur = 0; //pink gun will be added elsewhere later
	jjMusicLoad(BL18::musicFilename);
	for (uint i = 1; i < 32; ++i) //skip 0, used for pogo sticks
		jjTriggers[i] = BL18::SavedTriggers[i]; //whatever was set last time you visited a checkpoint
	if (BL18::myLevelReload !is null) //level-specific
		BL18::myLevelReload();
	else
		MLLE::Palette.apply();
}

void onLevelBegin() {
	if (jjGameConnection != GAME::LOCAL || jjLocalPlayerCount != 1) {
		jjPrint("ERROR: BL18 is only suitable for local single player.");
		if (jjGameMode != GAME::SP)
			jjChat("/sp");
		BL18::Player.lives = -1;
		BL18::Player.health = 0;
	}
	BL18::Player.scoreDisplayed = BL18::Player.score;
}

bool onDrawScore(jjPLAYER@ play, jjCANVAS@ canvas) {
	bool hide = false;
	if (BL18::CurrentPopup !is null) {
		BL18::CurrentPopup.Draw(canvas);
		hide = !BL18::CurrentPopup.DrawHUD();
	}
	if (!hide)
		BL18::HUD(canvas);
	return true;
}
bool onDrawAmmo(jjPLAYER@ play, jjCANVAS@ canvas) { 
	const bool hide = BL18::CurrentPopup !is null && !BL18::CurrentPopup.DrawHUD();
	if (!hide && !BL18::IsMurderer && !play.noFire) {
		const int x = jjSubscreenWidth - (jjSubscreenWidth > 400 ? 88 : 48), y = jjSubscreenHeight - (jjSubscreenWidth > 400 ? 14 : 9);
		int angle = jjGameTicks<<2;
		for (uint i = 0; i < 8; ++i, angle += 128)
			canvas.drawRotatedSpriteFromCurFrame(x - int(jjSin(angle) * 25), y - int(jjCos(angle) * 25), BL18::heartFrame, angle, 1,1, SPRITE::TRANSLUCENT);
	}
	if (BL18::myHUD !is null)
		BL18::myHUD(play, canvas);
	return hide;
}

bool onDrawHealth(jjPLAYER@ play, jjCANVAS@ canvas) {
	if (BL18::CurrentPopup is null || BL18::CurrentPopup.DrawHUD()) {
		int health = play.health - BL18::ExtraHealthPadding;
		if (health == 1 && (jjRenderFrame & 3) >= 2)
			health = 0;
		const int maxHealth = jjMaxHealth - BL18::ExtraHealthPadding;
		const int numberOfHeartsToDraw = !jjShowMaxHealth ? health : maxHealth;
		const int xOrg = jjResolutionWidth - 12, yOrg = 8;
		for (int i = 0; i < numberOfHeartsToDraw; ++i)
			canvas.drawSpriteFromCurFrame(xOrg - 16 * (i % 5), yOrg + 16 * (i / 5), BL18::heartFrame, 1, i < health ? SPRITE::NORMAL : SPRITE::TINTED, 4);
	}
	return true;
}
bool onDrawLives(jjPLAYER@ play, jjCANVAS@ canvas) { return true; }


bool PressingKeyToMakeCutsceneGoAway = false;
bool IsLevelWhereRunningIsAllowed = jjDifficulty < 2;
void onPlayer(jjPLAYER@ play) {
	const bool inCutscene = BL18::CurrentPopup !is null;
	jjCharacters[play.charCurr].canRun = !inCutscene && IsLevelWhereRunningIsAllowed; //block revving
	if (play.noclipMode || inCutscene)
		play.invincibility = -15;
	else {
		uint fur = play.fur;
		if (fur == 0) fur = 0x28201810;
		const uint targetGunColor = BL18::IsMurderer ? 0x480000 : 0x300000;
		if (fur & 0xFF0000 != targetGunColor) {
			play.fur = (fur & 0xFF00FFFF) | targetGunColor;
		}
	}
	if (inCutscene) {
		if (!BL18::CurrentPopup.Do())
			@BL18::CurrentPopup = null;
		PressingKeyToMakeCutsceneGoAway = true;
		play.keyLeft = play.keyRight = play.keyDown = play.keyUp = play.keyRun = play.keyFire = play.keyJump = play.keySelect = false;
		play.idle = 0;
	} else {
		++BL18::TimeSpentNotViewingPopups;
		
		BL18::ShowArrow();
		
		if (play.keyFire || play.keySelect) {
			if (PressingKeyToMakeCutsceneGoAway)
				play.keySelect = false;
		} else
			PressingKeyToMakeCutsceneGoAway = false;
			
		
		if (BL18::OnPogoStick) {
			if (play.keyFire) {
				BL18::SetPogoStick(false);
			} else {
				play.keyDown = false;
				if (jjDifficulty > 1 && !play.keyRight && !play.keyLeft)
					play.keyLeft = !(play.keyRight = play.direction >= 0);
				play.jumpStrength = (play.keyJump) ? -16.667 : -6;
				play.keyJump = true;
				play.keyRun = false;
				if (play.blink == 0 || ((jjRenderFrame >> 2) & 1) == 1) {
					int direction = play.direction;
					if (play.antiGrav) direction ^= 0x40;
					jjDrawSprite(play.xPos, play.yPos - (!play.antiGrav ? 19 : -11), play.setID, RABBIT::LIFTLAND, 0, direction, SPRITE::PLAYER, play.playerID);
					jjDrawSpriteFromCurFrame(play.xPos, play.yPos + (!play.antiGrav ? 5 : -12), BL18::PogoFrame, direction);
				}
			}
			play.doubleJumpCount = 1;
		} else {
			jjOBJ@ platform = jjObjects[play.platform];
			if (platform.behavior == BL18::Elevator && BL18::PlayerOnElevator(platform)) {
				if (platform.triggersTNT) { //LR
					play.xSpeed = 0;
					if (play.keyRight)
						play.direction = 1;
					else if (play.keyLeft)
						play.direction = -1;
					platform.var[0] = play.keyRight ? 2 : play.keyLeft ? -2 : 0;
					play.keyLeft = play.keyRight = false;
				} else {
					platform.var[0] = play.keyDown && !play.keyJump ? 2 : play.keyUp ? -2 : 0;
				}
			}
		}
		
		if (BL18::FlyCarrotTime != 0) {
			const uint dialFrame = BL18::KeyFrame + 18;
			for (int i = 255; i >= 0; --i) {
				uint8 color = 17;
				const int delta = BL18::FlyCarrotTime - i;
				if (delta < 0)
					color = 24;
				else if (delta < 10)
					color = 43;
				else if (delta < 20)
					color = 40;
				jjDrawRotatedSpriteFromCurFrame(play.xPos, play.yPos, dialFrame, i<<2, 1,1, SPRITE::SINGLECOLOR, color);
			}
			if (--BL18::FlyCarrotTime == 0)
				play.fly = FLIGHT::NONE;
			play.keyRun = false; //easier for level design if I don't have to worry about difficulties
		} else if ((play.yPos < jjWaterLevel || jjWaterInteraction == WATERINTERACTION::LOWGRAVITY) && !play.noclipMode) {
			if (play.ySpeed < BL18::PlayerLastSpeed && BL18::PlayerLastSpeed < 0.f && jjMaskedHLine(int(play.xPos) - 13, 26, int(play.yPos) + ((!play.antiGrav) ? 25 : -25))) {
				play.ySpeed = 1;
				if (play.keyDown)
					play.buttstomp = 1;
				play.keyJump = false; //probably not needed
			}
			BL18::PlayerLastSpeed = play.ySpeed;
		}
	}
	
	BL18::DoObjectLoop();
}

void onFunction0(jjPLAYER@ Player) {
	if (Player.noclipMode) {
		Player.noclipMode = false;
		Player.xSpeed = Player.ySpeed = 0;
		Player.fur = 0;
		jjSample(Player.xPos = (int(Player.xPos) & ~31) + 15, Player.yPos = (int(Player.yPos) & ~31) + 15, BL18::HPWarp);
	}
}
void onFunction1(jjPLAYER@, uint8 delay) {
	if (BL18::CurrentPopup is null)
		@BL18::CurrentPopup = BL18::EndScene(delay);
}
void onFunction2(jjPLAYER@, uint8 triggerID) {
	if (!jjTriggers[triggerID]) {
		jjTriggers[triggerID] = true;
		jjSamplePriority(BL18::HPTrigger);
	}
}

bool onCheat(string &in cheat) {
	if (BL18::CurrentPopup !is null && cheat != "jjt")
		return true; //let's not worry about this kind of state-based nonsense
	if (cheat == "jjnxt" || cheat == "jjnext") {
		onFunction1(null, 0);
	} else if (cheat == "jjpogo") {
		BL18::SetPogoStick(!BL18::OnPogoStick);
	} else if ((cheat == "jjk" || cheat == "jjkill") && BL18::Player.health <= 0) {
		;//do nothing, don't double die
	} else if (cheat == "jjmorph" || cheat == "jjgems" || cheat == "jjcoins") {
		return true; //pretend it doesn't exist
	} else if (cheat == "jjcolor") {
		BL18::Player.fur = 0; //no false negatives
		return false;
	} else
		return false;
	jjAlert(cheat, false, STRING::MEDIUM);
	return true;
}

void onDrawLayer4(jjPLAYER@, jjCANVAS@ canvas) {
	if (BL18::LevelContainsLava) {
		const uint8 lavaColor = 44;
		const jjBEHAVIORINTERFACE@ intermediateStep;
		for (int i = jjObjectCount; --i > 0;) {
			const jjOBJ@ obj = jjObjects[i];
			if (obj.eventID == 122 && obj.isActive && obj.state == STATE::LAND && (@intermediateStep = cast<jjBEHAVIORINTERFACE>(obj.behavior)) !is null) {
				const auto@ behavior = cast<BL18::Lava>(intermediateStep);
				canvas.drawSpriteFromCurFrame(int(obj.xPos - 16), int(obj.yPos - 16), obj.special, 1, SPRITE::ALPHAMAP,lavaColor);
				canvas.drawResizedSpriteFromCurFrame(int(obj.xPos), int(obj.yPos - 16), obj.special+1, behavior.widthInTiles,1, SPRITE::ALPHAMAP,lavaColor);
				canvas.drawSpriteFromCurFrame(int(obj.xPos + behavior.widthInPixels + 15), int(obj.yPos - 16), obj.special, -1, SPRITE::ALPHAMAP,lavaColor);
			}
		}
	}
}