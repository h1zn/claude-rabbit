const uint TimeTarget = 0; //unused
int backgroundFrameID;
void onLevelLoad() {
	BL18::ExtraHealthPadding = 3;
	BL18::Setup();
	SmokeSetup();
	BL18::CoinWarpFound = true;
	
	backgroundFrameID = jjAnimations[jjAnimSets[TrueColor::FindCustomAnim()].allocate(array<uint>={1})];
	jjANIMFRAME@ backgroundFrame = jjAnimFrames[backgroundFrameID];
	Resize::Resize(jjPIXELMAP(0,0, 320, 192, 8), 3.125, Resize::Method::BilinearInterpolation).save(backgroundFrame);
	backgroundFrame.hotSpotX = -backgroundFrame.width/2;
	backgroundFrame.hotSpotY = -backgroundFrame.height/2;
	
	jjObjectPresets[OBJECT::BILSY].deactivates = false; //lava
	jjObjectPresets[122].deactivates = false; //lava
	
	if (jjDifficulty > 1) {
		Conversations[0].insertLast("S6(btw you can run again)");
		IsLevelWhereRunningIsAllowed = true;
	}
	BL18::LavaDamage = 1; //be nice
	
	jjPlayers[BL18::FirstFriendPlayerID + 12].fur = BL18::FriendColor(80,80,80,80); //false prophet can't use palette-specific colors for this level
	jjObjectPresets[OBJECT::PRETZEL].deactivates = false;
	
	SetupHeartWalls();
}

void onPlayerInput(jjPLAYER@ play) {
	if ((play.health <= BL18::ExtraHealthPadding) && play.health > 0 && BL18::CurrentPopup is null) {
		jjOBJ@ dragon = jjObjects[play.boss];
		if (!play.bossActivated || dragon.energy > 35)
			play.hurt(7, true);
		else {
			dragon.state = STATE::FADEIN;
			play.invincibility = -10;
			@BL18::CurrentPopup = TeamworkCutscene();
		}
	}
}

void onDrawLayer8(jjPLAYER@, jjCANVAS@ screen) {
	if (!jjLowDetail)
		screen.drawSpriteFromCurFrame(jjSubscreenWidth/2, jjSubscreenHeight/2, backgroundFrameID);//, 1, SPRITE::BRIGHTNESS, int(jjSin(jjGameTicks * 12) * 18) + 128);
}

final class FinalEndScene : BL18::EndScene {
	FinalEndScene() {
		BL18::GemTargets[0] += 6262; //don't accidentally assign points for meeting an imaginary gem target
		super(70);
		instruction = "Press F12 to take screenshot";
		string difficulty;
		switch (jjDifficulty) {
			case 0:
				difficulty = "Easy";
				break;
			case 1:
				difficulty = "Normal";
				break;
			case 2:
				difficulty = "Hard";
				break;
			case 3:
				difficulty = "Turbo";
				break;
		}
		Colors.insertLast(72);
		const int NumberOfEnemiesInEntirePack = ((jjDifficulty <= 1) ? 747 : 860) + 2 * jjDifficulty; //the jjDifficulty multiplier is for Uterus's extra spike balls in level 3
		Message = array<string> = {
			"Game complete - congratulations!",
			"Final results (" + difficulty + " difficulty)",
			"Total score: §/" + formatInt(BL18::Player.score - (BL18::Player.score % 50), "0", 7),
			"Total deaths: " + formatInt(BL18::Player.food / 10000, "0", 3),
			"Enemies pacfested: " + (BL18::Player.lives - 3),
			"Enemies genoxided: " + (BL18::Player.food % 10000),
			"Enemies ignored: " + (NumberOfEnemiesInEntirePack - (BL18::Player.lives - 3) - (BL18::Player.food % 10000))
		};
	}
	bool Do() override {
		for (uint i = 0; i < 256; ++i)
			if (i != 0x7B)
				KeyPressed[i] = true;
		return EndScene::Do();
	}
}

void SetupHeartWalls() {
	const uint width = jjLayerWidth[4]; //thankfully, a multiple of 4 tiles
	const uint height = jjLayerHeight[4];
	const array<uint16> tilesThatNeedRedrawing = {192, 202, 212, 222, 232, 233, 234, 235, 236, 237, 227, 217, 207, 197, 198, 162, 208, 209, 218, 219, 440, 441, 442, 443, 180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 985, 57 | TILE::HFLIPPED, 757 | TILE::HFLIPPED};
	array<bool> redrawnTiles(tilesThatNeedRedrawing.length << 4, false);
	array<jjPIXELMAP@> wallPattern(4*4, null);
	for (uint i = 0; i < wallPattern.length; ++i) {
		const uint16 patternTileID = 780 + (i & 3) + (((i + 12) & 15) >> 2) * 10;
		@wallPattern[i] = jjPIXELMAP(patternTileID);
	}
	for (uint y = 0; y < height; ++y)
		for (uint x = 0; x < width; x += 4) {
			bool regenned = false;
			for (uint xx = 0; xx < 4; ++xx) {
				const uint16 oldTileID = jjTileGet(4, xx + x, y);
				const int index = tilesThatNeedRedrawing.find(oldTileID);
				if (index >= 0) {
					if (!regenned) {
						regenned = true;
						jjGenerateSettableTileArea(4, x, y, 4, 1);
					}
					const uint oldTileIndex = ((y & 3) << 2) | (xx);
					const uint replacingTileIndex = uint(index << 4) | oldTileIndex;
					const uint newTileID = jjTileCount + replacingTileIndex;
					if (!redrawnTiles[replacingTileIndex]) {
						jjPIXELMAP newTile(oldTileID);
						const jjPIXELMAP@ pattern = wallPattern[oldTileIndex];
						for (uint h = 0; h < 32; ++h)
							for (uint v = 0; v < 32; ++v)
								if (newTile[h,v] == 103)
									newTile[h,v] = pattern[h,v];
						newTile.save(newTileID);
						jjMASKMAP(oldTileID).save(newTileID);
						redrawnTiles[replacingTileIndex] = true;
					}
					jjTileSet(4, xx + x, y, newTileID);
				}
			}
	}
}

