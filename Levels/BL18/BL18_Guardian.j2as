/****************************************
	Code below this point by Smoke,
	modified as necessary to fit into
	BL18::Enemy and use different positions.
****************************************/


enum devanStates {Main,Ram1,Ram2,Final1,PreFinal,FollowShield1,FollowShield2,FollowShield3,FollowShield4,Elipse1,Elipse2,Elipse3,Pheonixx,Shootfire,Heart1,Bilsy};
array<int> DragonAttacks ={0,1,2,3,4};
array<int> NextDragonAttacks;
/*
timer used to manage the main movement of the dragon
Maintimer to manage the timer on the Main state
Bilsytimer2 to manage frames and stuff on Bilsy state
Bilystimer to manage timer on Bilsy state
Elipsetimer, pheonixtimer are timer for states Elipse and Pheonix
Follow is what makes the center of the fireballs move towards you when boss goes under lava
Amplitude plays a role in determining the radius of the rotating fires
omega plays a role in determining the speed of the rotating fires
FollowUsed determines whether the attack where the dragon goes underwater was used or not yet
CurrCase is the current case of the dragon
Mainx/y are the last positions of the dragon when he was in the main state
Playerx/y are the last positions of the player when the dragon was in the main state
Unitx/y are just unit vectors used in GoTo and GoArc, the reason they're global is that they're used outside these function in the final state
SpinfireX/Y are global integers used to determine the center of the rotating fire 
*/
void SmokeSetup() {

	//jjAnimations[jjAnimSets[DragonAnimSetID].firstAnim].firstFrame.gunSpotX=32;

	PurpleDragon(jjObjectPresets[OBJECT::BILSY]);
	jjObjectPresets[OBJECT::CHIPS].behavior = DragonProjectile();
	jjObjectPresets[OBJECT::CHIPS].light = 1;
	jjObjectPresets[OBJECT::CHIPS].lightType = LIGHT::POINT2;
	jjObjectPresets[OBJECT::DONUT].behavior = SpinFire;
	jjObjectPresets[OBJECT::DONUT].light = 1;
	jjObjectPresets[OBJECT::DONUT].lightType = LIGHT::POINT2;
	jjObjectPresets[OBJECT::CHERRY].behavior = BEHAVIOR::BILSYBULLET;
	jjObjectPresets[OBJECT::DONUT].animSpeed = 1;
	jjObjectPresets[OBJECT::CHIPS].animSpeed = 1;
}

int Bilsytimer2, Prevframe, Bilsytimer, rand, Elipsetimer, Pheonixtimer, timer, Maintimer = 0;
float Follow = 0;
float Final = 0;
float Amplitude, omega = 1;
float SpinFireX, SpinFireY;
bool FollowUsed = false;
double Targetx, Targety, Mainx, Mainy, Playerx, Playery, Vectx, Vecty, Unitx, Unity = 0;
int DragonAnimSetID;

uint CurrCase = Main;

class DragonProjectile: jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ @ o) {
		if (Maintimer % 350 == 100)
			o.delete();
		o.playerHandling = HANDLING::ENEMYBULLET;
		o.xPos += 10 * (Playerx - o.xOrg) / abs(Playerx - o.xOrg);
		jjDrawSprite(o.xPos, o.yPos, DragonAnimSetID, 3, 0, 62 * 32 - int(o.xOrg));
		if (timer % 10 == 0) {
			int bulletID2 = jjAddObject(OBJECT::TOASTERBULLET, o.xPos - 25, o.yPos - 4, o.var[0], CREATOR::LEVEL);
			jjOBJ @ bull2 = jjObjects[bulletID2];
			bull2.xAcc = 0;
			bull2.xSpeed = (62 * 32 - o.xOrg) / abs((62 * 32 - o.xOrg)) * 16;
			bull2.yAcc = 0;
			bull2.ySpeed = 0;
			bull2.playerHandling = HANDLING::ENEMYBULLET;
			bull2.frameID = 3;
			int bulletID3 = jjAddObject(OBJECT::TOASTERBULLET, o.xPos + 25, o.yPos, o.var[0]);
			jjOBJ @ bull3 = jjObjects[bulletID3];
			bull3.xAcc = 0;
			bull3.xSpeed = (62 * 32 - o.xOrg) / abs((62 * 32 - o.xOrg)) * 16;
			bull3.yAcc = 0;
			bull3.ySpeed = 0;
			bull3.frameID = 3;
			bull3.playerHandling = HANDLING::ENEMYBULLET;
			int bulletID4 = jjAddObject(OBJECT::TOASTERBULLET, o.xPos, o.yPos + 2, o.var[0]);
			jjOBJ @ bull4 = jjObjects[bulletID4];
			bull4.yAcc = 0;
			bull4.ySpeed = 0;
			bull4.xAcc = 0;
			bull4.xSpeed = (62 * 32 - o.xOrg) / abs((62 * 32 - o.xOrg)) * 16;
			bull4.playerHandling = HANDLING::ENEMYBULLET;
			bull4.frameID = 3;
			int bulletID5 = jjAddObject(OBJECT::TOASTERBULLET, o.xPos, o.yPos + 5, o.var[0]);
			jjOBJ @ bull5 = jjObjects[bulletID5];
			bull5.yAcc = 0;
			bull5.ySpeed = 0;
			bull5.xAcc = 0;
			bull5.xSpeed = (62 * 32 - o.xOrg) / abs((62 * 32 - o.xOrg)) * 16;
			bull5.frameID = 3;
			bull5.playerHandling = HANDLING::ENEMYBULLET;
		}
		//jjDrawSprite(obj.xPos  , obj.yPos , ANIM::PICKUPS, 1, 1, -3*sin(0.25*t/7+40));

	}
}

const uint DragonHealthMultiplier = 8;

class PurpleDragon: BL18::Enemy {
	PurpleDragon(jjOBJ @ preset) {
		super(preset, BL18::AnimSets::PurpleDragon);
		DragonAnimSetID = animSetID;
		preset.energy = 100; //for boss meter
		preset.special = preset.energy * DragonHealthMultiplier; //internal
		gender = BL18::Gender::Male;
		preset.lightType = LIGHT::PLAYER;
		preset.light = 13;
	}
	void onBehave(jjOBJ @ obj) {
		switch (obj.state) {
		case STATE::START: //always used
			obj.determineCurAnim(ANIM::DEVILDEVAN, 5);
			obj.state = STATE::WAIT;
		case STATE::WAIT:
			for (int i = 0; i < jjLocalPlayerCount; ++i) {
				jjPLAYER @ localPlayer = jjLocalPlayers[i];
				if (localPlayer.bossActivated == true) {
					Bilsytimer2 = Prevframe = Bilsytimer = rand = Elipsetimer = Pheonixtimer = timer = Maintimer = 0;
					Follow = 0;
					Final = 0;
					Amplitude = omega = 1;
					FollowUsed = false;
					CurrCase = Main;
					Targetx = Targety = Mainx = Mainy = Playerx = Playery = Vectx = Vecty = Unitx = Unity = 0;
				}
				localPlayer.boss = obj.objectID;
				obj.state = STATE::WALK;
			}

			break;
		case STATE::FADEIN:
			for (int i = 1; i < jjObjectCount; ++i) {
				jjOBJ@ obj2 = jjObjects[i];
				if (obj2.isActive && obj2.eventID != 122 && obj2 !is obj) //122=lava
					obj2.delete();
			}
			obj.determineCurAnim(DragonAnimSetID, 0);
			obj.state = STATE::FADEOUT;
		case STATE::FADEOUT:
			if (jjGameTicks % 70 == 0)
				jjSample(obj.xPos, obj.yPos, SOUND::DEVILDEVAN_FLAP, 63);
			obj.frameID = jjGameTicks / 14; //slower
			obj.determineCurFrame();
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, obj.justHit == 0 ? SPRITE::NORMAL : SPRITE::SINGLECOLOR, 48);
			break;
		case STATE::WALK: //arbitrarily chosen state

			if (CurrCase != Bilsy)
				obj.determineCurAnim(DragonAnimSetID, 0);
			obj.frameID = jjGameTicks / 7;
			if (jjGameTicks % 35 == 0)
				jjSample(obj.xPos, obj.yPos, SOUND::DEVILDEVAN_FLAP, 63);

			obj.determineCurFrame(); //remember to do this after changing frameID, since by the time you're writing your own behavior, JJ2 won't do it for you anymore
			//look at player
			for (int i = 0; i < jjLocalPlayerCount; i++) {
				jjPLAYER @ p = jjLocalPlayers[i];
				if (obj.xPos < p.xPos) {
					obj.direction = -1;
				}
				if (obj.xPos > p.xPos) {
					obj.direction = 1;
				}
			}
			if (obj.justHit == 0) {
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::NORMAL);
			} else
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::SINGLECOLOR, 48);

			switch (CurrCase) {
			case Main:
				timer++;
				Maintimer++;

				obj.xPos = obj.xOrg + 96 + 10 * 32 * cos((1.2 * timer) / 70);
				obj.yPos = obj.yOrg + 12 * 10 * cos((0.9 * timer) / 70);
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				Mainx = obj.xPos;
				Mainy = obj.yPos;
				Playerx = jjLocalPlayers[0].xPos;
				Playery = jjLocalPlayers[0].yPos;
				if (NextDragonAttacks.isEmpty()) {
					array < int > inbetween = DragonAttacks;
					while (!inbetween.isEmpty()) {
						int index = jjRandom() % inbetween.length;
						NextDragonAttacks.insertLast(inbetween[index]);
						inbetween.removeAt(index);
					}
				}
				if (Maintimer % 350 == 0) {
					jjSamplePriority(SOUND::INTRO_MONSTER);
					if (obj.energy <= 70 && FollowUsed == false)
						CurrCase = FollowShield1;
					else if (obj.energy <= 35) {
						CurrCase = PreFinal;
						jjLocalPlayers[0].showText("@@@@@@@The flames have fallen in love(?) with you!", STRING::MEDIUM);
					} else {
						ChooseAttack(NextDragonAttacks[0]);
						NextDragonAttacks.removeAt(0);
					}
				}
				if (CurrCase == Ram1)
					jjSamplePriority(SOUND::ROCK_ROCK1);
				else if (CurrCase == Elipse1)
					rand = jjRandom() % 2;
				else if (CurrCase == FollowShield1 || CurrCase == PreFinal)
					jjSamplePriority(SOUND::INTRO_MONSTER);

				break;
			case Ram1:
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				if (jjGameTicks % 1 == 0) {
					int bulletID2 = jjAddObject(OBJECT::TOASTERBULLET, obj.xPos, obj.yPos, obj.var[0], CREATOR::LEVEL);
					jjOBJ @ bull2 = jjObjects[bulletID2];
					bull2.xAcc = 0;
					bull2.xSpeed = 0;
					bull2.yAcc = 0;
					bull2.ySpeed = 0;
					bull2.playerHandling = HANDLING::ENEMYBULLET;
					bull2.counterEnd = 140;
				}
				if (GoArc(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Mainx, Mainy, Playerx, Playery, 10, 70) == true) {
					CurrCase = Ram2;
					Playerx = obj.xPos;
					Playery = obj.yPos;
				}
				break;
			case Ram2:
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				if (jjGameTicks % 1 == 0) {
					int bulletID2 = jjAddObject(OBJECT::TOASTERBULLET, obj.xPos, obj.yPos, obj.var[0], CREATOR::LEVEL);
					jjOBJ @ bull2 = jjObjects[bulletID2];
					bull2.xAcc = 0;
					bull2.xSpeed = 0;
					bull2.yAcc = 0;
					bull2.ySpeed = 0;
					bull2.playerHandling = HANDLING::ENEMYBULLET;
					bull2.counterEnd = 140;
				}
				if (GoArc(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Playerx, Playery, Mainx, Mainy, 10, 0) == true)
					CurrCase = Main;
				break;
			case Pheonixx:
				timer++;
				Pheonixtimer++;

				obj.xPos = obj.xOrg + 96 + 10 * 32 * cos((1.2 * timer) / 70);
				obj.yPos = obj.yOrg + 12 * 10 * cos((0.9 * timer) / 70);
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				if ((Pheonixtimer < 5 * 70)) {
					if (Pheonixtimer % 140 == 1) {
						int rx = jjRandom() % 2;
						int ry = jjRandom() % 2;
						int bird = jjAddObject(OBJECT::CHIPS, 62 * 32 + (2 * rx - 1) * 17 * 32, 262.5 * 32 + (2 * 1 - 1) * 28 * 3 + 10, 0);
						jjSamplePriority(SOUND::COMMON_BIRDFLY);
						int bird2 = jjAddObject(OBJECT::CHIPS, 62 * 32 + (2 * ry - 1) * 17 * 32, 262.5 * 32 + (2 * 0 - 1) * 28 * 3 + 10, 0);
					}
				} else {
					CurrCase = Main;
					Pheonixtimer = 0;
				}
				break;
			case Elipse1:
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				if (GoTo(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Mainx, Mainy, 62 * 32 + (2 * rand - 1) * 12 * 32, 263 * 32, 6, 0) == true)
					CurrCase = Elipse2;
				break;
			case Elipse2:
				Elipsetimer++;
				obj.xPos = 62 * 32 + 12 * cos(2.1 * Elipsetimer / 70) * 32 * (2 * rand - 1) / abs(2 * rand - 1);
				obj.yPos = 263 * 32 - 3 * sin(2.1 * Elipsetimer / 70) * 40;
				SpinFireX = obj.xPos;
				SpinFireY = -(obj.yPos - 263 * 32) + 263 * 32;
				if (Elipsetimer % 105 == 1)
					jjSamplePriority(SOUND::INTRO_GREN3);
				if (2.1 * Elipsetimer / 70 >= 2 * 6.28318530) {
					CurrCase = Elipse3;
					Elipsetimer = 0;
					Playerx = obj.xPos;
					Playery = obj.yPos;
				}
				break;

			case Elipse3:
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				if (GoTo(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Playerx, Playery, Mainx, Mainy, 6, 0) == true)
					CurrCase = Main;
				break;
			case Bilsy:
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				timer++;
				Bilsytimer++;
				obj.xPos = obj.xOrg + 96 + 10 * 32 * cos((1.2 * timer) / 70);
				obj.yPos = obj.yOrg + 12 * 10 * cos((0.9 * timer) / 70);
				if (Bilsytimer % 140 == 70) {
					obj.determineCurAnim(DragonAnimSetID, 2);
					obj.determineCurFrame();
					obj.frameID = 0;
					Bilsytimer2 = 0;
				}
				if (Bilsytimer % 140 > 70) {
					obj.frameID = Bilsytimer2 / 7;
					Bilsytimer2++;
				}
				if (Bilsytimer % 140 == 88) {
					jjSamplePriority(SOUND::DEVILDEVAN_DRAGONFIRE);
					jjOBJ @ bullet = jjObjects[obj.fireBullet(OBJECT::BULLET)];
					bullet.determineCurAnim(ANIM::BILSBOSS, 3);
					bullet.animSpeed = 1;
					bullet.behavior = HomingBullet();
					bullet.playerHandling = HANDLING::ENEMYBULLET;
				}
				if (Bilsytimer % 140 < 70 || Bilsytimer % 140 > 98)
					obj.determineCurAnim(DragonAnimSetID, 0);
				if (Bilsytimer >= 420) {
					CurrCase = Main;
					Bilsytimer = 0;
				}
				break;
			case FollowShield1:
				FollowUsed = true;
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;

				if (GoTo(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Mainx, Mainy, 63 * 32, 276 * 32, 7, 0) == true)
					CurrCase = FollowShield2;
				break;
			case FollowShield2:
				Follow += 2;
				omega = 0.5;
				Amplitude = 2;
				if (jjGameTicks % 100 == 0)
					jjSamplePriority(SOUND::COMMON_BURN);
				if ((GoTo(SpinFireX, SpinFireY, SpinFireX, SpinFireY, SpinFireX, SpinFireY, jjLocalPlayers[0].xPos, jjLocalPlayers[0].yPos, 3, 0) || true) && Follow / 70 > 6.14 * 4)
					CurrCase = FollowShield3;

				break;
			case FollowShield3:
				Follow++;
				obj.xPos = 63 * 32;
				obj.yPos = 276 * 32;
				if (GoTo(SpinFireX, SpinFireY, SpinFireX, SpinFireY, SpinFireX, SpinFireY, 63 * 32, 276 * 32, 6, 0) == true)
					CurrCase = FollowShield4;
				break;
			case FollowShield4:
				Follow = 0;
				omega = 1;
				Amplitude = 1;
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				if (GoTo(obj.xPos, obj.yPos, obj.xPos, obj.yPos, 63 * 32, 276 * 32, Mainx, Mainy, 5, 0) == true)
					CurrCase = Main;
				break;

			case PreFinal:
				timer++;
				Pheonixtimer++;
				obj.xPos = obj.xOrg + 96 + 10 * 32 * cos((1.2 * timer) / 70);
				obj.yPos = obj.yOrg + 12 * 10 * cos((0.9 * timer) / 70);
				if (Pheonixtimer > 80)
					CurrCase = Final1;
				break;
			case Final1:
				timer++;
				Bilsytimer++;
				obj.xPos = obj.xOrg + 96 + 10 * 32 * cos((1.2 * timer) / 70);
				obj.yPos = obj.yOrg + 12 * 10 * cos((0.9 * timer) / 70);
				break;
			case Heart1:
				SpinFireX = obj.xPos;
				SpinFireY = obj.yPos;
				Bilsytimer++;
				if (Bilsytimer == 40) {
					jjSamplePriority(SOUND::COMMON_FLAMER);
					for (float i = 0; i < 6; i += 0.1) {
						//old: 98,66
						//new: 61,260
						int fire = jjAddObject(OBJECT::TOASTERBULLET, 62 * 32 + 16 * 8 * sin(i) * sin(i) * sin(i), 244 * 32 - 8 * (13 * cos(i) - 5 * cos(2 * i) - 2 * cos(3 * i) - cos(4 * i)), 0);
						jjOBJ @ fire2 = jjObjects[fire];
						fire2.ySpeed = 10;
						fire2.xSpeed = 0;
						fire2.yAcc = 0;
						fire2.xAcc = 0;
						fire2.playerHandling = HANDLING::ENEMYBULLET;
						fire2.counterEnd = 244;
					}
				}
				if (Bilsytimer == 100) {
					jjSamplePriority(SOUND::COMMON_FLAMER);
					for (float i = 0; i < 6; i += 0.1) {
						int fire = jjAddObject(OBJECT::TOASTERBULLET, 73 * 32 + 16 * 8 * sin(i) * sin(i) * sin(i), 244 * 32 - 8 * (13 * cos(i) - 5 * cos(2 * i) - 2 * cos(3 * i) - cos(4 * i)), 0);
						jjOBJ @ fire2 = jjObjects[fire];
						fire2.ySpeed = 14;
						fire2.xSpeed = 0;
						fire2.yAcc = 0;
						fire2.xAcc = 0;
						fire2.playerHandling = HANDLING::ENEMYBULLET;
						fire2.counterEnd = 244;
						int fire3 = jjAddObject(OBJECT::TOASTERBULLET, 53 * 32 + 16 * 8 * sin(i) * sin(i) * sin(i), 244 * 32 - 8 * (13 * cos(i) - 5 * cos(2 * i) - 2 * cos(3 * i) - cos(4 * i)), 0);
						jjOBJ @ fire4 = jjObjects[fire3];
						fire4.ySpeed = 14;
						fire4.xSpeed = 0;
						fire4.yAcc = 0;
						fire4.xAcc = 0;
						fire4.playerHandling = HANDLING::ENEMYBULLET;
						fire4.counterEnd = 224;
					}
				}
				if (Bilsytimer > 120) {
					CurrCase = Main;
					Bilsytimer = 0;
				}
				break;

			}

			break;
		case STATE::FREEZE:
			if (obj.freeze > 0) {
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::FROZEN);
				obj.freeze -= 4;
			}
			if (obj.freeze < 4) {
				obj.unfreeze(0);
				obj.state = obj.oldState;
			}
			break;
		}
	}

	void onDraw(jjOBJ @ obj) override {
		if (obj.state == STATE::DONE) //hearts
			BL18::Enemy::onDraw(obj);
	}
	bool onObjectHit(jjOBJ @ obj, jjOBJ @ bullet, jjPLAYER @ player, int force) override {
		obj.energy = obj.special / DragonHealthMultiplier;
		BL18::Enemy::onObjectHit(obj, bullet, player, force);
		if (obj.energy <= 0 && BL18::CurrentPopup is null) {
			@BL18::CurrentPopup = FinalEndScene();
			//BL18::Player.xPos = 16;
			//BL18::Player.yPos = jjLayerHeight[4] * 32 - 16;
			player.shieldTime = 0;
		} else {
			obj.special -= (obj.special / DragonHealthMultiplier - obj.energy);
			obj.energy = obj.special / DragonHealthMultiplier;
		}
		return true;
	}

}

void SpinFire(jjOBJ @ obj) {
	obj.playerHandling = HANDLING::ENEMYBULLET;
	obj.determineCurAnim(ANIM::AMMO, 14, true);
	if (CurrCase != Final1) {
		jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 14, (jjGameTicks / 7) % 8, 256 + int((512 / 3.14) * atan2(-SpinFireY + obj.yPos, SpinFireX - obj.xPos)));
		switch (int((obj.xOrg / 32)) % 3) {
		case 0:
			{
				obj.xPos = SpinFireX + ((sin(0.5 * Follow / 70)) + 1) * Amplitude * 70 * jjSin(int((-jjGameTicks) * 20 * omega));
				obj.yPos = SpinFireY + ((sin(0.5 * Follow / 70)) + 1) * Amplitude * 70 * jjCos(int((-jjGameTicks) * 20 * omega));
				break;
			}
		case 1:
			{
				obj.xPos = SpinFireX + ((sin(0.5 * Follow / 70)) + 1) * Amplitude * 70 * jjSin(int((-jjGameTicks - 85 - 85) * 20 * omega));
				obj.yPos = SpinFireY + ((sin(0.5 * Follow / 70)) + 1) * Amplitude * 70 * jjCos(int((-jjGameTicks - 85 - 85) * 20 * omega));
				break;
			}
		case 2:
			{
				obj.xPos = SpinFireX + ((sin(0.5 * Follow / 70)) + 1) * Amplitude * 70 * jjSin(int((-jjGameTicks - 85 - 85 - 85 - 85) * 20 * omega));
				obj.yPos = SpinFireY + ((sin(0.5 * Follow / 70)) + 1) * Amplitude * 70 * jjCos(int((-jjGameTicks - 85 - 85 - 85 - 85) * 20 * omega));
				break;
			}

		}
	} else {
		switch (int((obj.xOrg / 32)) % 3) {

		case 0:
			{
				if (Bilsytimer % 210 == 0) {
					Playerx = jjLocalPlayers[0].xPos;
					Playery = jjLocalPlayers[0].yPos;
					Mainx = obj.xPos;
					Mainy = obj.yPos;
					jjSamplePriority(SOUND::DEVILDEVAN_DRAGONFIRE);
				}
				if (Bilsytimer % 210 < 70) {
					jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 14, (jjGameTicks / 7) % 8, int(atan2(-Unity, Unitx) * (512.f * 0.318309886142228f)));
					if (GoTo(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Mainx, Mainy, Playerx, Playery, 7, 150) == true)
						//Bilsytimer=263;
						Pheonixtimer = 0;
				} else
					jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 14, (jjGameTicks / 7) % 8, int(atan2(-(jjLocalPlayers[0].yPos - obj.yPos), jjLocalPlayers[0].xPos - obj.xPos) * (512.f * 0.318309886142228f)));
				break;
			}
		case 1:
			{
				if (Bilsytimer % 210 == 70) {
					Playerx = jjLocalPlayers[0].xPos;
					Playery = jjLocalPlayers[0].yPos;
					Mainx = obj.xPos;
					Mainy = obj.yPos;
					jjSamplePriority(SOUND::DEVILDEVAN_DRAGONFIRE);
				}
				if (Bilsytimer % 210 < 140 && Bilsytimer % 210 > 70) {
					jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 14, (jjGameTicks / 7) % 8, int(atan2(-Unity, Unitx) * (512.f * 0.318309886142228f)));
					if (GoTo(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Mainx, Mainy, Playerx, Playery, 7, 150) == true)
						//	Bilsytimer=139;
						Pheonixtimer = 0;
				} else
					jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 14, (jjGameTicks / 7) % 8, int(atan2(-(jjLocalPlayers[0].yPos - obj.yPos), jjLocalPlayers[0].xPos - obj.xPos) * (512.f * 0.318309886142228f)));
				break;
			}
		case 2:
			{
				if (Bilsytimer % 210 == 140) {
					Playerx = jjLocalPlayers[0].xPos;
					Playery = jjLocalPlayers[0].yPos;
					Mainx = obj.xPos;
					Mainy = obj.yPos;
					jjSamplePriority(SOUND::DEVILDEVAN_DRAGONFIRE);
				}
				if (Bilsytimer % 210 > 140) {
					jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 14, (jjGameTicks / 7) % 8, int(atan2(-Unity, Unitx) * (512.f * 0.318309886142228f)));
					if (GoTo(obj.xPos, obj.yPos, obj.xPos, obj.yPos, Mainx, Mainy, Playerx, Playery, 7, 150) == true)
						//Bilsytimer=209;
						Pheonixtimer = 0;
				} else
					jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 14, (jjGameTicks / 7) % 8, int(atan2(-(jjLocalPlayers[0].yPos - obj.yPos), jjLocalPlayers[0].xPos - obj.xPos) * (512.f * 0.318309886142228f)));
				break;
			}
		}
	}

}

class HomingBullet: jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ @ obj) {
		obj.behave(BEHAVIOR::BILSYBULLET);

		if (obj.counter > 70) obj.counter = 1;
		for (int i = 1; i < jjObjectCount; i++) {
			if (jjObjects[i].playerHandling == HANDLING::PLAYERBULLET && jjObjects[i].doesCollide(obj, true)) {
				jjObjects[i].state = STATE::EXPLODE;
			}
		}
	}
}
void ChooseAttack(int idx) {
	switch (idx) {
	case 0:
		CurrCase = Ram1;
		break;
	case 1:
		CurrCase = Pheonixx;
		break;
	case 2:
		CurrCase = Elipse1;
		break;
	case 3:
		CurrCase = Bilsy;
		break;
	case 4:
		CurrCase = Heart1;
		break;
	}
}

bool GoTo(float objx1, float objy1, float & out objx, float & out objy, float Startx, float Starty, float Endx, float Endy, float Speed, float Behind) {
	float Vectx = Endx - Startx;
	float Vecty = Endy - Starty;
	Unitx = Vectx / sqrt(Vectx * Vectx + Vecty * Vecty);
	Unity = Vecty / sqrt(Vectx * Vectx + Vecty * Vecty);
	objx1 += Unitx * Speed;
	objy1 += Unity * Speed;
	objx = objx1;
	objy = objy1;
	if ((Endx + Behind * Unitx - objx1) * (Endx + Behind * Unitx - objx1) + (Endy + Behind * Unity - objy1) * (Endy + Behind * Unity - objy1) < (Speed * 1.1 + 3) * (Speed * 1.1 + 3))
		return true;
	else return false;
}
bool GoArc(float objx1, float objy1, float & out objx, float & out objy, float Startx, float Starty, float Endx, float Endy, float Speed, float Behind) {
	float Vectx1 = Endx - Startx;
	float Vecty1 = Endy - Starty;
	float Unitx1 = Vectx1 / sqrt(Vectx1 * Vectx1 + Vecty1 * Vecty1);
	float Unity1 = Vecty1 / sqrt(Vectx1 * Vectx1 + Vecty1 * Vecty1);
	Vectx = (Endx + Behind * Unitx1 + Startx) / 2 - objx1;
	Vecty = (Endy + Behind * Unity1 + Starty) / 2 - objy1;
	Unitx = -Vecty / sqrt(Vectx * Vectx + Vecty * Vecty);
	Unity = Vectx / sqrt(Vectx * Vectx + Vecty * Vecty);
	objx1 += Unitx * Speed;
	objy1 += Unity * Speed;
	objx = objx1;
	objy = objy1;
	if ((Endx + Behind * Unitx1 - objx1) * (Endx + Behind * Unitx1 - objx1) + (Endy + Behind * Unity1 - objy1) * (Endy + Behind * Unity1 - objy1) < (Speed * 3) * (Speed * 3))
		return true;
	else return false;
}

void onFunction11() {

	Bilsytimer2 = Prevframe = Bilsytimer = rand = Elipsetimer = Pheonixtimer = timer = Maintimer = 0;
	Follow = 0;
	Final = 0;
	Amplitude = omega = 1;
	FollowUsed = false;
	CurrCase = Main;
	Mainx = Mainy = Playerx = Playery = 0;

}
	 
void onFunction12(jjPLAYER@ play) {
	play.activateBoss();
	jjMusicLoad("boss.j2b");
}

class TeamworkCutscene : BL18::Conversation {
	uint Counter = 0;
	uint TimeSpentShowingConversation = 0;
	uint NumberOfFriendsAdded = 0;
	float BossX, BossY;
	bool FinalPhase = false;
	TeamworkCutscene() {
		super(Conversations[0], 0, 0);
		jjOBJ@ dragon = jjObjects[BL18::Player.boss];
		const int maxX = jjLayerWidth[4] * 32 - jjResolutionWidth/2, maxY = jjLayerHeight[4] * 32 - jjResolutionHeight/2;
		if (dragon.xPos > maxX)
			dragon.xPos = maxX;
		if (dragon.yPos > maxY)
			dragon.yPos = maxY;
		BossX = dragon.xPos;
		BossY = dragon.yPos;
		BL18::Player.cameraFreeze(BossX,BossY, true, false);
		jjMusicLoad("Zombies.it");
	}
	bool Do() override {
		BL18::Player.shieldTime = 40*70;
		BL18::Player.shieldType = SHIELD::PLASMA;
		if (TimeSpentShowingConversation > 0) {
			if (--TimeSpentShowingConversation == 0 && FriendID == 0) {
				FinalPhase = true;
				Counter = 0;
				for (uint i = jjObjectCount; --i > 0;) {
					jjOBJ@ obj2 = jjObjects[i];
					if (obj2.behavior == AirboardFriend)
						obj2.state = STATE::FIRE;
				}
			}
			if (CharacterCount < Line.length) {
				CharacterCount += 1;
				jjSamplePriority(SOUND::MENUSOUNDS_TYPE);
			}
		}
		const uint periodBetweenFriends = 260;
		++Counter;
		if (!FinalPhase) {
			const uint currentMoment = Counter % periodBetweenFriends;
			if (currentMoment == 10) {
				++NumberOfFriendsAdded;
				if (NumberOfFriendsAdded < Conversations.length) {
					jjOBJ@ friend = jjObjects[jjAddObject(OBJECT::PRETZEL, BossX,BossY, NumberOfFriendsAdded, CREATOR::OBJECT, AirboardFriend)];
					const uint angle = NumberOfFriendsAdded * (1024 / BL18::FriendNames.length);
					friend.xPos = BossX + jjSin(angle) * 240;
					friend.yPos = BossY - jjCos(angle) * 200 - 400;
					friend.direction = (friend.xPos > friend.xOrg) ? -1 : 1;
					friend.var[0] = -int(angle) + 256;
					friend.xSpeed = jjSin(angle) * -5;
					friend.ySpeed = jjCos(angle) * 5;
				}
			}
		} else {
			if (Counter == 300)
				BL18::Player.lighting = 200;
			else if (Counter == 500) {
				BL18::Player.shieldTime = 0;
				@BL18::CurrentPopup = FinalEndScene();
			}
		}
		return true;
	}
	void Draw(jjCANVAS@ canvas) const override {
		if (TimeSpentShowingConversation != 0)
			Conversation::Draw(canvas);
	}
	void SetConversation(int conversationID) {
		TimeSpentShowingConversation = 210;
		@Lines = Conversations[conversationID];
		LineID = 0;
		CharacterCount = 0;
		FriendID = conversationID % (Conversations.length - 1);
		ParseLine();
	}
	//bool DrawHUD() const override { return true; }
}

void AirboardFriend(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.special = obj.creatorID % BL18::FriendSpaz.length;
		obj.determineCurAnim(BL18::FriendSpaz[obj.special] ? ANIM::SPAZ : ANIM::JAZZ, RABBIT::AIRBOARD);
		obj.state = STATE::FALL;
		obj.doesHurt = BL18::FirstFriendPlayerID + obj.special; //fur
		obj.animSpeed = jjGetStringWidth("§1" + BL18::FriendNames[obj.special], STRING::SMALL, STRING::NORMAL) / 2;
		obj.lightType = LIGHT::PLAYER;
		obj.light = 13;
		return;
	} else if (obj.state == STATE::FALL) {
		if (obj.counter++ < 100)
			obj.yPos += 4;
		else {
			cast<TeamworkCutscene>(BL18::CurrentPopup).SetConversation(obj.creatorID);
			obj.state = STATE::IDLE;
		}
	} else if (obj.state == STATE::FIRE && BL18::Player.shieldTime > 0) {
		if (++obj.counter % 35 == 0) {
			jjSample(obj.xPos,obj.yPos, SOUND::AMMO_GUNJAZZ);
			jjOBJ@ bullet = jjObjects[obj.fireBullet(OBJECT::BLASTERBULLET)];
			bullet.behavior = CircularFiringSquad;
			bullet.xSpeed = obj.xSpeed;
			bullet.ySpeed = obj.ySpeed;
			bullet.special = obj.var[0];
		}
	}
	obj.frameID = ++obj.age >> 3;
	jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.determineCurFrame(), obj.direction, obj.age & 7 < 4 ? SPRITE::PLAYER : SPRITE::TRANSLUCENTPLAYER, obj.doesHurt, 4);
	jjDrawString(obj.xPos - obj.animSpeed, obj.yPos - 36, "§1" + BL18::FriendNames[obj.special], STRING::SMALL,STRING::NORMAL,0, 3);
}

void CircularFiringSquad(jjOBJ@ obj) {
	if (++obj.counter < 37) {
		obj.xPos += obj.xSpeed;
		obj.yPos += obj.ySpeed;
		jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.special);
	} else {
		obj.curAnim = obj.killAnim;
		obj.behavior = BEHAVIOR::EXPLOSION;
		if (obj.objectID & 7 == 0) {
			jjOBJ@ dragon = jjObjects[BL18::Player.boss];
			dragon.energy -= 1;
			dragon.justHit = 5;
		}
	}
}