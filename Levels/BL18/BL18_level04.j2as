void onFunction11() { //entering the chasm... changes can be made permanently, no (significant) time will be spent above-ground after this.
	if (jjMusicLoad("nr-underthine.it"))
		BL18::musicFilename = jjMusicFileName;
	BL18::Recolor(jjAnimations[jjAnimSets[ANIM::VINE]+1], array<uint8>={16}, BL18::RecolorReplace(80));
}
void onFunction12(jjPLAYER@ play) {
	if (play.health < jjMaxHealth) {
		play.health = jjMaxHealth;
		jjSample(play.xPos, play.yPos, SOUND::JAZZSOUNDS_JUMMY);
	}
	if (BL18::IsMurderer) {
		BL18::IsMurderer = false;
		jjMusicLoad(BL18::musicFilename);
		MLLE::Palette.apply();
	}
}
uint8 spikeVineWarpTargetID = 50;
void onFunction13(jjPLAYER@, uint8 warpID) {
	spikeVineWarpTargetID = warpID;
}
void onFunction14(jjPLAYER@ play) {
	play.warpToID(spikeVineWarpTargetID);
}
void TurnOnTriggerThirty() {
	BL18::SavedTriggers[30] = true;
	onFunction2(null, 30);
	GrailFound = false;
}

const string FireIceClue = "- The Alfr Seeress' Prophecy Part VI -@@Some say the world will end in #|||f~ire~,@Some say in #||||i~ce~.@From what I've tasted of desire@I hold with those who favor #|||f~ire~,@But if it had to perish twice,@I think I know enough of hate@To say that for destruction #||||i~ce~@Is also great@And would suffice.";
array<string> WarpStrings = {
	"Roses will betray you@Roses will betray@Roses will@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses@Roses",
	"\"He's dreaming now,\" said Tweedledee:@\"and what do you think he's dreaming about?\"@@Alice said \"Nobody can guess that.\"@@\"Why, about YOU!\" Tweedledee exclaimed,@clapping his hands triumphantly.@@\"And if he left off dreaming about you,@where do you suppose you'd be?\"",
	"Where once was nature, sits a computer.@@@@@@#A big yellow taxi@came and took away@my old man.",
	"§1Bathe in blood@@@@@   . . . @@@@@@#|||B~ATHE IN BLOOD"
};
void onFunction15(jjPLAYER@ play) {
	play.offsetPosition(((!play.antiGrav ? 194 : 198)-80) * 32,0);
	if (play.antiGrav) play.yPos = 131*32;
	play.showText("@@@@@@" + (play.antiGrav ? "#Thank you for bathing in blood!" : (WarpStrings.length == 2 && !TreeAttacked) ? FireIceClue : WarpStrings[0]));
	if (WarpStrings.length > 1) {
		if (WarpStrings.length > 2 || TreeAttacked) {
			WarpStrings.removeAt(0);
			if (WarpStrings.length == 1)
				jjTriggers[11] = false; //reveal password monitors
		} else if (play.ammo[WEAPON::ICE] == 0 && play.ammo[WEAPON::TOASTER] == 0) {
			play.ammo[WEAPON::ICE] = 3;
			jjSample(play.xPos, play.yPos, SOUND::COMMON_PICKUPW1);
		}
	}
}

void onFunction16(jjPLAYER@ play) {
	play.offsetPosition(-58*32, -5*32);
	if (PlayerRoom.ID != 54)
		play.noclipMode = false;
	else
		play.antiGrav = false;
	if (BL18::IsMurderer)
		play.hurt(1, true);
	jjEventSet(30,14, 0); //delete spotty
}

void onFunction17(jjPLAYER@ play) {
	play.offsetPosition(0, (149-179)*32);
}

void onFunction18() {
	jjParameterSet(166,175,0,5,10);
}

void onFunction19(jjPLAYER@ play) {
	for (uint i = jjObjectCount; --i > 0;) {
		jjOBJ@ cow = jjObjects[i];
		if (cow.eventID == OBJECT::MILK && cow.state == STATE::START && cow.isActive) {
			play.bossActivated = true;
			play.boss = i;
			jjMusicLoad("boss.j2b");
			cow.state = STATE::FLY;
		}
	}
}

void onFunction20() {
	jjTileSet(4, 517,26, jjWaterLevel < 30*32 ? 9 : 0);
}

void onFunction21(int8 rockID) { //activate basketball, at a distance
	for (uint i = jjObjectCount; --i > 0;) {
		jjOBJ@ rock = jjObjects[i];
		if (rock.eventID == OBJECT::ROTATINGROCK && rock.isActive && rock.var[3] == rockID) {
			rock.xPos = rock.xOrg;
			rock.yPos = rock.yOrg;
			rock.counter = 0;
			rock.state = STATE::ACTION;
		}
	}
}

bool last22 = true;
void onFunction22(jjPLAYER@ play, bool activate) {
	if (BNBeaten) activate = false;
	if (activate != last22) {
		const uint16 tileID = activate ? 55 : 0;
		jjTileSet(4, 319,106, tileID);
		jjTileSet(4, 352,101, tileID);
		play.bossActivated = activate;
		if (activate)
			jjMusicLoad("benjamins_rock.s3m");
		else
			jjMusicLoad(BL18::musicFilename);
		last22 = activate;
	}
}

void onFunction23(jjPLAYER@ play, bool active) {
	if (active) {
		if (BL18::CurrentPopup is null) {
			@BL18::CurrentPopup = NullPopup(true);
			play.showText(7, 0);
		}
	} else
		@BL18::CurrentPopup = null;
}

void onFunction24() {
	BL18::SavedTriggers[14] = true;
	for (uint i = jjObjectCount; --i > 0;) {
		jjOBJ@ enemy = jjObjects[i];
		if (enemy.behavior == MyTufBoss)
			enemy.delete();
	}
}