const uint TimeTarget = 5500;
void onLevelLoad() {
	TrueColor::EnableCaching();
	BL18::Setup();
	@BL18::myLevelReload = RefreshStatsAfterBoss;
	@BL18::myCoinWarpFunction = TurnOnTriggerThirty;
	@BL18::myHUD = DrawMapWhenPressingTab;
	
	BN(jjObjectPresets[OBJECT::MORPH]);
	Cow(jjObjectPresets[OBJECT::MILK]);
	
	jjObjectPresets[OBJECT::FIVEHUNDREDBUMP].behavior = GemBumper;
	jjObjectPresets[OBJECT::FIVEHUNDREDBUMP].killAnim = jjObjectPresets[OBJECT::SPIKEBOLL].killAnim; //chain size
	jjObjectPresets[OBJECT::FIVEHUNDREDBUMP].xAcc = -1;
	jjObjectPresets[OBJECT::FIVEHUNDREDBUMP].deactivates = false;
	
	if (jjAnimSets[ANIM::DEVILDEVAN] != 0)
		BloodDemon(jjObjectPresets[OBJECT::DEVILDEVAN]);
	
	if (jjAnimSets[ANIM::GRASSPLAT]!=0) {
		BL18::Recolor(jjAnimations[jjAnimSets[ANIM::GRASSPLAT]], array<uint8>={40}, BL18::RecolorReplace(63));
		jjObjectPresets[OBJECT::GRASSPLATFORM].deactivates = false;
		jjObjectPresets[OBJECT::GRASSPLATFORM].behavior = DoublePlatform;
	}
	
	if (jjAnimSets[ANIM::PINKPLAT]!=0) {
		for (int i = 0; i < 2; ++i)
			BL18::Recolor(jjAnimations[jjAnimSets[ANIM::PINKPLAT] + i], array<uint8>={88}, BL18::RecolorReplace(152));
		jjObjectPresets[OBJECT::PINKPLATFORM].deactivates = false;
		jjObjectPresets[OBJECT::PINKPLATFORM].behavior = DoublePlatform;
	}
	
	array<string> inbetween = ShortcutNames;
	array<uint> newIndices = {0};
	while (newIndices.length < ShortcutNames.length)
		newIndices.insertAt(jjRandom() % newIndices.length, newIndices.length);
	for (uint i = 0; i < ShortcutNames.length; ++i)
		ShortcutNames[i] = inbetween[newIndices[i]];
	for (uint i = 0; i < 4; ++i)
		Conversations[5 + i][1] += ShortcutNames[i];
	//for (uint i = 4; i < 6; ++i)
	//	jjDebug(ShortcutNames[i]);
		
	GenerateShortcutList();
	
	FirstShortcutFrame = jjAnimations[jjAnimSets[TrueColor::FindCustomAnim()].allocate(array<uint>={ShortcutNames.length})];
	for (uint i = 0; i < ShortcutNames.length; ++i) {
		jjPIXELMAP(newIndices[i]*64, 8*32, 64, 96, 5).save(jjAnimFrames[FirstShortcutFrame+i]);
	}
	DesktopPalette.load("bndesktop82405.j2t");
	
	jjObjectPresets[OBJECT::SWINGINGVINE].behavior = SyncedVine;
	jjObjectPresets[OBJECT::BRIDGE].behavior = BridgeWhenYourGravityIsNormal;
	
	jjObjectPresets[OBJECT::CARROTBUMP].determineCurAnim(ANIM::BAT, 0);
	jjObjectPresets[OBJECT::CARROTBUMP].frameID = 4;
	jjObjectPresets[OBJECT::CARROTBUMP].determineCurFrame();
	jjObjectPresets[OBJECT::CARROTBUMP].playerHandling = HANDLING::PARTICLE;
	jjObjectPresets[OBJECT::CARROTBUMP].behavior = Batform;
	jjObjectPresets[OBJECT::CARROTBUMP].ySpeed = -1;
	
	jjObjectPresets[OBJECT::BUBBLER].behavior = Portal();
	jjObjectPresets[OBJECT::BUBBLER].playerHandling = HANDLING::PARTICLE;
	jjObjectPresets[OBJECT::BUBBLER].curFrame = jjObjectPresets[OBJECT::MILK].curFrame;
	jjObjectPresets[OBJECT::BUBBLER].light = 1;
	jjObjectPresets[OBJECT::BUBBLER].lightType = LIGHT::FLICKER;
	
	jjObjectPresets[OBJECT::RFAMMO15].behavior = PasswordMonitor();
	jjObjectPresets[OBJECT::RFAMMO15].deactivates = false;
	jjObjectPresets[OBJECT::RFAMMO15].playerHandling = HANDLING::PARTICLE;
	jjObjectPresets[OBJECT::RFAMMO15].light = 6;
	jjObjectPresets[OBJECT::RFAMMO15].lightType = LIGHT::BRIGHT;
	
	jjObjectPresets[OBJECT::ICEAMMO15].behavior = QuestionMarkBlock();
	jjObjectPresets[OBJECT::ICEAMMO15].playerHandling = HANDLING::PICKUP;
	jjObjectPresets[OBJECT::ICEAMMO15].scriptedCollisions = true;
	
	if (jjDifficulty > 0) {
		jjObjectPresets[OBJECT::SPIKEBOLL].energy = 0; //unkillable
		jjObjectPresets[OBJECT::SPIKEBOLL].deactivates = false;
		if (jjDifficulty > 1)
			jjObjectPresets[OBJECT::SPIKEBOLL].behavior = DoublePlatform;
		for (int i = 0; i < 2; ++i) {
			const jjANIMATION@ anim = jjAnimations[jjAnimSets[ANIM::SPIKEBOLL] + i];
			BL18::Recolor(anim, array<uint8>={72}, BL18::RecolorReplace(80));
			BL18::Recolor(anim, array<uint8>={24,48}, BL18::RecolorReplace(152));
		}
	} else
		jjObjectPresets[OBJECT::SPIKEBOLL].behavior = BEHAVIOR::INACTIVE; //no spike bolls on easy
	
	jjObjectPresets[OBJECT::EXTRATIME].behavior = FieldName;
	jjObjectPresets[OBJECT::EXTRATIME].playerHandling = HANDLING::PARTICLE;
	
	jjObjectPresets[OBJECT::TNTDESTRUCTSCENERY].behavior = FireOrIce;
	
	jjObjectPresets[OBJECT::FASTFEET].behavior = MarioPlatform;
	jjObjectPresets[OBJECT::FASTFEET].playerHandling = HANDLING::PARTICLE;
	{
		jjANIMFRAME@ marioFrame = jjAnimFrames[jjObjectPresets[OBJECT::FASTFEET].curFrame];
		jjPIXELMAP(1*32 - 8, 111*32 + 12, 96 + 8*2, 8, 5).save(marioFrame);
		marioFrame.hotSpotX = int(marioFrame.width) / -2;
		marioFrame.hotSpotY = -4;
	}
	
	jjObjectPresets[OBJECT::TUFBOSS].determineCurAnim(ANIM::TUFBOSS, 5);
	jjObjectPresets[OBJECT::TUFBOSS].determineCurFrame();
	jjObjectPresets[OBJECT::TUFBOSS].direction = -1;
	jjObjectPresets[OBJECT::TUFBOSS].behavior = MyTufBoss;
	
	jjObjectPresets[OBJECT::ONEUPCRATE].behavior = GemColorWall;
	jjObjectPresets[OBJECT::ONEUPCRATE].playerHandling = HANDLING::PARTICLE;

	jjObjectPresets[OBJECT::ROTATINGROCK].behavior = Basketball();
	jjObjectPresets[OBJECT::ROTATINGROCK].scriptedCollisions = true;
	jjObjectPresets[OBJECT::ROTATINGROCK].deactivates = true;
	jjObjectPresets[OBJECT::ROTATINGROCK].curFrame = jjAnimations[jjAnimSets[ANIM::ROCK].load(BL18::AnimSets::Basketball, "BL18.j2a")];
	
	//jjObjectPresets[OBJECT::LIME].behavior = WarpSpikes();
	
	if (jjDifficulty == 0)
		jjEventSet(115,82, 0); //friend introducing smart bombs
	
	//for (int i = 32; i < 256; ++i)
	//	jjObjectPresets[i].deactivates = false;
	
	{
		jjANIMFRAME@ mapFrame = jjAnimFrames[MapFrameID];
		mapFrame.hotSpotX = 0;
		mapFrame.hotSpotY = 0;
	}
	
	for (int x = 0; x < jjLayerWidth[4]; ++x)
		for (int y = 0; y < jjLayerHeight[4]; ++y)
			if (jjEventGet(x,y) == 32) { //room corner
				const uint roomID = jjParameterGet(x,y, 0,9);
				if (Rooms.length < roomID+1)
					Rooms.resize(roomID+1);
				Rooms[roomID].FoundEvent(x,y);
				Rooms[roomID].ID = roomID;
			} //else if (jjEventGet(x,y) == OBJECT::TRIGGERSCENERY || jjEventGet(x,y) == OBJECT::BANANA)
				//jjDebug(jjParameterGet(x,y,0,5) + "");
			
	@BGRotate = jjPIXELMAP(0,0, 256,256, 5);
	@BGWarp = jjPIXELMAP(256,0, 256,256, 5);
	jjUseLayer8Speeds = true;
}

const uint BNFriendID = 9;
int LastFood = 0, LastLives = 0;
bool BNBeaten = false;
void RefreshStatsAfterBoss() {
	if (LastFood != 0 || LastLives != 0)  { //should only be true if you died while fighting the boss, in which case, remove references to killing teh BNs
		BL18::Player.food = LastFood;
		BL18::Player.lives = LastLives;
		LastFood = LastLives = 0;
	}
	@PlayerRoom = null;
	lastSubscreenWidth = lastSubscreenHeight = 0; //force AdjustMaxResolution call
}

class BN : BL18::Enemy {
	array<jjOBJ@> BNs(8, null);
	uint halfNameWidth;
	string name;
	BN(jjOBJ@ preset) {
		super(preset);
		preset.energy = 120; //let's try this
		preset.playerHandling = HANDLING::PARTICLE; //inactive
		preset.isTarget = false;
		//preset.deactivates = false; //except in case of death
		name = BL18::FriendNames[BNFriendID];
		halfNameWidth = jjGetStringWidth("§1" + name, STRING::SMALL, STRING::NORMAL) / 2;
		gender = BL18::Gender::Male;
	}
	void onBehave(jjOBJ@ obj) override {
		if (obj.state == STATE::DEACTIVATE)
			obj.deactivate();
		else if (obj.creatorType == CREATOR::LEVEL) { //health
			if (obj.state == STATE::START) {
				if (BL18::Player.bossActivated) {
					BL18::Player.boss = obj.objectID;
					obj.state = STATE::ACTION;
					LastFood = BL18::Player.food;
					LastLives = BL18::Player.lives;
					for (int i = 0; i < 8; ++i)
						@BNs[i] = jjObjects[jjAddObject(obj.eventID, obj.xPos + (-6 + i * 2) * 32, obj.yPos - (8 * 32), obj.objectID, CREATOR::OBJECT)];
				}
			} else {
				if (obj.counter < 5000 && (obj.counter += (1 + jjDifficulty)) % 600 == 60) {
					jjOBJ@ obj2 = BNs[obj.counter / 600];
					obj2.isTarget = true;
					obj2.state = STATE::FADEIN;
					obj2.determineCurAnim(ANIM::JAZZ, RABBIT::TELEPORTFALL);
					obj2.curFrame = jjAnimations[obj2.curAnim];
					jjSample(obj2.xPos, obj2.yPos, SOUND::COMMON_TELPORT2);
				}
				obj.energy = 0;
				for (uint i = 0; i < 8; ++i) {
					jjOBJ@ obj2 = BNs[i];
					if (cast<jjBEHAVIORINTERFACE>(obj2.behavior) is this)
						obj.energy += obj2.energy;
				}
				if (obj.energy <= 0) {
					obj.delete();
					onFunction22(BL18::Player, false);
					BNBeaten = true;
				}
			}
		} else switch (obj.state) {
			case STATE::START:
				obj.energy = jjObjectPresets[obj.eventID].energy / 8;
				break;
			case STATE::FREEZE:
				if (--obj.freeze == 0)
					obj.state = obj.oldState;
				break;
			case STATE::FADEIN:
				obj.frameID = ++obj.counter >> 2;
				if (obj.frameID >= int(jjAnimations[obj.curAnim].frameCount)) {
					obj.state = STATE::FALL;
					obj.determineCurAnim(ANIM::JAZZ, RABBIT::TELEPORTFALLING);
					obj.frameID = obj.counter = 0;
					obj.playerHandling = HANDLING::SPECIAL;
				} else
					obj.curFrame = jjAnimations[obj.curAnim] + obj.frameID;
				break;
			case STATE::FALL:
				obj.yPos += obj.ySpeed += 0.1;
				if (jjMaskedVLine(int(obj.xPos), int(obj.yPos), 12)) {
					obj.state = STATE::IDLE;
					obj.determineCurAnim(ANIM::JAZZ, RABBIT::STAND);
					obj.curFrame = jjAnimations[obj.curAnim];
					obj.yPos -= 40;
					obj.putOnGround(true);
					obj.yOrg = obj.yPos;
				} else {
					obj.frameID = jjGameTicks >> 3;
					obj.determineCurFrame();
				}
				break;
			case STATE::IDLE:
				if (++obj.counter >= 40 && (jjRandom() & 31 == 0)) {
					obj.state = STATE::WALK;
					obj.determineCurAnim(ANIM::JAZZ, RABBIT::RUN1);
					obj.xSpeed = 0;
					obj.counter = 0;
				}
				break;
			case STATE::WALK:
				if (++obj.counter > 175 && obj.counterEnd == 0 && (jjRandom() & 127 == 0)) {
					obj.state = STATE::FIRE;
					obj.determineCurAnim(ANIM::JAZZ, RABBIT::FIRE);
					obj.lightType = LIGHT::LASER;
					obj.light = 1;
					obj.counter = 0;
					obj.direction = BL18::Player.xPos > obj.xPos ? 1 : -1;
				} else {
					const float acceleration = (BL18::IsMurderer ? 0.08 : 0.05) * (BL18::Player.running ? 1.5 : 1);
					if (BL18::Player.xPos > obj.xPos + 40) {
						obj.xSpeed += acceleration * ((obj.direction == 1) ? 1 : 2);
					} else if (BL18::Player.xPos < obj.xPos - 40) {
						obj.xSpeed -= acceleration * ((obj.direction == -1) ? 1 : 2);
					}
					const float targetX = obj.xPos + obj.xSpeed;
					if (jjMaskedPixel(int(targetX), int(obj.yPos)))
						obj.xSpeed = 0;
					else {
						obj.xPos = targetX;
						obj.direction = (obj.xSpeed > 0) ? 1 : -1;
					}
					if (obj.counterEnd == 0) {
						obj.ySpeed += abs(obj.xSpeed);
						if (abs(obj.xSpeed) >= 0.3) {
							obj.frameID = int(obj.ySpeed) >> 4;
							obj.determineCurFrame();
						} else
							obj.curFrame = jjAnimations[jjAnimSets[ANIM::JAZZ] + RABBIT::STAND];
						if (abs(obj.yPos - BL18::Player.yPos) < 20 && jjRandom() & 255 == 0) {
							obj.counterEnd = 4;
							jjSample(obj.xPos, obj.yPos, SOUND::COMMON_JUMP);
						}
					} else {
						if (obj.counterEnd < 128)
							obj.curFrame = jjAnimations[jjAnimSets[ANIM::JAZZ] + RABBIT::RIGHTJUMP] + (obj.counterEnd >> 4);
						else
							obj.curFrame = jjAnimations[jjAnimSets[ANIM::JAZZ] + RABBIT::RIGHTFALL] + ((jjGameTicks >> 2) % 3);
						obj.yPos = obj.yOrg - jjSin((obj.counterEnd += 4) << 1) * 80;
					}
				}
				break;
			case STATE::FIRE:
				obj.curFrame = jjAnimations[obj.curAnim] + ((jjGameTicks >> 2) & 1);
				if (++obj.counter > 70) {
					jjOBJ@ laser = jjObjects[jjAddObject(OBJECT::LASER, obj.xPos, obj.yPos, obj.objectID, CREATOR::OBJECT)];
					laser.playerHandling = HANDLING::ENEMYBULLET;
					laser.xSpeed = obj.direction << 3;
					laser.ySpeed = jjSin((jjGameTicks + (obj.objectID << 2)) << 5);
					if (laser.ySpeed == 0.f) laser.ySpeed = 0.0001f; //some weird jj2 thing
					if (obj.counter > 80 && abs(atan2(laser.ySpeed, laser.xSpeed) - atan2(BL18::Player.yPos - obj.yPos, BL18::Player.xPos - obj.xPos)) < 0.1)
						BL18::Player.hurt(BL18::IsMurderer ? 2 : 1);
					obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::AMMO_LASER,obj.doesHurt);
					if (obj.counter >= 140) {
						obj.state = STATE::IDLE;
						obj.determineCurAnim(ANIM::JAZZ, RABBIT::STAND);
						obj.curFrame = jjAnimations[obj.curAnim];
						obj.counter = 0;
						obj.lightType = LIGHT::NONE;
					}
				} else
					obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::COMMON_SHIELD4,obj.doesHurt);
				
				break;
		}
	}
	void onDraw(jjOBJ@ obj) override {
		if ((obj.creatorType == CREATOR::OBJECT) && (obj.state != STATE::START)) {
			if (obj.freeze == 0 && obj.justHit == 0) {
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::PLAYER, BL18::FirstFriendPlayerID + BNFriendID);
				if (obj.state == STATE::DONE) {
					jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::TRANSLUCENTCOLOR, 48);
					drawHearts(obj);
				}
			} else
				Enemy::onDraw(obj); //meh
			jjDrawString(obj.xPos - halfNameWidth, obj.yPos - 36, (obj.state == STATE::DONE ? "§1||||" : "§1") + name);
		}
	}
}

int LastGemGravityReverse = 0;
void GemBumper(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.var[8] = FindRoom(obj.xOrg, obj.yOrg).ID;
		obj.special = ((Rooms[obj.var[8]].LastGemColor += 1) %= 3);
		const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
		if (jjParameterGet(xTile,yTile, 8,4) != 0) {
			obj.behave(BEHAVIOR::PLATFORM, false);
			obj.var[9] = obj.var[0];
			obj.var[10] = obj.counter;
			if ((obj.age = jjParameterGet(xTile,yTile, -2, 1)) == 1 && obj.creatorType == CREATOR::LEVEL) { //mobile quad
				obj.lightType = LIGHT::NONE;
				int sync = jjParameterGet(xTile,yTile, 0, 2);
				for (int i = 0; i < 3; ++i) {
					jjParameterSet(xTile, yTile, 0,2, (sync += 1) &= 3);
					jjAddObject(obj.eventID, obj.xOrg, obj.yOrg);
				}
			}
		} else
			obj.deactivates = true;
		obj.xAcc = obj.xOrg;
		obj.state = STATE::SLEEP;
	} else if (obj.state == STATE::ACTION) {
		jjPLAYER@ hitPlayer = jjPlayers[obj.var[0]];
		hitPlayer.buttstomp = 121;
		hitPlayer.specialMove = 0;
		obj.special = (obj.special + 1) % 3;
		/*if (PlayerRoom.Type == RoomTypes::Dethjump && jjGameTicks-LastGemGravityReverse > 10) {
			hitPlayer.antiGrav = !hitPlayer.antiGrav;
			hitPlayer.ySpeed = 0;
			jjSetLayerYSpeed(8, hitPlayer.antiGrav ? 1 : -1, true);
			LastGemGravityReverse = jjGameTicks;
		}*/
	} else if (obj.state == STATE::DEACTIVATE) {
		if (obj.xAcc > 0)
			obj.xOrg = obj.xAcc;
		obj.deactivate();
		return;
	}
	
	obj.behave(BEHAVIOR::BUMP, false);
	//if (PlayerRoom.Type == RoomTypes::VutxfyCaves) {
		if (obj.var[2] != 0) {
			const auto realState = obj.state;
			const auto realVar0 = obj.var[0];
			const auto realCounter = obj.counter;
			obj.var[0] = obj.var[9];
			obj.counter = obj.var[10];
			obj.eventID = OBJECT::SPIKEBOLL; //can't be stood upon
			obj.state = STATE::ACTION;
			obj.behave(BEHAVIOR::PLATFORM, false);
			obj.eventID = OBJECT::FIVEHUNDREDBUMP; //don't hurt when touched
			obj.var[9] = obj.var[0];
			obj.var[10] = obj.counter;
			obj.state = realState;
			obj.counter = realCounter;
			obj.var[0] = realVar0;
			
			const float xStep = (obj.xPos - obj.xOrg) / obj.var[2];
			const float yStep = (obj.yPos - obj.yOrg) / obj.var[2];
			float xPos = obj.xOrg, yPos = obj.yOrg;
			for (int i = 0; i < obj.var[2]; ++i, xPos += xStep, yPos += yStep)
				jjDrawResizedSprite(xPos, yPos, ANIM::PICKUPS, 22, obj.frameID, 0.5,0.5, SPRITE::GEM, (obj.special + i) % 3);
			if (obj.age != 0 && PlayerRoom.ID == uint(obj.var[8])) {
				if (jjEventGet(int(obj.xOrg += obj.age) >> 5, int(obj.yOrg) >> 5) == 255)
					obj.age *= -1;
			}
		}
	//}
	jjDrawSprite(obj.xPos, obj.yPos - ((obj.state == STATE::BOUNCE) ? 4 : 0), ANIM::PICKUPS, 34, obj.freeze == 0 ? jjGameTicks>>3 : 0, 1, obj.freeze == 0 ? SPRITE::GEM : SPRITE::FROZEN, obj.special);
}

const uint MapFrameID = jjObjectPresets[OBJECT::SEEKERAMMO15].curFrame; //doesn't particularly matter which sprite so long as it's something otherwise unused
const uint MapMultiplier = 2;
jjPIXELMAP MapImage(jjLayerWidth[4] / MapMultiplier, jjLayerHeight[4] / MapMultiplier);

enum RoomTypes { Hustar, Crossroads, Dethmaze, VutxfyCaves, Dethjump, CrystalFalls, WiseGuru, FalseProphet, Desktop, Zerox };
const array<string> RoomNames = {"Forth", "Charnel Crossroads", "Dethmaze", "Vutxfy Caves", "Dethjump", "Crystal Falls", "Wise Guru`s@@Cathedral"};
const array<uint8> RoomMapColors = {16, 35, 40, 88, 48, 32, 42, 80, 64, 24};
int LastRoomName = -1;
class Room {
	float Top = -1, Bottom, Left, Right;
	uint Width = 0, Height;
	uint ID;
	bool Mapped = false;
	uint LastGemColor = 0;
	RoomTypes Type = RoomTypes(0);
	Room(){}
	void FoundEvent(uint x, uint y) {
		if (Top == -1) { //first
			Left = x*32;
			Top = y*32;
			Type = RoomTypes(jjParameterGet(x,y, 9, 4));
		} else if (Width == 0) { //second
			if (y == 194 && Type == RoomTypes::Dethjump) //bottomless pit
				y = 195;
			Right = (x+1)*32;
			Bottom = (y+1)*32;
			Width = uint(Right-Left);
			Height = uint(Bottom-Top);
			//jjDebug(Left + "," + Top + " to " + Right + "," + Bottom);
			if (Type == 0) //maybe wasn't set by other corner
				Type = RoomTypes(jjParameterGet(x,y, 9, 4));
		} else {
			jjDebug("Invalid room event at " + x + "," + y + "!");
		}
	}
	bool Contains(float x, float y) const {
		return x >= Left && x < Right && y >= Top && y < Bottom;
	}
	bool Map() const {
		if (!Mapped) {
			const uint
				left = uint(Left/32),
				right = uint(Right/32),
				top = uint(Top/32),
				bottom = uint(Bottom/32);
			for (uint x = left; x < right; x += MapMultiplier)
				for (uint y = top; y < bottom; y += MapMultiplier)
					MapImage[x / MapMultiplier,y / MapMultiplier] = jjTileGet(4,x,y) == 0 ? 0 : RoomMapColors[Type];
			MapImage.save(jjAnimFrames[MapFrameID]);
			return Rooms[ID].Mapped = true;
		}
		return false;
	}
}
array<Room> Rooms;
const Room@ PlayerRoom = null;
const Room@ NextPlayerRoom = null;
bool NoRoomAlertSounded = false;
const Room@ FindRoom(float x, float y, const Room@ defaultRoom = null) {
	if (defaultRoom !is null && defaultRoom.Contains(x,y))
		return defaultRoom;
	for (uint i = 0; i < Rooms.length; ++i)
		if (Rooms[i].Contains(x,y))
			return Rooms[i];
	//else...
	if (!NoRoomAlertSounded) {
		NoRoomAlertSounded = true;
		jjDebug("No room found at " + x + "," + y + "!");
	}
	return null;
}

float LastPlayerX, LastPlayerY;
bool goingUpFromRoomTransition = false;
class RoomTransition : BL18::Popup {
	uint LastPlayerCurFrame;
	int LastPlayerDirection; //just in case
	int playerXSpeed = 0, playerYSpeed = 0;
	RoomTransition(){
		const jjPLAYER@ player = BL18::Player;
		LastPlayerX = player.xPos;
		LastPlayerY = player.yPos;
		LastPlayerCurFrame = player.curFrame;
		LastPlayerDirection = player.direction;
		if (player.antiGrav)
			LastPlayerDirection ^= 0x40;
		BL18::Player.spriteMode = SPRITE::INVISIBLE;
		if (PlayerRoom !is null && NextPlayerRoom !is null && player.warpID == 0) {
			if (NextPlayerRoom.Left >= PlayerRoom.Right)
				playerXSpeed = 4;
			else if (NextPlayerRoom.Right <= PlayerRoom.Left)
				playerXSpeed = -4;
			if (NextPlayerRoom.Top >= PlayerRoom.Bottom)
				playerYSpeed = !player.antiGrav ? 2 : -11;
			else if (NextPlayerRoom.Bottom <= PlayerRoom.Top) {
				playerYSpeed = !player.antiGrav ? -11 : 2;
			}
		}
		jjSample(player.xPos, player.yPos, SOUND::COMMON_ITEMTRE, 63, 7000);
	}
	
	int counter = 248;
	bool Do() {
		jjPLAYER@ player = BL18::Player;
		player.xPos = LastPlayerX;
		player.yPos = LastPlayerY;
		if ((counter -= 8) == 0) { //moment of maximum opacity: do all loading here
			if (PlayerRoom.ID == 70 && player.warpID == 0) {//Type == RoomTypes::Dethmaze) {
				LastPlayerX = PlayerRoom.Left + (PlayerRoom.Right - PlayerRoom.Left) / 2;
				LastPlayerY = PlayerRoom.Top + (PlayerRoom.Bottom - PlayerRoom.Top) / 2 - 20;
				LastPlayerCurFrame = jjAnimations[jjAnimSets[ANIM::JAZZ] + RABBIT::STAND];
				playerXSpeed = playerYSpeed = 0;
				@NextPlayerRoom = @PlayerRoom;
				for (int i = 1; i <= 4; ++i) {
					const uint rand = jjRandom() % 3;
					MLLE::GetLayer("DM " + i + "G").hasTiles = (rand == 1);
					MLLE::GetLayer("DM " + i + "B").hasTiles = (rand == 2);
				}
				if (
					(NextDethmazeDir == DMD::Right && player.xPos > LastPlayerX+128) ||
					(NextDethmazeDir == DMD::Left && player.xPos < LastPlayerX-128) ||
					(NextDethmazeDir == DMD::Down && player.yPos > LastPlayerY+128) ||
					(NextDethmazeDir == DMD::Up && player.yPos < LastPlayerY-128)
				) {
					if ((DethmazeSuccessScore += 1) >= 13) {
						player.warpToID(95, true);
						LastPlayerX = player.xPos;
						LastPlayerY = player.yPos;
						@NextPlayerRoom = @PlayerRoom = @FindRoom(LastPlayerX,LastPlayerY);
					}
				} else if (DethmazeSuccessScore > 0)
					DethmazeSuccessScore -= 1;
				//else
					//player.hurt(1, true);
				GenerateShortcutList();
			} else {
				if (NextPlayerRoom !is null)
					ZoneTransition(PlayerRoom.Type, NextPlayerRoom.Type);
				@PlayerRoom = @NextPlayerRoom;
				if (NextPlayerRoom.ID == 32 && !SeenBNIntro)
					@BL18::CurrentPopup = BNIntro();
			}
			AdjustMaxResolution();
		}
		if (counter == -248) {
			player.spriteMode = SPRITE::PLAYER;
			player.xSpeed = playerXSpeed;
			player.ySpeed = playerYSpeed;
			if (playerYSpeed < 0) {
				goingUpFromRoomTransition = true;
				player.keyJump = true;
			}
			return false;
		}
		jjDrawSpriteFromCurFrame(LastPlayerX,LastPlayerY, LastPlayerCurFrame,LastPlayerDirection, SPRITE::PLAYER, player.playerID);
		return true;
	}
	void Draw(jjCANVAS@ canvas) const {
		canvas.drawRectangle(0,0, jjSubscreenWidth,jjSubscreenHeight, 0, SPRITE::BLEND_NORMAL, uint8(248-abs(counter)));
	}
	
	bool DrawHUD() const { return true; }
}

void AdjustMaxResolution() {
	int roomWidth = 800, roomHeight = 600;
	if (PlayerRoom !is null) {
		if (PlayerRoom.Width < 800)
			roomWidth = PlayerRoom.Width;
		if (PlayerRoom.Height < 600)
			roomHeight = PlayerRoom.Height;
	} else
		BL18::Player.cameraUnfreeze();
	if (roomWidth != jjResolutionMaxWidth || roomHeight != jjResolutionMaxHeight) {
		jjChat("/maxresolution " + roomWidth + "x" + roomHeight);
		for (int i = 0; i < 8; ++i)
			jjAlert(""); //move commands out of onscreen chatlog
	}
}

jjPIXELMAP@ BGRotate, BGWarp;
void ZoneTransition(RoomTypes old, RoomTypes new) {
	//for (uint i = jjObjectCount; i-- > 0;)
	//	jjObjects[i].deactivate();
	{
		const uint
			left = uint(NextPlayerRoom.Left/32),
			right = uint(NextPlayerRoom.Right/32),
			top = uint(NextPlayerRoom.Top/32),
			bottom = uint(NextPlayerRoom.Bottom/32);
		for (uint x = left; x < right; ++x)
			for (uint y = top; y < bottom; ++y) {
				const uint ev = jjParameterGet(x,y, -12,12);
				const uint8 eventID = ev;
				if (eventID > 32 && jjObjectPresets[eventID].isActive && !jjObjectPresets[eventID].deactivates && ev & 2048 == 0) {
					jjAddObject(eventID, x*32+16, y*32+15, 0,CREATOR::LEVEL);
					jjParameterSet(x,y, -1,1,1);
				}
			}
	}
		
	jjSetWaterLevel(jjLayerHeight[4] * 32 + 32, true);
	BL18::Player.lighting = new == RoomTypes::Hustar ? 100 : new == RoomTypes::WiseGuru ? 33 : 75;
	
	if (old == new)
		return;
		
	jjWaterLighting = (new != RoomTypes::CrystalFalls || BL18::Player.xPos < 310*32) ? WATERLIGHT::GLOBAL : WATERLIGHT::LAGUNICUS;
	
	for (uint i = 1; i <= 4; ++i)
		MLLE::GetLayer("Waterfall " + i).hasTiles = (new == RoomTypes::CrystalFalls);
	for (uint i = 1; i <= 3; ++i)
		MLLE::GetLayer("Lava " + i).hasTiles = (new == RoomTypes::Zerox);
	jjLayerHasTiles[7] = (new != RoomTypes::Dethjump);
	
	if (/*new == RoomTypes::Hustar || */new == RoomTypes::VutxfyCaves) { //although...
		MLLE::GetLayer("Waterfall 2").hasTiles = true;
		MLLE::GetLayer("Waterfall 2").spriteMode = SPRITE::BLEND_LUMINANCE;
		MLLE::GetLayer("Waterfall 3").spriteMode = SPRITE::NORMAL;
	} else if (new == RoomTypes::CrystalFalls)
		MLLE::GetLayer("Waterfall 2").spriteMode = SPRITE::NORMAL;
		
	MLLE::GetLayer("Bloodrayne").hasTiles = new == RoomTypes::WiseGuru;
	MLLE::GetLayer("Fog").hasTiles = new == RoomTypes::FalseProphet || new == RoomTypes::Dethmaze;
	
	//jjCharacters[CHAR::JAZZ].airJump = (new != RoomTypes::Dethjump) ? AIR::HELICOPTER : AIR::NONE;
	
	jjTexturedBGUsed = true;
	jjLayerYAutoSpeed[8] = 0;
	jjTexturedBGFadePositionY = (new != RoomTypes::Dethjump) ? 0.5 : 0.9;
	if (new == RoomTypes::Hustar) {
		jjTexturedBGTexture = TEXTURE::NORMAL;
		jjSetFadeColors(15);
	} else if (new == RoomTypes::VutxfyCaves) {
		BGRotate.makeTexture();
	} else if (new == RoomTypes::Dethjump) {
		BGWarp.makeTexture();
		jjSetFadeColors(79);
		jjSetLayerYSpeed(8, BL18::Player.antiGrav ? 1 : -1, true);
	} else {
		jjTexturedBGUsed = false;
	}
		
	jjTexturedBGStyle = new == RoomTypes::VutxfyCaves ? TEXTURE::TILEMENU : TEXTURE::WARPHORIZON;
		
	if (old == RoomTypes(-1) || old == RoomTypes::Hustar || new == RoomTypes::Hustar || old == RoomTypes::Desktop || new == RoomTypes::Desktop) { //palette change... besides those two, all use the same palette.
		if (new == RoomTypes::Desktop)
			jjPalette = DesktopPalette;
		else
			jjPalette = MLLE::Palette;
			
		if (new == RoomTypes::Hustar)
			jjPalette.gradient(jjPALCOLOR(0,127,255), jjPALCOLOR(0,31,63));
			
		if (BL18::IsMurderer)
			jjPalette.fill(jjPALCOLOR(), 0.15);
		jjPalette.apply();
		TrueColor::ProcessPalette();
	}
	
	jjBEHAVIORINTERFACE@ intermediate;
	for (uint i = jjObjectCount; --i > 0;) { //do some cleanup of orgasmed enemies because there are just so many of them
		jjOBJ@ enemy = jjObjects[i];
		if (enemy.state == STATE::DONE && ((@intermediate = cast<jjBEHAVIORINTERFACE@>(enemy.behavior)) !is null) && cast<BL18::Enemy>(intermediate) !is null)
			enemy.delete();
	}
}

const array<string> FallingFromParadiseStrings = {
	"IT'S WHALER TIME!!!", "@You will@          leave a@        small crater", "@@@@@@@@Who@is@the@RED@KING?", "Race for the Vodka", "Tuturu!", "@@@@@@@@yAY A SHIELD THNX", "hacked@by@@@               chinese", "fun@over@safety", "@@@@@@A CERTAIN SEXY GIRL", "@I've taken the Spear of Selene", "@@@@@@can't stop@won't stop", "BOOP BEEP BEEP,@YOU CHEAP DICK.","@@@@@@@@@@@@@@lori is a bori","@@@the password is@  \"RF\""
};

int lastSubscreenWidth = 0, lastSubscreenHeight = 0;
bool PressingTabOneTickAgo = false;
bool PressingTab = false;
bool PressingJumpOneTickAgo = false;
void onPlayerInput(jjPLAYER@ play) {
	const bool PressingJump = play.keyJump;
	if (BL18::CurrentPopup is null && (@NextPlayerRoom = @FindRoom(play.xPos, play.yPos, PlayerRoom)) !is PlayerRoom) {
		if (PlayerRoom !is null)
			@BL18::CurrentPopup = RoomTransition();
		else {
			@PlayerRoom = @NextPlayerRoom;
			ZoneTransition(RoomTypes(-1), NextPlayerRoom.Type);
		}
		NextPlayerRoom.Map();
	}
	if (lastSubscreenWidth != jjSubscreenWidth || lastSubscreenHeight != jjSubscreenHeight) {
		lastSubscreenWidth = jjSubscreenWidth;
		lastSubscreenHeight = jjSubscreenHeight;
		AdjustMaxResolution();
	}
	if (PlayerRoom !is null) {
		const int cameraWidth = lastSubscreenWidth - jjBorderWidth*2, cameraHeight = lastSubscreenHeight - jjBorderHeight*2;
		float cameraX = play.xPos - cameraWidth/2;
		float cameraY = play.yPos - cameraHeight/2;
		if (cameraX < PlayerRoom.Left) cameraX = PlayerRoom.Left;
		else if (cameraX + cameraWidth > PlayerRoom.Right) cameraX = PlayerRoom.Right - cameraWidth;
		if (cameraY < PlayerRoom.Top) cameraY = PlayerRoom.Top;
		else if (cameraY + cameraHeight > PlayerRoom.Bottom) cameraY = PlayerRoom.Bottom - cameraHeight;
		play.cameraFreeze(cameraX, cameraY, false, true);
		if (PlayerRoom.ID == 49)
			play.keyRight = false;
		else if (PlayerRoom.ID == 56) {
			play.keyDown = play.keyJump = false;
			play.ySpeed = 3.5;
			if (jjGameTicks % 21 == 5)
				play.showText("@@@@@#" + FallingFromParadiseStrings[jjRandom() % FallingFromParadiseStrings.length]);
		}
		jjTriggers[29] = BL18::IsMurderer;
		
		if (PlayerRoom.Type == RoomTypes::Dethjump) {
			/*if (play.keyJump || play.stoned != 0) {
				play.keyJump = false;
				if (BL18::IsPlayerOnGround() && play.ySpeed == 0) {
					play.ySpeed = 4;
					play.antiGrav = !play.antiGrav;
					if (play.platform != 0) {
						jjObjects[play.platform].clearPlatform();
						play.platform = 0;
					}
					//if (play.platform != 0)
					//	play.yPos += play.antiGrav ? 12 : -12;
					jjSetLayerYSpeed(8, play.antiGrav ? 1 : -1, true);
					jjSample(play.xPos, play.yPos, SOUND::COMMON_JUMP);
				}
			}
			const auto curAnim = play.curAnim - jjAnimSets[play.setID];
			if ((curAnim == RABBIT::TELEPORTFALL || curAnim == RABBIT::TELEPORTSTAND) && int(play.xPos) & 31 == 0) {
				play.xPos += 16;
				play.yPos += 16;
			}*/
		} else if (PlayerRoom.Type == RoomTypes::CrystalFalls) {
			MLLE::GetLayer("Waterfall 4").yOffset = -jjWaterLevel + 40;
		} else if (PlayerRoom.Type == RoomTypes::Crossroads) {
			const auto interval = jjGameTicks & 255;
			if (interval == 0)
				jjLayerHasTiles[7] = false;
			else if (interval == 8)
				jjLayerHasTiles[7] = true;
		}
		
		if (goingUpFromRoomTransition && (goingUpFromRoomTransition = (play.ySpeed <= 0))) {
			play.keyJump = true;
			BL18::PlayerLastSpeed = play.ySpeed;
		}
	}
	
	PressingTabOneTickAgo = PressingTab;
	PressingTab = jjKey[9];
	if (GrailFound && PressingTab && !PressingTabOneTickAgo && !BL18::CoinWarpFound && BL18::CurrentPopup is null && play.curAnim - jjAnimSets[play.setID] == RABBIT::STAND) {
		PressingTabOneTickAgo = true;
		@BL18::CurrentPopup = PortalSelection(0);
	}
	
	if (RaptorClawFound) {
		if (play.keyJump && !PressingJumpOneTickAgo && RaptorClawStage < 2 && (jjGameTicks - RaptorClawLastSlidingTick) < 10) {
			RaptorClawStage = 2;
			jjSample(play.xPos, play.yPos, SOUND::COMMON_JUMP);
			play.ySpeed = play.jumpStrength;
			play.helicopter = 0;
		} else if (RaptorClawStage > 1) {
			if (++RaptorClawStage == 20)
				RaptorClawStage = 0;
			else {
				play.keyRight = RaptorClawFacingRight;
				play.keyLeft = !RaptorClawFacingRight;
				play.keyJump = true;
				play.helicopter = 0;
			}
		} else {
			const auto anim = play.curAnim - jjAnimSets[play.setID];
			const int xPosToTest = int(play.xPos) + (play.keyRight ? 13 : -13);
			uint16 tileIDToTest;
			if (
				(anim == RABBIT::FALL || anim == RABBIT::HELICOPTER) &&
				(
					(play.keyRight && jjMaskedPixel(xPosToTest, int(play.yPos)-8) && jjMaskedPixel(xPosToTest, int(play.yPos)+8)) || 
					(play.keyLeft && jjMaskedPixel(xPosToTest, int(play.yPos)-8) && jjMaskedPixel(xPosToTest, int(play.yPos)+8))
				) &&
				((tileIDToTest = jjTileGet(4, xPosToTest>>5, int(play.yPos)>>5)) < 426 || tileIDToTest > 499)
			) {
				play.helicopter = 0;
				RaptorClawStage = 1;
				RaptorClawFacingRight = play.keyLeft;
				play.ySpeed = 0.25;
				play.keyJump = false;
				RaptorClawLastSlidingTick = jjGameTicks;
			} else if (RaptorClawStage == 1)
				RaptorClawStage = 0;
		}
		if (play.invisibility = RaptorClawStage == 1) {
			const int vDir = !play.antiGrav ? 1 : -1;
			jjDrawRotatedSprite(play.xPos - play.direction * 3, play.yPos, ANIM::JAZZ, RABBIT::SKID1, jjGameTicks>>4, 256 * play.direction * vDir, -play.direction, vDir, SPRITE::PLAYER,0);
		}
	}
	PressingJumpOneTickAgo = PressingJump;
}

void DrawMapWhenPressingTab(jjPLAYER@ play, jjCANVAS@ canvas) {
	if (PressingTab) {
		if (!GrailFound) {
			canvas.drawRectangle(0, 0, jjResolutionWidth, jjResolutionHeight, 0, SPRITE::SHADOW);
			DrawMap(canvas, -1);
		}
	} else if (jjTriggers[20] && !BL18::CoinWarpFound && BL18::CurrentPopup is null)
		canvas.drawString(110, jjResolutionHeight-6, "§1Tab for " + (GrailFound ? "Grail" : "Map"));
}
void DrawMap(jjCANVAS@ canvas, int selectedPortalID) {
	if (PlayerRoom !is null && (PlayerRoom.ID == 49 || PlayerRoom.ID == 58 || PlayerRoom.ID == 70)) //non-euclidean
		return;
	const uint mapOriginX = jjSubscreenWidth/2 - jjLayerWidth[4]/2;
	const uint mapOriginY = 16;
	canvas.drawResizedSpriteFromCurFrame(mapOriginX,mapOriginY, MapFrameID, MapMultiplier,MapMultiplier);
	for (int i = PortalLocations.length; i-- > 0;) {
		const auto@ location = PortalLocations[i];
		if (location !is null && (i != selectedPortalID || jjGameTicks & 7 < 4)) {
			canvas.drawTile(mapOriginX - 16 + int(location.x), mapOriginY - 16 + int(location.y), 1307);
		}
	}
	for (int i = BL18::CollectibleLocations.length; i-- > 0;) {
		const auto data = BL18::CollectibleLocations[i];
		if (!data.Found) {
			const auto location = data.Location;
			if (data.Type == BL18::CollectibleTypes::Coin)
				canvas.drawResizedSpriteFromCurFrame(mapOriginX + int(location.x) / 32, mapOriginY + int(location.y) / 32, BL18::CoinFirstFrame + ((jjGameTicks >> 3) & 7), 0.33,0.33);
			else
				canvas.drawResizedSpriteFromCurFrame(mapOriginX + int(location.x) / 32, mapOriginY + int(location.y) / 32, BL18::KeyFrame, 0.5,0.5, SPRITE::SINGLEHUE, BL18::KeyColors[data.Type-1]);
		}
	}
	canvas.drawResizedSprite(mapOriginX - 9 + int(BL18::Player.xPos / 32), mapOriginY + 6 + int(BL18::Player.yPos / 32), ANIM::FACES,3,0, 0.5,0.5);
}

class BloodDemon : BL18::Enemy {
	BloodDemon(jjOBJ@ preset) {
		super(preset);
		preset.energy = 4;
		Layer = 3;
		const array<uint> animsToReplace = {0,5,7};
		for (uint animID = 0; animID < animsToReplace.length; ++animID) {
			jjANIMATION@ anim = jjAnimations[jjAnimSets[ANIM::DEVILDEVAN] + animsToReplace[animID]];
			BL18::Recolor(anim, array<uint8>={16}, BL18::RecolorReplace(136)); //green to "red"
			Resize::Resize(anim, 1.5, Resize::Method::Scale2x);
		}
	}		
	void onBehave(jjOBJ@ obj) override {
		if (obj.state == STATE::START) {
			obj.doesHurt = FindRoom(obj.xPos, obj.yPos).ID;
			obj.state = STATE::FLY;
			obj.behave(BEHAVIOR::DEVILDEVAN, false);
		} else if (obj.state == STATE::DEACTIVATE)
			obj.deactivate();
		else if (obj.state != STATE::DONE && BL18::CurrentPopup is null && @PlayerRoom is Rooms[obj.doesHurt]) {
			obj.behave(BEHAVIOR::DEVILDEVAN, false);
			if (BL18::IsMurderer)
				obj.behave(BEHAVIOR::DEVILDEVAN, false);
			if (obj.state != STATE::FREEZE) {
				jjPARTICLE@ blood = jjAddParticle(PARTICLE::ICETRAIL);
				blood.xPos = obj.xPos + (jjRandom() & 63) - 31;
				blood.yPos = obj.yPos - (jjRandom() & 31);
				blood.icetrail.color = 24;
				blood.icetrail.colorStop = 32;
			}
		}
	}
}


const uint NumberOfBitsDevotedToSyncParameter = 3; //this should correspond to the number of bits you assign to the Sync parameter in your JCS.ini (or MLLE equivalent) entry for Swinging Vine. So for example if you give it a parameter Sync:2, this variable should ALSO equal 2.

void SyncedVine(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.var[1] = 128; //vine length--set this in whatever way appeals to you, but a constant 128 is the value that native swinging vines use.
		
		if (lastSwingingVineLUTLength != obj.var[1]) { //need to generate LUT by doing the same math swinging vine objects do
			lastSwingingVineLUTLength = obj.var[1];
			PossibleVineVariableConfigurations = array<array<int>> = {{obj.var[1] * 256, 0}};
			while (true) {
				const array<int>@ oldConfiguration = @PossibleVineVariableConfigurations[PossibleVineVariableConfigurations.length-1];
				array<int> newConfiguration(2);
				newConfiguration[1] = oldConfiguration[1] + ((oldConfiguration[0] > 0) ? -32 : 32);
				newConfiguration[0] = oldConfiguration[0] + newConfiguration[1];
				if (newConfiguration[1] == 0 && newConfiguration[0] == obj.var[1] * 256) //gone full circle
					break;
				PossibleVineVariableConfigurations.insertLast(newConfiguration);
			}
		}
		
		const array<int>@ syncedConfiguration = PossibleVineVariableConfigurations[(jjGameTicks + (jjParameterGet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0, NumberOfBitsDevotedToSyncParameter) * (PossibleVineVariableConfigurations.length / (1 << NumberOfBitsDevotedToSyncParameter)))) % PossibleVineVariableConfigurations.length];
		for (uint i = 0; i < 2; ++i)
			obj.var[2 + i] = syncedConfiguration[i];
			
		obj.state = STATE::ACTION;
	}
	
	obj.playerHandling = BL18::Player.antiGrav ? HANDLING::PARTICLE : HANDLING::SPECIAL;
	obj.behave(BEHAVIOR::SWINGINGVINE);
}
int lastSwingingVineLUTLength = -1;
array<array<int>> PossibleVineVariableConfigurations;

void Batform(jjOBJ@ obj) {
	if (obj.state == STATE::DEACTIVATE) {
		obj.clearPlatform();
		obj.deactivate();
	} else if (obj.state == STATE::START) {
		obj.var[0] = FindRoom(obj.xOrg, obj.yOrg).ID;
		obj.state = STATE::FLY;
	} else {
		const float lastX = obj.xPos, lastY = obj.yPos;
		jjDrawSpriteFromCurFrame(lastX, lastY, obj.special, obj.direction); //draw one frame behind to avoid weird jazz-on-bat visual lag
		obj.xPos = obj.xOrg + jjSin(obj.age += 4) * 80;
		obj.direction = ((obj.age + 256) & 1023) < 512 ? 1 : -1;
		obj.frameID = (obj.ySpeed < 0) ? (obj.age >> 4) : 4;
		obj.special = obj.determineCurFrame(false); //for display, but keep curFrame constant for bePlatform
		if (obj.ySpeed < 0 && obj.yPos < obj.yOrg - 96)
			obj.ySpeed = 2;
		else if (obj.ySpeed > 0 && obj.yPos > obj.yOrg + 96)
			obj.ySpeed = -1;
		else {
			obj.yPos += obj.ySpeed;
			if (obj.ySpeed < 0 && @Rooms[obj.var[0]] is @PlayerRoom)
				obj.doesHurt = jjSampleLooped(obj.xPos,obj.yPos,SOUND::BAT_BATFLY1,obj.doesHurt);
		}
		obj.bePlatform(lastX, lastY);
	}
}

void DoublePlatform(jjOBJ@ obj) {
	if (obj.creatorType == CREATOR::LEVEL) {
		const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
		if (jjParameterGet(xTile, yTile, 12,1) == 0) { //circle, not swing
			jjAddObject(obj.eventID, obj.xOrg, obj.yOrg);
			jjParameterSet(xTile,yTile, 1,1, jjParameterGet(xTile,yTile, 1,1) ^ 1); //opposite sync
		}
	}
	const auto@ room = FindRoom(obj.xOrg, obj.yOrg);
	if (room !is null && room.Type == RoomTypes::Dethmaze) {
		obj.xOrg -= 15;
		obj.yOrg -= 15;
	}
	obj.behavior = BEHAVIOR::PLATFORM;
	obj.behave();
}

array<string> ShortcutNames = {"Jazz 2", "OMFBG", "Microsoft Works", "ImageMixer", "Star Wars Battlefront", "Unreal II"};
jjPAL DesktopPalette;
uint FirstShortcutFrame;
uint DethmazeSuccessScore = 0;
enum DMD { Right,Left,Up,Down }
DMD NextDethmazeDir;
const array<array<uint>> DethmazeShortcutLocations = {
	{398 * 32,179 * 32},
	{390 * 32,179 * 32},
	{394 * 32,175 * 32},
	{394 * 32,183 * 32}
};
array<uint> CurrentShortcutList;
void GenerateShortcutList() {
	CurrentShortcutList.resize(0);
	const uint rand = jjRandom();
	NextDethmazeDir = DMD(rand & 3);
	const uint excludeFalse = (rand >> 2) & 3;
	for (uint i = 0; i < 4; ++i)
		if (i != excludeFalse)
			CurrentShortcutList.insertLast(i); //first four are false
	CurrentShortcutList.insertAt(NextDethmazeDir, 4 + ((rand >> 4) & 1)); //last two are true
	
	//jjDebug(CurrentShortcutList[0] + "," + CurrentShortcutList[1] + "," + CurrentShortcutList[2] + "," + CurrentShortcutList[3]);
}

const array<string> PortalNames = {"Chasm Entrance", "False Prophet of@Charnel Crossroads", "False Prophet of@Vutxfy Caves", "False Prophet of@Crystal Falls", "False Prophet of@the Dethjump", "Wise Guru", "Hot Spring Secret"};
array<BL18::Point@> PortalLocations(PortalNames.length, null);
class Portal : BL18::Switch {
	void onBehave(jjOBJ@ obj) override {
		if (obj.state == STATE::START) {
			const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
			obj.special = jjParameterGet(xTile, yTile, 0, 4);
			if (uint(obj.special) >= PortalLocations.length) {
				obj.playerHandling = HANDLING::PICKUP;
				obj.scriptedCollisions = true;
				if (obj.special == 15) {
					obj.curFrame = BL18::KeyFrame - 2;
					obj.behavior = Grail();
				} else if (obj.special == 14) {
					obj.curFrame = BL18::KeyFrame + 19;
					obj.behavior = Claw();
				}
				return;
			}
			@PortalLocations[obj.special] = BL18::Point(xTile, yTile);
			obj.state = STATE::WAIT;
		}
		BL18::Switch::onBehave(obj);
	}
	void playerPressedT(jjOBJ@ obj) override {
		@BL18::CurrentPopup = PortalSelection(obj.special);
	}
	void drawMe(const jjOBJ@ obj) override {
		const int frameID = (jjGameTicks >> 3) % 3;
		const int xOrg = (int(obj.xOrg) & ~31) - 16;
		const int yOrg = (int(obj.yOrg) & ~31);
		//jjDrawSpriteFromCurFrame(obj.xOrg, obj.yOrg, obj.curFrame);
		for (int x = 0; x < 2; ++x)
			for (int y = 0; y < 2; ++y)
				jjDrawTile(xOrg + x*32, yOrg + y*32, 920 + x + y*10 + frameID * 20);
	}
}
class PortalSelection : BL18::Popup {
	uint OriginalID;
	uint CurrentSelection;
	bool wasPressingSomething = true;
	array<bool> PortalsAvailable(PortalNames.length, false);
	jjTEXTAPPEARANCE Selected(STRING::SPIN);
	
	PortalSelection(uint id) {
		CurrentSelection = OriginalID = id;
		BL18::SavedTriggers[id + 20] = jjTriggers[id + 20] = true;
		for (uint i = 0; i < PortalsAvailable.length; ++i)
			PortalsAvailable[i] = jjTriggers[i + 20];
	}
	
	bool Do() override {
		if (jjKey[8] || (PressingTab && !PressingTabOneTickAgo)) //backspace
			return false;
		const bool pressingSelect = BL18::Player.keyFire || BL18::Player.keySelect || jjKey[1]; //left mouse button
		if (!wasPressingSomething) {
			wasPressingSomething = true;
			if (pressingSelect) {
				if (!PortalsAvailable[CurrentSelection]) {
					jjSamplePriority(SOUND::COMMON_HORN1);
					return true;
				} else {
					/*if (CurrentSelection != OriginalID) {
						for (uint i = jjObjectCount; i-- > 0;)
							jjObjects[i].deactivate();
					}*/
					BL18::Player.warpToTile(int(PortalLocations[CurrentSelection].x), int(PortalLocations[CurrentSelection].y));
					return false;
				}
			} else if (jjKey[0x26]) { //up
				if (CurrentSelection == 0)
					CurrentSelection = PortalsAvailable.length - 1;
				else
					CurrentSelection -= 1;
			} else if (jjKey[0x28]) { //down
				CurrentSelection += 1;
				CurrentSelection %= PortalsAvailable.length;
			} else
				wasPressingSomething = false;
		} else if (!(pressingSelect || jjKey[0x26] || jjKey[0x28]))
			wasPressingSomething = false;
		return true;
	}
	void Draw(jjCANVAS@ canvas) const override {
		canvas.drawRectangle(0, 0, jjResolutionWidth, jjResolutionHeight, 0, SPRITE::SHADOW);
		DrawMap(canvas, CurrentSelection);
		//canvas.drawString(0x8000, 40, "||||||||Select a Portal", STRING::LARGE);
		
		const uint xPos = jjSubscreenWidth/2 - 280;
		const uint yPos = 230;
		for (uint i = 0; i < PortalsAvailable.length; ++i)
			canvas.drawString(xPos + (i / 4) * 290, yPos + (i % 4) * 55, (!PortalsAvailable[i] ? "#||||~" : i == CurrentSelection ? "#" : "") + PortalNames[i], STRING::MEDIUM, i == CurrentSelection ? Selected : BL18::ConversationAppearance);
		canvas.drawString(10, jjResolutionHeight - 20, "|||||Press Backspace or Tab to cancel.");
	}
}

bool GrailFound = false;
bool RaptorClawFound = false;
uint RaptorClawStage = 0;
bool RaptorClawFacingRight;
int RaptorClawLastSlidingTick = 0;

class Grail : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE)
			obj.deactivate();
		else
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos + jjSin((obj.objectID*8+jjGameTicks+int(obj.xPos+obj.yPos*256))*16) * 4, obj.curFrame, 1, SPRITE::GEM, 9);
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
		GrailFound = true;
		jjSample(obj.xPos, obj.yPos, SOUND::COMMON_TELPORT2, 63, 5000);
		jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos)].curAnim = jjObjectPresets[OBJECT::GENERATOR].curAnim;
		jjEventSet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0);
		jjTileSet(4, 391, 170, 0); //text outside of dethmaze
		jjEventSet(391, 170, 0);
		for (uint x = 0; x < 3; ++x)
			for (uint y = 0; y < 2; ++y)
				jjTileSet(4, 397 + x, 169 + y, 360 + x + y*10); //guru outside of dethmaze
		for (uint x = 0; x < 5; ++x)
			for (uint y = 0; y < 2; ++y)
				jjTileSet(3, 523 + x, 10 + y, 0); //jesus
		jjEventSet(524, 8, 0);
		jjEventSet(398, 170, OBJECT::PRETZEL);
		obj.delete();
		@BL18::CurrentPopup = GrailNotice();
		return true;
	}
}
class GrailNotice : BL18::Popup {
	bool Do() override {
		return (!jjKey[8] && !jjKey[0xD]);
	}
	void Draw(jjCANVAS@ canvas) const override {
		canvas.drawRectangle(0, 0, jjResolutionWidth, jjResolutionHeight, 0, SPRITE::SHADOW);
		canvas.drawString(0x8000, 45, "||got the", STRING::MEDIUM);
		canvas.drawString(0x8000, 70, "||Unholy Grail", STRING::LARGE);
		canvas.drawString(0x8000, 330, "||While standing still, press TAB", STRING::MEDIUM);
		canvas.drawString(0x8000, 355, "||to megawarp to any portal.", STRING::MEDIUM);
		canvas.drawRotatedSpriteFromCurFrame(jjSubscreenWidth/2, 230, BL18::KeyFrame-2, int(jjSin(jjGameTicks << 3) * 20), 2,2, SPRITE::GEM,9);
	}
}
class Claw : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE)
			obj.deactivate();
		else
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos + jjSin((obj.objectID*8+jjGameTicks+int(obj.xPos+obj.yPos*256))*16) * 4, obj.curFrame);
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
		RaptorClawFound = true;
		jjSample(obj.xPos, obj.yPos, SOUND::LIZARD_LIZ6);
		jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos)].curAnim = jjObjectPresets[OBJECT::GENERATOR].curAnim;
		jjEventSet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0);
		obj.delete();
		@BL18::CurrentPopup = ClawNotice();
		return true;
	}
}
class ClawNotice : BL18::Popup {
	bool Do() override {
		return (!jjKey[8] && !jjKey[0xD]);
	}
	void Draw(jjCANVAS@ canvas) const override {
		canvas.drawRectangle(0, 0, jjResolutionWidth, jjResolutionHeight, 0, SPRITE::SHADOW);
		canvas.drawString(0x8000, 45, "||||got the", STRING::MEDIUM);
		canvas.drawString(0x8000, 70, "||||Raptor Claw", STRING::LARGE);
		canvas.drawString(0x8000, 330, "||||Press JUMP while sliding", STRING::MEDIUM);
		canvas.drawString(0x8000, 355, "||||against a wall to jump again.", STRING::MEDIUM);
		canvas.drawString(0x8000, 405, "||||(Can't slide on SHINY blocks.)", STRING::MEDIUM);
		canvas.drawRotatedSpriteFromCurFrame(jjSubscreenWidth/2, 230, BL18::KeyFrame+19, int(jjSin(jjGameTicks << 3) * 20), 2,2);
	}
}

const array<array<string>> Passwords = {
	{"RAVEN", "Neither writing desk nor ravine,@this rantin' bird enemy from Hell@plagues those with rocket powers."},
	{"ROSE", "On Valentine's Day@you'll want this flower.@Look all around you.@Don't look beneath you."},
	{"RED", "The color of meat, of fire,@of blood, of desire."},
	{"RF", "Very quick missiles@the color of the@water behind you;@namers of a climb."},
	{"R", "What has every password@so far had in common?@Continue the pattern.@Continue the countdown."},
	{"", "Even the Wise Guru does@not speak when he has@no wisdom at all."},
	{"33121", "Seek out FIVE@UNNUMBERED MURALS@within the Dethjump area."},
	{"21332", "Where a mural shows a BLOCK,@ignore the NUMBER here."},
	{"RABBIT", "The YELLOW EYE ROOM's@password is so large,@only the GRAIL may@read its letters."}
};
array<bool> PasswordHintsFound(Passwords.length, false);
class PasswordMonitor : BL18::Switch {
	void onBehave(jjOBJ@ obj) override {
		if (obj.state == STATE::START) {
			obj.doesHurt = jjParameterGet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 4, 5); //triggerID
			obj.state = STATE::WAIT;
			if (obj.yOrg > 138*32) {
				obj.light = 0;
				obj.lightType = LIGHT::NONE;
			}
		}
		if (!jjTriggers[obj.doesHurt])
			BL18::Switch::onBehave(obj);
		else
			jjDrawRectangle(int(obj.xOrg)&~31, int(obj.yOrg)&~31, 32,32, 79);
	}
	void playerPressedT(jjOBJ@ obj) override {
		const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
		const int index1 = jjParameterGet(xTile, yTile, 1, 3) | (jjParameterGet(xTile, yTile, 9, 1) << 3);
		const int index2 = jjParameterGet(xTile, yTile, 0, 1);
		if (index2 == 1)
			PasswordHintsFound[index1] = true;
		@BL18::CurrentPopup = PasswordPrompt(index1, index2 == 1, obj.doesHurt);
	}
	void drawMe(const jjOBJ@ obj) override { } //tile-based
}
class PasswordPrompt : BL18::Popup {
	array<bool> WasPressingSomething(26+10, false);
	uint8 TriggerID;
	const array<string>@ Prompts;
	bool IsHint, HintFound;
	string Header,Footer;
	string Input = "";
	uint8 ExitCounter = 0;
	bool CorrectPassword;
	
	PasswordPrompt(int passwordID, bool isHint, uint8 triggerID) {
		TriggerID = triggerID;
		IsHint = isHint;
		@Prompts = Passwords[passwordID];
		HintFound = PasswordHintsFound[passwordID];
		Header = isHint ? "Password Hint" : "Password Prompt";
		Footer = isHint ? "Press Backspace" : "Press Enter to Submit";
		if (isHint) WasPressingSomething[0] = true;
		else WasPressingSomething["T"[0] - "A"[0]] = true;
	}
	
	bool Do() override {
		if (jjKey[8]) //backspace
			return false;
		if (IsHint) {
			bool isPressingSomething = false;
			for (uint i = 1; i < 0xA5; ++i)
				if (jjKey[i]) {
					isPressingSomething = true;
					break;
				}
			if (!WasPressingSomething[0] && isPressingSomething)
				return false;
			WasPressingSomething[0] = isPressingSomething;
		} else if (ExitCounter == 0) {
			if (jjKey[0xD]) {
				ExitCounter = 1;
				Header = "";
				if (CorrectPassword = Input == Prompts[0]) {
					jjSamplePriority(BL18::HPTrigger);
					Footer = "Correct!";
				} else {
					jjSamplePriority(SOUND::COMMON_HORN1);
					Footer = (Input != "SWORDFISH") ? "Incorrect." : "That's-a not it. You no guess it.";
				}
				return true;
			}
			
			string foo = '?';
			for (uint i = 0; i < 26; ++i)
				if (jjKey['A'[0] + i]) {
					if (!WasPressingSomething[i]) {
						foo[0] = 'A'[0] + i;
						WasPressingSomething[i] = true;
					}
				} else
					WasPressingSomething[i] = false;
			for (uint i = 0; i < 10; ++i)
				if (jjKey['0'[0] + i]) {
					if (!WasPressingSomething[i+26]) {
						foo[0] = '0'[0] + i;
						WasPressingSomething[i+26] = true;
					}
				} else
					WasPressingSomething[i+26] = false;
					
			if (foo != '?') {
				Input += foo;
				jjSamplePriority(SOUND::MENUSOUNDS_TYPE);
			}
		} else if (++ExitCounter == 70) {
			if (CorrectPassword) {
				jjTriggers[TriggerID] = true;
				if (TriggerID == 11) { //weird infinite room
					jjTriggers[10] = true;
					BL18::SavedTriggers[10] = BL18::SavedTriggers[11] = true;
				}
				else if (TriggerID == 14) { //tuf boss
					@BL18::CurrentPopup = NullPopup(false);
					BL18::Player.direction = 1;
					return true;
				}
			}
			return false;
		}
		return true;
	}
	void Draw(jjCANVAS@ canvas) const override {
		canvas.drawRectangle(0, 0, jjResolutionWidth, jjResolutionHeight, 0, SPRITE::SHADOW);
		canvas.drawRectangle(jjResolutionWidth/2 - 275 - 2, 180 - 2, 550 + 4, 120 + 4, 32 + (jjRandom() & 3));
		canvas.drawRectangle(jjResolutionWidth/2 - 275, 180, 550, 120, 0);
		canvas.drawString(jjResolutionWidth/2 - 300, 140, Header, STRING::MEDIUM, STRING::NORMAL,0, SPRITE::PALSHIFT, 40);
		canvas.drawString(0x10000 + jjResolutionWidth/2 - 300, 340, Footer, STRING::MEDIUM, STRING::NORMAL,0, SPRITE::PALSHIFT, 40);
		canvas.drawString(jjResolutionWidth/2 - 275, 295, "Cyberspaz OS", STRING::SMALL,STRING::NORMAL,0, SPRITE::PALSHIFT, 40);
		if (IsHint)
			canvas.drawString(0x8000, 205, Prompts[1], STRING::MEDIUM, BL18::ConversationAppearance,0, SPRITE::PALSHIFT, uint8(-4*8));
		else {
			const bool flash = (jjGameTicks & 15) < 8;
			if (ExitCounter == 0 || flash) {
				string displayString = Input;
				if (ExitCounter == 0 && flash)
					displayString += "-";
				canvas.drawString(jjResolutionWidth/2 - 250, 230, displayString, STRING::LARGE, STRING::NORMAL,0, SPRITE::PALSHIFT, uint8((ExitCounter == 0 ? 4 : CorrectPassword ? 6 : 5) * -8));
			}
			if (HintFound && ExitCounter == 0)
				canvas.drawString(jjResolutionWidth/2, 45, "Hint:§1@" + Prompts[1], STRING::SMALL, BL18::ConversationAppearance,0, SPRITE::PALSHIFT, 40);
		}
	}
}

void BridgeWhenYourGravityIsNormal(jjOBJ@ obj) {
	if (!BL18::Player.antiGrav) {
		obj.behave(BEHAVIOR::BRIDGE);
	} else {
		const auto realYPos = BL18::Player.yPos;
		BL18::Player.yPos = 0;
		obj.behave(BEHAVIOR::BRIDGE);
		BL18::Player.yPos = realYPos;
	}
}

void FieldName(jjOBJ@ obj) {
	if (obj.state == STATE::DEACTIVATE)
		obj.deactivate();
	else if (obj.state == STATE::START) {
		obj.state = STATE::WAIT;
		obj.special = jjParameterGet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0, 4);
	} else {
		if (LastRoomName != obj.special && PlayerRoom.Type == obj.special) {
			LastRoomName = obj.special;
			BL18::Player.showText("@@@@@" + RoomNames[LastRoomName], STRING::LARGE);
		}
	}
}

bool TreeAttacked = false;
void FireOrIce(jjOBJ@ obj) {
	obj.eventID = (obj.state == STATE::DEACTIVATE) ? OBJECT::TNTDESTRUCTSCENERY : OBJECT::DESTRUCTSCENERY;
	if (obj.state == STATE::FREEZE)
		obj.state = STATE::KILL;
	obj.behave(BEHAVIOR::DESTRUCTSCENERY);
	if (obj.state == STATE::KILL || obj.state == STATE::DONE)
		TreeAttacked = true;
}

class QuestionMarkBlock : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE)
			obj.deactivate();
		else if (BL18::IsMurderer) {
			if (jjGameTicks & 31 == 0)
				jjObjects[jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos - 20, jjRandom() & 7, CREATOR::OBJECT, BL18::BoneWrapper)].ySpeed -= 1;
			else if (jjGameTicks & 3 == 1)
				jjDrawTile(uint(obj.xPos)&~31, uint(obj.yPos)&~31, 1332);
		}
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
		if (!BL18::IsMurderer && bullet is null && player !is null && player.yPos > obj.yPos && player.ySpeed < -1) {
			BL18::IsMurderer = true;
			jjPalette.fill(jjPALCOLOR(), 0.15);
			jjPalette.apply();
			if (!jjMusicLoad("DARKSIDE.MOD")) jjMusicStop();
			jjSamplePriority(SOUND::INTRO_BOEM1);
			jjAddParticleTileExplosion(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 1322, false);
			player.showText("#||||~@@EXODUS 30:20", STRING::LARGE);
			//jjAddObject(OBJECT::SHARD, obj.xPos, obj.yPos, 0,CREATOR::OBJECT, BL18::BloodSpatter);
		}
		return true;
	}
}

void MarioPlatform(jjOBJ@ obj) {
	if (PlayerRoom.Type == RoomTypes::WiseGuru) {// || PlayerRoom.ID >= 101) { //lol
		const auto lastYPos = obj.yPos;
		if (obj.state == STATE::START) {
			obj.state = STATE::FALL;
			obj.xPos = obj.xOrg + 16;
			const auto@ room = FindRoom(obj.xPos, obj.yPos);
			obj.var[0] = int(room.Top);
			obj.var[1] = int(room.Bottom);
			obj.yPos = ((int(obj.yOrg) - obj.var[0] + jjGameTicks) % (obj.var[1] - obj.var[0])) + obj.var[0]; //sync
			//jjDebug("" + obj.yPos);
		} else if ((obj.yPos += 1) >= obj.var[1]) {
			obj.yPos = obj.var[0];
			obj.clearPlatform();
		} else {
			obj.bePlatform(obj.xPos, lastYPos);
			if (BL18::Player.platform == obj.objectID && BL18::Player.xPos < obj.xPos-50)
				BL18::Player.xSpeed += 0.75;
		}
		jjDrawSpriteFromCurFrame(obj.xPos, lastYPos, obj.curFrame, 1, SPRITE::NORMAL,0, 5);
	} else
		obj.state = STATE::START;
}


class NullPopup : BL18::Popup {
	bool ShowHUD;
	NullPopup(bool sh) { ShowHUD = sh; }
	bool Do() override { return true; }
	void Draw(jjCANVAS@ canvas) const override { }
	bool DrawHUD() const { return ShowHUD; }
}
class Trail {
	int xPos, yPos, curFrame, direction;
	Trail(){}
	Trail(int x, int y, int c, int d) { xPos = x; yPos = y; curFrame = c; direction = d; }
	void Draw(uint8 opacity) const {
		jjDrawSpriteFromCurFrame(xPos, yPos, curFrame, direction, SPRITE::BLEND_NORMAL,opacity, 2);
	}
}
array<Trail> TufBossTrail, FlailerangTrail;
void MyTufBoss(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.state = STATE::ACTION;
		obj.yPos -= 10;
		obj.xAcc = 0;
	} else if (obj.state == STATE::DEACTIVATE)
		obj.deactivate();
	if (jjGameTicks & 7 == 0) {
		if (TufBossTrail.length > 15) TufBossTrail.removeLast();
		if (FlailerangTrail.length > 15) FlailerangTrail.removeLast();
		TufBossTrail.insertAt(0, Trail(int(obj.xPos), int(obj.yPos), obj.curFrame, obj.direction));
		if (jjGameTicks & 15 == 0)
			obj.frameID += 1;
		obj.determineCurFrame();
		if (++obj.age < 80) {
			obj.xPos -= 2;
		} else if (obj.age == 80) {
			obj.frameID = 0;
			obj.curAnim -= 5; //throw
			obj.state = STATE::ATTACK;
			//jjSample(obj.xPos, obj.yPos, SOUND::TUFBOSS_SWING, 63, 5000);
		} else if (obj.state == STATE::ATTACK) {
			if (obj.frameID == 15) {
				obj.xAcc = obj.xPos - 36;
				obj.yAcc = obj.yPos;
				jjSample(obj.xPos, obj.yPos, SOUND::TUFBOSS_RELEASE, 63, 2500);
				BL18::Player.spriteMode = SPRITE::INVISIBLE;
				//BL18::Player.showText("@@@@@@@@@@No, Jazz.@      You are the demons.");
			} else if (obj.frameID == 19) {
				obj.frameID = 0;
				obj.curAnim += 4; //stand
				obj.state = STATE::FLY;
			}
		} else if (obj.state == STATE::FLY) {
			if (obj.age == 170) {
				@BL18::CurrentPopup = null;
				BL18::Player.warpToID(68);
				obj.deactivates = true;
			}
		}
		if (obj.xAcc != 0)
			FlailerangTrail.insertAt(0, Trail(int(obj.xAcc -= 2), int(obj.yAcc += 0.2), jjAnimations[jjAnimSets[ANIM::JAZZ] + RABBIT::FALL] + ((jjGameTicks >> 3) % 3), -1));
	}
	if (BL18::Player.spriteMode == SPRITE::INVISIBLE)
		jjDrawSprite(BL18::Player.xPos, BL18::Player.yPos, ANIM::TUFBOSS, 3, (obj.age >> 1) & 3, 1,SPRITE::NORMAL,0, 2);
	for (int i = TufBossTrail.length; i-- > 0;)
		TufBossTrail[i].Draw(248 - i*16);
	for (int i = FlailerangTrail.length; i-- > 0;)
		FlailerangTrail[i].Draw(248 - i*16);
}

int LastGemColorWallSamplePlayed = 0;
void GemColorWall(jjOBJ@ obj) {
	const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
	if (obj.state == STATE::START) {
		const auto@ tile = jjTiles[obj.var[0] = jjTileGet(4, xTile,yTile)];
		const auto@ Frames = tile.getFrames();
		while (Frames.length < 2)
			Frames.insertLast(0);
		obj.var[1] = Frames[0];
		obj.var[2] = Frames[Frames.length-1];
		obj.var[3] = jjParameterGet(xTile,yTile, 0, 2); //desired color
		obj.var[4] = FindRoom(obj.xOrg, obj.yOrg).ID;
		obj.var[5] = jjParameterGet(xTile,yTile, 8, 4); //number of gems in room (as remedy against memory management)
		jjTileSet(4, xTile,yTile, obj.var[1]);
		obj.state = STATE::WAIT;
	} else if (obj.state == STATE::DEACTIVATE) {
		if (obj.var[0] != 0) //has been STARTed
			jjTileSet(4, xTile,yTile, obj.var[0]);
		obj.deactivate();
	} else {
		const auto@ room = Rooms[obj.var[4]];
		{//if (room is PlayerRoom) {
			int gemCount = 0;
			for (uint i = jjObjectCount; i-- > 0;) {
				const jjOBJ@ gem = jjObjects[i];
				if (gem.eventID == OBJECT::FIVEHUNDREDBUMP && gem.isActive && FindRoom(gem.xOrg,gem.yOrg) is room) {
					if (gem.special != obj.var[3])
						return;
					gemCount += 1;
				}
			}
			if (gemCount < obj.var[5])
				return;
			jjTileSet(4, xTile,yTile, obj.var[2]);
			jjEventSet(xTile,yTile, 0); //let's be generous... solve once, solve forever
			//if (jjEventGet(xTile,yTile - 1) == AREA::HURT)
			//	jjTileSet(4, xTile,yTile-1, 0);
			jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xOrg, obj.yOrg)].determineCurAnim(ANIM::CUSTOM[BL18::AnimSets::Misc], 4 | (jjRandom() & 1));
			obj.delete();
			if (jjGameTicks - LastGemColorWallSamplePlayed > 35) {
				LastGemColorWallSamplePlayed = jjGameTicks;
				jjSamplePriority(BL18::HPTrigger);
			}
		}
	}
}

int LastBallGemCollision = 0;
class Basketball : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		if (obj.state == STATE::DEACTIVATE) {
			if (jjDeactivatingBecauseOfDeath)
				obj.deactivate();
			else {
				jjAddObject(obj.eventID, obj.xOrg, obj.yOrg, 0, CREATOR::LEVEL);
				obj.delete();
			}
		} else {
			if (obj.isBlastable) {
				if (obj.yPos > jjWaterLevel && obj.state != STATE::START) {
					obj.isBlastable = false;
					jjSample(obj.xPos, obj.yPos, SOUND::COMMON_WATER);
					jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, jjWaterLevel)].determineCurAnim(ANIM::COMMON, 3);
				}
				obj.behave(BEHAVIOR::ROTATINGROCK);
			} else {
				const auto xSpeed = abs(obj.xSpeed);
				obj.yPos = jjWaterLevel;
				obj.ySpeed = 0;
				obj.behave(BEHAVIOR::ROTATINGROCK);
				if (abs(obj.xSpeed) < xSpeed) {
					obj.xSpeed = (obj.xSpeed < 0) ? -xSpeed : xSpeed; //don't stop
				}
			}
			/*if (PlayerRoom.Type == RoomTypes::Dethjump && jjGameTicks - LastBallGemCollision > 6)
				for (uint i = jjObjectCount; --i > 0;) {
					jjOBJ@ gem = jjObjects[i];
					if (gem.eventID == OBJECT::FIVEHUNDREDBUMP && gem.isActive && gem.doesCollide(obj)) {
						LastBallGemCollision = jjGameTicks;
						obj.xSpeed *= -1;
						obj.xAcc *= -1;
						gem.var[0] = 31;
						gem.state = STATE::ACTION;
					}
				}*/
			if (BL18::Player.platform == obj.objectID && !jjMaskedHLine(int(BL18::Player.xPos + obj.xSpeed) - 14, 28, int(BL18::Player.yPos)))
				BL18::Player.xPos += obj.xSpeed;
		}
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) { //still use normal bullet collision code, but don't hurt the player
		if (bullet !is null) {
			obj.scriptedCollisions = false;
			bullet.objectHit(obj, HANDLING::SPECIAL);
			obj.scriptedCollisions = true;
		}
		return true;
	}
}

