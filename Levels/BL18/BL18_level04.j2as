		jjPalette.copyFrom(64, 8, 48, jjPalette); //brown to pink
		jjPalette.apply();
		
		for (uint i = 0; i < 100; ++i)
			Scenes[2].insertAt(0, IntroLetter(i<<1, jjRandom()%640, jjRandom()%480, STRING::Size(jjRandom() % 3), IntroLetterStyle::JumpOut, "?"));
			
		string fourthScene = "Guess again,";
		int fourthSceneXPos = 212;
		for (uint i = 0; i < fourthScene.length; ++i) {
			string letter = "?";
			letter[0] = fourthScene[i];
			Scenes[3].insertAt(0, IntroLetter(i<<3, fourthSceneXPos, 250, STRING::MEDIUM, IntroLetterStyle::RotateIn, letter));
			Scenes[4].insertAt(0, IntroLetter(jjRandom()&3, fourthSceneXPos, 250, STRING::MEDIUM, IntroLetterStyle::JumpOut, letter));
			if (letter == " ")
				fourthSceneXPos += 18;
			else
				fourthSceneXPos += jjAnimFrames[jjAnimations[jjAnimSets[ANIM::FONT] + STRING::MEDIUM] + letter[0] - 32].width + 1;
		}
	}
	bool Do() override {
		if (Scenes.length != 0) {
			array<IntroElement@>@ scene = Scenes[0];
			for (uint i = 0; i < scene.length; ++i)
				++scene[i].Age;
			return true;
		}
		jjPalette.copyFrom(64, 8, 64, DesktopPalette);
		jjPalette.apply();
		jjMusicStop();
		BL18::Player.spriteMode = SPRITE::PLAYER;
		BL18::Player.xSpeed = -4;
		return false;
	}
	void Draw(jjCANVAS@ canvas) const override {
		canvas.drawRectangle(0, 0, jjResolutionWidth, jjResolutionHeight, 0);
		
		const int xOrg = (jjResolutionWidth - 640) / 2;
		const int yOrg = (jjResolutionHeight - 480) / 2;
		
		if (Scenes.length != 0) {
			const array<IntroElement@>@ scene = Scenes[0];
			for (uint i = 0; i < scene.length; ++i) {
				const IntroElement@ element = scene[i];
				if (element.Age >= 0)
					element.Draw(xOrg,yOrg, canvas);
			}
		}
	}
}

