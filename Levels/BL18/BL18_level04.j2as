class Cow : BL18::Enemy {
	array<uint> BulletAnims = {11, 15, 25, 39, 53, 76};
	Cow(jjOBJ@ preset) {
		super(preset, BL18::AnimSets::Cow);
		preset.curAnim = jjAnimSets[animSetID];
		preset.determineCurFrame();
		preset.energy = 25;
		gender = BL18::Gender::Female;
		Layer = 3;
	}
	void onBehave(jjOBJ@ obj) override {
		if (obj.state == STATE::DONE)
			return;
		else if (obj.state == STATE::FREEZE)
			obj.behave(BEHAVIOR::FLOATSUCKER, false);
		else if (obj.state == STATE::DEACTIVATE) {
			deboss(obj);
			if (obj.playerHandling == HANDLING::SPECIALDONE)
				obj.delete();
			else
				obj.deactivate();
		} else if (obj.state == STATE::START) {
			//just hang out
		} else {
			obj.special = int(jjSin(jjGameTicks << 5) * 20); //angle
			const float speed = BL18::IsMurderer ? 1.2 : 0.2;
			if (BL18::Player.xPos > obj.xPos + 80) {
				obj.direction = 1;
				obj.xPos += speed;
			} else if (BL18::Player.xPos < obj.xPos - 80) {
				obj.direction = -1;
				obj.xPos -= speed;
			}
			if (BL18::Player.yPos > obj.yPos + 30) {
				obj.yPos += speed;
			} else if (BL18::Player.yPos < obj.yPos - 30) {
				obj.yPos -= speed;
			}
			if (jjGameTicks & (BL18::IsMurderer ? 15 : 31) == 10) {
				jjOBJ@ bullet = jjObjects[jjAddObject(OBJECT::SHARD, obj.xPos - 12*obj.direction, obj.yPos + 50, obj.objectID, CREATOR::OBJECT, BEHAVIOR::BOUNCEONCE)];
				bullet.playerHandling = HANDLING::ENEMYBULLET;
				bullet.animSpeed = 1;
				bullet.killAnim = jjAnimSets[ANIM::AMMO] + 4;
				bullet.curAnim = jjAnimSets[ANIM::PICKUPS] + BulletAnims[jjRandom() % BulletAnims.length];
				bullet.behave(BEHAVIOR::BIRDFEATHER);
				bullet.xSpeed /= 2;
				jjSample(bullet.xPos, bullet.yPos, SOUND::COMMON_PLOOP1);
			}
		}
	}
	void deboss(const jjOBJ@ obj) const {
		if (BL18::Player.boss == obj.objectID) {
			BL18::Player.bossActivated = false;
			BL18::Player.boss = 0;
			jjMusicLoad(BL18::musicFilename);
		}
	}
	void onDraw(jjOBJ@ obj) override {
		if (obj.state == STATE::START)
			return;
		drawHearts(obj);
		jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame+1, obj.special + 256*obj.direction, obj.direction,1, obj.state == STATE::DONE ? SPRITE::TINTED : obj.state == STATE::FREEZE ? SPRITE::FROZEN : obj.justHit == 0 ? SPRITE::SINGLEHUE : SPRITE::SINGLECOLOR, obj.state == STATE::DONE || obj.justHit != 0 ? 48 : ((jjRandom() % 10 + 2) << 3));
		jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame+2, obj.special + 256*obj.direction, obj.direction,1, obj.state == STATE::DONE ? SPRITE::TINTED : obj.state == STATE::FREEZE ? SPRITE::FROZEN : obj.justHit == 0 ? SPRITE::NORMAL : SPRITE::SINGLECOLOR, 48);
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
		BL18::Enemy::onObjectHit(obj, bullet, player, force);
		if (obj.energy <= 0) {
			const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
			jjSamplePriority(BL18::HPTrigger);
			jjEventSet(xTile,yTile, OBJECT::GENERATOR);
			jjParameterSet(xTile,yTile, 0,8, OBJECT::GRAPES); //balloon
			jjParameterSet(xTile,yTile, 8,5, 5); //delay
			jjAddObject(OBJECT::GENERATOR, obj.xOrg,obj.yOrg, 0,CREATOR::LEVEL);
			deboss(obj);
		}
		return true;
	}
}


void onDrawLayer5(jjPLAYER@, jjCANVAS@ canvas) {
	if (PlayerRoom !is null && PlayerRoom.ID == 70) { //dethmaze
		jjPAL backup = jjPalette;
		jjPalette = DesktopPalette; //but don't apply; we're going to cheat instead
		for (uint i = 0; i < 4; ++i) {
			const auto@ loc = DethmazeShortcutLocations[i];
			canvas.drawSpriteFromCurFrame(loc[0], loc[1], FirstShortcutFrame + CurrentShortcutList[i], 0, SPRITE::BLEND_LIGHTEN,185 + int(jjSin((jjGameTicks << 3) + (i << 8)) * 64));
		}
		jjPalette = backup;
	}
}

bool SeenBNIntro = false;
class IntroElement {
	int Age;
	void Draw(int,int, jjCANVAS@) const {}
	IntroElement(){}
}
class IntroEndScene : IntroElement {
	void Draw(int,int,jjCANVAS@) const override {
		auto@ scenes = cast<BNIntro>(BL18::CurrentPopup).Scenes;
		scenes.removeAt(0);
	}
	IntroEndScene(int a) { Age = -a; }
}
class IntroVerbalElement : IntroElement{
	int X, Y;
}
enum IntroLetterStyle {
	Abrupt = 0, RotateIn, JumpOut
}
class IntroLetter : IntroVerbalElement {
	uint Letter;
	IntroLetterStyle Style;
	float XSpeed = (int(jjRandom() & 31) - 16) / 5;
	IntroLetter(int a, int x, int y, STRING::Size s, IntroLetterStyle t, string l) {
		Age = -a;
		X = x;
		Y = y;
		Style = t;
		Letter = jjAnimations[jjAnimSets[ANIM::FONT] + s] + l[0] - 32;
	}
	void Draw(int xOrg, int yOrg, jjCANVAS@ canvas) const override {
		switch (Style) {
			case JumpOut:
				if (Age < 100) {
					float yPos = Y;
					float ySpeed = -3;
					for (int i = 0; i < Age; ++i)
						yPos += ySpeed += 0.15;
					canvas.drawSpriteFromCurFrame(xOrg + X + int(XSpeed * Age), yOrg + int(yPos), Letter);
				}
				return;
			case RotateIn:
				if (Age < 70) {
					const int intensity = 70-Age;
					const float scale = 1 + intensity / 14.0;
					canvas.drawRotatedSpriteFromCurFrame(xOrg + X, yOrg + Y, Letter, int(XSpeed * intensity), scale,scale, SPRITE::BLEND_NORMAL, Age * 3 + 50);
					return;
				}
				break;
		}
		canvas.drawSpriteFromCurFrame(xOrg + X, yOrg + Y, Letter);
	}
}
enum IntroStringStyle {
	Abrupt = 0, FadeIn, Sprinkler, SpinIn, BounceIn, RandomOffset, FallDown
}
class IntroString : IntroVerbalElement {
	STRING::Size Size;
	IntroStringStyle Style;
	string Letters;
	IntroString(int a, int x, int y, STRING::Size s, IntroStringStyle t, string l) {
		Age = -a;
		X = x;
		Y = y;
		Size = s;
		Style = t;
		Letters = l;
	}
	void Draw(int xOrg, int yOrg, jjCANVAS@ canvas) const override {
		switch (Style) {
			case FadeIn:
				if (Age < 64) {
					canvas.drawString(xOrg + X, yOrg + Y, Letters, Size, STRING::NORMAL,0, SPRITE::BLEND_NORMAL, Age<<2);
					return;
				}
				break;
			case SpinIn:
			case BounceIn:
				if (Age < 128) {
					canvas.drawString(xOrg + X, yOrg + Y, Letters, Size, Style == SpinIn ? STRING::SPIN : STRING::BOUNCE,255 - (Age<<1));
					return;
				}
				break;
			case Sprinkler:
				for (uint i = 0; i < 2; ++i) {
					const uint angle = (i << 9) + (Age << 1);
					const float xStep = jjSin(angle) * 16, yStep = jjCos(angle) * 10;
					for (uint j = 0; j < 5; ++j)
						canvas.drawString(xOrg + X + int(xStep*j), yOrg + Y + int(yStep*j), Letters, Size, STRING::NORMAL,0, SPRITE::BLEND_NORMAL, (5-j) << 4);
				}
				break;
			case RandomOffset: {
				const uint rand = jjRandom();
				canvas.drawString(xOrg + X - 20 + (rand & 3) * 15, yOrg + Y - 20 + ((rand >> 2) & 3) * 15, Letters, Size, STRING::NORMAL,0, SPRITE::BLEND_NORMAL, (rand >> 4) & 0xFF);
				return;
			}
			case FallDown:
				if (Age < 32) {
					canvas.drawString(xOrg + X, yOrg + Y - (32-Age) * 20, Letters, Size);
					return;
				}
		}
		canvas.drawString(xOrg + X, yOrg + Y, Letters, Size);
	}
}

