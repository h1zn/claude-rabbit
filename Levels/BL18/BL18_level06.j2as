array<jjLAYER@> SkywardLayers;
Foorumen Fooruman(jjObjectPresets[OBJECT::TUFBOSS]);
void onLevelLoad() {
jjIsSnowing = false;
	{
		const uint canopyFrameID = jjAnimations[jjAnimSets[ANIM::CUSTOM[BL18::AnimSets::Canopy]].load(BL18::AnimSets::Canopy, "BL18.j2a")];
		FirstPoemFrameID = canopyFrameID + 1;
		for (uint i = 0; i < 4; ++i)
			Resize::Resize(jjAnimFrames[FirstPoemFrameID + 2 + i], 2, i < 2 ? Resize::Method::AdvMAME2x : Resize::Method::NearestNeighbor);
		for (uint i = 0; i < 2; ++i) {
			jjPIXELMAP canopy(jjAnimFrames[canopyFrameID + (i << 1)]); //0, 2
			const int layerID = i+1; //1,2
			const int shift = 1-i; //1,0
			for (int x = 0; x < jjLayerWidth[layerID]; ++x)
				for (int y = 0; y < jjLayerHeight[layerID]; ++y) {
					jjPIXELMAP canopyTile;
					for (uint xx = 0; xx < 32; ++xx)
						for (uint yy = 0; yy < 32; ++yy)
							canopyTile[xx,yy] = canopy[(x << 5) | xx, (y << 5) | yy] >> shift;
					const uint16 tileID = jjTileGet(layerID, x, y);
					canopyTile.save(tileID, false);
					//jjTileType[tileID] = 5; //heat
				}
		}
		jjLayers[1].spriteMode = SPRITE::ALPHAMAP;
		jjLayers[1].spriteParam = 23;
		
		jjLayers[2].spriteMode = SPRITE::BLEND_DODGE; //should be HARDLIGHT but JJ2+'s implementation is screwed
		
		//https://www.videoblocks.com/video/new-version-magical-rain-of-sparkling-orbs-with-light-rays-from-sky-seamless-loop-motion-background-4k-ultra-hd-gold-brown-orange-golden-yellow-bu7fpaedeiyswl4bm
		
		//jjLAYER LightenCanopyComponent(jjLayers[1]);
		//LightenCanopyComponent.spriteMode = SPRITE::BLEND_LIGHTEN;
		//LightenCanopyComponent.spriteParam = 63;
		//auto layers = jjLayerOrderGet();
		//layers.insertAt(0, LightenCanopyComponent);
		//jjLayerOrderSet(layers);
	}
	
	jjANIMATION@ leaves = jjAnimations[jjAnimSets[ANIM::PLUS_SCENERY]];
	for (uint i = 0; i < leaves.frameCount; ++i)
		jjAnimFrames[leaves + i].transparent = true;
		
	for (int i = 10; i <= 245; ++i) {
		const jjPALCOLOR old = MLLE::Palette.color[i];
		MLLE::Palette.color[i].setHSL(old.getHue() + 10, old.getSat(), old.getLight());
	}
	MLLE::Palette.apply();
	
	ForestPalette = jjBackupPalette;
	ForestPalette.copyFrom(16, 80, 16, MLLE::Palette);
	ForestPalette.fill(jjPALCOLOR(34, 139, 34), .33);
	
	HocusPalette.load("BL18_Foo.pal");
	
	//some arcane weapons stuff... should be done before BL18::Setup just in case, because these ANIM::CUSTOM slots are kinda hardcoded
	jjAnimSets[ANIM::CUSTOM[22]].load(0, "Meteor.j2a");
	jjAnimSets[ANIM::CUSTOM[23]].load(0, "CosmicDust.j2a");
	jjAnimSets[ANIM::CUSTOM[24]].load(0, "Mortar.j2a");
	jjAnimSets[ANIM::CUSTOM[27]].load(0, "Lightningrod.j2a");
	
	jjSampleLoad(SOUND::ORANGE_SWEEP2R, "rustycreaksmall.wav");
	jjSampleLoad(SOUND::P2_TONG, "HPFirePlayer.wav");
	jjSampleLoad(SOUND::P2_THROW, "HPOuch.wav");
		
	@BL18::myCoinWarpFunction = StartStage1;
	@BL18::myLevelReload = UseRightPalette;
	@BL18::myHUD = fixPalette;
	TrueColor::EnableCaching();
	BL18::Setup();
	
	jjTexturedBGTexture = TEXTURE::MEDIVO;
	onFunction11(false);
	
	const uint numberOfParallaxFrames = jjLayerHeight[8] * 4;
	for (uint i = 0; i < numberOfParallaxFrames; ++i)
		RowStarts.insertLast(int(jjRandom()));
	const uint pixelsPerFrame = jjLayerHeight[8] * 32 / numberOfParallaxFrames;
	const uint frameWidth = 320;
	FirstParallaxFrameID = jjAnimations[jjAnimSets[TrueColor::FindCustomAnim()].allocate(array<uint>={numberOfParallaxFrames})];
	for (uint y = 0; y < numberOfParallaxFrames; ++y) {
		jjPIXELMAP(0, y * pixelsPerFrame, frameWidth, pixelsPerFrame, 8).save(jjAnimFrames[FirstParallaxFrameID + y]);
	}
	
	//jjAddObject(OBJECT::STEADYLIGHT,0,0, 0,CREATOR::OBJECT, FlickerLight);

	if (jjAnimSets[ANIM::SONICPLAT] != 0) { //just testing for debugging
		jjOBJ@ platform = jjObjectPresets[OBJECT::SONICPLATFORM];
		jjANIMFRAME@ platFrame = jjAnimFrames[platform.curFrame];
		jjPIXELMAP(0, 0+4, 64, 32-4, 5).save(platFrame);
		platFrame.hotSpotX = -32;
		platform.behavior = BloxoniusPlatform;
	}
	
	if (jjAnimSets[ANIM::UTERUS] != 0) {
		for (int i = 0; i < 6; ++i) {
			const jjANIMATION@ anim = jjAnimations[jjAnimSets[ANIM::UTERUS] + i];
			BL18::Recolor(anim, array<uint8>={16, 80}, BL18::RecolorReplace(154));
		}
		for (uint i = 0; i < 2; ++i) {
			jjANIMFRAME@ shieldFrame = jjAnimFrames[jjObjectPresets[OBJECT::UTERUS].curFrame - 1 - i];
			jjPIXELMAP(0, i*32 + 32 + 4, 64, 18, 5).save(shieldFrame);
			shieldFrame.hotSpotX = -32;
			shieldFrame.hotSpotY = -10;
		}
		Uterus(jjObjectPresets[OBJECT::UTERUS]);
		jjObjectPresets[OBJECT::CRAB].behavior = BEHAVIOR::INACTIVE; //cheap fix
		
		for (int x = 0; x < jjLayerWidth[4]; ++x)
			for (int y = jjLayerHeight[4] - 1; y >= 0; --y)
				if (jjEventGet(x, y) == OBJECT::UTERUS) //stand-in for coin
					BL18::CollectibleLocations.insertLast(BL18::CollectibleLocation(BL18::Point(x * 32 + 15, y * 32 + 15), BL18::CollectibleTypes::Coin));
			
		for (uint i = 0; i < 20; ++i)
		jjAnimFrames[BL18::CoinFirstFrame + i] = jjAnimFrames[jjObjectPresets[OBJECT::CRAB].curFrame + (i & 7)];
	}
	
	const auto jillEventID = OBJECT::MILK;
	Kangaroo::MakeEventJill(jillEventID, 0, false);
	JillWrapper(jjObjectPresets[jillEventID]);
	Foo(jjObjectPresets[OBJECT::MORPH]);
	
	//get some anims/sounds for arcane weapons
	if (jjAnimSets[ANIM::HATTER] == 0)
		jjAnimSets[ANIM::HATTER].load();
	if (jjAnimSets[ANIM::MONKEY] == 0)
		jjAnimSets[ANIM::MONKEY].load();
		
	jjObjectPresets[OBJECT::GRASSPLATFORM].behavior = FerrisWheel;
	jjObjectPresets[OBJECT::GRASSPLATFORM].playerHandling = HANDLING::PARTICLE; //the way the object's xPos/yPos change a lot means this can't be used for bullet collisions
	const auto recolorGreen = array<uint8> = {123,122,121,119,117,115,113,112}, recolorOrange = array<uint8> = {171,170,168,167,165,164,161,160};
	for (int i = 0; i < 1; ++i) {
		const jjANIMATION@ anim = jjAnimations[jjAnimSets[ANIM::GRASSPLAT] + i];
		BL18::Recolor(anim, array<uint8>={16}, recolorGreen);
		BL18::Recolor(anim, array<uint8>={40}, recolorOrange);
	}
	
	jjObjectPresets[OBJECT::STOMPSCENERY].behavior = SlightButtstompSceneryCheat;
	
	jjObjectPresets[OBJECT::BOMB].behavior = function(obj) { obj.behavior = SpringCord(); };
	jjObjectPresets[OBJECT::BOMB].playerHandling = HANDLING::SELFCOLLISION;
	
	jjObjectPresets[OBJECT::DIAMONDUSPOLE].behavior = Seesaw;
	jjObjectPresets[OBJECT::DIAMONDUSPOLE].playerHandling = HANDLING::SELFCOLLISION;
	jjObjectPresets[OBJECT::DIAMONDUSPOLE].triggersTNT = false;
	jjAnimFrames[jjObjectPresets[OBJECT::DIAMONDUSPOLE].curFrame].hotSpotY /= 2; //center
	if (jjAnimSets[ANIM::ROCK] == 0)
		jjAnimSets[ANIM::ROCK].load();
	Resize::Resize(jjAnimSets[ANIM::ROCK], 1, 0.5);
	
	jjObjectPresets[OBJECT::PINKPLATFORM].curFrame = jjObjectPresets[OBJECT::GRASSPLATFORM].curFrame;
	jjObjectPresets[OBJECT::PINKPLATFORM].behavior = Pulley;
	
	jjObjectPresets[OBJECT::SPIKEBOLL].curAnim = jjObjectPresets[OBJECT::GRASSPLATFORM].curFrame+1;
	jjObjectPresets[OBJECT::SPIKEBOLL].energy = 0; //unkillable
	jjObjectPresets[OBJECT::SPIKEBOLL].isFreezable = false;
	jjObjectPresets[OBJECT::SPIKEBOLL].behavior = SpikeBoll;
	const jjANIMATION@ anim = jjAnimations[jjAnimSets[ANIM::SPIKEBOLL] + 0];
	BL18::Recolor(anim, array<uint8>={72}, BL18::RecolorReplace(16));
	BL18::Recolor(anim, array<uint8>={24,48}, recolorOrange);
	
	ForestyBackgroundLayers = array<jjLAYER@> = { MLLE::GetLayer("Tree Leaves"), MLLE::GetLayer("Trees"), MLLE::GetLayer("Copy of Trees"), MLLE::GetLayer("Foliage"), MLLE::GetLayer("God Rays") };
	SkywardLayers = array<jjLAYER@> = { MLLE::GetLayer("Skyward"), MLLE::GetLayer("Skyward 2") };
	for (uint i = 0; i < ForestyBackgroundLayers.length; ++i)
		ForestyBackgroundLayers[i].hasTiles = false;
	GodColors.load("BL18_GodJ.pal");
	DevilColors = GodColors;
	for (uint i = 0; i < 255; ++i)
		DevilColors.color[i].swizzle(COLOR::RED, COLOR::BLUE, COLOR::GREEN);
	jjSetDarknessColor();
	
	jjPIXELMAP rain(2,32); //rain code by PJ
	for (uint y = 0; y < rain.height; ++y)
		rain[0,y] = (y <= 24) ? 75 : 74;
	@anim = jjAnimations[jjAnimSets[ANIM::COMMON].firstAnim + 2];
	for (uint frameID = 0; frameID < anim.frameCount; ++frameID) {
		jjANIMFRAME@ frame = jjAnimFrames[anim.firstFrame + frameID];
		rain.save(frame);
		frame.hotSpotX = 0;
		frame.hotSpotY = -frame.height;
	}
	
	jjObjectPresets[OBJECT::BOLLY].playerHandling = HANDLING::PARTICLE;
	jjObjectPresets[OBJECT::BOLLY].behavior = Redeemer;
	jjObjectPresets[OBJECT::BOLLY].lightType = LIGHT::NORMAL;
	jjObjectPresets[OBJECT::BOLLY].light = 13;
	Resize::Resize(jjAnimations[jjAnimSets[ANIM::SONCSHIP]], 2, Resize::Method::AdvMAME2x);
}

