class Uterus : BL18::Enemy {
	Uterus(jjOBJ@ preset) {
		super(preset);
		preset.energy = 20; //less than 100
		preset.direction = 1; //multiplied for scale
		gender = BL18::Gender::Female; //obviously
	}
	void onBehave(jjOBJ@ obj) override {
		if (obj.state == STATE::DEACTIVATE) { //fixes JJ2 bug
			obj.xOrg = obj.var[8];
			obj.yOrg = obj.var[9];
			obj.deactivate();
		} else if (obj.state == STATE::START) {
			obj.var[8] = int(obj.xOrg); //cUTERUS changes these a lot, but we need them for interacting with the event map...
			obj.var[9] = int(obj.yOrg);
			if (!BL18::Player.noclipMode && obj.findNearestPlayer(270*270) >= 0) {
				obj.state = STATE::EXTRA; //skip spike ball phase
				obj.var[3] = 2;
				obj.var[4] = -1;
				obj.var[7] = 96;
				jjTriggers[0] = true; //can't go too far away while fighting
			} else
				obj.frameID = (jjGameTicks >> 3) & 7;
		} else if (obj.state != STATE::DONE) {
			const uint movementTimes = (obj.bulletHandling == HANDLING::DETECTBULLET) ? BL18::IsMurderer ? 3 : 2 : 1; //move faster while invincible
			obj.var[7] = obj.var[7] - (movementTimes - 1); //increase at constant speed
			for (uint i = movementTimes; i != 0; --i) {
				obj.behave(BEHAVIOR::UTERUS, false);
				obj.age += obj.var[2] / 2; //shield plate angle
			}
			if (jjDifficulty > 1 || BL18::IsMurderer)
				ShieldLoop(obj);
		}
	}
	void onDraw(jjOBJ@ obj) override {
		drawMainSprite(obj, obj.determineCurFrame(false), obj.var[2] * 4 - 256); //* 2 in native code
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
		const auto originalX = obj.var[8], originalY = obj.var[9]; //get all these properties out of obj NOW, in case it's no longer the object we want it to be by the end of this method
		const auto lastX = obj.xOrg, lastY = obj.yOrg;
		obj.xOrg = originalX;
		obj.yOrg = originalY;
		Enemy::onObjectHit(obj, bullet, player, force);
		if (obj.energy <= 0) {
			cast<BL18::CollectableCoin>(cast<jjBEHAVIORINTERFACE>(jjObjectPresets[OBJECT::SILVERCOIN].behavior)).onObjectHit(obj, bullet, player, force);
			jjTriggers[0] = false;
		}
		if (obj.eventID == OBJECT::UTERUS) { //didn't die and get replaced with another object, e.g. a bloodspatter or the coin itself
			obj.xOrg = lastX;
			obj.yOrg = lastY;
		}
		return true;
	}
	void ShieldLoop(const jjOBJ@ obj) const { //adapted from Demon's FireLoop
		const int shieldFramePhysical = jjObjectPresets[obj.eventID].curFrame;
		const int shieldFrameVisual = shieldFramePhysical - 1;
		for (int i = 0; i < 1024; i += 256) {
			const int angle = obj.age + i;
			const int distance = int(abs(256 - ((192 + obj.var[7]) & 0x1FF))) / 4 + 32;
			const float xPos = obj.xPos + jjSin(angle) * distance;
			const float yPos = obj.yPos + jjCos(angle) * distance;
			{
				jjDrawRotatedSpriteFromCurFrame(xPos, yPos, shieldFrameVisual - ((i >> 8) & 1), angle + 512);
				for (uint j = jjObjectCount; --j != 0;) {
					jjOBJ@ bullet = jjObjects[j];
					if (bullet.playerHandling == HANDLING::PLAYERBULLET && bullet.freeze == 0 && bullet.isActive && jjAnimFrames[bullet.curFrame].doesCollide(int(bullet.xPos), int(bullet.yPos), bullet.direction, jjAnimFrames[shieldFramePhysical], int(xPos), int(yPos), 1)) {
						bullet.state = STATE::EXPLODE;
					}
				}
			}
		}
	}
}

enum FooWeapon { None, Meteor, Duster, Mortar, Rod, Sanguine};
bool FooSoundsLoaded = false;
class Foo : BL18::Enemy {
	Foo(jjOBJ@ preset) {
		super(preset);
		preset.energy = 3;
		gender = BL18::Gender::Male;
		preset.determineCurAnim(ANIM::JAZZ, RABBIT::STAND);
		preset.determineCurFrame();
		preset.direction = -1;
		preset.triggersTNT = false;
	}
	void onBehave(jjOBJ@ obj) override {
		uint frameID;
		const auto lastCurFrame = obj.curFrame;
		const bool powerup = BL18::IsMurderer;
		switch (obj.state) {
			case STATE::START: {
				if (!FooSoundsLoaded) {
					FooSoundsLoaded = true;
					jjSampleLoad(SOUND::ORANGE_BOEMR, "expmine.wav");
					jjSampleLoad(SOUND::ORANGE_BOEML, "lowind.wav");
					jjSampleLoad(SOUND::ORANGE_MERGE, "f_gren4.wav");
					jjSampleLoad(SOUND::COMMON_ELECTRICHIT, "ZAPFIZZ1.wav");
					jjSampleLoad(SOUND::COMMON_ELECTRIC2, "ZAPFIZZ2.wav");
				}
				const uint characterID = (jjRandom()) % uint(jjIsTSF ? 3 : 2); //aesthetic only
				if (characterID == 0)
					obj.special = ANIM::JAZZ;
				else if (characterID == 1)
					obj.special = ANIM::SPAZ;
				else
					obj.special = ANIM::LORI;
				switch (obj.doesHurt = (BL18::getParameterAtOrigin(obj, 0, 3) % 6)) { //weapon
					case FooWeapon::Meteor:
						obj.state = STATE::BOUNCE;
						obj.curAnim = RABBIT::JUMPFIRERIGHT;
						break;
					case FooWeapon::Duster:
						obj.state = STATE::JUMP;
						obj.curAnim = RABBIT::JUMPFIRERIGHT;
						break;
					case FooWeapon::Mortar:
						obj.state = STATE::ATTACK;
						obj.curAnim = RABBIT::DIVEFIRERIGHT;
						obj.counter = jjRandom();
						break;
					case FooWeapon::Rod:
						obj.state = STATE::FLY;
						obj.curAnim = RABBIT::AIRBOARD;
						break;
					case FooWeapon::Sanguine:
					default:
						obj.state = STATE::WALK;
						break;
				}
				if (obj.doesHurt != FooWeapon::Rod)
					obj.putOnGround(true);
				break; }
			case STATE::BOUNCE: //Meteor
				if (obj.counter == 0) //starting out
					obj.yAcc = obj.yPos;
				obj.yPos = obj.yAcc - abs(jjSin(obj.counter += 8) * 128);
				if (obj.counter & 511 == 0) {
					jjSample(obj.xPos, obj.yPos, SOUND::COMMON_JUMP);
					jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos + 12)].determineCurAnim(ANIM::AMMO, 72);
				} else if (obj.counter & 511 == 256) {
					jjOBJ@ meteor = fireBullet(obj, lastCurFrame, powerup ? OBJECT::BOUNCERBULLETPU : OBJECT::BOUNCERBULLET);
					jjSample(meteor.xPos, meteor.yPos, SOUND::ORANGE_BOEMR, 42, !powerup? 22000 : 20000);
					meteor.determineCurAnim(ANIM::CUSTOM[22], powerup ? 0 : 1);
					meteor.ySpeed = 0;
					meteor.killAnim = jjObjectPresets[OBJECT::SEEKERBULLET].killAnim;
					meteor.lightType = powerup ? LIGHT::BRIGHT : LIGHT::POINT;
					meteor.light = 10;
					meteor.xSpeed = abs(meteor.xSpeed);
					meteor.xAcc = abs(meteor.xAcc);
					meteor.behavior = Meteor;
				}
				obj.direction = (obj.xPos < BL18::Player.xPos) ? 1 : -1;
				frameID = obj.counter >> 6;
				break;
			case STATE::JUMP: //Duster
				if (obj.ySpeed < 0 && jjMaskedPixel(int(obj.xPos), int(obj.yPos + obj.ySpeed) - 12))
					obj.ySpeed = 0;
				else
					obj.yPos += obj.ySpeed += 0.25;
				if (jjMaskedPixel(int(obj.xPos), int(obj.yPos) + 12)) {
					jjSample(obj.xPos, obj.yPos, SOUND::COMMON_JUMP);
					jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos, obj.yPos + 12)].determineCurAnim(ANIM::AMMO, 72);
					obj.ySpeed = -8;
				} else {
					const float targetX = obj.xPos + obj.direction * 1.25 * (4 - obj.energy);
					if (jjMaskedVLine(int(targetX), int(obj.yPos) - 12, 24))
						obj.direction = -obj.direction;
					else
						obj.xPos = targetX;
				}
				if (++obj.counter % 50 == 1) {
					jjOBJ@ duster = fireBullet(obj, lastCurFrame, powerup ? OBJECT::ICEBULLETPU : OBJECT::ICEBULLET);
					duster.determineCurAnim(ANIM::CUSTOM[23], powerup ? 0 : 1);
					duster.counterEnd = 180;
					duster.lightType = LIGHT::BRIGHT;
					duster.light = powerup ? 12 : 8;
					duster.playerHandling = HANDLING::PICKUP;
					duster.scriptedCollisions = true;
					duster.behavior = Duster;
				}
				obj.var[1] = jjSampleLooped(obj.xPos,obj.yPos,SOUND::ORANGE_BOEML,obj.var[1]);
				frameID = obj.counter >> 6;
				break;
			case STATE::ATTACK: //Mortar
				if (++obj.counter & (obj.creatorType == CREATOR::LEVEL ? 63 : 127) == 5) {
					jjOBJ@ mortar = fireBullet(obj, lastCurFrame, powerup ? OBJECT::SEEKERBULLETPU : OBJECT::SEEKERBULLET);
					jjSample(mortar.xPos, mortar.yPos, SOUND::ORANGE_MERGE, 0, 0);
					mortar.determineCurAnim(ANIM::CUSTOM[22], powerup ? 0 : 1);
					mortar.xSpeed = 7;
					mortar.xAcc = abs(mortar.xAcc);
					mortar.ySpeed = (powerup ? -10 : -9) + (jjRandom() & ((4 << (3 - obj.energy)) - 1)) / 2.f;
					mortar.counterEnd = powerup ? 105 : 90;
					mortar.behavior = Mortar;
				}
				obj.direction = (obj.xPos < BL18::Player.xPos) ? 1 : -1;
				frameID = obj.counter >> 6;
				break;
			case STATE::FLY: //Rod
				obj.xPos = obj.xOrg + jjSin((++obj.counterEnd) << 2) * 100;
				obj.yPos = obj.yOrg + 8 * (1 - jjSin(jjGameTicks * 12));
				obj.direction = (((obj.counterEnd + 64) & 255) < 128) ? 1 : -1;
				if (obj.counterEnd & 127 == 64) {
					obj.var[0] = 22;
					obj.curAnim = RABBIT::AIRBOARDTURN;
					jjSample(obj.xPos, obj.yPos, SOUND::COMMON_AIRBTURN, 100, 16537);
				}
				if (obj.var[0] != 0) {
					if ((obj.var[0] = obj.var[0] - 1) == 0) {
						obj.curAnim = RABBIT::AIRBOARD;
					jjSample(obj.xPos, obj.yPos, SOUND::COMMON_AIRBTURN2, 0, 16537);
					} else
						frameID = obj.var[0] / 3;
				}
				if (obj.var[0] == 0) { //not turning
					frameID = obj.counterEnd >> 3;
					if (obj.age < -60 && (obj.energy < 3 || (BL18::Player.yPos > obj.yPos && abs(BL18::Player.xPos - obj.xPos) < 50)) && !jjMaskedHLine(int(obj.xPos) - 5, 10, int(obj.yPos))) {
						jjOBJ@ rod = fireBullet(obj, lastCurFrame, OBJECT::TNT);
						jjSample(rod.xPos, rod.yPos, SOUND::COMMON_MONITOR, 0, 12500);
						rod.determineCurAnim(ANIM::CUSTOM[27], 0);
						rod.playerHandling = HANDLING::PARTICLE;
						rod.bulletHandling = HANDLING::IGNOREBULLET;
						rod.counterEnd = 255;
						rod.var[4] = 1; //color
						rod.behavior = Lightningrod;
					}
				}
				obj.var[1] = jjSampleLooped(obj.xPos,obj.yPos,SOUND::COMMON_AIRBOARD,obj.var[1]);
				break;
			case STATE::WALK: //Sanguine/None
				obj.xSpeed = (4 - obj.energy) * 1.5 * obj.direction;
				obj.behave(BEHAVIOR::WALKINGENEMY, false);
				if (obj.doesHurt == FooWeapon::Sanguine) {
					if (obj.counter % 70 == 10) {
						for (uint i = obj.energy; i < 4; ++i) {
							jjOBJ@ spear = fireBullet(obj, lastCurFrame, powerup ? OBJECT::FIREBALLBULLETPU : OBJECT::FIREBALLBULLET);
							jjSample(spear.xPos, spear.yPos, SOUND::HATTER_PTOEI, 0, powerup? 19000:20000);
							spear.xSpeed = abs(obj.xSpeed) * 4;
							spear.xAcc = abs(spear.xAcc);
							if (!powerup) {
								spear.ySpeed = -1.5;
								spear.counterEnd = 85;
								spear.var[6] = 0;
							} else {
								spear.ySpeed = -2;
								spear.counterEnd = 95;
								spear.var[6] = 8;
							}
							spear.behavior = BloodSpear;
							if (obj.energy != 3 && i == 3)
								spear.ySpeed *= 2;
							else if (i == 2)
								spear.ySpeed = 0;
						}
					}
				}
				if (obj.energy == 3) obj.curAnim = RABBIT::RUN1;
				else obj.curAnim = RABBIT::RUN2 + (2 - obj.energy);
				frameID = ++obj.counter / int(10 - abs(obj.xSpeed));
				break;
			default: //deactivate/freeze/done
				obj.behave(BEHAVIOR::TUBETURTLE, false);
				return;
		}
		const auto@ anim = jjAnimations[jjAnimSets[obj.special] + obj.curAnim];
		obj.curFrame = anim.firstFrame + (frameID % anim.frameCount);
	}
	jjOBJ@ fireBullet(jjOBJ@ obj, int lastCurFrame, OBJECT::Object eventID) const {
		obj.age = 5;
		obj.curFrame = lastCurFrame; //for gunspot, etc.
		jjOBJ@ bullet = jjObjects[obj.fireBullet(eventID)];
		bullet.playerHandling = HANDLING::ENEMYBULLET;
		bullet.animSpeed = BL18::IsMurderer ? 2 : 1;
		return bullet;
	}
	void onDraw(jjOBJ@ obj) override {
		drawHearts(obj);
		const SPRITE::Mode mode = obj.state == STATE::FREEZE ? SPRITE::FROZEN : obj.justHit == 0 ? SPRITE::PLAYER : SPRITE::SINGLECOLOR;
		jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, mode, (mode==SPRITE::PLAYER) ? BL18::FirstFriendPlayerID + 23 : 48);
		if (obj.state == STATE::DONE)
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::TRANSLUCENTCOLOR, 48); //got to do it this way, because TINTED would erase the player colors and make it look like jazz instead of purplejazz
		else if (obj.age-- > 0) { //flare time
			const jjANIMFRAME@ frame = jjAnimFrames[obj.curFrame];
			jjDrawSprite(obj.xPos + (frame.hotSpotX - frame.gunSpotX) * obj.direction, obj.yPos + frame.hotSpotY - frame.gunSpotY, ANIM::AMMO, 16, 0, obj.direction, SPRITE::PLAYER, BL18::FirstFriendPlayerID + 23); //flare
		}
	}
}



void Meteor(jjOBJ@ obj) {
	obj.behave(BEHAVIOR::BULLET, obj.state == STATE::EXPLODE? true:false);
	
	if (obj.state != STATE::EXPLODE) {
		obj.var[2] = 0;
		obj.age += obj.direction == 0? 10 : 10 * obj.direction;
		
		jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::CUSTOM[22], obj.eventID == OBJECT::BOUNCERBULLET? 1:0, 0, -obj.age, 1, 1, obj.eventID == OBJECT::BOUNCERBULLET || obj.var[4] == 1? SPRITE::SINGLEHUE : SPRITE::NORMAL, 72);
		
		jjPARTICLE@ smoke = jjAddParticle(PARTICLE::SMOKE);
		if (smoke !is null) {
			smoke.xPos = smoke.xPos;
			smoke.yPos = smoke.yPos;
		}
		
		if (obj.eventID == OBJECT::BOUNCERBULLETPU && obj.var[4] == 0) {
			jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::CUSTOM[22], 0, 0, -obj.age, 1, 1, SPRITE::TRANSLUCENTSINGLEHUE, 40);
			jjPARTICLE@ cinders = jjAddParticle(PARTICLE::FIRE);
			if (cinders !is null) {
				cinders.xPos = int(obj.xPos - 8) + jjRandom()%17;
				cinders.yPos = int(obj.yPos - 8) + jjRandom()%17;
			}
		}
		
		if (obj.yPos > jjWaterLevel) {
			obj.var[4] = 1;
			obj.xSpeed = obj.xSpeed * 0.875;
			obj.ySpeed = obj.ySpeed * 0.875;
		}
	
		switch (obj.direction) {
			case 1: obj.xSpeed -= obj.eventID == OBJECT::BOUNCERBULLET? 0.1:0.15; obj.ySpeed += obj.eventID == OBJECT::BOUNCERBULLET? 0.15:0.2; break;
			case -1: obj.xSpeed += obj.eventID == OBJECT::BOUNCERBULLET? 0.1:0.15; obj.ySpeed += obj.eventID == OBJECT::BOUNCERBULLET? 0.15:0.2; break;
		}
		
		if (obj.xSpeed == 0) obj.ySpeed += 0.4;
		if (obj.ySpeed > 8) obj.ySpeed = 8;
		

		
	} else {
		obj.age = 0;
		if (obj.var[2] == 0) {
			jjSample(obj.xPos, obj.yPos, SOUND::COMMON_BENZIN1, 0, 0);
			obj.var[2] = 1;
			
			if (obj.eventID == OBJECT::BOUNCERBULLETPU) {
				for (int i = -1; i <= 1; i+= 2) {
					jjOBJ@ rock = jjObjects[jjAddObject(OBJECT::SHARD, int(obj.xPos + (i * 12)), int(obj.yPos - 8), obj.creatorID, CREATOR::OBJECT, Rock)];
					rock.determineCurAnim(ANIM::CUSTOM[22], 1);
					rock.playerHandling = HANDLING::ENEMYBULLET;
					rock.var[3] = 2;
					rock.var[4] = obj.var[4];
					rock.var[6] = 8;
					rock.animSpeed = 2;
					rock.direction = i;
					rock.xSpeed = 6 * i;
					rock.ySpeed = -3;
					rock.state = STATE::FLY;
					rock.lightType = LIGHT::POINT;
					rock.light = 10;
					rock.counterEnd = jjObjectPresets[OBJECT::BOUNCERBULLET].counterEnd;
					rock.killAnim = jjObjectPresets[OBJECT::BOUNCERBULLET].killAnim;
				}
			}
		}
	}
}

void Rock(jjOBJ@ obj) {
	obj.behave(BEHAVIOR::BULLET, obj.state == STATE::EXPLODE? true:false);
	
	if (obj.state == STATE::FLY) {
		obj.age += obj.direction == 0? 10 : 10 * obj.direction;
		jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::CUSTOM[22], 1, 0, -obj.age, 1, 1, obj.var[4] == 1? SPRITE::SINGLEHUE : SPRITE::NORMAL, 72);
		
		switch (obj.direction) {
			case 1: obj.xSpeed -= 0.05; obj.ySpeed += 0.1; break;
			case -1: obj.xSpeed += 0.05; obj.ySpeed += 0.1; break;
		}
		
		if (obj.yPos > jjWaterLevel) {
			obj.var[4] = 1;
			obj.xSpeed = obj.xSpeed * 0.875;
			obj.ySpeed = obj.ySpeed * 0.875;
		}
		
		jjPARTICLE@ smoke = jjAddParticle(PARTICLE::SMOKE);
		if (smoke !is null) {
			smoke.xPos = obj.xPos;
			smoke.yPos = obj.yPos;
		}
		
	}
	
}

class CosmicDust : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		const jjOBJ@ creator = jjObjects[obj.creatorID];
		if (creator.eventID != OBJECT::MORPH) { //ded
			obj.delete();
			return;
		}
		obj.behave(obj.state == STATE::EXPLODE? BEHAVIOR::BULLET : BEHAVIOR::TNT, false);
		obj.var[0] = obj.var[0] + (5 * obj.direction);
		
		if (obj.state != STATE::EXPLODE) {
			obj.xPos = creator.xPos + (obj.eventID == OBJECT::ICEBULLETPU? 160:120)*jjSin((obj.counter + 1)*12) * (obj.direction != 0? obj.direction : 1);
			obj.yPos = creator.yPos - (obj.eventID == OBJECT::ICEBULLETPU? 80:60)*jjCos((obj.counter + 1)*12);
		} else {
			obj.delete();
		}
	}
	void onDraw(jjOBJ@ obj) {
		if (obj.state != STATE::EXPLODE && obj.counter > 1) {
			jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::CUSTOM[23], obj.eventID == OBJECT::ICEBULLETPU? 0:1, 0, -obj.var[0], 1, 1, SPRITE::ALPHAMAP, obj.eventID == OBJECT::ICEBULLETPU? 34:72);
			jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::CUSTOM[23], obj.eventID == OBJECT::ICEBULLETPU? 0:1, 0, -obj.var[0], 1, 1, SPRITE::ALPHAMAP, obj.eventID == OBJECT::ICEBULLETPU? 34:72);
		}
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) {
		player.frozen = obj.freeze;
		obj.delete();
		return true;
	}
}

void Mortar(jjOBJ@ obj) {
	obj.behave(obj.state == STATE::EXPLODE? BEHAVIOR::RFBULLET : BEHAVIOR::BULLET, false);
	if (obj.yPos <= 0) obj.state = STATE::EXPLODE;
	obj.var[0] = int(atan2(-obj.ySpeed, obj.xSpeed) * (512.f * 0.318309886142228f));
	
	switch (obj.state) {
		case STATE::START:
			obj.state = STATE::FLY;
			obj.lightType = LIGHT::POINT;
			obj.var[2] = 0;
		break;
		
		case STATE::FLY:
			jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::CUSTOM[24], obj.eventID == OBJECT::SEEKERBULLETPU? 2:0, jjGameTicks >> 2, obj.var[0], 0.75, 0.75, SPRITE::NORMAL);
			
			if (obj.counter % 5 == 0 && !jjLowDetail) {
				jjOBJ@ trail = jjObjects[jjAddObject(OBJECT::EXPLOSION, int(obj.xPos - jjCos(obj.var[0])), int(obj.yPos - jjSin(obj.var[0])))];
				trail.determineCurAnim(ANIM::AMMO, 3);
				trail.lightType = LIGHT::NONE;
				trail.playerHandling = HANDLING::PARTICLE;
				trail.bulletHandling = HANDLING::IGNOREBULLET;
				trail.isBlastable = false;
			}
			
			switch (obj.direction) {
				case 1: obj.xSpeed -= 0.275; obj.ySpeed += 0.225; break;
				case -1: obj.xSpeed += 0.275; obj.ySpeed += 0.225; break;
			}
			if (obj.xSpeed == 0) obj.ySpeed += 0.3;
			if (obj.ySpeed > 12) obj.ySpeed = 12;
		break;
		
		case STATE::EXPLODE:
			jjDrawResizedSprite(obj.xPos, obj.yPos, ANIM::AMMO, 5, obj.curFrame + 5, 2, 2, SPRITE::NORMAL);
		
			if (obj.var[2] == 0) {
				jjOBJ@ blast = jjObjects[jjAddObject(OBJECT::BULLET, obj.xPos, obj.yPos, obj.creatorID, CREATOR::OBJECT, MortarShockwave)];
				obj.var[2] = 1;
				blast.var[2] = 1;
				blast.animSpeed = obj.animSpeed;
			}
		break;
	}
}

void MortarShockwave(jjOBJ@ obj) {
	obj.playerHandling = HANDLING::PARTICLE;
	obj.bulletHandling = HANDLING::IGNOREBULLET;
	
	if (obj.var[2] == 1) {
		obj.lightType = obj.var[2] == 1? LIGHT::RING2 : LIGHT::NONE;
		obj.var[1] = obj.var[1] + 1;
		obj.light += 2;
		obj.var[4] = obj.light * 4;
		/*
		for (int i = 1; i < jjObjectCount; i++) {
			jjOBJ@ target = jjObjects[i];
			float dx = target.xPos - obj.xPos, dy = target.yPos - obj.yPos;
			if ((target.eventID == OBJECT::TNT || target.behavior == BEHAVIOR::MONITOR || target.behavior == BEHAVIOR::AMMO15 || target.eventID == OBJECT::GUNCRATE || target.eventID == OBJECT::GEMCRATE || target.eventID == OBJECT::CARROTCRATE || target.playerHandling == HANDLING::ENEMY || target.eventID == OBJECT::DESTRUCTSCENERY) && target.var[4] == 0) {
				if (dx * dx + dy * dy < obj.var[4] * obj.var[4]) {
					if (target.eventID != OBJECT::TNT) {
						obj.objectHit(target, target.playerHandling == HANDLING::ENEMY? HANDLING::ENEMY : HANDLING::SPECIAL);
						if (target.playerHandling != HANDLING::ENEMY) target.state = STATE::KILL;
					}
					else target.state = STATE::EXPLODE;
					if (target.playerHandling != HANDLING::ENEMY) target.var[4] = 1;
				}
				else target.var[4] = 0;
			}
			else if ((target.behavior == BEHAVIOR::PICKUP || target.eventID == OBJECT::TNTAMMO3 || target.eventID == OBJECT::GUN9AMMO3) && target.state == STATE::FLOAT) {
				if (dx * dx + dy * dy < obj.var[4] * obj.var[4])
					target.state = STATE::FLOATFALL;
			}
		}*/
		
		jjPLAYER@ player = BL18::Player;
		float dx = player.xPos - obj.xPos, dy = player.yPos - obj.yPos;
		if (dx * dx + dy * dy < obj.var[4] * obj.var[4])
			player.hurt(obj.animSpeed);
	}
	
	if (obj.var[1] == 14) {
		obj.var[1] = 0;
		obj.var[2] = 0;
		obj.var[4] = 0;
		obj.delete();
	}
}

void Lightningrod(jjOBJ@ obj) {
	obj.behave(BEHAVIOR::BULLET, false);
	
	jjDrawSprite(obj.xPos, obj.yPos, ANIM::CUSTOM[27], obj.var[0] == 1? obj.var[4] : 0, obj.var[0] == 1? jjGameTicks / 10 % 6 : 0, obj.direction, SPRITE::NORMAL);
	
	if (obj.counter == 2) {
		obj.age = 0;
		obj.var[1] = 0;
	}
	
	if (obj.counter == 127) obj.counter = 2; 
	
	if (!jjMaskedHLine(int(obj.xPos - 16), 24, int(obj.yPos + 8))) {
		obj.yPos += 6;
		obj.var[0] = 0;
		obj.lightType = LIGHT::POINT;
	} else {
		obj.var[0] = 1;
	}
	
	if (obj.var[0] == 1) {
		obj.age++;
		if (obj.var[1] == 0) {
			jjSample(obj.xPos, obj.yPos, SOUND::COMMON_LANDCAN1, 0, 30000);
			obj.var[1] = 1;
		}
		obj.lightType = LIGHT::BRIGHT;
		obj.light = 10;
		if (obj.age % 20 == 0) {
			for (int i = -4; i <= 4; i += 4) {
				int id = jjAddObject(OBJECT::LIGHTNINGSHIELDBULLET, obj.xPos, obj.yPos - 12, obj.creatorID, CREATOR::OBJECT, Electricity);
				if (id != 0) {
					jjOBJ@ zap = jjObjects[id];
					zap.lightType = LIGHT::NONE;
					zap.counterEnd = 6;
					zap.animSpeed = BL18::IsMurderer ? 2 : 1;
					zap.direction = obj.direction;
					zap.lightType = LIGHT::NONE;
					zap.playerHandling = HANDLING::ENEMYBULLET;
					zap.var[3] = 1;
					zap.var[6] = 8;
					zap.xSpeed = i;
					zap.xAcc = 0;
					if (i == 0) zap.ySpeed = -4;
				}
			}
		}
	}
	
	if (obj.age == 420) {
		obj.var[0] = obj.var[1] = 0;
		obj.particlePixelExplosion(0);
		obj.delete();
	}
}

void Electricity(jjOBJ@ obj) {
	obj.behave(BEHAVIOR::BULLET, false);
}

void BloodSpear(jjOBJ@ obj) {
	obj.behave(BEHAVIOR::BULLET, false);
	obj.var[0] = int(atan2(-obj.ySpeed, obj.xSpeed) * (512.f * 0.318309886142228f));
	
	if (obj.state == STATE::FLY) {
		jjDrawRotatedSprite(obj.xPos, obj.yPos, ANIM::HATTER, 3, jjGameTicks >> 2, obj.var[0], 2, 1, SPRITE::SINGLEHUE, obj.eventID == OBJECT::FIREBALLBULLETPU? 15:24);
		switch (obj.direction) {
			case 1: obj.xSpeed -= 0.1; obj.ySpeed += 0.1; break;
			case -1: obj.xSpeed += 0.1; obj.ySpeed += 0.1; break;
		}
		if (obj.xSpeed == 0) obj.ySpeed += 0.15;
		
		jjPARTICLE@ blood = jjAddParticle(PARTICLE::ICETRAIL);
		blood.xPos = obj.xPos;
		blood.yPos = obj.yPos;
		blood.icetrail.color = obj.eventID == OBJECT::FIREBALLBULLETPU? 16:24;
		blood.icetrail.colorStop = obj.eventID == OBJECT::FIREBALLBULLETPU? 24:32;
	}
	
	if (obj.state == STATE::EXPLODE) {
		jjDrawSprite(obj.xPos, obj.yPos, ANIM::MONKEY, 1, obj.curFrame, obj.direction, SPRITE::SINGLEHUE, obj.eventID == OBJECT::FIREBALLBULLETPU? 15:24);
		if (obj.var[1] < 27) {
			if (obj.var[1] == 1) jjSample(obj.xPos, obj.yPos, SOUND::HATTER_SPLOUT, 0, 20000);
			obj.var[1] = obj.var[1] + 1;
		}
		if (obj.var[1] == 27) {
			obj.var[1] = 0;
			obj.delete();
		}
	}
}

void FerrisWheel(jjOBJ@ obj) {
	if (obj.state == STATE::KILL) {
		if (obj.doesHurt != 0) { //has children
			for (int i = 0; i < obj.var[1]; ++i) {
				const int fooID = obj.var[3 + i];
				if (fooID != 0) {
					jjOBJ@ foo = jjObjects[fooID];
					if (foo.eventID == OBJECT::MORPH && foo.isActive && foo.state != STATE::DONE)
						foo.delete();
				}
			}
		}
		return;
	}
	if (obj.state == STATE::START) {
		obj.state = STATE::CIRCLE;
		obj.special = 0;
		obj.var[1] = BL18::getParameterAtOrigin(obj, 2, 5); //platform count
		obj.var[2] = BL18::getParameterAtOrigin(obj, 8, 4); //chain length
		obj.var[0] = 256/obj.var[1]*BL18::getParameterAtOrigin(obj, 0, 2)*512; //sync (and therefore angle)
		if ((obj.doesHurt = BL18::getParameterAtOrigin(obj, 12, 1)) != 0) {
			jjParameterSet(0,0,0,3, FooWeapon::Mortar);
			for (int i = 0; i < obj.var[1]; ++i) {
				jjObjects[obj.var[3 + i] = jjAddObject(OBJECT::MORPH,0,0, obj.objectID)].deactivates = false;
			}
		}
	} else if (obj.state == STATE::DEACTIVATE) {
		obj.state = STATE::KILL;
		obj.behave();
		obj.deactivate();
	} else {
		const auto chainFrameID = obj.curFrame+1;
		const auto lastX = obj.xPos, lastY = obj.yPos;
		const auto step = jjAnimFrames[chainFrameID].width - 1;
		const BL18::Point playerLocation(BL18::Player.xPos, BL18::Player.yPos);
		array<int> angles;
		array<BL18::Point> platforms;
		array<BL18::SortableDistance> distances; //the object's xPos/yPos (unlike its xOrg/yOrg) change all the time, to be at whichever platform image is closest to the player
		for (int i = 0; i < obj.var[1]; ++i) {
			auto orgX = obj.xOrg, orgY = obj.yOrg;
			const int angle = obj.var[0] / 512 + i * 1024 / obj.var[1];
			const auto stepX = jjSin(angle) * step, stepY = jjCos(angle) * step;
			for (int j = 0; j < obj.var[2]; ++j, orgX += stepX, orgY += stepY) {
				if (i == 0 || j != 0)
					jjDrawSpriteFromCurFrame(orgX, orgY, chainFrameID);
			}
			jjDrawSpriteFromCurFrame(orgX, orgY, obj.curFrame);
			if (obj.doesHurt != 0) {
				const int fooID = obj.var[3 + i];
				if (fooID != 0) {
					jjOBJ@ foo = jjObjects[fooID];
					if (foo.eventID == OBJECT::MORPH && foo.isActive && foo.state != STATE::DONE) {
						foo.xPos = orgX;
						foo.yPos = orgY - 22;
					} else {
						obj.var[3 + i] = 0; //defeated
						jjParameterSet(uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, 12, 1, 0); //don't generate new foo objects next time this respawns
					}
				}
			}
			angles.insertLast(angle);
			platforms.insertLast(BL18::Point(orgX, orgY));
			const float deltaX = abs(playerLocation.x - orgX);
			const float deltaY = abs(playerLocation.y - orgY);
			distances.insertLast(BL18::SortableDistance(deltaX * deltaX + deltaY * deltaY, i));
		}
		distances.sortAsc();
		const auto target = platforms[distances[0].index];
		obj.xPos = target.x;
		obj.yPos = target.y;
		obj.bePlatform(lastX, lastY);
		if (obj.objectID == BL18::Player.platform) {
			int angle = angles[distances[0].index] & 1023;
			if (obj.yPos < obj.yOrg)
				angle -= int(BL18::Player.xPos - obj.xPos);
			const int intensity = 256 - int(abs(256 - (angle & 511)));
			if (angle > 512)
				obj.special += intensity;
			else
				obj.special -= intensity;
		}
		obj.var[0] = obj.var[0] + obj.special;
		const int deaccel = 24;
		if (obj.special > deaccel)
			obj.special -= deaccel;
		else if (obj.special < -deaccel)
			obj.special += deaccel;
		else
			return;
		obj.counterEnd = jjSampleLooped(obj.xPos,obj.yPos,SOUND::ORANGE_SWEEP2R,obj.counterEnd);
	}
	
}

float vlen(float x,float y) {
	return float(sqrt(x*x+y*y));
}
class SpringCord : jjBEHAVIORINTERFACE { //no attempt was made to understand how any of this works, or more importantly, how it's supposed to work
	array<float> string1x(32);
	array<float> string1y(32, 0);
	array<float> velox(32, 0);
	array<float> veloy(32, 0);
	array<float> string2x(32);
	array<float> string2y(32);
	void onBehave(jjOBJ@ obj) {
		int t;
		uint i;
		float xv1,yv1,mag1,ex1,xv2,yv2,mag2,ex2,xv,yv;

		if (obj.state == STATE::START) {
			
			for (t=0;t<32;t++)
				string1x[t]=float(t); 
			
			obj.state = STATE::ACTION;
		} else if (obj.state == STATE::DEACTIVATE) {
			obj.deactivate();
		} else {
			string1x[15]=(-obj.xOrg+BL18::Player.xPos)/8;
			string1y[15]=(-obj.yOrg+BL18::Player.yPos)/8;
		
			for (i=1;i<31;i++) {
				xv1=string1x[i-1]-string1x[i];
				yv1=string1y[i-1]-string1y[i];
				mag1=vlen(xv1,yv1);
				ex1=mag1-1.f;

				xv2=string1x[i+1]-string1x[i];
				yv2=string1y[i+1]-string1y[i];
				mag2=vlen(xv2,yv2);
				ex2=mag2-1.f;

				xv=((xv1/mag1)*ex1)+((xv2/mag2)*ex2);
				yv=((yv1/mag1)*ex1)+((yv2/mag2)*ex2)+0.21f;

				velox[i]=velox[i]*0.97f+xv*0.01f;
				veloy[i]=veloy[i]*0.97f+yv*0.01f;

				string2x[i]=string1x[i]+velox[i];
				string2y[i]=string1y[i]+veloy[i];
			};

			const jjANIMFRAME@ myFrame = jjAnimFrames[obj.curFrame];
			const jjANIMFRAME@ playerFrame = jjAnimFrames[BL18::Player.curFrame];
			for (i=0;i<32;i++) {
				string1x[i] = string2x[i];
				string1y[i] = string2y[i];
				const auto x = obj.xOrg+string1x[i]*4, y = obj.yOrg+string1y[i]*4;
				if (i < 16)
					jjDrawSprite(x,y, ANIM::AMMO, 1, i + (jjGameTicks>>3));
				if (myFrame.doesCollide(int(x), int(y), obj.direction, playerFrame, int(BL18::Player.xPos), int(BL18::Player.yPos), BL18::Player.direction))
					BL18::Player.hurt();
			}
		}
	}
}

void Seesaw(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.var[0] = -256 * 256; //initial angle: flat
		obj.var[7] = obj.curFrame;
		obj.curFrame = jjAnimations[jjObjectPresets[OBJECT::ICEBULLETPU].special];
		obj.state = STATE::WAIT; //for BEHAVIOR::SPRING to work
		obj.var[9] = BL18::getParameterAtOrigin(obj, 5, 1) + 1; //width, x1 or x2
		const int xDelta = BL18::getParameterAtOrigin(obj, 0, -2) * 80 * obj.var[9]; //0, 1, and 3 (-1) are good values
		if (xDelta != 0)
			obj.var[8] = jjAddObject(OBJECT::ROTATINGROCK, obj.xOrg + xDelta, obj.yOrg - 80, obj.objectID, CREATOR::OBJECT, Seeball);
		if (jjEventGet(uint(obj.xOrg)>>5, (uint(obj.yOrg)>>5) + 1) == AREA::BELTRIGHT)
			obj.xOrg += 15;
	} else if (obj.state == STATE::DEACTIVATE) {
		if (obj.var[8] != 0) //ball
			jjObjects[obj.var[8]].delete();
		obj.deactivate();
	} else {
		const int angle = obj.var[0] >> 8;
		const float stepX = jjSin(angle) * 4;
		const float stepY = jjCos(angle) * 4;
		const uint frameHeight = jjAnimFrames[obj.var[7]].height / (4 / obj.var[9]);
		const auto playerX = BL18::Player.xPos;
		const bool hasBall = obj.var[8] != 0;
		jjOBJ@ ball = jjObjects[obj.var[8]];
		const auto ballX = ball.xPos, ballY = ball.yPos;
		bool foundPlayer = false;
		bool foundBall = false;
		{
			float xPos = obj.xOrg - stepX * frameHeight / 2, yPos = obj.yOrg - stepY * frameHeight / 2;
			if (BL18::Player.ySpeed >= 0.f || (hasBall && ball.ySpeed >= 0.f)) {
				const auto playerY = BL18::Player.yPos;
				for (uint i = 0; i < frameHeight; ++i, xPos += stepX, yPos += stepY) {
					if (!foundPlayer && BL18::Player.fly == FLIGHT::NONE)
						if (abs(playerX-xPos) < 3 && abs(playerY-(yPos-20)) < (abs(obj.age) <= 500 ? 8 : 18)) {
							foundPlayer = true;
							obj.xPos = xPos;
							obj.yPos = yPos;
							BL18::Player.yPos = yPos - 12;
							obj.beSolid();
							obj.age += int(obj.xOrg - xPos) / obj.var[9]; //momentum
							//obj.draw(); //preview
							//break;
						}
					if (!foundBall && obj.var[8] != 0 && ball.ySpeed >= 0.f && ball.freeze == 0)
						if (abs(ballX-xPos) < 3 && abs(ballY-(yPos-22)) < 8) {
							foundBall = true;
							ball.yPos = yPos - 22;
							obj.age += int((obj.xOrg - xPos) / obj.var[9] * ball.ySpeed * 4); //momentum
							ball.ySpeed = 0;
						}
				}
			}
			if (!foundPlayer)
				obj.clearPlatform();
		}
		const int proposedNewTarget = obj.var[0] + obj.age;
		const float multiplier = (obj.var[9] == 1 ? 2.0 : 1.8) * frameHeight;
		const float distanceToEndX = jjSin(proposedNewTarget >> 8) * multiplier;
		const float distanceToEndY = jjCos(proposedNewTarget >> 8) * multiplier;
		float impactX, impactY;
		if (!jjMaskedPixel(int(impactX = obj.xOrg + distanceToEndX), int(impactY = obj.yOrg + distanceToEndY)) && !jjMaskedPixel(int(impactX = obj.xOrg - distanceToEndX), int(impactY = obj.yOrg - distanceToEndY))) {
			obj.var[0] = proposedNewTarget;
			const int deaccel = 8;
			if (obj.age > deaccel)
				obj.age -= deaccel;
			else if (obj.age < -deaccel)
				obj.age += deaccel;
			if (abs(obj.age) > deaccel)
				obj.counterEnd = jjSampleLooped(obj.xPos,obj.yPos,SOUND::ORANGE_SWEEP2R,obj.counterEnd);
		} else {
			obj.age /= -2; //bounce back
			if (abs(obj.age) > 512) {
				jjSample(impactX,impactY,SOUND::SMALTREE_GROUND);//, 31);
				jjObjects[jjAddObject(OBJECT::EXPLOSION, impactX, impactY)].determineCurAnim(ANIM::AMMO, 2); //same as used for shootable poles
			}
			if (hasBall) {
				if (foundPlayer) {
					const auto deltaX = (playerX - obj.xOrg) / obj.var[9];
					if (deltaX > 0 != obj.age > 0) {
						obj.ySpeed = abs(deltaX) / -4; //based on distance from center
						const auto realCurFrame = obj.curFrame;
						obj.special = CREATOR::PLAYER;
						obj.state = STATE::SPRING;
						obj.behave(BEHAVIOR::SPRING, false);
						obj.curFrame = realCurFrame;
					}
				}
				if (foundBall) {
					const auto deltaX = (ballX - obj.xOrg) / obj.var[9];
					if (deltaX > 0 != obj.age > 0) {
						ball.ySpeed = abs(deltaX) / -8; //based on distance from center
					}
				}
				obj.age = 0; //don't bounce back after all
			}
		}
		jjDrawRotatedSpriteFromCurFrame(obj.xOrg, obj.yOrg, obj.var[7], obj.var[0] >> 8, 1,obj.var[9]);
		//jjDrawSpriteFromCurFrame(obj.xOrg, obj.yOrg, jjObjectPresets[OBJECT::GRASSPLATFORM].curFrame+1); //pivot
	}
}
void Seeball(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.state = STATE::FLY; //use regular rock collision code
		obj.curFrame = jjAnimations[jjAnimSets[ANIM::ROCK]];
		obj.deactivates = false;
		obj.ySpeed = 0.05;
	} else if (obj.state == STATE::FREEZE) {
		obj.behave(BEHAVIOR::ROTATINGROCK, false); //whatever
	} else {
		if (obj.ySpeed != 0) {
			obj.yPos += obj.ySpeed += 0.25;
			if (obj.ySpeed == 0) obj.ySpeed += 0.25;
		}
	}
	jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, 1, obj.state == STATE::FREEZE ? SPRITE::FROZEN : SPRITE::NORMAL);
}

void Pulley(jjOBJ@ obj) {
	const auto chainFrameID = obj.curFrame+1;
	const auto step = jjAnimFrames[chainFrameID].width - 1;
	if (obj.state == STATE::START) {
		//obj.var[1] = BL18::getParameterAtOrigin(obj, 2, 5); //platform count
		obj.var[2] = BL18::getParameterAtOrigin(obj, 8, 4); //chain length
		obj.var[3] = obj.var[2] * step; //max height
		obj.var[0] = BL18::getParameterAtOrigin(obj, 0, 2) * obj.var[3] / 4; //sync
		obj.var[2] = obj.var[2] + (512 / step);
		obj.state = STATE::CIRCLE;
		obj.deactivates = false;
	} else if (obj.state == STATE::DEACTIVATE) {
		obj.deactivate();
	} else {
		const float lastX = obj.xPos, lastY = obj.yPos;
		float xPos;
		float yPos;
		int angle = 768 + obj.var[0];
		for (int i = 0; true; ++i) {
			if (angle > 768) {
				yPos = obj.yOrg + (angle - 768);
				xPos = obj.xOrg - 96;
			} else if (angle < 256) {
				yPos = obj.yOrg + (256 - angle);
				xPos = obj.xOrg + 96;
			} else {
				xPos = obj.xOrg + jjSin(angle) * 96;
				yPos = obj.yOrg + jjCos(angle) * 96;
			}
			if (i < obj.var[2]) {
				if (i != 0) {
					if (angle > 768 || angle < 256 || (i & 1) == 0)
						jjDrawSpriteFromCurFrame(xPos, yPos, chainFrameID);
				} else {
					if (BL18::Player.xPos < obj.xOrg) {
						obj.xPos = xPos;
						obj.yPos = yPos;
					}
					jjDrawSpriteFromCurFrame(xPos, yPos, obj.curFrame);
				}
				angle -= step;
			} else {
				if (BL18::Player.xPos >= obj.xOrg) {
					obj.xPos = xPos;
					obj.yPos = yPos;
				}
				jjDrawSpriteFromCurFrame(xPos, yPos, obj.curFrame);
				break;
			}
		}
		obj.bePlatform(lastX, lastY);
		//jjDrawString(obj.xOrg, obj.yOrg, "" + obj.var[0] + ": " + obj.var[3]);
		if (obj.objectID == BL18::Player.platform) {
			if (BL18::Player.xPos < obj.xOrg) {
				if (obj.var[0] < obj.var[3])
					obj.var[0] = obj.var[0] + 1;
				else
					return;
			} else {
				if (obj.var[0] > 0)
					obj.var[0] = obj.var[0] - 1;
				else
					return;
			}
			obj.counterEnd = jjSampleLooped(obj.xPos,obj.yPos,SOUND::ORANGE_SWEEP2R,obj.counterEnd);
		}
	}
}

void SpikeBoll(jjOBJ@ obj) {
	if (obj.special == 0 && (obj.state == STATE::START || jjGameTicks & 7 == 0)) {
		const auto me = obj.eventID;
		for (int otherObjectID = obj.objectID + 1; otherObjectID < jjObjectCount; ++otherObjectID) { //find something LATER in the object list
			const jjOBJ@ otherObj = jjObjects[otherObjectID];
			if (otherObj.eventID == me && otherObj.isActive) {
				const float deltaX = otherObj.xPos - obj.xPos;
				const float deltaY = otherObj.yPos - obj.yPos;
				const float distance = sqrt(deltaX * deltaX + deltaY * deltaY);
				if (distance < 160) {
					obj.special = int(distance / 20);
					obj.xAcc = deltaX / obj.special;
					obj.yAcc = deltaY / obj.special;
					break;
				}
			}
		}
	}
	if (obj.state == STATE::START) {
		obj.state = STATE::WAIT;
		obj.doesHurt = jjRandom();
	} else if (obj.state == STATE::DEACTIVATE) {
		obj.behave(BEHAVIOR::FLOATSUCKER, false);
	} else {
		for (int i = 0; i < obj.special; ++i) {
			jjDrawSpriteFromCurFrame(obj.xPos + i*obj.xAcc, obj.yPos + i*obj.yAcc, obj.curAnim);
		}
		if ((obj.doesHurt += 2) < 128)
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame);
		else
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame,1, SPRITE::BRIGHTNESS, (obj.doesHurt < 192) ? obj.doesHurt : 384 - obj.doesHurt);
	}
}

void SlightButtstompSceneryCheat(jjOBJ@ obj) {
	obj.xPos = obj.xOrg += 2;
	obj.behavior = BEHAVIOR::DESTRUCTSCENERY;
	obj.behave();
}

void Redeemer(jjOBJ@ obj) {
	if (obj.state == STATE::DEACTIVATE)
		obj.deactivate();
	else
		jjDrawSprite(obj.xPos - 6, obj.yPos + jjSin(jjGameTicks*10)*6, ANIM::SONCSHIP, 0, jjGameTicks>>2);
}

class JillWrapper : BL18::Enemy {
	JillWrapper(jjOBJ@ preset) {
		super(preset);
		preset.energy = 40;
	}
	void onBehave(jjOBJ@ obj) override {
		if (obj.state != STATE::DONE) {
			obj.behave(Kangaroo::Jill);
			if (obj.playerHandling == HANDLING::ENEMY)
				obj.playerHandling = HANDLING::SPECIAL;
		}
	}
	void onDraw(jjOBJ@ obj) override {
		//drawHearts(obj);
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
		const auto xPos = obj.xPos;
		const auto yPos = obj.yPos;
		if (force == -101) force = 0; //no damage from frozen speed collision
		Enemy::onObjectHit(obj, bullet, player, force);
		if (obj.energy <= 0) {
			if (BL18::IsMurderer)
				BL18::Player.food -= 1; //this one doesn't count
			else
				BL18::Player.lives -= 1; //same
			jjObjects[BL18::Player.boss = jjAddObject(OBJECT::TUFBOSS, (int(xPos) & ~31) + 4, 36*32 + 20)].yPos = yPos;
			if (cast<jjBEHAVIORINTERFACE@>(obj.behavior) is this) obj.delete();
		}
		return true;
	}
}

class Foorumen : BL18::Enemy {
	Foorumen(jjOBJ@ preset) {
		super(preset, BL18::AnimSets::Fooruman);
		preset.curAnim = jjAnimSets[animSetID] + 3;
		preset.determineCurFrame();
		preset.frameID = 0;
		preset.energy = 50; //reduced due to difficulty of injuring
		preset.age = preset.energy / 10 - 1;
		gender = BL18::Gender::Male;
		preset.playerHandling = HANDLING::PARTICLE;
		preset.lightType = LIGHT::BRIGHT;
		preset.light = 14;
	}
	void onBehave(jjOBJ@ obj) override {
		if (obj.state == STATE::DONE)
			return;
		else if (obj.state == STATE::START) {
			if (++obj.counter == 350) {
				obj.counter = 0;
				obj.lightType = LIGHT::NORMAL;
				obj.playerHandling = HANDLING::SPECIAL;
				obj.state = STATE::WALK;
				obj.direction = (BL18::Player.xPos > obj.xPos) ? 1 : -1;
				if (BL18::Player.health < jjMaxHealth-1) {
					BL18::Player.health += (jjMaxHealth - BL18::Player.health) / 2;
					//jjSamplePriority(SOUND::JAZZSOUNDS_JUMMY);
				}
				//else
					jjSamplePriority(SOUND::BUBBA_SNEEZE2);
				BL18::Player.showText("@@@Fooruman was hiding@inside the kangaroo!", STRING::MEDIUM);
			} else if (obj.counter < 300) {
				if (obj.yPos < obj.yOrg)
					obj.yPos += 0.5;
				if (obj.counter & 1 == 0) {
					for (int i = 0; i < 1024; i += 256)
						jjObjects[jjAddObject(OBJECT::BULLET, obj.xPos, obj.yPos, ((obj.counter << 3) + i) & 1023, CREATOR::OBJECT, FooStartupSequence)].curFrame = jjAnimations[jjAnimSets[animSetID] + 4];
				}
			}
			if (jjDifficulty > 1 && obj.counter & 31 == 31) {
				jjOBJ@ glove = jjObjects[jjAddObject(OBJECT::BOUNCEONCE, BL18::Player.xPos, 30*32)];
				glove.direction = SPRITE::FLIPV;
				glove.animSpeed = 1;
				glove.playerHandling = HANDLING::ENEMYBULLET;
				glove.determineCurAnim(ANIM::GLOVE, 2);
				glove.xSpeed = glove.xAcc = glove.ySpeed = 0;
			}
		} else if (obj.state == STATE::FREEZE)
			obj.behave(BEHAVIOR::FISH, false);
		else {
			if (jjGameTicks & 7 == 0) { //move every eighth tick
				if (obj.state == STATE::BOUNCE || obj.state == STATE::JUMP) {
					switch (++obj.counter) {
						case 0:
							obj.curFrame = jjAnimations[obj.curAnim - 2]; //jump!
						case 1:
						case 2:
							obj.yPos -= 32;
							break;
						case 3:
						case 4:
						case 5:
						case 6:
							obj.yPos -= 16;
							break;
						case 7:
							obj.curFrame += 1;
							break;
						case 8:
						case 9:
						case 10:
						case 11:
							obj.yPos += 16;
							break;
						case 14: //land.
							obj.curFrame -= 2; //standing
							if (obj.state == STATE::JUMP) {
								obj.curFrame = jjAnimations[obj.curAnim];
								obj.state = STATE::WALK;
							} else if (obj.doesHurt == 0)
								obj.state = STATE::FADEOUT;
							else
								obj.counter = -3;
						case 12:
						case 13:
							obj.yPos += 32;
							break;
					}
				}
				if ((obj.direction == 1) == (obj.xPos < BL18::Player.xPos)) {
					if (obj.state == STATE::WALK || obj.state == STATE::JUMP)
						obj.xPos += obj.direction * 16; //move
				} else
					obj.direction = -obj.direction; //turn around
				if (obj.state == STATE::WALK) {
					obj.curFrame = jjAnimations[obj.curAnim] + (++obj.frameID & 3);
					if (obj.counterEnd == 6) {
						uint random = 63;
						if (obj.energy < 20) random >>= 1;
						if (BL18::IsMurderer) random >>= 1;
						if (BL18::Player.keyDown) random >>= 1;
						if (BL18::Player.yPos < obj.yPos - 20) random >>= 1;
						if ((jjRandom() & random) == 0) {
							obj.state = STATE::JUMP;
							obj.counter = -1;
						}
					}
				}
				if (/*obj.counter >= 0 &&*/ ++obj.counterEnd >= uint8((obj.doesHurt == 0) ? (BL18::IsMurderer) ? 9 : 10 : 3) && obj.counterEnd < 100) {
					obj.counterEnd = 0;
					int bulletID;
					const auto xDelta = abs(BL18::Player.xPos - obj.xPos);
					if (obj.state != STATE::BOUNCE && obj.state != STATE::JUMP && xDelta < 56 && BL18::Player.yPos < obj.yPos - 20) {
						obj.state = STATE::FADEIN;
						obj.curFrame = jjAnimations[obj.curAnim - 1] + 1; //point up
						bulletID = jjAddObject(OBJECT::BULLET, obj.xPos, obj.yPos - 4, obj.objectID, CREATOR::OBJECT, FooLightning);
					} else if ((obj.state == STATE::WALK || obj.state == STATE::FADEOUT) && xDelta > 240) {
						obj.state = STATE::FADEIN;
						obj.curFrame = jjAnimations[obj.curAnim - 1] + 0; //point forwards
						obj.counterEnd = uint8(-5);
						bulletID = jjAddObject(OBJECT::BULLET, BL18::Player.xPos, obj.yOrg, obj.objectID, CREATOR::OBJECT, KillerSpell);
					} else {
						if (obj.state == STATE::FADEIN) {
							obj.state = STATE::FADEOUT;
							obj.curFrame = jjAnimations[obj.curAnim - 1] + 0; //point forwards
						} else if (obj.state == STATE::FADEOUT)
							obj.state = STATE::WALK;
						bulletID = jjAddObject(OBJECT::BULLET, obj.xPos, obj.yPos + 14, obj.objectID, CREATOR::OBJECT, FooLightning);
					}
					jjObjects[bulletID].curFrame = jjAnimations[jjAnimSets[animSetID] + 4] + (obj.counterEnd != uint8(-5) ? 0 : 3);
				} else if (obj.counterEnd == 2) {
					if (obj.state == STATE::FADEIN || obj.state == STATE::FADEOUT)
						obj.curFrame = jjAnimations[obj.curAnim - 3]; //basic standing
				}
				if (obj.doesHurt != 0) //potion counter
					--obj.doesHurt;
			}
		}
	}
	void onDraw(jjOBJ@ obj) override {
		if (obj.state == STATE::START)
			return;
		SPRITE::Mode mode = SPRITE::NORMAL;
		uint8 param = 24; //red
		if (obj.state == STATE::DONE) {
			mode = SPRITE::TINTED;
			param = 48;
		} else if (obj.freeze != 0)
			mode = SPRITE::FROZEN;
		else if (jjGameTicks & 4 == 0) { //injured (and therefore invincible)
			if (obj.justHit != 0)
				mode = SPRITE::SINGLECOLOR;
		} else if (obj.doesHurt != 0) { //potion
			mode = SPRITE::SINGLECOLOR;
			param = 15;
		}
		jjDrawSpriteFromCurFrame(obj.xPos,obj.yPos, obj.curFrame, obj.direction, mode,param);
		drawHearts(obj);
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
		if (obj.justHit != 0) {
			if (bullet !is null)
				bullet.state = STATE::EXPLODE;
			else
				player.hurt();
		} else {
			//if (bullet !is null) force = 1;
			Enemy::onObjectHit(obj, bullet, player, force);
			if (obj.energy <= 0) {
				player.activateBoss(false);
				jjAlert("|AAAAAAH FOO!!!", false, STRING::MEDIUM);
				onFunction1(null, 210);
			}
			else if (obj.justHit > 0) {
				obj.justHit = 35;
				const int newAge = obj.energy / 10;
				if (obj.age != newAge) {
					obj.age = newAge;
					obj.doesHurt = 24; //potion duration (in eight-tick increments)
					if (obj.state == STATE::WALK || obj.state == STATE::FADEOUT) { //on ground
						obj.state = STATE::BOUNCE;
						obj.counter = -1;
					}
				}
				jjSample(obj.xPos, obj.yPos, SOUND::P2_THROW);
			}
		}
		return true;
	}
}
void FooStartupSequence(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.state = STATE::FLY;
		obj.playerHandling = HANDLING::PARTICLE;
		obj.special = obj.creatorID; //angle
		obj.counter = 500;
		obj.lightType = LIGHT::POINT2;
		obj.light = 5;
	}
	if ((obj.counter -= 10) == 0)
		obj.delete();
	else
		jjDrawRotatedSpriteFromCurFrame(obj.xPos = (obj.xOrg - jjCos(obj.special) * obj.counter), obj.yPos = (obj.yOrg + jjSin(obj.special) * obj.counter), obj.curFrame + ((jjGameTicks + obj.objectID) & 1), obj.special);
}
void FooLightning(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		jjSample(obj.xPos, obj.yPos, SOUND::P2_TONG);
		obj.state = STATE::FLY;
		obj.animSpeed = 1;
		obj.playerHandling = HANDLING::ENEMYBULLET;
		const jjOBJ@ creator = jjObjects[obj.creatorID];
		obj.direction = creator.direction;
		if (creator.state == STATE::FADEIN) { //up
			obj.xSpeed = 0;
			obj.ySpeed = -32;
		} else {
			obj.xSpeed = obj.direction * 32;
			obj.ySpeed = 0;
		}
	} else {
		if (jjGameTicks & 7 == 0) {
			obj.xPos += obj.xSpeed;
			if (obj.ySpeed != 0)
				obj.yPos += obj.ySpeed;
			else if (BL18::Player.yPos < obj.yPos)
				obj.yPos -= 2;
			else
				obj.yPos += 2;
		}
		if (obj.state == STATE::EXPLODE || jjMaskedPixel(int(obj.xPos), int(obj.yPos))) {
			obj.xSpeed /= 32;
			obj.ySpeed /= 32;
			do {
				obj.xPos -= obj.xSpeed;
				obj.yPos -= obj.ySpeed;
			} while (jjMaskedPixel(int(obj.xPos), int(obj.yPos)));
			obj.curFrame += 2; //red and white stuff
			for (uint i = 0; i < 2; ++i)
				obj.particlePixelExplosion(2);
			obj.delete();
		} else {
			const auto curFrame = obj.curFrame + ((jjGameTicks & 8) >> 3);
			if (obj.ySpeed == 0)
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, curFrame, obj.direction);
			else
				jjDrawRotatedSpriteFromCurFrame(obj.xPos, obj.yPos, curFrame, 256, obj.direction);
			auto part = jjAddParticle(PARTICLE::ICETRAIL);
			if (part !is null) {
				part.xPos = obj.xPos;
				part.yPos = obj.yPos;
				part.icetrail.color = 40;
				part.icetrail.colorStop = 45;
			}
		}
	}
}
void KillerSpell(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.state = STATE::FALL;
		obj.animSpeed = 1;
		obj.playerHandling = HANDLING::ENEMYBULLET;
		obj.yPos -= 700;
		obj.lightType = LIGHT::FLICKER;
		obj.light = 1;
		jjSample(obj.xOrg, obj.yOrg, SOUND::Sample(SOUND::COMMON_BELL_FIRE + (jjRandom() & 1)));
	} else if (obj.yPos > obj.yOrg + 700)
		obj.delete();
	else {
		if (obj.yPos < obj.yOrg)
			jjDrawString(obj.xOrg - 32, obj.yOrg, "|Kïllër");
		jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos += 5, obj.curFrame);
	}
}

