uint FailureTimes = 0;
class PoetryResult : BL18::Popup {
	uint Counter = 200;
	uint StringIndex = 0;
	const array<string>@ ResultStrings = FailureResults[FailureTimes++];
	bool Do() override {
		if (++Counter == 270) {
			Counter = 0;
			if (StringIndex < ResultStrings.length) {
				BL18::Player.showText("@@@@@@@@" + jjRegexReplace(ResultStrings[StringIndex++], "@", jjSubscreenWidth > 640 ? "@@@" : jjSubscreenWidth > 400 ? "@@" : "@"), jjSubscreenWidth > 640 ? STRING::LARGE : jjSubscreenWidth > 400 ? STRING::MEDIUM : STRING::SMALL);
			} else if (FailureTimes < FailureResults.length) {
				BL18::Player.showText("");
				LevelStage -= 1;
				@BL18::CurrentPopup = PoetryWritingSession();
			} else {
				jjSetDarknessColor(); //iris out to black
				const array<string> FilenamesToTry = {"race11", "fsp7", "hh17_level06", "ml_qob", "trainer"};
				for (uint i = 0; i < FilenamesToTry.length; ++i)
					if (!jjSTREAM(FilenamesToTry[i] + ".j2l").isEmpty()) {
						jjNxt(FilenamesToTry[i], true, true);
						break;
					}
			}
		}
		return true;
	}
	void Draw(jjCANVAS@ canvas) const override {
		//all covered by showText and onDrawLayer8
	}
}

void BloxoniusPlatform(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		const int xSpeed = BL18::getParameterAtOrigin(obj, 2, -6);
		if (BL18::getParameterAtOrigin(obj, 2+6, 4) != 0) { //length
			//if (xSpeed == 0)
				//obj.behavior = IceCapPlatform;
			//else
				obj.behavior = BEHAVIOR::PLATFORM;
			return;
		}
		obj.xSpeed = float(xSpeed) / 2.f;
		obj.isFreezable = false;
		obj.state = STATE::FLY;
		obj.yPos -= 12;
		if (jjDifficulty > 0 && BL18::getParameterAtOrigin(obj, 0, 1) != 0) { //sync
			obj.doesHurt = 1;
			for (uint i = 0; i < 4; ++i)
				jjObjects[jjAddObject(OBJECT::LIME, i, 0, obj.objectID)].deactivates = false; //spikes, at tile 0,0 which has event parameters for them to use
		}
	} else if (obj.state == STATE::DEACTIVATE) {
		obj.clearPlatform();
		if (obj.doesHurt == 1)
			for (uint i = jjObjectCount-1; i > 0; --i) {
				jjOBJ@ spike = jjObjects[i];
				if (spike.behavior == BL18::Spikes && spike.creatorID == uint(obj.objectID))
					spike.delete();
			}
		obj.deactivate();
	} else {
		const float lastX = obj.xPos;
		const float targetX = obj.xPos + obj.xSpeed;
		jjPLAYER@ play = BL18::Player;
		if (obj.xSpeed < 0.f) {
			if (jjMaskedVLine(int(targetX - 31), int(obj.yPos), 20))
				obj.xSpeed *= -1;
			else {
				obj.xPos = targetX;
				/* if (play.platform == obj.objectID && play.xPos < obj.xPos - 24) {
					play.xPos = obj.xPos - 24;
					play.xSpeed = 1;
				} */
			}
		} else {
			if (jjMaskedVLine(int(targetX + 31), int(obj.yPos), 20))
				obj.xSpeed *= -1;
			else {
				obj.xPos = targetX;
				/* if (play.platform == obj.objectID && play.xPos > obj.xPos + 24) {
					play.xPos = obj.xPos + 24;
					play.xSpeed = -1;
				} */
			}
		}
		if (obj.doesHurt == 1) {
			for (uint i = jjObjectCount-1; i > 0; --i) {
				jjOBJ@ spike = jjObjects[i];
				if (spike.behavior == BL18::Spikes && spike.creatorID == uint(obj.objectID)) {
					spike.xPos = obj.xPos - 24 + spike.xOrg * 16;
					spike.yPos = obj.yPos + 18;
				}
			}
		}
		obj.bePlatform(lastX, obj.yPos);
		jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame);
	}
}

