void onMain() {
	if (jjLayerHasTiles[1]) {
		const float speedIntensity = abs(jjSin(jjGameTicks >> 2) - 0.5);
		jjLayerXOffset[1] = jjSin(jjGameTicks * 9) * speedIntensity * 19;
		jjLayerYOffset[1] = jjCos(jjGameTicks * 7) * speedIntensity * 14;
		//ForestyBackgroundLayers[0].yOffset = (jjLayerXOffset[1] = jjSin(jjGameTicks * 9) * speedIntensity * 19) / -2;
		//ForestyBackgroundLayers[0].xOffset = -8 + (jjLayerYOffset[1] = jjCos(jjGameTicks * 7) * speedIntensity * 14) / -2;
		jjIsSnowing = jjTexturedBGUsed && !jjLowDetail;
		
		const float yOffset = 22 + jjSin(jjGameTicks << 3) * 4;
		for (uint i = 0; i < SkywardLayers.length; ++i) {
			SkywardLayers[i].yOffset = yOffset;
		}
	} else {
		if (jjIsSnowing = (LevelStage == 5)) {
			const auto playYSpeed = BL18::Player.ySpeed;
			for (int i = 0; i < 1024; i++) { //loop through the global array jjParticles[1024]
				jjPARTICLE@ particle = jjParticles[i];
				if (particle.type == PARTICLE::RAIN) {
					particle.xSpeed = 0; //make rain fall straight down
					particle.ySpeed = playYSpeed < 0? 10 : int(10 + playYSpeed); //the rain speed accounts for differences in the player speed, and so won't appear to fall more slowly when the player is falling
				}
			}
		}
	}
	if (LevelStage == 1 && BL18::CurrentPopup is null) {
		LevelStage = 2;
		for (uint i = 1; i <= 2; ++i)
			MLLE::GetLayer("Scaffolding " + i).hasTiles = false;
		@BL18::CurrentPopup = PoetryWritingSession();
	} else if (LevelStage == 3 && BL18::CurrentPopup is null) {
		LevelStage += 1;
		BL18::Player.cameraUnfreeze();
		jjPalette = ForestPalette;
		if (BL18::IsMurderer)
			jjPalette.fill(jjPALCOLOR(), 0.15);
		jjPalette.apply();
		TrueColor::ProcessPalette();
		jjSetFadeColors(180);
		if (!(BL18::IsMurderer && jjMusicLoad("DARKSIDE.MOD")) && !jjMusicLoad("forest.xm"))
			jjMusicStop();
		onFunction11(true);
		jjTexturedBGUsed = true;
		if ((jjLevelFileName[5] | 0x20) == 'l'[0]) //debug
			BL18::Player.warpToID(0, true);
		jjLayerHasTiles[4] = jjLayerHasTiles[5] = true;
		for (uint i = 0; i < ForestyBackgroundLayers.length; ++i)
			ForestyBackgroundLayers[i].hasTiles = true;
		for (uint i = 0; i < 32; ++i)
			jjTriggers[i] = false; //reset for new area
		BL18::CoinWarpFound = true;
	}
}

void UseRightPalette() {
	if (LevelStage < 3)
		MLLE::Palette.apply();
	else {
		LevelStage = 4;
		ForestPalette.apply();
		jjMusicLoad("forest.xm");
	}
	//jjAddObject(OBJECT::STEADYLIGHT,0,0, 0,CREATOR::OBJECT, FlickerLight);
}

void onDrawLayer8(jjPLAYER@, jjCANVAS@ canvas) {
	if (jjLowDetail)
		return;
	int halfHeight = jjSubscreenHeight >> 1;
	
	int i, y;
	const bool hearts = LevelStage == 3;
	if (LevelStage <= 1 || hearts) {
		if (hearts) {
			canvas.drawRectangle(0,0, jjSubscreenWidth, jjSubscreenHeight, 0);
			canvas.drawRectangle(0,0, jjSubscreenWidth, jjSubscreenHeight, 54, SPRITE::BLEND_DISSOLVE, 54);
		}
		i = (jjLayerHeight[8] << 1) - (jjSubscreenHeight >> 4);
		y = 0;
	} else if (LevelStage > 3) {
		i = 0;
		y = halfHeight;
		halfHeight <<= 1;
	} else
		return;
	halfHeight >>= 3;
	
	if (LevelStage < 5)
		for (; y < jjSubscreenHeight; y += 8, ++i) {
			const int xStart = -319 + ((RowStarts[i] + (int((halfHeight - abs(i - 40)) * jjRenderFrame) >> 4)) % 320);
			for (int x = xStart; x < jjSubscreenWidth; x += 320)
				canvas.drawSpriteFromCurFrame(x, y, !hearts ? FirstParallaxFrameID + i : BL18::heartFrame);
		}
	
	jjLayerHasTiles[2] = (jjColorDepth > 8 && jjLayerHasTiles[1]);
}

void onDrawLayer1(jjPLAYER@ player, jjCANVAS@) {
	if (LevelStage >= 4 && !jjLowDetail && jjLayerHasTiles[2]) {
		jjPalette = !BL18::IsMurderer ? GodColors : DevilColors;
		auto cameraX = player.cameraX;
		const float cameraMin = 155*32;
		if (cameraX < cameraMin)
			cameraX = cameraMin;
		jjLayerXOffset[2] = (jjSubscreenWidth - 320) / 2 + ((cameraX - cameraMin) / (jjLayerWidth[4] * 32 - jjSubscreenWidth - cameraMin) * ((jjLayerWidth[2] * 32) - jjSubscreenWidth)); //snap to left, regardless of resolution
		jjLayerYOffset[2] = (jjSubscreenHeight- 200) / 2; //and top
		jjLayers[2].spriteParam = 192 + int(jjSin(jjRenderFrame << 2) * 32) + (jjRandom() & 31);
	}
}
void fixPalette(jjPLAYER@, jjCANVAS@) {
	if (LevelStage >= 4 && !jjLowDetail) {
		if (jjLayerHasTiles[2]) {
			jjPalette = ForestPalette;
		}
	}
}

void onFunction11(bool outside) {
	jjLayerHasTiles[1] = outside;
	BL18::Player.lighting = outside ? 100 : 70;
	jjEcho = outside ? 0 : 1;
}
void onFunction12(bool outside) {
	if (outside != (LevelStage == 5)) {
		LevelStage = outside ? 5 : 4;
		onFunction11(false);
		MLLE::GetLayer("Hills").hasTiles = outside;
		jjSnowingType = outside ? SNOWING::RAIN : SNOWING::LEAF;
		jjSnowingIntensity = outside ? 15 : 5;
		jjPalette = ForestPalette;
		if (outside) {
			for (uint i = 24; i <= 245; ++i) {
				const jjPALCOLOR foo = jjBackupPalette.color[i];
				if (i >= 105 && i <= 217 && (i <= 143 || i >= 176)) //foliage
					jjPalette.color[i].setHSL(foo.getHue() + ((i >= 176 && i <= 207) ? 0 : 30), foo.getSat() / 2, foo.getLight() * 3 / 5);
				else
					jjPalette.color[i].setHSL(foo.getHue(), foo.getSat() * 5 / 7, foo.getLight() * 5 / 6);
			}
		}
		TrueColor::ProcessPalette();
		if (BL18::IsMurderer)
			jjPalette.fill(jjPALCOLOR(), 0.15);
		jjPalette.apply();
		jjSetWaterLevel(81*32, true);
		jjSetWaterGradient();
	}
}

void onFunction13() {
	for (uint i = jjObjectCount-1; i > 0; --i) {
		jjOBJ@ ferris = jjObjects[i];
		if (ferris.eventID == OBJECT::GRASSPLATFORM) {
			ferris.state = STATE::KILL;
			ferris.behave();
			ferris.state = STATE::START;
		}
	}
}

void onFunction14(bool hocus) {
	if (hocus != (LevelStage == 6)) {
		LevelStage = hocus ? 6 : 4;
		onFunction11(false);
		jjPalette = ForestPalette;
		if (hocus) {
			jjPalette.copyFrom(176, 31, 176, HocusPalette);
			jjPalette.copyFrom(240, 6, 240, HocusPalette);
		}
		TrueColor::ProcessPalette();
		if (BL18::IsMurderer)
			jjPalette.fill(jjPALCOLOR(), 0.15);
		jjPalette.apply();
	}
}

void onFunction15(jjPLAYER@ play) {
	if (LevelStage < 7) {
		LevelStage = 7;
		jjEcho = 0;
		jjPalette = HocusPalette;
		TrueColor::ProcessPalette();
		if (BL18::IsMurderer)
			jjPalette.fill(jjPALCOLOR(), 0.15);
		jjPalette.apply();
		jjMusicLoad("boss.j2b");
		play.boss = jjAddObject(OBJECT::MILK, 650*32 + 15, 36*32 + 15);
		play.activateBoss();
		play.cameraFreeze(658*32 + 16, 33*32 + 16, true, false);
	}
}

void StartStage1() {
	if (LevelStage == 0) { //just to be sure
		LevelStage = 1;
		@BL18::CurrentPopup = BL18::Conversation(Conversations[0], 0, 0);
		BL18::Player.shieldTime = 0; //simpler this way
	}
}

const int WordOriginX = 370, WordOriginY = 146, WordStepX = 200, WordStepY = 76;
const array<string> AllWords = {
	"spot", "canada", "rabbit", "unfooruman", "rent", "realty", "daughter", "prayer", "easter", "devout", "typo", "cats", "creationism", "fur", "prank", "marmalade", "tall", "marry", "web", "design", "blode", "spaz", "msn", "dm", "northern", "support", "bible", "housing", "ghost", "reformation", "code", "regent", "pray", "preach", "safety", "thump", "track", "life", "straight", "quotes", "dither", "pacman", "butt", "puma man", "spoy", "spay", "whaler", "trek", "mst3000", "cornbread",
	"FERRET", "FOO", "HUMAN", "NINJA", "DRESS", "ROBES", "EUTHANASIA", "FUN", "EDGY", "OCTO", "GINGERBREAD", "HAT", "BEARD", "KILLER", "TNT", "EXPLODE", "PIPE CLEANER", "DRUGS", "COUNCIL", "CAPSLOCK", "CAPITALS", "YELL", "MAGIC", "ENCHANT", "SPELL", "LIGHTNING", "OLD", "GRAY", "JEDI", "POLICE", "FLY", "MENTOS", "GOLD", "CLONE", "TIEF", "HOLOGRAM", "UMBRELLA", "TOASTER", "MEME", "HANDLE", "EBAY", "RULE", "FICTION", "67", "SHAMWOW", "CASTLE", "HALLOWEEN", "DESTROY", "REBUILD", "RACE"
};
class PoetryWritingSession : BL18::Popup {
	uint PageID = 0;
	array<int> JumpHeights(2, 0);
	jjTEXTAPPEARANCE style(STRING::NORMAL);
	array<string> ShuffledWords;
	int CurrentlySelectedWordID = -1;
	bool LastSelect = true, LastUp = true, LastDown = true, LastSide = true;
	uint NumberOfSpottyWords = 0;
	int LastMouseX = -1, LastMouseY = -1;
	PoetryWritingSession() {
		jjPalette.load("BL18_Card.pal");
		jjPalette.apply();
		
		if (!jjMusicLoad("CUTE_LITTLE_PIANO.MOD"))
			jjMusicStop();
			
		array<uint> ShuffleIndices;
		for (uint i = 0; i < AllWords.length; ++i)
			for (uint j = 0; j < 2; ++j)
				ShuffleIndices.insertLast(i);
		while (ShuffleIndices.length != 0) {
			const auto index = jjRandom() % ShuffleIndices.length;
			ShuffledWords.insertLast(AllWords[ShuffleIndices[index]]);
			ShuffleIndices.removeAt(index);
		}
	}
	void WriteStringAt(jjCANVAS@ canvas, int x, int y,  string &in str, bool highlighted = false) const {
		if (jjDifficulty > 0) {
			for (uint i = 0; i < str.length; ++i) {
				auto c = str[i];
				if (c >= 'A'[0] && c <= 'Z'[0]) //uppercase
					c += 0x20; //lowercase
				str[i] = c;
			}
		}
		canvas.drawString(x * jjSubscreenWidth / 800, y * jjSubscreenHeight / 600, "§3" + str, jjSubscreenWidth > 400 ? STRING::MEDIUM : STRING::SMALL, style, 0, SPRITE::PALSHIFT, !highlighted ? 174 : 24);
	}
	bool Do() override {
		for (uint i = 0; i < 2; ++i)
			if (JumpHeights[i] != 0)
				(JumpHeights[i] += 16) &= 1023;
		
		const jjPLAYER@ Player = BL18::Player;
		const bool
			pressingSelect = Player.keyFire || Player.keySelect || jjKey[1],
			pressingUp = Player.keyUp,
			pressingDown = Player.keyDown,
			pressingSide = Player.keyLeft || Player.keyRight;
		if (!LastSelect && pressingSelect && CurrentlySelectedWordID >= 0) {
			const bool spotty = ShuffledWords[(PageID * 10 + CurrentlySelectedWordID) % ShuffledWords.length][0] >= 'a'[0]; 
			JumpHeights[spotty ? 0 : 1] = 16;
			if (spotty)
				NumberOfSpottyWords += 1;
			if (++PageID >= 20) {
				LevelStage += 1;
				MLLE::Palette.apply();
				//jjDebug("" + NumberOfSpottyWords);
				if (!jjMusicLoad("3ddemo.mod"))
					jjMusicStop();
				if (NumberOfSpottyWords > 10) //good!
					@BL18::CurrentPopup = BL18::Conversation(Conversations[1], 0, 0);
				else //bad!
					@BL18::CurrentPopup = PoetryResult();
				BL18::Player.cameraFreeze(0,64, false, true);
				jjLayerHasTiles[4] = jjLayerHasTiles[5] = false;
				return true;
			}
			CurrentlySelectedWordID = LastMouseX = LastMouseY = -1;
		} else if (!LastUp && pressingUp) {
			if (--CurrentlySelectedWordID < 0)
				CurrentlySelectedWordID = 9;
		} else if (!LastDown && pressingDown) {
			if (++CurrentlySelectedWordID > 9)
				CurrentlySelectedWordID = 0;
		} else if (!LastSide && pressingSide) {
			if (CurrentlySelectedWordID < 5)
				CurrentlySelectedWordID += 5;
			else
				CurrentlySelectedWordID -= 5;
		}
		LastSelect = pressingSelect;
		LastUp = pressingUp;
		LastDown = pressingDown;
		LastSide = pressingSide;
		
		const auto mouseX = jjMouseX, mouseY = jjMouseY;
		if (abs(mouseX - LastMouseX) > 5 || abs(mouseY - LastMouseY) > 5) { //ignore jitters
			LastMouseX = mouseX;
			LastMouseY = mouseY;
			const int relativeX = mouseX * 800 / jjSubscreenWidth + 30, relativeY = mouseY * 600 / jjSubscreenHeight + 12; //the 30,12 offsets are more accurate at larger resolutions... oh well
			if (relativeY >= WordOriginY && relativeY < WordOriginY + WordStepY * 5 && (relativeY - WordOriginY) % WordStepY < WordStepY / 2 && relativeX >= WordOriginX && relativeX < WordOriginX + WordStepX * 2)
				CurrentlySelectedWordID = (relativeX - WordOriginX) / WordStepX * 5 + (relativeY - WordOriginY) / WordStepY;
			else
				CurrentlySelectedWordID = -1;
		}
			
		return true;
	}
	void Draw(jjCANVAS@ canvas) const override {
		const auto width = jjSubscreenWidth, height = jjSubscreenHeight;
		
		if (width == 800 && height == 600)
			canvas.drawSpriteFromCurFrame(0,0, FirstPoemFrameID);
		else
			canvas.drawResizedSpriteFromCurFrame(0,0, FirstPoemFrameID, width / 800.f, height / 600.f);
			
		{
			int xPos = width / 9;
			uint i = 0;
			while (true) {
				const int yPos = int(height - 20 - abs(jjSin(JumpHeights[i])) * 50);
				if (jjSubscreenWidth > 400) {
					canvas.drawSpriteFromCurFrame(xPos, yPos, FirstPoemFrameID + 3 + (i << 1), 1, SPRITE::ALPHAMAP, 58); //white
					canvas.drawSpriteFromCurFrame(xPos, yPos, FirstPoemFrameID + 2 + (i << 1));
				} else {
					canvas.drawResizedSpriteFromCurFrame(xPos, yPos, FirstPoemFrameID + 3 + (i << 1), 0.5,0.5, SPRITE::ALPHAMAP, 58); //white
					canvas.drawResizedSpriteFromCurFrame(xPos, yPos, FirstPoemFrameID + 2 + (i << 1), 0.5,0.5);
				}
				if (++i == 2)
					break;
				(xPos *= 5) /= 2;
			}
		}
		
		WriteStringAt(canvas, 675, 58, (PageID + 1) + "/20");
		
		for (int i = 0; i < 10; ++i)
			WriteStringAt(canvas, WordOriginX + (i / 5) * WordStepX, WordOriginY + (i % 5) * WordStepY, ShuffledWords[(PageID * 10 + i) % ShuffledWords.length], i == CurrentlySelectedWordID);
	}
}
