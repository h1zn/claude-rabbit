	if (obj.state == STATE::START) {
		obj.state = STATE::CIRCLE;
		obj.lightType = LIGHT::FLICKER;
		obj.light = 116;
		obj.deactivates = false;
	}
	if (LevelStage > 3) {
		BL18::Player.lightType = LIGHT::NONE;
		//BL18::Player.lighting = 82;//66;
		obj.xPos = BL18::Player.xPos;
