const uint TimeTarget = 1000;

int backgroundFrameID;
void onLevelLoad() {
	BL18::Setup();
	//BL18::CoinWarpFound = true;
	
	makeSlopes();
	
	backgroundFrameID = jjAnimations[jjAnimSets[TrueColor::FindCustomAnim()].allocate(array<uint>={1})];
	jjANIMFRAME@ backgroundFrame = jjAnimFrames[backgroundFrameID];
	Resize::Resize(jjPIXELMAP(0,0, 320, 192, 5), 3.125, Resize::Method::Scale2xSAI)
	//Resize::Resize(jjPIXELMAP(0,0, 320, 192, 5), 3.125)
	//jjPIXELMAP(0,0, 320, 192, 5)
	.save(backgroundFrame);
	backgroundFrame.hotSpotX = -backgroundFrame.width/2;
	backgroundFrame.hotSpotY = -backgroundFrame.height/2;
	
	Monk(jjObjectPresets[OBJECT::MORPH]);
	
	jjObjectPresets[OBJECT::GUN8POWERUP].behavior = FlashTile;
	jjObjectPresets[OBJECT::GUN8POWERUP].playerHandling = HANDLING::PARTICLE;
	
	jjObjectPresets[OBJECT::GREENSPRING].behavior = DontFallSpring;
	
	jjObjectPresets[OBJECT::TNT].isBlastable = false; //no chain reactions
	jjObjectPresets[OBJECT::TNT].counterEnd /= 3; //explode fastar
	
	/*array<bool> triggersExist(32);
	for (int x = 0; x < jjLayerWidth[4]; ++x)
		for (int y = 0; y < jjLayerHeight[4]; ++y)
			if (jjEventGet(x,y) == OBJECT::TRIGGERSCENERY || jjEventGet(x,y) == OBJECT::BANANA)
				triggersExist[jjParameterGet(x,y,0,5)] = true;
	for (uint i = 0; i < triggersExist.length; ++i)
		if (triggersExist[i])
			jjDebug("" + i);*/
	
}
void onDrawLayer8(jjPLAYER@, jjCANVAS@ screen) {
	jjTexturedBGUsed = jjLowDetail;
	if (!jjLowDetail)
		screen.drawSpriteFromCurFrame(jjSubscreenWidth/2, jjSubscreenHeight/2, backgroundFrameID, 1, SPRITE::BRIGHTNESS, int(jjSin(jjGameTicks * 6) * 24) + 100);
}

void onMain() {
	for (uint i = 0; i < 1024; ++i) {
		jjPARTICLE@ part = jjParticles[i];
		if (part.type == PARTICLE::FLOWER && part.flower.color == 72)
			part.flower.color = 40 | (jjRandom() & 7);
		}
	jjPLAYER@ play = BL18::Player;
	if (play.yPos > 137 * 32 && play.warpID == 0) {
		if (play.health > 1)
			play.hurt(1, true);
		play.warpToID(play.xPos > 86*32 ? 1 : 2);
	}
}

class Monk : BL18::Enemy {
	string name = "|GrèéñKïllër";
	Monk(jjOBJ@ preset) {
		super(preset, BL18::AnimSets::Monk);
		preset.direction = 1;
		preset.curAnim = jjAnimSets[animSetID];
		preset.curFrame = jjAnimations[preset.curAnim];
		preset.energy = 1;
		preset.isFreezable = false;
		Resize::Resize(jjAnimations[preset.curAnim], 2, Resize::Method::AdvMAME2x);
		jjSampleLoad(BL18::HPLaughter, "HPLaughter.wav");
		gender = BL18::Gender::Male;
	}
	void onBehave(jjOBJ@ obj) override {
		const bool doBossThing = obj.doesHurt == 1 && BL18::Player.bossActivated;
		if (obj.state == STATE::FREEZE || obj.state == STATE::DEACTIVATE)
			obj.behave(BEHAVIOR::DRAGON, false);
		else if (BL18::Player.health <= 0)
			return;
		else if (obj.state == STATE::START) {
			obj.state = STATE::WAIT;
			obj.deactivates = (obj.doesHurt = BL18::getParameterAtOrigin(obj, 0, 1)) == 0;
		} else if (obj.state == STATE::WAIT) {
			if (BL18::IsMurderer || doBossThing || ++obj.counter > 100) {
				const float targetX = BL18::Player.xPos, targetY = BL18::Player.yPos;
				if (doBossThing || (abs(obj.xPos - targetX) < 250 && abs(obj.yPos - targetY) < 170)) {
					obj.state = STATE::ATTACK;
					obj.curFrame += 1;
					obj.counter = 0;
					jjSample(obj.xPos, obj.yPos, BL18::HPLaughter);
					jjAddObject(OBJECT::BULLET, targetX, targetY, animSetID, CREATOR::OBJECT, FireFromHeaven);
				}
			}
		} else if (obj.state == STATE::ATTACK)
			if (++obj.counter > 90) {
				obj.state = STATE::WAIT;
				obj.curFrame -= 1;
				obj.counter = 0;
			}
		if (doBossThing) {
			BL18::Player.boss = obj.objectID;
			if (BL18::Player.yPos < obj.yPos)
				obj.yPos -= 2;
			if (BL18::Player.xPos < obj.xPos - 30)
				obj.xPos -= 1;
			else if (BL18::Player.xPos > obj.xPos + 30)
				obj.xPos += 1;
			if (jjGameTicks & 3 == 1) {
				const auto rand = jjRandom();
				jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos - 24 + (rand & 63), obj.yPos + 40 + ((rand >> 7) & 15))].determineCurAnim(ANIM::CUSTOM[BL18::AnimSets::Misc], 4 | ((rand >> 6) & 1));
			}
		}
		if (obj.energy == 1)
			for (uint i = jjObjectCount; --i > 0;) {
				jjOBJ@ tnt = jjObjects[i];
				if (tnt.behavior == BEHAVIOR::TNT && abs(obj.xPos - tnt.xPos) < (200 >> obj.doesHurt) && abs(obj.yPos - tnt.yPos) < (96 >> obj.doesHurt)) {
					//obj.energy = 1;
					Enemy::onObjectHit(obj, tnt, BL18::Player, 1);
					if (doBossThing && obj.energy <= 0) {
						BL18::SavedTriggers[18] = jjTriggers[18] = true;
						jjSamplePriority(BL18::HPTrigger);
						BL18::Player.activateBoss(false);
						if (!BL18::IsMurderer || !jjMusicLoad("DARKSIDE.MOD", true))
							jjMusicLoad(BL18::musicFilename, true);
						for (uint x = 339; x <= 346; ++x)
							jjEventSet(x,53, 0); //activate boss events
					}
				}
			}
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ player, int force) override {
		if (bullet !is null) {
			bullet.state = STATE::EXPLODE;
		} else {
			if (player.health > 0) {
				player.hurt(8, true);
				jjSample(obj.xPos, obj.yPos, BL18::HPLaughter);
			}
		}
		return true;
	}
	void onDraw(jjOBJ@ obj) override {
		Enemy::onDraw(obj);
		if (obj.doesHurt == 1) { //boss
			jjDrawString(obj.xPos - 40, obj.yPos - 26, (obj.state == STATE::DONE ? "§1||||" : "§1") + name);
		}
	}
}
void FireFromHeaven(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		obj.state = STATE::DELAYEDSTART;
		obj.playerHandling = HANDLING::PARTICLE;
	} else if (obj.state == STATE::DELAYEDSTART) {
		if (++obj.counter < 45) {
			obj.xPos = BL18::Player.xPos;
			obj.yPos = BL18::Player.yPos;
		} else if (obj.counter == 90) {
			if (!BL18::Player.antiGrav && !(BL18::Player.bossActivated && jjRandom() & 1 == 1)) {
				obj.yPos = BL18::Player.yPos - 300;
				obj.direction = 1;
				obj.ySpeed = 4;
			} else {
				obj.yPos = BL18::Player.yPos + 300;
				obj.direction = SPRITE::FLIPV;
				obj.ySpeed = -4;
			}
			obj.state = STATE::FALL;
			obj.playerHandling = HANDLING::ENEMYBULLET;
			obj.animSpeed = 2;
			obj.determineCurAnim(obj.creatorID, 1);
			obj.killAnim = jjAnimSets[ANIM::AMMO] + 5;
			obj.lightType = LIGHT::BRIGHT;
			obj.light = 15;
		}
		if (jjGameTicks & 3 < 2)
			jjDrawResizedSprite(obj.xPos, obj.yPos, ANIM::PLUS_RETICLES, 1, 0, 5,5, SPRITE::NORMAL,0, 1);
	} else if (obj.state == STATE::EXPLODE) {
		obj.curAnim = obj.killAnim;
		obj.frameID = 0;
		obj.behavior = BEHAVIOR::EXPLOSION;
		obj.playerHandling = HANDLING::EXPLOSION;
	} else if (obj.state == STATE::DEACTIVATE) {
		obj.delete();
	} else {
		obj.yPos += obj.ySpeed;
		obj.curFrame = jjAnimations[obj.curAnim] + ((jjGameTicks >> 2) & 7);
		jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction);
	}
}

void makeSlopes() {
	array<array<jjPIXELMAP@>> images(4, array<jjPIXELMAP@>(13, null));
	array<array<jjMASKMAP@>> masks(4, array<jjMASKMAP@>(13, null));
	for (uint x = 0; x < 4; ++x)
		for (uint y = 0; y < 13; ++y) {
			const uint16 tileID = y < 4 ? jjTileGet(5, x, y+6) : 0;
			@images[x][y] = jjPIXELMAP(tileID);
			@masks[x][y] = jjMASKMAP(tileID);
		}
	for (uint x = 0; x < 128; ++x) {
		const uint xTile = x >> 5;
		for (uint y = 0; y < 96; ++y) {
			const uint yTile = y >> 5;
			{
				const uint ySrc = (((x & 63) >> 1) + y);
				images[xTile][yTile + 7][x & 31, y & 31] = images[xTile][ySrc >> 5][x & 31, ySrc & 31];
				 masks[xTile][yTile + 7][x & 31, y & 31] =  masks[xTile][ySrc >> 5][x & 31, ySrc & 31];
			}
			{
				const uint ySrc = (((63 - (x & 63)) >> 1) + y);
				images[xTile][yTile + 4][x & 31, y & 31] = images[xTile][ySrc >> 5][x & 31, ySrc & 31];
				 masks[xTile][yTile + 4][x & 31, y & 31] =  masks[xTile][ySrc >> 5][x & 31, ySrc & 31];
			}
			{
				const uint ySrc = (x < 64) ? ((31 - (x & 31)) + y) : ((x & 31) + y);
				images[xTile][yTile + 10][x & 31, y & 31] = images[(x >> 4) & 3][ySrc >> 5][x & 31, ySrc & 31];
				 masks[xTile][yTile + 10][x & 31, y & 31] =  masks[(x >> 4) & 3][ySrc >> 5][x & 31, ySrc & 31];
			}
		}
	}
	for (uint x = 0; x < 4; ++x)
		for (uint y = 4; y < 13; ++y) {
			const uint16 tileID = jjTileGet(5, x, y+6);
			images[x][y].save(tileID,true);
			masks[x][y].save(tileID,true);
		}
}

int lastFlashBurn = 0;
void FlashTile(jjOBJ@ obj) {
	switch (obj.state) {
		case STATE::START: {
			const uint xTile = uint(obj.xOrg)>>5, yTile = uint(obj.yOrg)>>5;
			obj.special = jjTileGet(4, xTile,yTile);
			jjTileSet(4, xTile,yTile, jjTiles[obj.special].getFrames()[0]);
			obj.state = STATE::WAIT;
			break;
		} case STATE::WAIT: {
			if (abs(BL18::Player.xPos - obj.xPos) < 120 && abs(BL18::Player.yPos - obj.yPos) < 70) {
				obj.state = STATE::FADEIN;
				if (lastFlashBurn + 13 < jjGameTicks) { //don't overdo it
					jjSample(obj.xPos, obj.yPos, SOUND::COMMON_BURN);
					lastFlashBurn = jjGameTicks;
				}
				obj.deactivates = false;
			}
			break;
		} case STATE::FADEIN: {
			if (++obj.age % 6 == 0) {
				const uint frameID = obj.age / 6;
				const auto frames = jjTiles[obj.special].getFrames();
				if (frameID < frames.length)
					jjTileSet(4, uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, frames[frameID]);
				else {
					obj.delete();
					BL18::removeFromEventMap(obj);
					//obj.state = STATE::SLEEP;
				}
			}
			break;
		} case STATE::DEACTIVATE: {
			if (obj.special != 0) //has started
				jjTileSet(4, uint(obj.xOrg)>>5, uint(obj.yOrg)>>5, obj.special);
			obj.deactivate();
			break;
		}
	}
}

void DontFallSpring(jjOBJ@ obj) {
	const auto realCreator = obj.creator;
	obj.creator = CREATOR::LEVEL;
	obj.behave(BEHAVIOR::SPRING);
	obj.var[4] = int((obj.yPos = obj.yOrg + 8) * 65536);
	obj.creator = realCreator;
	obj.behavior = BEHAVIOR::SPRING;
}

void onFunction11() {
	//BL18::CoinWarpFound = false; //show HUD again
}
void onFunction12(jjPLAYER@ play) {
	play.showText("@@@@@@@You left a small crater.");
}
void onFunction13(jjPLAYER@ play) {
	play.spriteMode = SPRITE::SINGLECOLOR;
	play.spriteParam = 0;
}
void onFunction14() {
	for (uint i = jjObjectCount; --i > 0;) {
		jjOBJ@ obj = jjObjects[i];
		if (obj.behavior == BL18::Elevator && obj.yOrg > 90*32) { //don't reset the hub world's elevator
			obj.xPos = obj.xOrg + 17;
		}
	}
}
void onFunction15(jjPLAYER@ play) {
	if (play.noclipMode) {
		onFunction0(play);
		play.direction = 1;
		@BL18::CurrentPopup = BrieflyDisableControls();
	}
}
class BrieflyDisableControls : BL18::Popup {
	uint8 counter = 0;
	bool Do() override { return ++counter < 20; }
	void Draw(jjCANVAS@ canvas) const override { }
	bool DrawHUD() const override { return true; }
}

void onPlayerInput(jjPLAYER@ play) {
	if (play.spriteMode == SPRITE::SINGLECOLOR) //enforced solemnity
		play.keyRun = false;
}

