};
bool onDrawHealth(jjPLAYER@ player, jjCANVAS@ canvas) {
	return (PlayersX[player.localPlayerID].TunnelGhostSequence > 250); //fade to total blackness
}
bool onDrawAmmo(jjPLAYER@ player, jjCANVAS@ canvas) {
	if (ViewingMap) {
		jjTEXTAPPEARANCE appearance(STRING::BOUNCE);
		appearance.at=STRING::SPECIALSIGN;
		const int xOrg = (jjSubscreenWidth - 256) / 2 - 50;
		const int yOrg = (jjSubscreenHeight - 256) / 2;
		for (uint i = 0; i < MapDetails.length; ++i) {
			const MapDetail@ detail = MapDetails[i];
			appearance.align = detail.Alignment;
			canvas.drawString(xOrg + detail.xPos, yOrg + detail.yPos, detail.Label, STRING::SMALL, appearance);
		}
	}
	if (PlayersX[player.localPlayerID].TunnelGhostSequence > 250)
		return true;
	return MLLE::WeaponHook.drawAmmo(player, canvas);
}

bool onDrawScore(jjPLAYER@ player, jjCANVAS@ canvas) {
	if (player.localPlayerID != 0)
		return false;
	
	if (PlayersX[player.localPlayerID].TunnelGhostSequence > 250)
		return true;
	
	bool dark;
	if (jjGameConnection == GAME::LOCAL) {
		canvas.drawSprite(14, 42, ANIM::CUSTOM[0],0,1, 1, SPRITE::GEM, 0);
		dark = CollectedGems < NumberOfGems;
		//if (dark || (jjGameTicks & 15 < 9))
			canvas.drawString(25, 42, (CollectedGems * 100 / NumberOfGems) + "%", STRING::SMALL,STRING::NORMAL,0, dark ? SPRITE::BRIGHTNESS : SPRITE::PALSHIFT, dark ? 96 : 208);
		//canvas.drawString(25, 60, CollectedGems + " / " + NumberOfGems); //debug
	}
	const uint displayedCoins = CollectedCoins < NumberOfCoins ? CollectedCoins : NumberOfCoins; //cheats
	dark = displayedCoins < NumberOfCoins;
	canvas.drawSprite(72, 42, ANIM::PICKUPS, 84, 0);
	canvas.drawString(75, 42, "§1" + displayedCoins + "/" + NumberOfCoins, STRING::SMALL,STRING::NORMAL,0, dark ? SPRITE::BRIGHTNESS : SPRITE::PALSHIFT, dark ? 96 : 208);
	
	//if (SkyrunnerStage > 1)
	//	canvas.drawString(80, 60, "" + SkyrunnerStage, STRING::MEDIUM);
	
	return false;
}

bool onDrawLives(jjPLAYER@, jjCANVAS@) {
	return true;
}

void CollideAsPickup(jjPLAYER@ play, jjOBJ@ obj) {
	string score;
	switch (obj.eventID) {
		case OBJECT::REDGEM:
		case OBJECT::PURPLEGEM:
			CollectedGems += 1;
			CollectedRed += 1;
			obj.eventID = OBJECT::FASTFEET; //play sound but do nothing
			score = "|||||+1";
			break;
		case OBJECT::GREENGEM:
			CollectedGems += 5;
			CollectedGreen += 1;
			obj.eventID = OBJECT::FASTFEET;
			score = "|+5";
			break;
		case OBJECT::BLUEGEM:
			CollectedGems += 10;
			CollectedBlue += 1;
			score = "|||+10";
			obj.eventID = OBJECT::FASTFEET;
			break;
		case OBJECT::RECTREDGEM: //old black gem
			obj.eventID = OBJECT::FASTFEET;
			//no gem increase
			break;
		case OBJECT::SILVERCOIN:
		case OBJECT::GOLDCOIN:
			CollectedCoins += (obj.eventID == OBJECT::SILVERCOIN) ? 1 : 5;
			CoinLocations.removeAt(CoinLocations.find(CoinLocation(jjParameterGet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0, 4))));
			break;
	}
	obj.scriptedCollisions = false;
	play.objectHit(obj, 0, HANDLING::PICKUP);
	if (score.length != 0) {
		jjPARTICLE@ particle = jjAddParticle(PARTICLE::STRING);
		if (particle !is null) {
			particle.xPos = obj.xPos;
			particle.yPos = obj.yPos;
			particle.xSpeed = (-32768 - int(jjRandom() & 0x3FFF)) / -65536.f; //positive!
			particle.ySpeed = (-65536 - int(jjRandom() & 0x7FFF)) / -65536.f; //
			particle.string.text = score;
		}
	}
}
bool makeIcePowerup = false;
class PermaPickup : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			if (obj.creatorType == CREATOR::PLAYER) {
				if (obj.xSpeed == 0.f && obj.ySpeed == 0.f) { //dropped by enemy
					if (jjLocalPlayers[0].fly == FLIGHT::AIRBOARD) {
						if (obj.eventID == OBJECT::FASTFIRE && (makeIcePowerup = !makeIcePowerup))
							jjAddObject(OBJECT::ICEPOWERUP, obj.xOrg, obj.yOrg);
					} else if (jjDifficulty < 2)
						jjAddObject(OBJECT::BOUNCERAMMO3, obj.xOrg, obj.yOrg, obj.creatorID, obj.creatorType);
					obj.delete();
					return;
				} else { //from gem barrel
					//nothing?
				}
			}
			if (obj.eventID == OBJECT::RECTREDGEM)
				obj.lightType = LIGHT::NONE; //don't glow inside walls if you've already been collected
			else if (obj.lightType != LIGHT::NONE) {
				obj.lightType = LIGHT::BRIGHT;
				obj.light = 9;
			}
		} else if (obj.state == STATE::DEACTIVATE && obj.creatorType == CREATOR::PLAYER)
			obj.state = STATE::FLOAT;
		obj.behave(BEHAVIOR::PICKUP);
		obj.scriptedCollisions = obj.playerHandling == HANDLING::PICKUP;
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ play, int force) {
		if (obj.creatorType == CREATOR::LEVEL) { //be safe
			const auto xTile = uint(obj.xOrg) >> 5, yTile = uint(obj.yOrg) >> 5;
			jjEventSet(xTile,yTile, OBJECT::RECTREDGEM);
			jjParameterSet(xTile,yTile, -1,1, 1); //active
			GemLocations.removeAt(GemLocations.find(xTile | (yTile << 16))); //includes coins, because coins are also in GemLocations, but that's okay because you never get to see the gem arrow until you've found all the coins
		}
		CollideAsPickup(play, obj);
		return true;
	}
}
class MyIcePowerup : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		obj.xPos = obj.xOrg;
		obj.yPos = obj.yOrg;
		obj.xSpeed = obj.ySpeed = 0;
		obj.behave(obj.eventID == OBJECT::CARROT ? BEHAVIOR::PICKUP : BEHAVIOR::FLICKERGEM);
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@, jjPLAYER@ player, int) {
		jjObjectPresets[OBJECT::ICEBULLET].var[0] = 
		jjObjectPresets[OBJECT::ICEBULLET].var[0] + 1;
		jjSample(obj.xPos, obj.yPos, SOUND::COMMON_GLASS2);
		if (jjAutoWeaponChange)
			player.currWeapon = WEAPON::ICE;
		obj.delete();
		return true;
	}
}
class SeriesGem : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.deactivates = false;
			obj.scriptedCollisions = true;
		}
		obj.xSpeed = obj.ySpeed = 0;
		obj.behave(BEHAVIOR::PICKUP, obj.state == STATE::EXPLODE);
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ play, int force) {
		SeriesGemsCollected[obj.var[8]] = SeriesGemsCollected[obj.var[8]] | obj.var[9];
		CollideAsPickup(play, obj);
		return true;
	}
}
SeriesGem SeriesGemInstance;

uint SkyrunnerStage = 0;	//0: not yet encountered skyrunner
							//1: skyrunner is visible in the cave only, post-skyrunner checkpoint has been manually inserted into the location array
							//2: skyrunner is visible and usable at all checkpoints (coop skips 1 but still inserts the manual checkpoint)
							//>2: actively playing skyrunner stage
array<uint32> SkyrunnerLocations;
void Skyrunner(jjOBJ@ obj) {
	switch (obj.state) {
	case STATE::START: {
		const auto xTile = uint(obj.xOrg) >> 5, yTile = uint(obj.yOrg) >> 5;
		obj.var[2] = int(obj.xOrg) + jjParameterGet(xTile, yTile, 0, -5) * 32;
		obj.var[3] = int(obj.yOrg) + jjParameterGet(xTile, yTile, 5, -5) * 32 - 16;
	break; }
	case STATE::STOP: //don't do anything anymore
		jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame);
		break;
	case STATE::DEACTIVATE: //due to death
		obj.deactivate();
		return;
	case STATE::DONE: { //triggered by the player hitting it
		obj.state = STATE::STOP;
		//save the current state of some properties
		//OPTIONAL: this loop makes checkpoints reusable, so only the most recent checkpoint you touched is ever active
		for (int i = jjObjectCount; --i > 0;) {
			jjOBJ@ obj2 = jjObjects[i];
			if (obj2.eventID == OBJECT::CHECKPOINT && i != obj.objectID && obj2.isActive) {
				obj2.state = STATE::SLEEP;
				obj2.var[0] = 0;
			}
		}
		const uint location = (uint(obj.xOrg) >> 5) | ((uint(obj.yOrg) >> 5) << 16);
		if (SkyrunnerLocations.find(location) < 0)
			SkyrunnerLocations.insertLast(location);
		}
	}
	obj.behave(BEHAVIOR::CHECKPOINT);
	
	if (SkyrunnerStage < 1) //skyrunner hasn't been discovered yet
		return;
	
	float skyrunnerSpriteY = obj.var[3] + jjSin(jjGameTicks << 2) * 12;
	
	if (obj.var[4] >= 70) {
		obj.var[4] = obj.var[4] + 1;
		skyrunnerSpriteY -= (obj.var[4] - 70) * 3; //lifting off
		if (obj.var[4] >= 240)
			obj.var[4] = 0;
	} else {
		int localPlayerID = 0;
		while (true) {
			jjPLAYER@ localPlayer = jjLocalPlayers[localPlayerID];
			if (abs(localPlayer.xPos - obj.var[2]) < 40 && abs(localPlayer.yPos - obj.var[3]) < 40) {
				if (obj.state == STATE::SLEEP && (jjGameTicks & 7) == 0) {
					obj.state = STATE::ACTION;
					obj.frameID = 80;
					obj.special = localPlayer.playerID | CREATOR::PLAYER;
					obj.behave(BEHAVIOR::CHECKPOINT, false);
					for (int lp2 = 0; lp2 < jjLocalPlayerCount; ++lp2) {
						jjLocalPlayers[lp2].xOrg = obj.var[2]; //start at the skyrunner, not the checkpoint
						jjLocalPlayers[lp2].yOrg = obj.var[3];
					}
				}
				if (localPlayer.curAnim == jjAnimSets[localPlayer.setID] + RABBIT::LOOKUP) {
					obj.var[4] = obj.var[4] + 1;
					if (obj.var[4] == 70) { //not inside cave
						localPlayer.lighting = 81;
						if (SkyrunnerStage == 2) {
							const auto nextLocation = SkyrunnerLocations[(SkyrunnerLocations.find((uint(obj.xOrg) >> 5) | ((uint(obj.yOrg) >> 5) << 16)) + 1) % SkyrunnerLocations.length];
							const auto nextX = nextLocation & 0xFFFF, nextY = nextLocation >> 16;
							localPlayer.warpToTile(nextX + jjParameterGet(nextX,nextY, 0, -5), nextY + jjParameterGet(nextX,nextY, 5, -5));
						} else {
							localPlayer.warpToID(0);
							localPlayer.fly = FLIGHT::AIRBOARD;
							LimitCameraSize(true);
							if (localPlayer.ammo[WEAPON::BOUNCER] == 0)
								localPlayer.ammo[WEAPON::BOUNCER] = 1;
							for (int weapon = 3; weapon <= 5; ++weapon)
								localPlayer.ammo[weapon] = 1;
							jjObjectPresets[WEAPON::ICE].var[0] = (jjDifficulty <= 0) ? 1 : 0; //number of laser bullets
							SkyrunnerStage = 1;
							jjMusicLoad("EB_Valley_Gremlins_OC_ReMix.mp3");
							setAutoscrollingSpeeds(true);
						}
					}
					break;
				}
			}
			if (++localPlayerID == jjLocalPlayerCount) {
				obj.var[4] = 0; //no one is holding up
				break;
			}
		}
	}
	jjDrawSpriteFromCurFrame(obj.var[2], skyrunnerSpriteY, obj.var[1], layerZ: 3);
}
void onFunction0() {
	if (SkyrunnerStage != 2) {
		if (jjLocalPlayerCount != 1) {
			SkyrunnerLocations.insertLast(125 | (27 << 16)); //final checkpoint before skyrunner
			SkyrunnerLocations.insertLast(107 | (74 << 16)); //inaccessible checkpoint
		}
		SkyrunnerStage = jjLocalPlayerCount == 1 ? 1 : 2;
	}
}

void Flyhive(jjOBJ@ obj) {
	if (obj.state == STATE::START) {
		/*if (jjDifficulty <= 0) {
			obj.delete();
			return;
		}*/
		while (!jjMaskedHLine(int(obj.xPos) - 5, 10, int(obj.yPos) - 17))
			obj.yPos -= 1;
		obj.state = STATE::ATTACK;
	} else if (obj.state == STATE::DEACTIVATE) {
		obj.deactivate();
	} else if (obj.state == STATE::KILL) {
		obj.delete();
	} else {
		jjDrawTile(obj.xPos - 16, obj.yPos - 16, 2054);
		if (jjGameTicks & 15 == 1) {
			obj.var[1] = (jjGameTicks * 5) & 1023;
			if (obj.var[1] >= 512)
				obj.var[1] = 1024 - obj.var[1];
			jjObjects[jjAddObject(OBJECT::BULLET, obj.xPos, obj.yPos, obj.objectID, CREATOR::OBJECT, Threed::SmellyGhostBee)].counterEnd -= (jjDifficulty >= 1 ? 60 : 120);
		}
	}
}

namespace LaserBlaster {
	class NonBouncing : Weapon {
		void onBehave(jjOBJ@ obj) override {
			Weapon::onBehave(obj);
			obj.behavior = BEHAVIOR::BULLET;
			obj.behave();
			if (obj.var[0] > 0) {
				obj.yPos -= obj.var[0] * 8;
				do {
					jjOBJ@ newObj = jjObjects[jjAddObject(OBJECT::ICEBULLET, obj.xPos, obj.yPos + 16 * obj.var[0], obj.creatorID, CREATOR::PLAYER, BEHAVIOR::INACTIVE)];
					//newObj.direction = obj.direction;
					newObj.xSpeed = obj.xSpeed;
					newObj.xAcc = obj.xAcc;
					newObj.var[7] = obj.var[7];
					newObj.behavior = BEHAVIOR::BULLET;
					newObj.eventID = OBJECT::BLASTERBULLET;
					obj.var[0] = obj.var[0] - 1;
				} while (obj.var[0] != 0);
			}
		}
	}
}

void MrBatty(jjOBJ@ obj) {
	switch (obj.state) {
		case STATE::START:
			if (obj.creatorID == 1) {
				obj.direction = 1;
				obj.xSpeed = 1;
			} else {
				obj.direction = -1;
				obj.xSpeed = -2;
			}
			obj.counterEnd = jjRandom();
			obj.counter = (jjRandom() & 1023) + 150;
			obj.state = STATE::FLY;
			break;
		case STATE::DEACTIVATE:
			obj.delete();
			break;
		case STATE::KILL:
			obj.delete();
			break;
		case STATE::ROTATE:
			obj.yPos += 0.2;
			obj.frameID = ++obj.counterEnd / 11;
			obj.determineCurFrame();
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::SINGLECOLOR, obj.justHit == 0 ? 91 : 15);
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::BLEND_NORMAL, obj.doesHurt < 128 ? 255 - obj.doesHurt : obj.doesHurt);
			jjDrawSprite(obj.xPos - 8, obj.yPos - 32, ANIM::FONT, 0, 31, 1, SPRITE::PALSHIFT, 16); //?
			if ((obj.doesHurt += 2) == 0) {
				obj.direction = -obj.direction;
				obj.xSpeed = (obj.direction >= 0) ? 1 : -2;
				obj.state = STATE::FLY;
			}
			break;
		default:
			if (!obj.isTarget && abs(obj.xPos - obj.xOrg) >= 50) {
				obj.playerHandling = HANDLING::ENEMY;
				obj.isTarget = true;
			}
			if (--obj.counter <= 0) {
				obj.counter = 9001;
				obj.state = STATE::ROTATE; //confuses itself
				obj.doesHurt = 0;
			}
			obj.xPos += obj.xSpeed;
			obj.frameID = ++obj.counterEnd >> 3;
			obj.determineCurFrame();
			obj.draw();
			break;
	}
}
void SmilinSphere(jjOBJ@ obj) {
	if (obj.state == STATE::FLY) {
		obj.xPos += obj.xSpeed;
		obj.yPos = obj.yOrg + jjSin(obj.age += 9) * 7;
		obj.draw();
		
		for (int i = 0; i < 1024; i += 256) {
			const int angle = (obj.xSpeed >= 0 ? -obj.age : obj.age) + i;
			jjDrawSprite(obj.xPos + jjSin(angle) * 37, obj.yPos + jjCos(angle) * 37, ANIM::AMMO, 1, angle);
		}
		if (!obj.isTarget && abs(obj.xPos - obj.xOrg) >= 50) {
			obj.playerHandling = HANDLING::ENEMY;
			obj.isTarget = true;
		}
		return;
	} else if (obj.state == STATE::KILL) {
		obj.eventID = OBJECT::STEADYLIGHT;
		obj.playerHandling = HANDLING::EXPLOSION;
		obj.lightType = LIGHT::RING2;
		if (obj.counter++ % 7 == 0) {
			jjSample(obj.xPos, obj.yPos, SOUND::AMMO_BOEM1);
			const int radius = obj.counter * 5;
			for (int explosionID = 0; explosionID < 5; ++explosionID) {
				const int angle = obj.counter * 12 + explosionID * 205;
				jjOBJ@ explosion = jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos + jjSin(angle) * radius, obj.yOrg + jjCos(angle) * radius)];
				explosion.playerHandling = HANDLING::ENEMYBULLET;
				explosion.animSpeed = 1;
				explosion.killAnim = explosion.determineCurAnim(ANIM::AMMO, 3);
				explosion.lightType = LIGHT::BRIGHT;
				explosion.light = 10;
			}
		}
		obj.light = obj.counter + obj.counter / 2;
		if (obj.counter == (24 + jjDifficulty * 6)) {
			if (jjDifficulty < 3)
				obj.grantPickup(jjLocalPlayers[0], 10); //risk/reward
			obj.delete();
		}
	} else {
		MrBatty(obj);
		obj.counter = 0;
	}
}

void SpitefulCrow(jjOBJ@ obj) {
	if (obj.state == STATE::DEACTIVATE) {
		obj.delete();
		return;
	}
	if (obj.state == STATE::START) {
		obj.direction = obj.xOrg >= shmupRightBorder ? -1 : 1;
		obj.xAcc = obj.direction * 2;
		obj.yAcc = obj.xOrg;
	}
	obj.xPos += obj.xAcc;
	obj.xOrg += obj.xAcc;
	obj.behave(BEHAVIOR::RAVEN);
	if (!obj.isTarget && abs(obj.xPos - obj.yAcc) >= 50) {
		obj.playerHandling = HANDLING::ENEMY;
		obj.isTarget = true;
	}
}

void AddMitten(const jjOBJ@ obj, float xSpeed, float ySpeed, int xOffset = 0, int yOffset = 0) {
	jjOBJ@ subcloud = jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos + xOffset, obj.yPos + yOffset, obj.objectID, CREATOR::OBJECT, ThunderMitten)];
	subcloud.killAnim = subcloud.determineCurAnim(ANIM::AMMO, 2);
	subcloud.frameID = 4;
	subcloud.xSpeed = xSpeed;
	subcloud.ySpeed = ySpeed;
	
}
void ThunderMite(jjOBJ@ obj) {
	switch (obj.state) {
		case STATE::START:
			if (obj.creatorID == 1) {
				obj.direction = 1;
				obj.xSpeed = 0.5;
			} else {
				obj.direction = -1;
				obj.xSpeed = -1;
			}
			obj.state = STATE::FLY;
			break;
		case STATE::DEACTIVATE:
			obj.delete();
			break;
		case STATE::KILL:
			obj.delete();
			break;
		case STATE::ATTACK: {
			const int angle = jjRandom() & 1023;
			const int angle2 = jjRandom() & 1023;
			if (++obj.counter & 7 == 5)
				AddMitten(obj, jjSin(angle) * 3, jjCos(angle) * 3, int(jjCos(angle2) * 10), int(jjSin(angle2) * 10));
			obj.xPos = obj.xOrg - (angle - 512) / 128;
			obj.yPos = obj.yOrg - (angle2 - 512) / 128;
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, 1, obj.justHit == 0 ? SPRITE::BRIGHTNESS : SPRITE::SINGLECOLOR, obj.justHit == 0 ? 128 + obj.counter : 15, layerZ: 3);
			if (obj.counter >= 65) {
				jjPLAYER@ player = jjLocalPlayers[0];
				obj.var[0] = jjSampleLooped(obj.xPos, player.yPos, SOUND::AMMO_LASER3, obj.var[0]);
				jjDrawSwingingVineSpriteFromCurFrame(obj.xPos, player.cameraY, obj.special, jjSubscreenHeight, 0);
				jjDrawSwingingVineSpriteFromCurFrame(obj.xOrg, player.cameraY, obj.special + 1, jjSubscreenHeight, 0, mode:SPRITE::ALPHAMAP, param:41);
				if (obj.counter == 108) {
					obj.counter -= 8;
					if (++obj.counterEnd == 11) {
						obj.counter = 0;
						obj.counterEnd = 0;
						obj.state = STATE::FLY;
					} 
				} else if (abs(obj.xOrg - player.xPos) < 62) {
					player.hurt(1);
				}
			}
			break; }
		default:
			obj.xPos += obj.xSpeed;
			obj.yPos = obj.yOrg + jjSin(obj.age += 7) * 5;
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, 1, obj.justHit == 0 ? SPRITE::NORMAL : SPRITE::SINGLECOLOR, 15, layerZ: 3);
			if (jjGameTicks & 15 == 0)
				AddMitten(obj, obj.xSpeed * -3, 0, obj.direction * -12, -16 + int(jjRandom() & 31));
			if (abs(obj.xPos - jjLocalPlayers[0].xPos) < 15) {
				obj.xOrg = obj.xPos;
				obj.state = STATE::ATTACK;
				obj.playerHandling = HANDLING::ENEMY;
				obj.isTarget = true;
			} else if (!obj.isTarget && abs(obj.xPos - obj.xOrg) >= 50) {
				obj.playerHandling = HANDLING::ENEMY;
				obj.isTarget = true;
			}
			
		break;
	}
}
void ThunderMitten(jjOBJ@ obj) {
	obj.xPos += obj.xSpeed;
	obj.yPos += obj.ySpeed;
	obj.behave(BEHAVIOR::EXPLOSION);
}

void PogoPunk(jjOBJ@ obj) {
	switch (obj.state) {
		case STATE::START:
			obj.direction = obj.creatorID == 1 ? 1 : -1;
			obj.yPos = 490;
			obj.ySpeed = obj.yPos - obj.yOrg;
			obj.xSpeed = obj.ySpeed / 2;
			obj.state = STATE::BOUNCE;
			break;
		case STATE::DEACTIVATE:
			obj.delete();
			break;
		case STATE::KILL:
			obj.delete();
			break;
		default: {
			const int angle = ++obj.counter * 3;
			if (angle >= 512)
				obj.delete();
			else {
				obj.yPos = 490 - jjSin(angle) * obj.ySpeed + 75;
				obj.xPos = obj.xOrg - jjCos(angle) * obj.xSpeed * obj.direction;
				int frameID = (obj.counter / 10) & 3;
				if (frameID == 3) frameID = 1;
				obj.curFrame = jjAnimations[obj.curAnim] + frameID;
				obj.draw();
			}
		break; }
	}
}
 
void SpawnSkyrunnerEnemies() {
	++SkyrunnerStage;
	if (SkyrunnerStage < 200000 && SkyrunnerStage >= 200 && (SkyrunnerStage - 200) % 70 == 0) { //one enemy column per second, after the fade-in sequence
		const uint xTile = 12 + SkyrunnerStage / 70;
		if (xTile >= uint(jjLayerWidth[7])) {
			SkyrunnerStage = 200000;
			return;
		}
		const float right = shmupRightBorder + 48;
		const float left = shmupLeftBorder - 48;
		for (uint yTile = 0; yTile < 14; ++yTile) {
			const uint16 tileID = jjTileGet(7, xTile, yTile);
			const bool faceLeft = (tileID & TILE::HFLIPPED) != 0;
			OBJECT::Object enemy;
			switch (tileID & TILE::RAWRANGE) {
				case 2120:
					enemy = OBJECT::BAT;
					break;
				case 2121:
					enemy = OBJECT::RAVEN;
					break;
				case 2122:
					enemy = OBJECT::SUCKER;
					break;
				case 2557:
					enemy = OBJECT::FLOATSUCKER;
					break;
				case 2291:
					if (jjDifficulty > 0)
						jjAddObject(OBJECT::FENCER, left + (right - left) / 2, yTile * 32 + 16, faceLeft ? 0 : 1);
					continue;
				case 1594: //stop sign
					if (jjDifficulty < 2) //Easy or Normal
						yTile += 1; //skip next row
				default:
					continue;
			}
			jjOBJ@ obj = jjObjects[jjAddObject(enemy, faceLeft ? right : left, yTile * 32 + 16, faceLeft ? 0 : 1, CREATOR::LEVEL)];
			obj.playerHandling = HANDLING::SPECIALDONE;
			obj.isTarget = false;
		}
	}
}

void LimitCameraSize(bool limit) {
	if (jjGameConnection != GAME::LOCAL || jjLocalPlayerCount > 1) //servers don't limit resolution for skyrunner, splitscreeners don't play skyrunner at all
		return;
	const int newHeight = limit ? 450 : 600;
	if (jjResolutionMaxHeight != newHeight || jjResolutionMaxWidth != 800) {
		jjChat("/maxresolution 800x" + newHeight);
		for (int i = 0; i < 8; ++i)
			jjAlert(""); //hide from onscreen chatlog
	}
}

