void onFunction1(bool circus) {
	if (jjLocalPlayerCount > 1)
		return;
	DesiredFogSpriteParam = circus ? 0 : 50;
	jjMusicLoad(circus ? "EB_Battling_Organs_OC_ReMix.mp3" : "EB_Zombie_Lounge_OC_ReMix.mp3");
	jjLayerOrderSet(circus ? LayersCircus : LayersNormal);
	jjLocalPlayers[0].lighting = circus ? 100 : 81;
	if (circus)
		jjLayerHasTiles[2] = (jjLocalPlayers[0].yPos < 250 * 32) || jjTriggers[13]; //no scaffolding at the boss
}

void onFunction3(bool enter) {
	if (jjLocalPlayerCount > 1)
		return;
	MLLE::GetLayer("Hide the Circus").hasTiles = !enter;
}

jjLAYER@ Clouds2, Fog, Crepuscular, Bushes;
uint8 DesiredFogSpriteParam = 50;
void setAutoscrollingSpeeds(bool on) {
	if (jjLocalPlayerCount > 1)
		return;
	array<jjLAYER@> layers = {MLLE::GetLayer("Skyscrapers"), MLLE::GetLayer("Smallscrapers"), MLLE::GetLayer("Sky")};
	for (uint i = 0; i < layers.length; ++i) {
		jjLAYER@ layer = layers[i];
		layer.xAutoSpeed = on ? layer.xSpeed : 0;
	}
	Clouds2.hasTiles = MLLE::GetLayer("Clouds").hasTiles = on;
	
	//for (uint tileID = 2866; tileID <= 2871; ++tileID)
	//	jjTileType[tileID] = 
	//	jjTileType[tileID + 10] = on ? 0 : 1; //clouds/balloons
}

void onDrawLayer1(jjPLAYER@ player, jjCANVAS@ canvas) {
	const int yPos = 97;
	//if (yPos > jjSubscreenHeight)
	//	return;
	//const int playerX = int(Bushes.getXPosition(player));
	int xPos = jjRenderFrame;
	for (int i = 0; i < 4; ++i) {
		const jjANIMATION@ anim = jjAnimations[(i < 2) ? jjAnimSets[ANIM::SKELETON].firstAnim + 2 : jjObjectPresets[i == 2 ? 170 : 181].curAnim];
		canvas.drawSpriteFromCurFrame((uint((i & 1 == 0 ? xPos : int(3100 - xPos)) /*- playerX*/) % 3200) - 20, yPos, anim.firstFrame + (((jjGameTicks >> 3) + (i << 1)) % anim.frameCount), i & 1 == 0 ? 1 : -1, SPRITE::SINGLEHUE, 229);
		xPos += 400;
	}
}

void onFunction2(jjPLAYER@ player) {
	player.activateBoss(); //no music change
}

void addEyeBeam(const jjOBJ@ obj, float xSpeed, float ySpeed) {
	jjOBJ@ beam = jjObjects[jjAddObject(OBJECT::FIREBALLBULLET, obj.xPos, obj.yPos, obj.objectID, CREATOR::OBJECT)];
	beam.killAnim = beam.determineCurAnim(ANIM::AMMO, 75, false);
	beam.determineCurAnim(ANIM::AMMO, 11);
	beam.determineCurFrame();
	beam.xSpeed = xSpeed;
	beam.ySpeed = ySpeed;
	beam.xAcc = beam.yAcc = 0;
	beam.playerHandling = HANDLING::ENEMYBULLET;
	beam.animSpeed = 1;
	beam.counterEnd = 255;
}
class BoogeyEyeClass : jjBEHAVIORINTERFACE {
	void onBehave(jjOBJ@ obj) {
		if (jjLocalPlayerCount == 1) {
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame + 1, obj.direction, SPRITE::CHROMAKEY, 113, layerZ: 15);
			jjDrawRotatedSpriteFromCurFrame( //eyebrow
				obj.xPos - 71 * obj.direction,
				obj.yPos + 32, obj.curFrame + 3,
				(obj.counterEnd == 0 ? (14 - int(abs(jjSin(jjGameTicks * 5) * 14))) : (obj.counterEnd >> 1)) * -obj.direction,
				obj.direction,1,
				layerZ: 15
			);
		} else { //splitscreen, no pink circus background to chromakey onto
			if (obj.state == STATE::KILL)
				return;
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame + 1, obj.direction, layerZ: 5);
		}
		if (obj.justHit == 0) {
			if (obj.state == STATE::WAIT) {
				float pupilX = obj.xPos, pupilY = obj.yPos;
				const int playerID = obj.findNearestPlayer(500 * 500);
				if (playerID >= 0) {
					const jjPLAYER@ target = jjPlayers[playerID];
					const auto angle = atan2(
						target.yPos - pupilY,
						target.xPos - pupilX
					);
					pupilX += cos(angle) * 6;
					pupilY += sin(angle) * 6;
				}
				jjDrawSpriteFromCurFrame(pupilX, pupilY, obj.curFrame + 2, obj.direction, SPRITE::CHROMAKEY, 15, layerZ: 5);
			}
			jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction, SPRITE::CHROMAKEY, 15, layerZ: 5);
		}
		if (obj.state == STATE::KILL) {
			if (obj.counterEnd < 255)
				++obj.counterEnd;
			return;
		}
		if (obj.counterEnd != 0 && obj.counterEnd != 255)
			--obj.counterEnd;
		if (obj.state != STATE::WAIT) {
			obj.var[1] = jjSampleLooped(obj.xPos, obj.yPos, SOUND::COMMON_SHIELD4, obj.var[1]);
			if (++obj.counter > 120 && (obj.counter & 3 == 0)) {
				if (obj.state == STATE::BOUNCE) {
					obj.age += (12 + obj.counter / 40);
					addEyeBeam(obj, jjSin(obj.age) * 2.75 * -obj.direction, 4);
				} else { //rotate
					if (obj.state == STATE::CIRCLE || obj.counter < obj.var[2] / 2)
						obj.age += 10;
					else
						obj.age -= 10;
					if (obj.state == STATE::ROTATE)
						addEyeBeam(obj, jjSin(obj.age - 64) * 4, jjCos(obj.age - 64) * 4);
					addEyeBeam(obj, jjSin(obj.age + 64) * 4, jjCos(obj.age + 64) * 4);
				}
				if (obj.counter >= obj.var[2]) {
					obj.state = STATE::WAIT;
					obj.lightType = LIGHT::NONE;
				}
			}
		}
	}
	bool onObjectHit(jjOBJ@ obj, jjOBJ@ bullet, jjPLAYER@ play, int force) {
		if (bullet !is null) {
			obj.justHit = 5; //should this be up here? idk
			if ((bullet.var[6] & 16) == 16) { //sword
				if (jjGameTicks > obj.var[0]) {
					obj.energy -= 1;
					obj.var[0] = jjGameTicks - bullet.age + 35; //one hit per stab
				}
			} else {
				obj.energy -= 1;
				bullet.state = STATE::EXPLODE;
			}
		} //else... don't hurt player?
		return true;
	}
}
void AddBossClown() {
	jjOBJ@ clown = jjObjects[jjAddObject(141, 109 * 32 + (jjRandom() & 63), 263 * 32, 0,CREATOR::OBJECT, BEHAVIOR::INACTIVE)];
	clown.direction = (jjRandom() & 1 == 1) ? 1 : -1;
	clown.state = STATE::FALL;
	clown.curFrame = jjAnimations[clown.curAnim += 3];
	clown.bulletHandling = HANDLING::IGNOREBULLET;
	clown.xSpeed = clown.xAcc = 0;
	clown.behavior = Threed::Clown;
}
void AddBossFires(int duration = 600) {
	for (uint x = 101; x <= 118; ++x)
	jjObjects[jjAddObject(141, x * 32 + 16,283*32, 0,CREATOR::OBJECT, function(obj) {
		if (obj.state == STATE::START) {
			obj.determineCurAnim(ANIM::PLUS_SCENERY, 1);
			obj.frameID = jjRandom();
			obj.state = STATE::FLY;
			obj.animSpeed = 2;
			obj.playerHandling = HANDLING::ENEMYBULLET;
			obj.isTarget = false;
		} else {
			--obj.counter;
			if (obj.yPos > 8986) {
				obj.yPos -= 0.45;
			} else if (obj.counter <= 0) {
				obj.particlePixelExplosion(80);
				obj.delete();
			}
			if (jjGameTicks & 7 == 0) {
				++obj.frameID;
				obj.determineCurFrame();
			}
			jjDrawTile(int(obj.xPos) & ~31, obj.yPos + 8, 2683);
			obj.draw();
		}
	})].counter = duration;
}
class BoogeyTent : jjBEHAVIORINTERFACE {
	array<jjOBJ@> Teeth;
	array<jjOBJ@> Eyes;
	array<jjOBJ@> Rings;
	bool DropTeeth = false;
	uint TimeTillTeethReappear = 110;
	void StartBouncing(uint i, int initialAngle = 0, int duration = 550, STATE::State state = STATE::BOUNCE) {
		jjOBJ@ eye = Eyes[i];
		eye.counter = 0;
		eye.state = state;
		eye.lightType = LIGHT::LASER;
		eye.light = 1;
		eye.age = initialAngle;
		eye.var[2] = duration;
	}
	void onBehave(jjOBJ@ obj) {
		bool found = false;
		for (int localPlayerID = 0; localPlayerID < jjLocalPlayerCount; ++localPlayerID)
			if (jjLocalPlayers[localPlayerID].bossActivated) {
				jjLocalPlayers[localPlayerID].boss = obj.objectID;
				found = true;
			}
					
		switch (obj.state) {
			case STATE::START: {
				jjOBJ@ eye;
				@eye = jjObjects[jjAddObject(obj.eventID, obj.xOrg + 96, obj.yOrg - 150, obj.objectID, CREATOR::OBJECT, BEHAVIOR::BEES)];
				eye.direction = -1;
				Eyes.insertLast(eye);
				@eye = jjObjects[jjAddObject(obj.eventID, obj.xOrg + 448, obj.yOrg - 150, obj.objectID, CREATOR::OBJECT, BEHAVIOR::BEES)];
				eye.direction = 1;
				Eyes.insertLast(eye);
				const auto eyeFrameID = jjAnimations[obj.curAnim + 2];
				BoogeyEyeClass BoogeyEye;
				for (uint i = 0; i < 2; ++i) {
					Eyes[i].behavior = BoogeyEye;
					Eyes[i].curFrame = eyeFrameID;
					Eyes[i].counterEnd = 255; //eye angle
					Eyes[i].playerHandling = HANDLING::SPECIAL;
					Eyes[i].bulletHandling = HANDLING::DETECTBULLET;
					Eyes[i].scriptedCollisions = true;
					Eyes[i].state = STATE::WAIT;
					Eyes[i].isTarget = true; //eh why not, have fun typing jjammo
				}
				obj.state = STATE::DELAYEDSTART;
			}
			case STATE::DELAYEDSTART:
				if (found) {
					obj.state = STATE::FADEIN;
					obj.xPos = int(obj.xOrg) & ~31;
					Eyes[0].counterEnd = 254; //start opening
					Eyes[1].counterEnd = 254;
					jjSample(0, jjLocalPlayers[0].yPos, SOUND::DOG_AGRESSIV, 0, 14000);
					jjVerticalSplitscreen = true;
				}
				return;
			case STATE::DEACTIVATE:
				for (uint i = 0; i < Eyes.length; ++i)
					Eyes[i].delete();
				obj.deactivate();
				break;
			case STATE::FADEIN:
				if (++obj.counterEnd == 200) {
					obj.state = STATE::IDLE;
					NewTeeth(obj);
				}
				DrawBoogeyMouth(obj, obj.counterEnd >> 1);
				break;
			case STATE::IDLE:
				++obj.counter;
				//jjDrawString(108 * 32, 272 * 32, "" + obj.counter, STRING::LARGE);
				if (obj.counter == 100) {
					DropTeeth = true;
				} else if (obj.counter == 850) {
					AddBossClown();
				} else if (obj.counter == 1000) {
					StartBouncing(0);
					StartBouncing(1, 0x200);
				} else if (obj.counter == 1700) {
					AddRing(2);
					AddRing(15);
				} else if (obj.counter == 1800) {
					AddBossFires();
				} else if (obj.counter == 2400) {
					DeleteRings();
				} else if (obj.counter == 2550) {
					StartBouncing(0);
					StartBouncing(1);
				} else if (obj.counter == 3050) {
					NewTeeth(obj);
				} else if (obj.counter == 3320) {
					DropTeeth = true;
					AddBossClown();
					if (jjDifficulty <= 1)
						jjObjects[jjAddObject(OBJECT::CARROT, 110 * 32, 263 * 32, 0,CREATOR::OBJECT, BEHAVIOR::PICKUP)].state = STATE::FLOATFALL;
				} else if (obj.counter == 3550) {
					AddBossClown();
				} else if (obj.counter == 3600) {
					AddBossClown();
				} else if (obj.counter == 4040) {
					AddRing(8);
				} else if (obj.counter == 4120) {
					AddRing(1);
				} else if (obj.counter == 4200) {
					AddRing(16);
					StartBouncing(0, state: STATE::ROTATE);
					StartBouncing(1, state: STATE::ROTATE);
				} else if (obj.counter == 4300) {
					AddBossFires(duration: 450);
				} else if (obj.counter == 4800) {
					AddBossClown();
					DeleteRings();
					AddRing(8);
					StartBouncing(0, duration: 1200, initialAngle: 0x300, state: STATE::CIRCLE);
					StartBouncing(1, duration: 1750);
				} else if (obj.counter == 6000) {
					StartBouncing(0);
				} else if (obj.counter == 6100) {
					AddBossFires(duration: 475);
					NewTeeth(obj);
				} else if (obj.counter == 6600) {
					DeleteRings();
					jjObjects[jjAddObject(OBJECT::CARROT, 110 * 32, 263 * 32, 0,CREATOR::OBJECT, BEHAVIOR::PICKUP)].state = STATE::FLOATFALL;
					obj.counter = 0; //loop
				}
				
				DrawBoogeyMouth(obj, 100 + int(jjSin(jjGameTicks * 12) * 4));
				break;
			case STATE::KILL:
				if (obj.counterEnd == 1) {
					for (int j = 0; j < jjLocalPlayerCount; ++j) {
						jjLocalPlayers[j].bossActivated = false;
						jjLocalPlayers[j].cameraFreeze(true, false, false, true);
					}
					jjTriggers[13] = true;
					obj.deactivates = true;
					jjVerticalSplitscreen = false;
					jjLayerHasTiles[2] = true;
				}
				if (obj.counterEnd != 0) {
					--obj.counterEnd;
					DrawBoogeyMouth(obj, obj.counterEnd >> 1);
					jjObjects[jjAddObject(OBJECT::EXPLOSION, obj.xPos + (jjRandom() % jjAnimFrames[obj.curFrame].width), obj.yPos - 150 + (jjRandom() % 150))].determineCurAnim(ANIM::AMMO, 3);
				}
				return;
		}
		
		if (Teeth.length == 0) {
			if (TimeTillTeethReappear != 0)
				--TimeTillTeethReappear;
			//else
			//	NewTeeth(obj);
		} else
			for (int i = Teeth.length; --i >= 0; ) {
				jjOBJ@ tooth = Teeth[i];
				float yPos = tooth.yPos;
				if (tooth.counter < 110 || DropTeeth)
					++tooth.counter;
				if (tooth.counter < 110)
					yPos += (110 - tooth.counter) * ((tooth.yPos > obj.yOrg) ? .85 : -.85);
				else if (tooth.counter == 110)
					tooth.counter = 2000 - tooth.age;
				else if (tooth.counter == 2001) {
					tooth.state = STATE::FADEIN;
					Teeth.removeAt(i);
					if (Teeth.length == 0) {
						TimeTillTeethReappear = 500;
						DropTeeth = false;
					}
				}
				jjDrawSpriteFromCurFrame(tooth.xPos, yPos, tooth.curFrame, tooth.direction, SPRITE::CHROMAKEY, 175, layerZ: 5);
			}
			
		for (uint i = 0; i < 2; ++i) {
			jjOBJ@ eye = Eyes[i];
			if (eye.energy < 60) {
				obj.energy -= (60 - eye.energy);
				eye.energy = 60;
				if (obj.energy <= 0) {
					obj.state = STATE::KILL; //shut mouth
					for (uint j = 0; j < 2; ++j) {
						@eye = Eyes[j];
						eye.state = STATE::KILL; //shut eyes
						eye.isTarget = false;
						eye.lightType = LIGHT::NONE;
					}
					DeleteRings();
					for (int j = Teeth.length; --j >= 0; ) {
						jjOBJ@ tooth = Teeth[j];
						tooth.particlePixelExplosion(2);
						tooth.delete();
					}
					for (int spawnID = jjObjectCount; --spawnID != 0;) {
						const jjOBJ@ spawn = jjObjects[spawnID];
						if ((spawn.eventID == 141 || spawn.eventID == OBJECT::BULLET) && spawn.isActive) //clowns and fire and beams
							jjDeleteObject(spawnID);
					}
					SavedTriggers[13] = true;
					jjEnabledASFunctions[2] = false;
					jjEventSet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 0);
					obj.creatorType = CREATOR::OBJECT;
					jjSample(0, jjLocalPlayers[0].yPos, SOUND::DOG_AGRESSIV, 0, 14000);
					return;
				}
			}
		}
		for (int i = Rings.length; --i >= 0;)
			if (Rings[i].yPos > obj.yOrg)
				Rings[i].yPos -= 1;
	}
	void NewTeeth(const jjOBJ@ obj) {
		const array<uint> frameIDs = {
			2,3, 1,1,1, 3, 0,0,0,
			0,0,0, 3, 1,1,1, 3,2,
			2,2,2, 1,1,1, 3, 0,0,
			0,0, 3, 1,1,1, 2,2,2
		};
		array<uint> delays;
		SPRITE::Direction direction = SPRITE::FLIPNONE;
		float ySpeed = 1.5;
		for (uint i = 0; i < 36; ++i)
			delays.insertLast(i * 18);
		for (uint i = 0; i < 36; ++i) {
			if (i == 9)
				direction = SPRITE::FLIPH;
			else if (i == 18) {
				direction = SPRITE::FLIPV;
				ySpeed = -6;
			} else if (i == 27)
				direction = SPRITE::FLIPHV;
			jjOBJ@ tooth = jjObjects[jjAddObject(obj.eventID, obj.xOrg + (i % 18) * 32, obj.yOrg + ((i < 18) ? -36 : 36), obj.objectID, CREATOR::OBJECT, jjVOIDFUNCOBJ(Tooth))];
			tooth.direction = direction;
			tooth.ySpeed = ySpeed;
			tooth.curFrame += frameIDs[i];
			const uint delayIndex = jjRandom() % delays.length;
			tooth.age = delays[delayIndex];
			delays.removeAt(delayIndex);
			Teeth.insertLast(@tooth);
		}
	}
	void AddRing(int x) {
		jjOBJ@ ring = jjObjects[jjAddObject(158, (101 + x) * 32 + 16, 284 * 32 - 1)];
		ring.special = ring.age = 256;
		Rings.insertLast(ring);
	}
	void DeleteRings() {
		while (Rings.length != 0) {
			Rings[0].particlePixelExplosion(1);
			Rings[0].state = STATE::DEACTIVATE;
			Rings[0].behave();
			Rings.removeAt(0);
		}
	}
	void DrawBoogeyMouth(const jjOBJ@ obj, uint height) const {
		const int top = int(obj.yPos) - height / 2;
		const auto spriteMode = height < 60 ? SPRITE::CHROMAKEY : SPRITE::NORMAL; //presumably NORMAL is ever so slightly faster
		jjDrawRectangle(obj.xPos, top, jjAnimFrames[obj.curFrame].width, height + 1, 175, layerZ:5);
		jjDrawSpriteFromCurFrame(obj.xPos, top, obj.curFrame, 1, spriteMode, 175, layerZ:5);
		jjDrawSpriteFromCurFrame(obj.xPos, top + height, obj.curFrame, SPRITE::FLIPV, spriteMode, 175, layerZ:5);
		jjDrawSpriteFromCurFrame(obj.xPos, top, obj.curFrame + 1, 1, layerZ:5);
		jjDrawSpriteFromCurFrame(obj.xPos, top + height, obj.curFrame + 1, SPRITE::FLIPV, layerZ:5);
	}
	void Tooth(jjOBJ@ obj) {
		if (obj.state == STATE::START) {
			obj.state = STATE::WAIT;
			obj.curFrame = jjAnimations[obj.curAnim + 1];
			return;
		} else if (obj.state == STATE::FADEIN) {
			float xPos = obj.xPos, yPos = obj.yPos;
			xPos += int(jjRandom() & 7) - 3.5;
			yPos += int(jjRandom() & 7) - 3.5;
			jjDrawSpriteFromCurFrame(xPos, yPos, obj.curFrame, obj.direction);
			if (++obj.counter == 2050) {
				obj.state = STATE::BOUNCE;
				obj.playerHandling = HANDLING::ENEMYBULLET;
				obj.animSpeed = 1;
			}
		} else if (obj.state == STATE::BOUNCE) {
			if ((obj.ySpeed += 0.1) > 16) {
				obj.delete();
			} else {
				obj.yPos += obj.ySpeed;
				jjDrawSpriteFromCurFrame(obj.xPos, obj.yPos, obj.curFrame, obj.direction);
			}
		} else if (obj.state == STATE::EXPLODE) {
			obj.particlePixelExplosion(0);
			obj.curAnim = jjAnimSets[ANIM::AMMO] + 3;
			obj.behavior = BEHAVIOR::EXPLOSION;
			obj.playerHandling = HANDLING::EXPLOSION;
			obj.behave();
		}
	}
}

///@Event 44=Silver Coin                      |+|Goodies   |Silver |Coin|Location:{Hint Man, Skyrunner, Graveyard, Pole corner, Respawn bumpers, Teddy bear, Circus, Float ups, Under forest, Boogey Tent, Burger, Woman}4
///@Event 45=Gold Coin                        |+|Goodies   |Gold   |Coin|Location:{Hint Man, Skyrunner, Graveyard, Pole corner, Respawn bumpers, Teddy bear, Circus, Float ups, Under forest, Boogey Tent, Burger, Woman}4
const string coinPrefix = jjHelpStrings[7];
class CoinLocation {
	uint16 x,y,idx;
	int d;
	CoinLocation(){}
	CoinLocation(uint8 i){ idx = i; }
	CoinLocation(uint8 h, uint16 v, uint8 i) {
		x = h; y = v; idx = i;
		const int dx = 209 - int(x);
		const int dy = 30 - int(y);
		d = int(dx * dx + dy * dy);
	}
	int opCmp(const CoinLocation &in other) const {
		return d - other.d;
	}
	bool opEquals(const CoinLocation &in other) const {
		return idx == other.idx;
	}
}
array<CoinLocation> CoinLocations;
const array<string> CoinHints = {
	"on@the way here. Buttstomp@MacLellan's Pub & Grill.",
	"by@where the Skyrunner first landed.@Did you really miss it?@Did you do that on purpose?",
	"between@the main graveyard's tall trees.@Climb the hidden pole.",
	"at@the top of a tall pole@near some fire escapes.@It's a very precise jump.",
	"west@from the mysterious woman,@above two ghost bumpers.@Time yourself carefully.",
	"above@a big parking sign. Stomp off of@the smelly ghost and its flies.",
	"inside@the central circus. Go up from@the Two-Three tunnel, then turn@right at the forest.",
	"under@a hollowed out treestump@that you float out of.@Try buttstomping into it.",
	"beneath@the eastern forest.@There's a buttstomp block@obscured behind some leaves.",
	"far@to the left of the battle@with the flying teeth.@Open the colored crates@to get down there, then head left.",
	"slightly@northeast of the burger shop.@Use the horde of puppets@to get up high.",
	"by the@top of some fire escapes.@Can you reach the two@hidden trigger crates?"
};
bool ShowGemArrow = false;
void onFunction4() {
	if (CoinLocations.length > 0) {
		jjHelpStrings[7] = coinPrefix + CoinHints[CoinLocations[0].idx] + "@@@Come back later, I'll tell you more...";
	} else if (CollectedGems < NumberOfGems) {
		jjHelpStrings[7] =
			"@@@@@@You've found all the coins!@Now how about the skulls?@Follow that pink arrow!";
		ShowGemArrow = true;
	} else {
		jjHelpStrings[7] =
			"@@@@@@You've found everything!@Take the coins to the burger shop.@Then use the Two-Three Tunnel...";
	}
}

void BurgerBooth(jjOBJ@ obj) {
	array<float> realY(jjLocalPlayerCount);
	for (int i = 0; i < jjLocalPlayerCount; ++i) {
		realY[i] = jjLocalPlayers[i].yPos;
		jjLocalPlayers[i].yPos = -40;
	}
	obj.behave(BEHAVIOR::WARP);
	for (int i = 0; i < jjLocalPlayerCount; ++i)
		jjLocalPlayers[i].yPos = realY[i];
	
	const int nearestPlayerID = obj.findNearestPlayer(32*32);
	if (nearestPlayerID >= 0) {
		jjPLAYER@ player = jjPlayers[nearestPlayerID];
		if (player.isLocal && player.getObjectHitForce() != 1 && PlayersX[player.localPlayerID].BurgerSequence == 0) {
			if (player.testForCoins(obj.var[0])) {
				obj.var[0] = 0; //don't show price anymore
				jjParameterSet(uint(obj.xOrg) >> 5, uint(obj.yOrg) >> 5, 8,8, 0); //, even if it deactivates
				PlayersX[player.localPlayerID].BurgerSequence = 1;
				player.buttstomp = 121;
				player.specialMove = 0;
				player.extendInvincibility(-1000);
				player.noclipMode = true;
				player.ySpeed = -1;
				player.xSpeed = 0;
				jjSamplePriority(SOUND::COMMON_HARP1);
			}
		}
	}
}

bool onCheat(string &in cheat) {
	if (cheat == "jjcoins") {
		CollectedCoins = NumberOfCoins;
		jjAlert("jjcoins", size: STRING::MEDIUM);
		return true;
	}
	if (cheat == "jjgems" || cheat == "jjbird") {
		/*auto layers = jjLayerOrderGet();
		for (uint i = 0; i < layers.length; ++i)
			layers[i].spriteMode = SPRITE::INVISIBLE;*/ //debug
		return true; //nope
	}
	if (cheat == "jjfly") {
		for (int i = 0; i < jjLocalPlayerCount; ++i) {
			jjPLAYER@ play = jjLocalPlayers[i];
			if (play.fly == FLIGHT::NONE)
				play.fly = FLIGHT::FLYCARROT;
			else if (play.fly == FLIGHT::FLYCARROT) //no airboards
				play.fly = FLIGHT::NONE;
		}
		jjAlert("jjfly", size: STRING::MEDIUM);
		return true;
	}
	return false;
}

int TunnelGhostsScaredUntil = 0;
void onFunction5(jjPLAYER@ play) {
	jjTriggers[15] = true; //can't go back
	play.showText("");
	if (jjLocalPlayerCount == 1)
		jjMusicStop();
	if (TunnelGhostsScaredUntil < jjGameTicks) { //scary!
		if (PlayersX[play.localPlayerID].TunnelGhostSequence == 0)
			PlayersX[play.localPlayerID].TunnelGhostSequence = 1;
	} else { //you win!
		jjTriggers[14] = true; //can go forwards!
		jjEnabledASFunctions[5] = false;
		play.gems[GEM::RED] = CollectedRed;
		play.gems[GEM::GREEN] = CollectedGreen;
		play.gems[GEM::BLUE] = CollectedBlue;
		if (jjLocalPlayerCount == 1) {
			DesiredFogSpriteParam = 0;
			Crepuscular.spriteMode = SPRITE::INVISIBLE;
			MLLE::GetLayer("Skyscrapers").hasTiles = false;
			MLLE::GetLayer("Smallscrapers").hasTiles = false;
			jjPAL carrotus;
			carrotus.load("Carrot1.j2t");
			jjPalette.copyFrom(176, 32, 176, carrotus);
			for (uint i = 144; i <= 159; ++i)
				jjPalette.color[i].swizzle(COLOR::RED, COLOR::BLUE, COLOR::GREEN);
			for (uint i = 216; i <= 239; ++i)
				jjPalette.color[i].swizzle(COLOR::RED, COLOR::BLUE, COLOR::GREEN);
			jjPalette.apply();
			jjSetFadeColors();
			MLLE::GetLayer("Reflection").reflection.tintColor = 35;
		}
		jjAnimations[jjAnimSets[ANIM::JAZZ] + RABBIT::TELEPORT].frameCount -= 15; //skyrunner animation offset
		jjAnimations[jjAnimSets[ANIM::SPAZ] + RABBIT::TELEPORT].frameCount -= 15;
		if (jjIsTSF) {
			jjAnimations[jjAnimSets[ANIM::LORI] + RABBIT::TELEPORT].frameCount -= 15;
		}
	}
}

void onFunction6(uint8 triggerID) {
	jjTriggers[triggerID] = SavedTriggers[triggerID] = true;
}
