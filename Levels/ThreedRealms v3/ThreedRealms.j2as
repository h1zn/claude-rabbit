const bool MLLESetupSuccessful = MLLE::Setup(array<MLLEWeaponApply@> = {SzmolWeaponPack::MeleeSword::Weapon(), null, null, SzmolWeaponPack::LockOnMissile::Weapon(), WeaponVMega::Voranj::Weapon(), null, null, null, null}); ///@MLLE-Generated
